<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lgriffin</groupId>
        <artifactId>hadur-parent</artifactId>
        <version>2.0-SNAPSHOT</version>
    </parent>

    <artifactId>jaylexi</artifactId>
    <name>JayLexi</name>
    <description>hadur117.mini.JayLexi, a MiniRumble (1v1) entry: its classes within 1499 bytes (docs/kitlab.md).
        Separate from Hadur, Saor, TwinSaor, Deise and Sanaro.</description>

    <properties>
        <!-- The robot's version: the jar is named for it and JayLexi.properties takes it by filtering. -->
        <jaylexi.release>0.3</jaylexi.release>
        <!-- MiniRumble's limit, as Robocode's codesize tool counts the shipped jar (JAYLEXI-1). -->
        <jaylexi.codesize.limit>1499</jaylexi.codesize.limit>
        <!-- Rating clients still run Java 8; the shipped class targets it. -->
        <maven.compiler.release>8</maven.compiler.release>
        <jaylexi.jar>${project.build.directory}/hadur117.mini.JayLexi_${jaylexi.release}.jar</jaylexi.jar>
        <proguard.version>7.8.2</proguard.version>
        <codesize.version>1.3.1</codesize.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>net.sf.robocode</groupId>
            <artifactId>robocode-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Build tools, test scope so nothing reaches the jar: ProGuard runs at package. -->
        <dependency>
            <groupId>com.guardsquare</groupId>
            <artifactId>proguard-base</artifactId>
            <version>${proguard.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.sf.robocode</groupId>
            <artifactId>codesize</artifactId>
            <version>${codesize.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <!-- ProGuard needs the API jar's path as a library. -->
                    <execution>
                        <id>robocode-api-path</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <!-- The jar the rumble takes: the robot's classes through ProGuard's optimiser
                         (proguard.pro), with its properties and source, as Deise's (0.3's opponent
                         tables fit MiniRumble only optimised). Run in its own JVM: ProGuard calls
                         System.exit. -->
                    <execution>
                        <id>proguard</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>-Djaylexi.jar=${jaylexi.jar}</argument>
                                <argument>-Drobocode.api=${net.sf.robocode:robocode-api:jar}</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>proguard.ProGuard</argument>
                                <argument>@${project.basedir}/proguard.pro</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The gate on the shipped jar (JAYLEXI-1, JAYLEXI-9). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <systemPropertyVariables>
                        <jaylexi.jar>${jaylexi.jar}</jaylexi.jar>
                        <jaylexi.release>${jaylexi.release}</jaylexi.release>
                        <jaylexi.codesize.limit>${jaylexi.codesize.limit}</jaylexi.codesize.limit>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
