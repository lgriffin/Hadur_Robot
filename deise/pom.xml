<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lgriffin</groupId>
        <artifactId>hadur-parent</artifactId>
        <version>2.0-SNAPSHOT</version>
    </parent>

    <artifactId>deise</artifactId>
    <name>Deise</name>
    <description>hadur117.mini.Deise, a MiniMelee entry: one class flattened by hand from a pure core, held to
        it by an equivalence test (docs/deise.md). Separate from Hadur, Saor and TwinSaor.</description>

    <properties>
        <!-- The robot's version: the jar is named for it and Deise.properties takes it by filtering. -->
        <deise.release>0.2</deise.release>
        <!-- MiniMelee's limit, as Robocode's codesize tool counts the shipped jar (DEISE-12). -->
        <deise.codesize.limit>1499</deise.codesize.limit>
        <!-- Rating clients still run Java 8; the shipped classes target it. -->
        <maven.compiler.release>8</maven.compiler.release>
        <deise.jar>${project.build.directory}/hadur117.mini.Deise_${deise.release}.jar</deise.jar>
        <deise.lab.jar>${project.build.directory}/hadur117.mini.DeiseLab_${deise.release}.jar</deise.lab.jar>
        <proguard.version>7.8.2</proguard.version>
        <codesize.version>1.3.1</codesize.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>net.sf.robocode</groupId>
            <artifactId>robocode-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Build tools, test scope so nothing reaches the jar: ProGuard runs at package. -->
        <dependency>
            <groupId>com.guardsquare</groupId>
            <artifactId>proguard-base</artifactId>
            <version>${proguard.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.sf.robocode</groupId>
            <artifactId>codesize</artifactId>
            <version>${codesize.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <!-- ProGuard needs the API jar's path as a library. -->
                    <execution>
                        <id>robocode-api-path</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <!-- The jar the rumble takes: the one flat class through ProGuard's peephole pass
                         (proguard.pro), with its properties and source. Run in its own JVM: ProGuard
                         calls System.exit. -->
                    <execution>
                        <id>proguard</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>-Ddeise.jar=${deise.jar}</argument>
                                <argument>-Drobocode.api=${net.sf.robocode:robocode-api:jar}</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>proguard.ProGuard</argument>
                                <argument>@${project.basedir}/proguard.pro</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The bench adapter's jar: DeiseLab over the core, unoptimised. Not for the rumble;
                 the bench arms are built from its source (hadur-bench/tools/deise_arms.sh). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>lab-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <jar destfile="${deise.lab.jar}">
                                    <fileset dir="${project.build.outputDirectory}">
                                        <include name="hadur117/mini/**"/>
                                        <exclude name="hadur117/mini/Deise.class"/>
                                        <exclude name="hadur117/mini/Deise.properties"/>
                                    </fileset>
                                </jar>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The gate on the shipped jar (DEISE-12, DEISE-15, DEISE-16). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <systemPropertyVariables>
                        <deise.jar>${deise.jar}</deise.jar>
                        <deise.lab.jar>${deise.lab.jar}</deise.lab.jar>
                        <deise.release>${deise.release}</deise.release>
                        <deise.codesize.limit>${deise.codesize.limit}</deise.codesize.limit>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
