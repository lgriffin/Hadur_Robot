<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lgriffin</groupId>
        <artifactId>hadur-parent</artifactId>
        <version>2.0-SNAPSHOT</version>
    </parent>

    <artifactId>hadur-bench</artifactId>
    <packaging>jar</packaging>

    <name>Hadur Bench</name>
    <description>Headless Robocode battles for measuring Hadur: cold and warm runs, seeded, with console and ground-truth logs.</description>

    <properties>
        <!-- The full engine, from Maven Central: 1.11.1, a release LiteRumble takes uploads from (issue #151,
             BENCH-79). Robots compiled against the 1.9.3.0 API run on it. -Drobocode.version=... swaps it. -->
        <robocode.version>1.11.1</robocode.version>
        <!-- The bench never ships, so it keeps Java 17. -->
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- Reads Hadur's stored profiles for the report (the bench process only; battles
             run in child JVMs whose classpath leaves the core out, see below). -->
        <dependency>
            <groupId>com.lgriffin</groupId>
            <artifactId>hadur-core</artifactId>
        </dependency>
        <dependency>
            <groupId>net.sf.robocode</groupId>
            <artifactId>robocode.api</artifactId>
            <version>${robocode.version}</version>
        </dependency>
        <dependency>
            <groupId>net.sf.robocode</groupId>
            <artifactId>robocode.core</artifactId>
            <version>${robocode.version}</version>
        </dependency>
        <dependency>
            <groupId>net.sf.robocode</groupId>
            <artifactId>robocode.host</artifactId>
            <version>${robocode.version}</version>
        </dependency>
        <dependency>
            <groupId>net.sf.robocode</groupId>
            <artifactId>robocode.battle</artifactId>
            <version>${robocode.version}</version>
        </dependency>
        <dependency>
            <groupId>net.sf.robocode</groupId>
            <artifactId>robocode.repository</artifactId>
            <version>${robocode.version}</version>
        </dependency>
        <dependency>
            <groupId>net.sf.robocode</groupId>
            <artifactId>robocode.samples</artifactId>
            <version>${robocode.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Each battle runs in its own JVM (Robocode reads RANDOMSEED once per JVM),
                 so the bench needs the runtime classpath written out. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>classpath</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <outputFile>${project.build.directory}/classpath.txt</outputFile>
                            <includeScope>runtime</includeScope>
                            <!-- The robot brings its own copy of the core in its jar; one on
                                 the engine's classpath could shadow it. -->
                            <excludeArtifactIds>hadur-core</excludeArtifactIds>
                        </configuration>
                    </execution>
                    <execution>
                        <id>samples</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>net.sf.robocode</groupId>
                                    <artifactId>robocode.samples</artifactId>
                                    <version>${robocode.version}</version>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/samples</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>hadur.bench.Bench</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
