melee-census-317.txt
--seeds
6
--seed-base
3176
--rounds
35
--parallel
@C@
--child-heap
2G
--cpu-constant
auto
--robot-jar
bisect/hadur2.Hadur_@V@@A@.jar
--robot
hadur2.Hadur @V@@A@
--out
work/melee-s2-@V@-@A@
