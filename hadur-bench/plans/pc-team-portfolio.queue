# Team: every team on the one change it leans to, banked as a group (BENCH-231). Team thread: team-only, duel and
# melee fixtures bit for bit. pc-team-farm (BENCH-204) screened nine per-team changes and stopped at its pilot: its
# pick kept a team only when the team's own 95% low end cleared zero, and at 6 seeds a team reads to about +/-5
# points, so almost no team could. pc-team-quarters (PR #759) showed the same thing from the other side:
# NightmareTeam read +4.0 and then +4.3 on fresh seeds and still could not clear a bar set for many teams. The
# ladder scores the mean over the teams, so this card asks the group, not the team.
#   aa      the baseline (master); bb its A/A copy
#   qt      QUARTERS on (TMODE-45)          ga  GANG on from the first tick (TMODE-3)
#   ho      OWN + HEADON, LINEAR off        li  OWN + LINEAR, HEADON off (TMODE-20..22)
#   nd      DODGE off    nc  CONCORD off    nk  CLOSE off (teams with HUNT)    nh  HUNT off    np  PATH off
# Each arm's table (work/team-portfolio-ARM.java) and team set come from tools/team_modes.py arms over
# plans/team-portfolio-arms.tsv: a team's entry is its shipped TABLE entry, else the default, changed one way; a
# team the change leaves as it is skips the arm.
# Screen: bb and every arm against aa on the same 6 fresh seeds (from 15000), 12 rounds, paired.
# Pick (tppick, team_modes.py pick --shrink): each arm's gain over aa less half of bb's is shrunk toward the arm's
#   mean over its teams by the share of the gains' variance that is spread between teams and not noise; a team takes
#   the arm whose shrunk gain is largest and above 0, else none. No team has to clear an interval.
# Confirm: the picked table (fx) and bb against aa on the picked teams, 24 fresh seeds (from 15100); tpgate prices the
#   group as a projected team APS change: at least +0.15 over 46 pairings with the 95% low end above zero. No
#   per-team lock. The card changes nothing: on a PASS a PR writes work/team-portfolio-pick.java into TeamModes.TABLE.
# No team picked: the confirm steps do nothing and the results PR carries the screen and the pick.
# Why it should win: the levers are all per team, each team gets its own or none, the pick is made on the screen's
#   seeds and judged on seeds it has not seen, and one team's +4 is +0.09 APS. Risk: team battles are noisy and there
#   are only 46 teams, so the group gate needs its 24 seeds; on a FAIL nothing ships.
# Size: bb 552 battles; the arms at most 9 x 552; the confirm 2 x picked teams x 48 (1,920 at 20 teams): about 7,400
# battles at most, about 5 h at the 1,470 team battles/h pc-team-quarters ran at. Every step resumes where it stopped.
# Stop rules on every battle step (halt; every battle fought is kept and a rerun resumes): 60 failed battles, no
# battle in 30 minutes, or 60+ skipped turns a battle over the last 200.
# The team thread reads claude/pc-team-portfolio-results.
#   ./queue.sh run pc-team-portfolio        (or  .\queue.ps1 run pc-team-portfolio)
# Run it from master (one bench queue at a time, RoboRumble workers at 0):
#   git checkout master && git pull

set OUT = ../docs/bench/local
set T = python3 tools/team_modes.py
set MODES = ../hadur-core/src/main/java/hadur117/core/melee/TeamModes.java
set DEFAULT = MATEFIRE,HUNT,PATH,DODGE,CONCORD,CLOSE

tpprep | git checkout -q master && V=$(sed -n 's:.*<robot.release>\(.*\)</robot.release>.*:\1:p' ../hadur-robot/pom.xml) && test -n "$V" && for a in aa bb qt ga ho li nd nc nk nh np fx; do rm -f bisect/hadur117.HadurTeam_"$V"$a.jar; done && rm -f ${OUT}/team-portfolio-*.md && mkdir -p work && rm -rf work/team-portfolio-"$V"-* && rm -f work/team-portfolio-*.java work/team-portfolio-*.txt work/team-portfolio-*.tsv work/team-portfolio-*.args && echo "$V" > work/team-portfolio.version && ./fetch-opponents.sh --set team-census46.txt && ${T} arms --arms plans/team-portfolio-arms.tsv --census team-census46.txt --opponents opponents --shipped ${MODES} --default ${DEFAULT} --out-dir work --stem team-portfolio && bash ./build-ablation.sh aa && bash ./build-ablation.sh bb && for a in qt ga ho li nd nc nk nh np; do TEAM_MODE_TABLE="$(pwd)/work/team-portfolio-$a.java" TEAM_MODE_SUFFIX=$a bash ./build-ablation.sh tmtab || exit 1; done && sed "s/@V@/$V/g" plans/team-portfolio-bb.args > work/team-portfolio-bb.args && for a in qt ga ho li nd nc nk nh np; do sed -e "s/@V@/$V/g" -e "s/@A@/$a/g" plans/team-portfolio-arm.args > work/team-portfolio-$a.args || exit 1; done && for a in aa bb qt ga ho li nd nc nk nh np; do test -f bisect/hadur117.HadurTeam_"$V"$a.jar || exit 1; done && mvn -q compile
tpbb | mvn -q exec:java "-Dexec.args=@work/team-portfolio-bb.args"
  after: tpprep
  watch: battles=552
  stop: fails 60
  stop: stall 30m
  stop: skips 60 over 200
tpqt | mvn -q exec:java "-Dexec.args=@work/team-portfolio-qt.args"
  after: tpbb
  watch:
  stop: fails 60
  stop: stall 30m
  stop: skips 60 over 200
tpga | mvn -q exec:java "-Dexec.args=@work/team-portfolio-ga.args"
  after: tpqt
  watch:
  stop: fails 60
  stop: stall 30m
  stop: skips 60 over 200
tpho | mvn -q exec:java "-Dexec.args=@work/team-portfolio-ho.args"
  after: tpga
  watch:
  stop: fails 60
  stop: stall 30m
  stop: skips 60 over 200
tpli | mvn -q exec:java "-Dexec.args=@work/team-portfolio-li.args"
  after: tpho
  watch:
  stop: fails 60
  stop: stall 30m
  stop: skips 60 over 200
tpnd | mvn -q exec:java "-Dexec.args=@work/team-portfolio-nd.args"
  after: tpli
  watch:
  stop: fails 60
  stop: stall 30m
  stop: skips 60 over 200
tpnc | mvn -q exec:java "-Dexec.args=@work/team-portfolio-nc.args"
  after: tpnd
  watch:
  stop: fails 60
  stop: stall 30m
  stop: skips 60 over 200
tpnk | mvn -q exec:java "-Dexec.args=@work/team-portfolio-nk.args"
  after: tpnc
  watch:
  stop: fails 60
  stop: stall 30m
  stop: skips 60 over 200
tpnh | mvn -q exec:java "-Dexec.args=@work/team-portfolio-nh.args"
  after: tpnk
  watch:
  stop: fails 60
  stop: stall 30m
  stop: skips 60 over 200
tpnp | mvn -q exec:java "-Dexec.args=@work/team-portfolio-np.args"
  after: tpnh
  watch:
  stop: fails 60
  stop: stall 30m
  stop: skips 60 over 200
tppick | ${T} pick --report qt=${OUT}/team-portfolio-qt.md --control qt=${OUT}/team-portfolio-bb.md --report ga=${OUT}/team-portfolio-ga.md --control ga=${OUT}/team-portfolio-bb.md --report ho=${OUT}/team-portfolio-ho.md --control ho=${OUT}/team-portfolio-bb.md --report li=${OUT}/team-portfolio-li.md --control li=${OUT}/team-portfolio-bb.md --report nd=${OUT}/team-portfolio-nd.md --control nd=${OUT}/team-portfolio-bb.md --report nc=${OUT}/team-portfolio-nc.md --control nc=${OUT}/team-portfolio-bb.md --report nk=${OUT}/team-portfolio-nk.md --control nk=${OUT}/team-portfolio-bb.md --report nh=${OUT}/team-portfolio-nh.md --control nh=${OUT}/team-portfolio-bb.md --report np=${OUT}/team-portfolio-np.md --control np=${OUT}/team-portfolio-bb.md --shrink --margin 0 --teams 46 --census team-census46.txt --opponents opponents --counters work/team-portfolio-counters.tsv --out-md ${OUT}/team-portfolio-pick.md --out-tsv work/team-portfolio-pick.tsv --out-java work/team-portfolio-pick.java --out-set work/team-portfolio-confirm.txt && if [ -s work/team-portfolio-pick.java ]; then cp work/team-portfolio-pick.java ${OUT}/team-portfolio-pick.java.txt; else echo "nothing picked: no confirm"; fi
  after: tpnp
tpcprep | if [ -s work/team-portfolio-pick.java ]; then V=$(cat work/team-portfolio.version) && test -n "$V" && TEAM_MODE_TABLE="$(pwd)/work/team-portfolio-pick.java" TEAM_MODE_SUFFIX=fx bash ./build-ablation.sh tmtab && for j in bb fx; do sed -e "s/@V@/$V/g" -e "s/@J@/$j/g" plans/team-portfolio-confirm.args > work/team-portfolio-c$j.args || exit 1; done && test -f bisect/hadur117.HadurTeam_"$V"fx.jar; else echo "nothing picked: no confirm"; fi
  after: tppick
tpcbb | if [ -s work/team-portfolio-pick.java ]; then mvn -q exec:java "-Dexec.args=@work/team-portfolio-cbb.args"; else echo "nothing picked: no confirm"; fi
  after: tpcprep
  watch:
  stop: fails 60
  stop: stall 30m
  stop: skips 60 over 200
tpcfx | if [ -s work/team-portfolio-pick.java ]; then mvn -q exec:java "-Dexec.args=@work/team-portfolio-cfx.args"; else echo "nothing picked: no confirm"; fi
  after: tpcbb
  watch:
  stop: fails 60
  stop: stall 30m
  stop: skips 60 over 200
tpgate | if [ -s work/team-portfolio-pick.java ]; then ${T} gate --report ${OUT}/team-portfolio-cfx.md --control ${OUT}/team-portfolio-cbb.md --set work/team-portfolio-confirm.txt --seeds 24 --teams 46 --min-aps 0.15 --out-md ${OUT}/team-portfolio-verdict.md || test $? -eq 1; else echo "nothing picked: no confirm"; fi
  after: tpcfx
tppr | bash tools/open_results_pr.sh claude/pc-team-portfolio-results "Team: every team on the one change it leans to, banked as a group" $(ls ${OUT}/team-portfolio-*.md ${OUT}/team-portfolio-pick.java.txt 2>/dev/null)
  after: tpgate
