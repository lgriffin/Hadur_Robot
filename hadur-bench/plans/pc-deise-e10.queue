# Deise's stage E6b (docs/deise.md section 8): stacking the aim arms.
# pc-deise-e09 (PR #498) read PL400 +0.23 ± 0.21, NARROW +0.21 ± 0.20 and SAME +0.14 ± 0.20 over D:
# each lifts damage a round (135.0 to 136.9, 136.6, 135.4) and reach to the last two without costing
# survival, none alone at +0.30. Mirage leads 0.61 live, so the margins are fine: E6b asks whether
# the three add up, on fresh seeds, with Mirage seated to read the gap directly.
#   ./queue.sh run pc-deise-e10        (or  .\queue.ps1 run pc-deise-e10)
# Run it from master:
#   git checkout master && git pull
# One bench queue, RoboRumble workers at 0, unpinned, 12 workers. A rerun skips every seat that
# finished; a seat that was stopped part-way is fought again from its start (the melee path has no
# per-battle resume). No step needs a decision. Nothing here touches Hadur, Saor or the shipped
# Deise class.
#
# Arms (deise-arms/arms.txt, sed on DeiseLab over the core, 0.4):
#   D      Deise 0.4 (DeiseLab), the reference     SAOR  Saor 0.2 seated, the control
#   PL400  400 playouts, again on fresh seeds      MIR   Mirage 0.2 seated: the gap to 1st
#   PN     PL400 and NARROW (constants, 0 B)
#   PNS    PL400, NARROW and SAME (about 8 B of PR #491's 47)
#   PNS6   PNS with 600 playouts: whether more keep paying (e09's PL400 skipped 0.14 turns a
#          battle to D's 0.02; the skip rule halts on 40 a battle)
# Live-shaped census: 46 fields x 6 seeds a seat (276 battles, about 17 min on the PC), 7 seats,
# about 2 h, fresh seeds from 4000.
# Reads: each arm against SAOR and against D, and melee_split of every seat against D
# (deise-e10-split.md). The best stack at +0.30 or more over D, low end above 0, is fitted into the
# shipped class and the core, matched (DEISE-16), as 0.5 on Leigh's go. MIR's seat says how much of
# Mirage's bench lead is left.
# Stop rules on every census step (halt; finished seats are kept, the stopped seat reruns from its
# start): 20 failed battles (a broken jar), no battle in 30 minutes (a hung step), or 40+ skipped
# turns a battle over the last 100. A halt at worst leaves the rest of that seat and the seats
# after it unrun, at most 1,932 battles (about 2 h). There is no early finish on score: a census
# seat is one robot, so there is no arm to call futile mid-step.

set MVN = mvn -q -Drobocode.version=1.11.1 compile exec:java
set OUT = ../docs/bench/local
set ARMS = D,PL400,PN,PNS,PNS6,MIR,SAOR

prep | (cd .. && mvn -q -DskipTests install -pl deise -am) && cp ../deise/target/hadur117.mini.Deise_0.4.jar opponents/ && curl -fsSLo opponents/hadur117.micro.Saor_0.2.jar https://github.com/lgriffin/Hadur_Robot/releases/download/saor-v0.2/hadur117.micro.Saor_0.2.jar && ./fetch-opponents.sh --set minimelee-field.txt && for f in melee-census-317/f*.txt; do ./fetch-opponents.sh --set "$f" || exit 1; done && DEISE_RUN=e10 bash tools/deise_arms.sh live 6 4000 ${ARMS}

live-D | ${MVN} "-Dexec.args=@work/deise-e10/live-D.args"
  after: prep
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-PL400 | ${MVN} "-Dexec.args=@work/deise-e10/live-PL400.args"
  after: live-D
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-PN | ${MVN} "-Dexec.args=@work/deise-e10/live-PN.args"
  after: live-PL400
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-PNS | ${MVN} "-Dexec.args=@work/deise-e10/live-PNS.args"
  after: live-PN
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-PNS6 | ${MVN} "-Dexec.args=@work/deise-e10/live-PNS6.args"
  after: live-PNS
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-MIR | ${MVN} "-Dexec.args=@work/deise-e10/live-MIR.args"
  after: live-PNS6
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-SAOR | ${MVN} "-Dexec.args=@work/deise-e10/live-SAOR.args"
  after: live-MIR
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

read | python3 tools/saor_arms.py --work-root work/deise-e10 --field live --arms ${ARMS} --control SAOR --only work/deise-e10/live/micro.txt --top5 71.15 --control-live 68.79 --pairings 203 --robot-prefix hadur117.mini.Deise --arms-file deise-arms/arms.txt > ${OUT}/deise-e10-live.md && python3 tools/saor_arms.py --work-root work/deise-e10 --field live --arms ${ARMS} --control D --only work/deise-e10/live/micro.txt --pairings 203 --robot-prefix hadur117.mini.Deise --arms-file deise-arms/arms.txt > ${OUT}/deise-e10-vs-d.md && python3 tools/melee_split.py --ref D ${OUT}/deise-e10-live-D.md ${OUT}/deise-e10-live-PL400.md ${OUT}/deise-e10-live-PN.md ${OUT}/deise-e10-live-PNS.md ${OUT}/deise-e10-live-PNS6.md ${OUT}/deise-e10-live-MIR.md ${OUT}/deise-e10-live-SAOR.md > ${OUT}/deise-e10-split.md
  after: live-SAOR

pr | bash tools/open_results_pr.sh claude/pc-deise-e10-results "Deise stage E6b: stacking the aim arms" ${OUT}/deise-e10-live.md ${OUT}/deise-e10-vs-d.md ${OUT}/deise-e10-split.md ${OUT}/deise-e10-live-*.md
  after: read
