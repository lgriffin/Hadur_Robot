# 1v1, cloud locks to the PC (BENCH-253), round 27. Round 26 ran as PR #1040 (nothing held: Midboss fq, ForceMajeure fq
# and RandomBot vj stay off).
# Round 27 carries seven per-robot lines on existing table switches, each locked on 12 fresh cloud seeds and confirmed
# on a second, independent 12-seed set (Robocode 1.12.0, live turn time, c a master copy, aa its A/A twin):
#   infovk.s_schwarzm16.silverbird 1.0  sb (MOVE-45 speed band)  +9.6 +- 1.3 vs aa (12 seeds 140300); confirm
#                                       +8.3 +- 2.9 vs c / +8.8 +- 1.9 vs aa (12 seeds 100000)
#   zen.Mirage 0.9.5                    rp (POW-17 race power)   +7.0 +- 4.7 vs c / +9.3 +- 3.2 vs aa (12 seeds 52900);
#                                       confirm +5.3 +- 3.2 vs c / +3.7 +- 3.8 vs aa (12 seeds 52920)
#   kjc.etc.Dharok 1.0, ms.Ares 0.19, mcb.Audace 1.3, sam.ChipmunkDuelist 1.0, acid.Bl4ck 1.0
#                                       qw (MOVE-67 aim weight 1.0), a group line: +0.55 +- 0.25 vs c / +0.32 +- 0.27 vs
#                                       aa pooled over the five (36 seeds 132300-132423); about +0.3 points each
# The PC reads 24 fresh seeds from 101000 and a line ships only on the PC's own read; the five qw robots are judged one
# by one like the rest, so only those that clear on their own ship.
# Fifteen robots whose lines are already on master (Maui, MadHatter, RammingC, AutoBot, Impact, NanoDeath, Kowari,
# Bicephal, GhostShell, Gridd, Polar, Dreadnaught, Nicator, MoggFanatic, BlackIce) are read only in c and aa, so the A/A
# check reads 22 robots.
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live
#   lock       panel-locks.txt  c / aa / sb / rp / qw, 24 fresh seeds from 101000, --cpu-constant live, in
#              work/pc-locks27 (earlier rounds' battles stay in work/pc-locks to -locks26)
#   gate       each robot judged on its own lever arm only (lock_prep.py --restrict); it keeps its line where the 95%
#              low end is above 0 (mode_table.py --margin 0).
# Leigh starts it once the PC is free (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-locks --fresh        (or  ./queue.sh run pc-locks --fresh)
#   --fresh because round 26 left this plan's queue state marked complete; the new work directory and seeds mean no
#   battle is read back from an earlier round (and BENCH-272 refights any whose jar changed).
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. 1,224 lock battles (22 robots in c and aa, 7 on a
# lever arm, 24 seeds), about 70 minutes with the live-match check. The prep step stops if any panel robot's jar is missing.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: each line names one robot; every other robot, team and melee play bit for bit as master.
#   - Diagnosis, from truth-log traces against BeepBoop 2.0: silverbird's learning gun hits us 6.0% against BeepBoop's
#     4.7%, and the speed band is the switch built against guns that learn our rounded velocity. Mirage is a learning
#     gun where we lose the low-energy endgames we enter behind (we won 3 of 18 such wars); race power is the switch
#     for that energy race. The five qw robots fire about half their shots head-on and those connect on us at 1.7-4.0%
#     against BeepBoop's 0.1-1.6%; the aim weight lets our surf trust the simple aims they actually use.
#   - Every line read positive against both controls on two independent cloud seed sets; 24 PC seeds settle them at half
#     the cloud's interval width, and the gate keeps only what holds on the PC.
# Stop rules (docs/bench/watch.md): the watcher's A/A rule needs 10 robots read in both c and aa; this lock reads 22, but
# the gate reads aa (multiarm.py prints aa against c), so no aa stop rule is set. The lock halts on 30 failed battles, an
# arm scoring nothing in 8, 60+ skipped turns a battle over the last 24 or no battle in 30 minutes. The live-match step
# stops the card if the PC no longer scores us and BeepBoop as live does (tools/live_match.py exit 3).
# ALERT opens an issue for Leigh on any stop.
# Bank: the owning cloud thread adds the gate's lines in a PR after this card's results PR. Nothing is released by the card.
set V = 3.24
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-locks27
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && python3 tools/lock_prep.py plans/locks-pick.tsv panel-locks.txt plans/pc-locks.arms ${W}-prep && bash ${W}-prep/build.sh && for a in sb rp qw; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; done && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-locks.txt && for j in $(grep -v "^#" panel-locks.txt | cut -d"|" -f3); do test -f opponents/$j || { echo "missing jar $j"; exit 1; }; done && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out work/pc-livematch-rel-live --label pc-locks-livematch --shuffle-jobs && python3 tools/live_match.py work/pc-livematch-rel-live/arms.tsv --out ${OUT}/pc-locks27-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock | ./bench-top20.sh ${C} ${P} --set panel-locks.txt --seeds 24 --seed-base 101000 --arms ${W}-prep/lock.arms --out ${W} --label pc-locks --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

gate | python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks27-lock.md && python3 tools/lock_prep.py --restrict ${W}/arms.tsv ${W}-prep ${W}/arms-picked.tsv && python3 ../data/tools/mode_table.py ${W}/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-locks27-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks27-lock-pick.md && python3 tools/per_robot.py ${W}/arms-picked.tsv --arms sb rp qw --out ${OUT}/$(date +%Y-%m-%d)_pc-locks27-lock-per-robot.md --out-tsv ${OUT}/pc-locks27-lock-per-robot.tsv
  after: lock

pr | bash tools/open_results_pr.sh claude/pc-locks27-results "1v1 cloud locks, round 27 (silverbird sb, Mirage rp, five head-on robots qw) on 24 fresh PC seeds" ${OUT}/pc-locks27-livematch.md ${OUT}/*_pc-locks27-*.md ${OUT}/pc-locks27-lock-per-robot.tsv $(find ${OUT} -maxdepth 1 -name 'pc-locks27-lock-pick.tsv' -size +0c)
  after: gate
