# 1v1, cloud locks to the PC (BENCH-253), round 17. Round 16 (PR #975; A/A -0.10 +- 0.37 on 15 robots, band +- 0.87)
# held Maui pm, RammingC, GrubbmThree and PureAggression rbd, MadHatter vj (banked), and kept all six on-master lines.
# Round 17 carries every cloud lock since, round 16's three near misses, and the MOVE-58 four, 12 robots in all.
# Cloud locks (Robocode 1.12.0, live turn time; coverage/shards/locks.tsv), vs c / vs aa:
#   pm (MOVE-56 pattern-matcher mimic) on NanoSatan (box D: 12 seeds 84176 +10.50 +- 1.67 / +11.00 +- 2.02).
#   ty (SHIELD-33 tiny-shot shield waves) on FloodMini (boxes G and A pooled: 24 seeds 84200 + 86623 +3.00 +- 2.59 /
#      +2.55 +- 2.45; all 48 seeds +2.06 +- 1.32 / +2.25 +- 1.49).
#   Re-reads from round 16: Leopard rbd (round 14 PC -0.6, round 16 PC +1.7; pooled about +0.6, low end just under 0;
#      cloud 12 seeds 84300 +1.54 +- 0.59 / +1.16 +- 0.75), RamRod rbd (round 16 PC +1.3, not clear; cloud +3.10 +- 2.13 /
#      +2.33 +- 1.90), Saguaro rp (round 16 PC +3.1, not clear; cloud pooled 60 seeds +4.76 +- 2.64 / +3.26 +- 2.29).
#   On master already, read as c minus bb (bb = master before it, 6f413dbf9):
#   MOVE-58 cw.megas-form mimic (PR #974; box G: 12 seeds 84230) on GhostShell +12.19 / +11.06, Gridd +10.35 / +9.69,
#      Polar +10.59 / +10.49, Silhouette +21.58 / +24.10.
#   A/A pads: Sanguijuela, UbaRamLT and ScalpBotC (round 14 lines on master, read only in c and aa), so the A/A check
#      reads 12 robots (round 15 was void on 5).
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live
#   lock       panel-locks.txt  c / aa / bb / pm / ty / rbd / rp, 12 fresh seeds from 85300, --cpu-constant live, in
#              work/pc-locks17 (earlier rounds' battles stay in work/pc-locks to -locks16)
#   gate       each robot judged on its own lever arm only (lock_prep.py --restrict); it keeps its line where the 95%
#              low end is above 0 (mode_table.py --margin 0). The MOVE-58 robots are read per robot as control minus
#              bb with a 95% interval (onmaster_ci.py; per-battle rows kept too): a line stays on master where the low
#              end is above 0, and comes off where the interval is wholly below 0. Leopard banks only if rounds 14, 16
#              and 17 pooled keep the low end above 0.
# Leigh starts it once the PC is free (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-locks --fresh        (or  ./queue.sh run pc-locks --fresh)
#   --fresh because round 16 left this plan's queue state marked complete.
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. 1,008 lock battles (12 robots, 7 arms, 12 seeds),
# about 30 minutes with the live-match check. The prep step stops if any panel robot's jar is missing.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: every line names one robot; every other robot, team and melee play bit for bit as master.
#   - NanoSatan: a truncated-lateral-velocity pattern matcher close to AutoBot's form; the shipped MOVE-56 mimic predicts
#     its bullets (+10.5 on its cloud lock; the round-by-round forensic runs on box D).
#   - FloodMini: a shield robot that keeps firing sub-0.1 bullets near 0.2 energy, which our hold rule left undodged;
#     each such hit refunds its energy (SHIELD-33, as FloodSonnet and QuickHack, both kept on round 16).
#   - MOVE-58: the four cw.megas guns are deterministic matchers on our movement; their own form cut their real hit
#     share on our waves from 8.4% to 2.9%, lower in every round bucket from round 0 (box C forensic).
#   - Leopard, RamRod: RAM-18's escape leaves out the heading a linear aim leads; Saguaro: an energy race BeepBoop wins
#     at power 0.7-0.85 while we open at 2.0.
# Stop rules (docs/bench/watch.md): the watcher's A/A rule needs 10 robots read in both c and aa; this lock reads 12, but
# the gate reads aa (multiarm.py prints aa against c), so no aa stop rule is set. The lock halts on 30 failed battles, an
# arm scoring nothing in 8, 60+ skipped turns a battle over the last 24 or no battle in 30 minutes. The live-match step
# stops the card if the PC no longer scores us and BeepBoop as live does (tools/live_match.py exit 3).
# ALERT opens an issue for Leigh on any stop.
# Bank: the owning cloud thread adds the gate's lines in a PR after this card's results PR. Nothing is released by the card.
set V = 3.23
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-locks17
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && python3 tools/lock_prep.py plans/locks-pick.tsv panel-locks.txt plans/pc-locks.arms ${W}-prep && bash ${W}-prep/build.sh && bash ./build-ablation.sh --ref 6f413dbf9 bb && grep "^bb " plans/pc-locks.arms >> ${W}-prep/lock.arms && for a in bb pm ty rbd rp; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; done && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-locks.txt && for j in $(grep -v "^#" panel-locks.txt | cut -d"|" -f3); do test -f opponents/$j || { echo "missing jar $j"; exit 1; }; done && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out work/pc-livematch-rel-live --label pc-locks-livematch --shuffle-jobs && python3 tools/live_match.py work/pc-livematch-rel-live/arms.tsv --out ${OUT}/pc-locks17-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock | ./bench-top20.sh ${C} ${P} --set panel-locks.txt --seeds 12 --seed-base 85300 --arms ${W}-prep/lock.arms --out ${W} --label pc-locks --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

gate | python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks17-lock.md && python3 tools/lock_prep.py --restrict ${W}/arms.tsv ${W}-prep ${W}/arms-picked.tsv && python3 ../data/tools/mode_table.py ${W}/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-locks17-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks17-lock-pick.md && python3 tools/per_robot.py ${W}/arms-picked.tsv --arms pm ty rbd rp --out ${OUT}/$(date +%Y-%m-%d)_pc-locks17-lock-per-robot.md --out-tsv ${OUT}/pc-locks17-lock-per-robot.tsv && python3 tools/onmaster_ci.py ${W}/arms.tsv --without bb --robots "cw.megas.GhostShell GT" "cw.megas.Gridd 0.4" "cw.megas.Polar 3.2" "cw.megas.Silhouette 1.1" --out ${OUT}/$(date +%Y-%m-%d)_pc-locks17-onmaster-per-robot.md --out-tsv ${OUT}/pc-locks17-onmaster-per-robot.tsv && head -1 ${W}/arms.tsv > ${OUT}/pc-locks17-onmaster-rows.tsv && grep -E "GhostShell|Gridd|Polar|Silhouette" ${W}/arms.tsv >> ${OUT}/pc-locks17-onmaster-rows.tsv
  after: lock

pr | bash tools/open_results_pr.sh claude/pc-locks17-results "1v1 cloud locks, round 17 (1 pm, 1 ty, 2 rbd, 1 rp; MOVE-58 confirm) on 12 fresh PC seeds" ${OUT}/pc-locks17-livematch.md ${OUT}/*_pc-locks17-*.md ${OUT}/pc-locks17-lock-per-robot.tsv ${OUT}/pc-locks17-onmaster-per-robot.tsv ${OUT}/pc-locks17-onmaster-rows.tsv $(find ${OUT} -maxdepth 1 -name 'pc-locks17-lock-pick.tsv' -size +0c)
  after: gate
