# 1v1, cloud locks to the PC (BENCH-253), round 2: every per-robot line that locked on the cloud (12+ fresh seeds, 95%
# low end above 0, live turn time; coverage/shards/locks.tsv) after round 1 (PR #843) ran, locked on 12 fresh PC seeds:
#   pb (POW-20 power band): MoxieBot +8.0 (low +5.9), CHCl3 +3.8 (+0.8), Combat +3.3 (+1.1), Portia +3.8 (+0.7, on its
#      second 12 seeds), Mikey +1.3 (+0.2, marginal)
#   x0 (SHIELD-19 exit off): Meroka +5.9 (+1.9), PralDeGuerre +4.1 (+1.0), Vespa +2.1 (+0.6, 24 seeds, marginal)
#   mv (SHIELD-17 moving shield): Lucid +8.6 (+2.7), LightningStorm +4.8 (+1.1, 24 seeds), Blade +3.4 (+0.5, 24 seeds),
#      Constitution +3.0 (+0.6)
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live
#   lock       the 12 robots   c / aa / pb / x0 / mv (each lever arm built with only its own robots)   12 fresh seeds
#              from 43200, --cpu-constant live, in work/pc-locks2 (round 1's battles stay in work/pc-locks)
#   gate       each robot judged on its own arm only (lock_prep.py --restrict); it keeps its line where the 95% low end
#              is above 0 (mode_table.py --margin 0)
# Leigh starts it once the PC is free (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-locks        (or  ./queue.sh run pc-locks)
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. 720 lock battles (12 robots, 5 arms, 12 seeds), about 20 minutes.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: every line names one robot; every other robot, team and melee play bit for bit as master.
#   - Diagnosis first:
#     pb: per energy band, the ratio of BeepBoop's bullet power against the robot to ours, from paired truth logs
#     (plans/power-band-lines.txt). Of 77 fitted lines screened on 8 seeds (field mean -0.2, so never a global switch),
#     23 leads went to 12 fresh seeds on four boxes and five held; BeepBoop fires a third of our power at MoxieBot.
#     With 23 robots locked, about one marginal lock may be luck; the PC decides.
#     x0: on these shielded robots the shield leaks slowly, the 150-damage exit fires mid-battle and the surf then takes
#     2.4-4.9x more damage a round (shards/shield-exit-C.tsv).
#     mv: these shielded robots close to 70-100 px and hit the still shield there (shards/shield-quality-D.md,
#     shards/screen-mvC.txt).
#   - Every robot passed the cloud lock bar first; round 1 held 8 of 13 such cloud locks on the PC (#843).
# Stop rules (docs/bench/watch.md): the watcher's A/A rule needs 10 robots read in both c and aa, which on 12 shuffled
# robots comes only near the end; aa is read in the gate (multiarm.py prints aa against c). The card halts on 30 failed
# battles, an arm scoring nothing in 8, 60+ skipped turns a battle over the last 24, or no battle in 30 minutes. The
# live-match step stops the card if the PC no longer scores us and BeepBoop as live does (tools/live_match.py exit 3).
# ALERT opens an issue for Leigh on any stop.
# Bank: the owning cloud thread adds the gate's lines on this card's results PR. Nothing is released by the card.
set V = 3.23
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-locks2
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && python3 tools/lock_prep.py plans/locks-pick.tsv panel-locks.txt plans/pc-locks.arms ${W}-prep && bash ${W}-prep/build.sh && for a in pb x0 mv; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; done && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-locks.txt && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out work/pc-livematch-rel-live --label pc-locks-livematch --shuffle-jobs && python3 tools/live_match.py work/pc-livematch-rel-live/arms.tsv --out ${OUT}/pc-locks-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock | ./bench-top20.sh ${C} ${P} --set panel-locks.txt --seeds 12 --seed-base 43200 --arms ${W}-prep/lock.arms --out ${W} --label pc-locks --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

gate | python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks-lock.md && python3 tools/lock_prep.py --restrict ${W}/arms.tsv ${W}-prep ${W}/arms-picked.tsv && python3 ../data/tools/mode_table.py ${W}/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-locks-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks-lock-pick.md && python3 tools/per_robot.py ${W}/arms-picked.tsv --arms pb x0 mv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks-lock-per-robot.md --out-tsv ${OUT}/pc-locks-lock-per-robot.tsv
  after: lock

pr | bash tools/open_results_pr.sh claude/pc-locks2-results "1v1 cloud locks, round 2 (12 robots from the field shards) locked on 12 fresh PC seeds" ${OUT}/pc-locks-livematch.md ${OUT}/*_pc-locks-*.md ${OUT}/pc-locks-lock-per-robot.tsv $(find ${OUT} -maxdepth 1 -name 'pc-locks-lock-pick.tsv' -size +0c)
  after: gate
