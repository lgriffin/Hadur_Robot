# 1v1, cloud locks to the PC (BENCH-253), round 25. Round 24 ran as PR #1024 (25 of 26 held, banked in #1026).
# Round 25 carries three per-robot lines, each locked on the cloud on 12 fresh seeds (Robocode 1.12.0, live turn time,
# c a master copy, aa its A/A twin), every 95% low end above 0 against both:
#   zen.Lindada 0.2           hf (POW-19 hard fire)        +3.46 +- 3.07 vs c / +4.83 +- 3.44 vs aa (seeds 90110)
#   slugzilla.Parallax 0.1    rp (POW-17 race power)       +2.71 +- 2.62 vs c / +3.28 +- 2.30 vs aa (seeds 90110)
#   rsim.mini.BulletCatcher 0.4  mv (SHIELD-17 opening drive) +3.08 +- 2.70 vs c / +7.42 +- 3.61 vs aa (seeds 92800)
# with fifteen robots whose lines are already on master (Maui, MadHatter, RammingC, AutoBot, Impact, NanoDeath, Kowari,
# Bicephal, GhostShell, Gridd, Polar, Dreadnaught, Nicator, MoggFanatic, BlackIce), read only in c and aa, so the A/A
# check reads 18 robots.
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live
#   lock       panel-locks.txt  c / aa / hf / rp / mv, 12 fresh seeds from 95300, --cpu-constant live, in work/pc-locks25
#              (earlier rounds' battles stay in work/pc-locks to -locks24)
#   gate       each robot judged on its own lever arm only (lock_prep.py --restrict); it keeps its line where the 95%
#              low end is above 0 (mode_table.py --margin 0).
# Leigh starts it once the PC is free (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-locks --fresh        (or  ./queue.sh run pc-locks --fresh)
#   --fresh because round 24 left this plan's queue state marked complete; the new work directory and seeds mean no
#   battle is read back from an earlier round (and BENCH-272 refights any whose jar changed).
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. 468 lock battles (18 robots in c and aa, 3 on a
# lever arm, 12 seeds), about 25 minutes with the live-match check. The prep step stops if any panel robot's jar is missing.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: each line names one robot; every other robot, team and melee play bit for bit as master.
#   - Diagnosis, from the top-200 gap diagnosis against BeepBoop 2.0 (truth logs, dzlane/G and dzlane/L):
#     BulletCatcher: some rounds spawn us 43-46 px apart; a still shield cannot stop power-3 shots at point blank (flight
#     1-2 ticks) and we die by tick 80; after two such losses shield mode exits and we fight, and the battle's share falls
#     from about 98 to 75. The opening drive takes us away before its first shot (dzlane/L/sq2-leak.md).
#     Parallax and Lindada: from the PC learn-trace (#1021) class where BeepBoop out-scores us on power (the 3.24-vs-
#     BeepBoop truth logs read our mean shot power 0.97 against its 1.54 on Parallax); of the power levers screened on
#     26 such robots (hf, rp; 6 seeds 90100) these two led and held on 12 fresh seeds: rp makes Parallax a race it
#     wins on energy, hf lets the gun fire hard on Lindada, which shields and rarely punishes it (dzlane/L/t324-hard*).
#   - Each line held on 12 fresh cloud seeds against both controls; the gate keeps only what holds again on the PC.
# Stop rules (docs/bench/watch.md): the watcher's A/A rule needs 10 robots read in both c and aa; this lock reads 18, but
# the gate reads aa (multiarm.py prints aa against c), so no aa stop rule is set. The lock halts on 30 failed battles, an
# arm scoring nothing in 8, 60+ skipped turns a battle over the last 24 or no battle in 30 minutes. The live-match step
# stops the card if the PC no longer scores us and BeepBoop as live does (tools/live_match.py exit 3).
# ALERT opens an issue for Leigh on any stop.
# Bank: the owning cloud thread adds the gate's lines in a PR after this card's results PR. Nothing is released by the card.
set V = 3.24
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-locks25
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && python3 tools/lock_prep.py plans/locks-pick.tsv panel-locks.txt plans/pc-locks.arms ${W}-prep && bash ${W}-prep/build.sh && for a in hf rp mv; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; done && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-locks.txt && for j in $(grep -v "^#" panel-locks.txt | cut -d"|" -f3); do test -f opponents/$j || { echo "missing jar $j"; exit 1; }; done && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out work/pc-livematch-rel-live --label pc-locks-livematch --shuffle-jobs && python3 tools/live_match.py work/pc-livematch-rel-live/arms.tsv --out ${OUT}/pc-locks25-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock | ./bench-top20.sh ${C} ${P} --set panel-locks.txt --seeds 12 --seed-base 95300 --arms ${W}-prep/lock.arms --out ${W} --label pc-locks --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

gate | python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks25-lock.md && python3 tools/lock_prep.py --restrict ${W}/arms.tsv ${W}-prep ${W}/arms-picked.tsv && python3 ../data/tools/mode_table.py ${W}/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-locks25-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks25-lock-pick.md && python3 tools/per_robot.py ${W}/arms-picked.tsv --arms hf rp mv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks25-lock-per-robot.md --out-tsv ${OUT}/pc-locks25-lock-per-robot.tsv
  after: lock

pr | bash tools/open_results_pr.sh claude/pc-locks25-results "1v1 cloud locks, round 25 (Lindada hf, Parallax rp, BulletCatcher mv) on 12 fresh PC seeds" ${OUT}/pc-locks25-livematch.md ${OUT}/*_pc-locks25-*.md ${OUT}/pc-locks25-lock-per-robot.tsv $(find ${OUT} -maxdepth 1 -name 'pc-locks25-lock-pick.tsv' -size +0c)
  after: gate
