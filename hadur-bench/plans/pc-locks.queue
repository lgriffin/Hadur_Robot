# 1v1, cloud locks to the PC (BENCH-253), round 31. Round 30 ran as PR #1066 (A/A -0.34 +- 0.54 on 13 robots): ky
# (close-range yield) on GFMicro +6.6 and Fhqwhgads +4.0, rwl (ram wait) on Fe4r +1.6 and LightningBug +1.1, and ty
# (tiny-shot waves) on Sparrow +1.4 held and were banked (plans/locks30-shipped.txt); PkAssassin ky, TheoryOfEverything
# rwl, Decepticon ty and DarkHallow x0 did not clear 0.
# Round 31 carries 9 per-robot lines on existing table switches, each read on 24 or more fresh cloud seeds (two or three
# independent 12-seed blocks on separate boxes; Sanguijuela one 12-seed block clear by 1.7 points) against both c
# (master) and aa (its A/A twin) at Robocode 1.12.0 and the live turn time (coverage/shards/locks.tsv):
#   gl (GUN-11 gun stack)              YersiniaPestis +8.9 vs c / +6.6 vs aa, Ascendant +4.3 / +4.6, Wavelet +4.5 / +5.3
#   rwl (MOVE-46 ram wait)             QuantumChromodynamics +1.1 / +0.9, Gron +1.0 / +1.0, Dharok +0.8 / +0.7
#   x0 (SHIELD-19 exit off)            LightningStorm +1.9 / +2.2
#   ky (SHIELD-35 close-range yield)   Blade +3.8 / +3.3
#   rlnrkn (RAM-20 + RAM-21)           Sanguijuela +3.0 / +2.9
# and three robots whose round 30 line is on master (GFMicro, Fhqwhgads, Fe4r) read only in c and aa, so the A/A check
# reads 12 robots. The PC reads 24 fresh seeds from 110000 and a line ships only on the PC's own read; every robot is
# judged on its own.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: each line names one robot; every other robot, team and melee play bit for bit as master.
#   - Diagnosis: the gl robots are strong learning movers our main gun hits below its field rate; the gun stack adds
#     the second gun's view on them alone. QuantumChromodynamics (36%), Gron (46%) and Dharok (37%) land that share of
#     their hits on us after our endgame ram on their disabled robot starts; the ram wait lets those waves pass first.
#     LightningStorm is shielded; with the shield's battle exit off we take 140-170 less damage a battle.
#     Blade is shielded; inside 150 px the yield hands the drive to the surf, and we take 50-80 less damage a battle.
#     Sanguijuela is a rammer (74% of its hits in rammer rounds); the learned and known rammer models cut damage taken
#     from about 1,320 to 1,110 a battle.
#   - Every line read positive against both controls on fresh cloud seeds; 24 PC seeds settle each one.
# Stop rules (docs/bench/watch.md): no aa stop rule (aa is read in the gate). The lock halts on 30 failed battles, an arm
# scoring nothing in 8, 60+ skipped turns a battle over the last 24 or no battle in 30 minutes. The live-match step stops
# the card if the PC no longer scores us and BeepBoop as live does (tools/live_match.py exit 3).
# ALERT opens an issue for Leigh on any stop.
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live, in its
#              own folder (work/pc-locks31-livematch), so no earlier round's battle is read back
#   lock       panel-locks.txt  c / aa, 24 fresh seeds from 110000, --cpu-constant live, in work/pc-locks31-ctl
#   stage      writes each lever's two-arm file (c and the lever) and copies in, times kept, the c battles of that lever's
#              own robots, so the bench reads them back (BENCH-95) and the watcher counts them as resumed
#   lock-X     each lever arm (gl, rwl, x0, ky, rlnrkn) on its own picked robots only, same seeds, in work/pc-locks31-X; the gate takes c
#              and aa from -ctl and only the lever rows from each -X
#   gate       each robot judged on its own lever arm only (lock_prep.py --restrict); it keeps its line where the 95%
#              low end is above 0 (mode_table.py --margin 0).
# Leigh starts it once the PC is free (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-locks --fresh        (or  ./queue.sh run pc-locks --fresh)
#   --fresh because round 30 left this plan's queue state marked complete; the new work directory and seeds mean no
#   battle is read back from an earlier round (and BENCH-272 refights any whose jar changed).
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. 792 lock battles (12 robots in c and aa, the nine
# lever robots again on their own arm, 24 seeds), about 1.6 hours with the live-match check. The prep step stops if any
# panel robot's jar is missing.
#
set V = 3.24
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-locks31
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && python3 tools/lock_prep.py plans/locks-pick.tsv panel-locks.txt plans/pc-locks.arms ${W}-prep && bash ${W}-prep/build.sh && for a in gl rwl x0 ky rlnrkn; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; grep -F -f ${W}-prep/$a.list panel-locks.txt > ${W}-prep/$a.panel && grep "^$a |" ${W}-prep/lock.arms > ${W}-prep/$a.arms || exit 1; done && grep -E "^(c|aa) [|]" ${W}-prep/lock.arms > ${W}-prep/ctl.arms && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-locks.txt && for j in $(grep -v "^#" panel-locks.txt | cut -d"|" -f3); do test -f opponents/$j || { echo "missing jar $j"; exit 1; }; done && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out ${W}-livematch --label pc-locks-livematch --shuffle-jobs && python3 tools/live_match.py ${W}-livematch/arms.tsv --out ${OUT}/pc-locks31-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock | ./bench-top20.sh ${C} ${P} --set panel-locks.txt --seeds 24 --seed-base 110000 --arms ${W}-prep/ctl.arms --out ${W}-ctl --label pc-locks --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

stage | for a in gl rwl x0 ky rlnrkn; do grep -E "^(c|$a) [|]" ${W}-prep/lock.arms > ${W}-prep/$a-c.arms && mkdir -p ${W}-$a/battles || exit 1; for s in $(grep -v "^#" ${W}-prep/$a.panel | cut -d"|" -f1 | sed -E "s/^ +| +$//g; s/[^A-Za-z0-9.]+/_/g"); do cp -rp ${W}-ctl/battles/$s-*-c ${W}-$a/battles/ || exit 1; done; done
  after: lock

lock-gl | ./bench-top20.sh ${C} ${P} --set ${W}-prep/gl.panel --seeds 24 --seed-base 110000 --arms ${W}-prep/gl-c.arms --out ${W}-gl --label pc-locks-gl --shuffle-jobs
  after: stage
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-rwl | ./bench-top20.sh ${C} ${P} --set ${W}-prep/rwl.panel --seeds 24 --seed-base 110000 --arms ${W}-prep/rwl-c.arms --out ${W}-rwl --label pc-locks-rwl --shuffle-jobs
  after: lock-gl
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-x0 | ./bench-top20.sh ${C} ${P} --set ${W}-prep/x0.panel --seeds 24 --seed-base 110000 --arms ${W}-prep/x0-c.arms --out ${W}-x0 --label pc-locks-x0 --shuffle-jobs
  after: lock-rwl
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-ky | ./bench-top20.sh ${C} ${P} --set ${W}-prep/ky.panel --seeds 24 --seed-base 110000 --arms ${W}-prep/ky-c.arms --out ${W}-ky --label pc-locks-ky --shuffle-jobs
  after: lock-x0
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-rlnrkn | ./bench-top20.sh ${C} ${P} --set ${W}-prep/rlnrkn.panel --seeds 24 --seed-base 110000 --arms ${W}-prep/rlnrkn-c.arms --out ${W}-rlnrkn --label pc-locks-rlnrkn --shuffle-jobs
  after: lock-ky
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

gate | mkdir -p ${W} && (cat ${W}-ctl/arms.tsv && for d in gl rwl x0 ky rlnrkn; do awk -F"\t" -v a=$d 'NR > 1 && $1 == a' ${W}-$d/arms.tsv; done) > ${W}/arms.tsv && python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks31-lock.md && python3 tools/lock_prep.py --restrict ${W}/arms.tsv ${W}-prep ${W}/arms-picked.tsv && python3 ../data/tools/mode_table.py ${W}/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-locks31-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks31-lock-pick.md && python3 tools/per_robot.py ${W}/arms-picked.tsv --arms gl rwl x0 ky rlnrkn --out ${OUT}/$(date +%Y-%m-%d)_pc-locks31-lock-per-robot.md --out-tsv ${OUT}/pc-locks31-lock-per-robot.tsv
  after: lock-rlnrkn

pr | bash tools/open_results_pr.sh claude/pc-locks31-results "1v1 cloud locks, round 31 (3 gl, 3 rwl, LightningStorm x0, Blade ky, Sanguijuela rlnrkn) on 24 fresh PC seeds" ${OUT}/pc-locks31-livematch.md ${OUT}/*_pc-locks31-*.md ${OUT}/pc-locks31-lock-per-robot.tsv $(find ${OUT} -maxdepth 1 -name 'pc-locks31-lock-pick.tsv' -size +0c)
  after: gate
