# 1v1, cloud locks to the PC (BENCH-253), round 29. Round 28 ran as PR #1057 (A/A -0.01 +- 0.16 on 33 robots): 15 rwl
# (ram wait), X_FireFly hof, RedBull rf, X1 sp2 and RainbowBot md (+0.5 to +3.2) held and were banked
# (plans/locks28-shipped.txt); seven rwl, five hof, RaikoNano x0 and FunkyChicken ty did not clear 0.
# Round 29 carries 14 per-robot lines on existing table switches, each read on 12+ fresh cloud seeds against both c
# (master) and aa (its A/A twin) at Robocode 1.12.0 and the live turn time (coverage/shards/locks.tsv):
#   rwl (MOVE-46 ram wait), 13 robots: locked on both controls: Eater_of_Worlds_Mini, GhostShell, gpBot_0, Ant, ROBv300,
#        iRobot, Jammy, Rover, Blur and X_FireFly (its rwl read on top of the hof line it now carries); near, low ends
#        about 0 over 36-48 seeds: Gnome, Thinker and Samspin
#   x0 (SHIELD-19 exit off)                       oog.micro.MagicD3 0.41       48 seeds pooled about +2.1 vs c (near)
# The PC reads 24 fresh seeds from 106000 and a line ships only on the PC's own read; every robot is judged on its own.
# Every pick is read in c and aa too, so the A/A check reads 14 robots and no pads are needed.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: each line names one robot; every other robot, team and melee play bit for bit as master.
#   - Diagnosis: the rwl robots are those where 20% or more of their hits on us (20+ hits in the truth logs) land after
#     our endgame ram on their disabled robot starts, so the ram drives into their last bullets; the ram wait lets those
#     waves pass first. MagicD3: the shield's battle exit hands it the fight it wins; with the exit off the damage we
#     take halves on the cloud.
#   - Every line read positive against both controls on the cloud; 24 PC seeds settle each one.
# Stop rules (docs/bench/watch.md): no aa stop rule (aa is read in the gate). The lock halts on 30 failed battles, an arm
# scoring nothing in 8, 60+ skipped turns a battle over the last 24 or no battle in 30 minutes. The live-match step stops
# the card if the PC no longer scores us and BeepBoop as live does (tools/live_match.py exit 3).
# ALERT opens an issue for Leigh on any stop.
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live, in its
#              own folder (work/pc-locks29-livematch), so no earlier round's battle is read back
#   lock       panel-locks.txt  c / aa, 24 fresh seeds from 106000, --cpu-constant live, in work/pc-locks29-ctl
#   stage      writes each lever's two-arm file (c and the lever) and copies in, times kept, the c battles of that lever's
#              own robots, so the bench reads them back (BENCH-95) and the watcher counts them as resumed
#   lock-X     each lever arm (rwl, x0) on its own picked robots only, same seeds, in work/pc-locks29-X; the gate takes
#              c and aa from -ctl and only the lever rows from each -X
#   gate       each robot judged on its own lever arm only (lock_prep.py --restrict); it keeps its line where the 95%
#              low end is above 0 (mode_table.py --margin 0).
# Leigh starts it once the PC is free (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-locks --fresh        (or  ./queue.sh run pc-locks --fresh)
#   --fresh because round 28 left this plan's queue state marked complete; the new work directory and seeds mean no
#   battle is read back from an earlier round (and BENCH-272 refights any whose jar changed).
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. 1,008 lock battles (14 robots in c and aa, each
# again on its own lever arm, 24 seeds), about 1.5 hours with the live-match check. The prep step stops if any panel
# robot's jar is missing.
#
set V = 3.24
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-locks29
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && python3 tools/lock_prep.py plans/locks-pick.tsv panel-locks.txt plans/pc-locks.arms ${W}-prep && bash ${W}-prep/build.sh && for a in rwl x0; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; grep -F -f ${W}-prep/$a.list panel-locks.txt > ${W}-prep/$a.panel && grep "^$a |" ${W}-prep/lock.arms > ${W}-prep/$a.arms || exit 1; done && grep -E "^(c|aa) [|]" ${W}-prep/lock.arms > ${W}-prep/ctl.arms && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-locks.txt && for j in $(grep -v "^#" panel-locks.txt | cut -d"|" -f3); do test -f opponents/$j || { echo "missing jar $j"; exit 1; }; done && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out ${W}-livematch --label pc-locks-livematch --shuffle-jobs && python3 tools/live_match.py ${W}-livematch/arms.tsv --out ${OUT}/pc-locks29-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock | ./bench-top20.sh ${C} ${P} --set panel-locks.txt --seeds 24 --seed-base 106000 --arms ${W}-prep/ctl.arms --out ${W}-ctl --label pc-locks --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

stage | for a in rwl x0; do grep -E "^(c|$a) [|]" ${W}-prep/lock.arms > ${W}-prep/$a-c.arms && mkdir -p ${W}-$a/battles || exit 1; for s in $(grep -v "^#" ${W}-prep/$a.panel | cut -d"|" -f1 | sed -E "s/^ +| +$//g; s/[^A-Za-z0-9.]+/_/g"); do cp -rp ${W}-ctl/battles/$s-*-c ${W}-$a/battles/ || exit 1; done; done
  after: lock

lock-rwl | ./bench-top20.sh ${C} ${P} --set ${W}-prep/rwl.panel --seeds 24 --seed-base 106000 --arms ${W}-prep/rwl-c.arms --out ${W}-rwl --label pc-locks-rwl --shuffle-jobs
  after: stage
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-x0 | ./bench-top20.sh ${C} ${P} --set ${W}-prep/x0.panel --seeds 24 --seed-base 106000 --arms ${W}-prep/x0-c.arms --out ${W}-x0 --label pc-locks-x0 --shuffle-jobs
  after: lock-rwl
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

gate | mkdir -p ${W} && (cat ${W}-ctl/arms.tsv && for d in rwl x0; do awk -F"\t" -v a=$d 'NR > 1 && $1 == a' ${W}-$d/arms.tsv; done) > ${W}/arms.tsv && python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks29-lock.md && python3 tools/lock_prep.py --restrict ${W}/arms.tsv ${W}-prep ${W}/arms-picked.tsv && python3 ../data/tools/mode_table.py ${W}/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-locks29-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks29-lock-pick.md && python3 tools/per_robot.py ${W}/arms-picked.tsv --arms rwl x0 --out ${OUT}/$(date +%Y-%m-%d)_pc-locks29-lock-per-robot.md --out-tsv ${OUT}/pc-locks29-lock-per-robot.tsv
  after: lock-x0

pr | bash tools/open_results_pr.sh claude/pc-locks29-results "1v1 cloud locks, round 29 (13 ram-wait rwl, MagicD3 x0) on 24 fresh PC seeds" ${OUT}/pc-locks29-livematch.md ${OUT}/*_pc-locks29-*.md ${OUT}/pc-locks29-lock-per-robot.tsv $(find ${OUT} -maxdepth 1 -name 'pc-locks29-lock-pick.tsv' -size +0c)
  after: gate
