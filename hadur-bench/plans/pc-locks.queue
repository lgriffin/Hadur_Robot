# 1v1, cloud locks to the PC (BENCH-253), round 16. Round 15 (PR #968) was void: its A/A copy read -1.74 +- 4.15 against c
# on 5 robots (band +- 1.51), a spread that points at one bad battle on one robot, and on 5 robots one battle is enough to
# void the card. Round 16 re-reads all of round 15 and adds every cloud lock since, 14 robots, so the A/A band is +- 0.90
# and one bad battle weighs less than half as much.
# Cloud locks (master, Robocode 1.12.0, live turn time; coverage/shards/locks.tsv), vs c / vs aa:
#   rbd (RAM-18 escape bend) on RamRod (box A: 12 seeds 81300 +3.10 +- 2.13 / +2.33 +- 1.90), GrubbmThree, MaxRisk and
#      PureAggression (round 14 PC, 12 seeds 85000: +1.59, +0.96, +0.76; round 15 read +1.7, +0.6, +1.8 before the void),
#      Leopard (box L: 12 seeds 84300 +1.54 +- 0.59 / +1.16 +- 0.75) and RammingC (box A: 12 seeds 84679 +1.51 +- 1.10 /
#      +1.99 +- 0.87; its escape fires and close shots hit us 34% vs BeepBoop 13%).
#   rp (POW-17 race power) on Saguaro (boxes A and L): pooled 60 seeds +4.76 +- 2.64 / +3.26 +- 2.29.
#   vj (MOVE-44 velocity jitter) on MadHatter (box A: 12 seeds 83330 +2.16 +- 0.83 / +2.52 +- 0.75; it hits us at full
#      speed 7.7% vs BeepBoop 3.0%).
#   On master already, read as c minus bb (bb = master before them, 4d6a3ca76):
#   MOVE-56 pattern-matcher mimic on AutoBot (PR #970; box G: 12 seeds 81700 +12.57 +- 2.86 / +12.60 +- 2.65).
#   SHIELD-33 tiny-shot shield waves (PR #971; box G) on QuickHack +5.42 / +4.92, MakoHT +3.17 / +2.00 (12 seeds 83962),
#      Caedo +2.86 / +3.33, FloodSonnet +3.22 / +2.42, SavantMicro +3.11 / +3.81 (24 seeds 83280 + 83950).
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live
#   lock       panel-locks.txt  c / aa / bb / rbd / rp / vj, 12 fresh seeds from 85200, --cpu-constant live, in
#              work/pc-locks16 (earlier rounds' battles stay in work/pc-locks to -locks15)
#   gate       each robot judged on its own lever arm only (lock_prep.py --restrict); it keeps its line where the 95%
#              low end is above 0 (mode_table.py --margin 0). The MOVE-56 and SHIELD-33 robots are read per robot as bb
#              minus control (per_robot.py --arms bb, with the per-battle rows for the 95% interval); a line stays on master where c beats bb with the 95% low end
#              above 0, and comes off where its interval is wholly below 0.
# Leigh starts it once the PC is free (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-locks --fresh        (or  ./queue.sh run pc-locks --fresh)
#   --fresh because round 15 left this plan's queue state marked complete.
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. 1,008 lock battles (14 robots, 6 arms, 12 seeds),
# about 30 minutes with the live-match check. The prep step stops if any panel robot's jar is missing.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: every line names one robot; every other robot, team and melee play bit for bit as master.
#   - RAM-18: for 10 ticks after each rammer shot the escape leaves out headings within 25 degrees of the line we were
#     on when it fired, because RAM-2's fixed-heading escape is the path a linear aim leads (round 14 held it on 6
#     rammers, PR #964).
#   - Saguaro: an energy race; BeepBoop holds power 0.7-0.85 and wins the longer rounds, we open at 2.0 and lose it.
#   - MadHatter: an exact-velocity pattern matcher; MOVE-44's jitter keeps us off exactly 8 and 0.
#   - AutoBot: its gun is static and deterministic on our own movement, so a member running the same matcher predicts
#     its bullets from round 0 (real hit share 9.1% to 2.8% in the cloud forensic).
#   - SHIELD-33: shield robots near 0.2 energy keep firing sub-0.1 bullets our hold rule left undodged; 87-100% of their
#     unshielded hits are these, and each hit refunds their energy.
# Stop rules (docs/bench/watch.md): the watcher's A/A rule needs 10 robots read in both c and aa; this lock reads 14, but
# the gate reads aa (multiarm.py prints aa against c), so no aa stop rule is set. The lock halts on 30 failed battles, an
# arm scoring nothing in 8, 60+ skipped turns a battle over the last 24 or no battle in 30 minutes. The live-match step
# stops the card if the PC no longer scores us and BeepBoop as live does (tools/live_match.py exit 3).
# ALERT opens an issue for Leigh on any stop.
# Bank: the owning cloud thread adds the gate's lines on this card's results PR. Nothing is released by the card.
set V = 3.23
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-locks16
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && python3 tools/lock_prep.py plans/locks-pick.tsv panel-locks.txt plans/pc-locks.arms ${W}-prep && bash ${W}-prep/build.sh && bash ./build-ablation.sh --ref 4d6a3ca76 bb && grep "^bb " plans/pc-locks.arms >> ${W}-prep/lock.arms && for a in bb rbd rp vj; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; done && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-locks.txt && for j in $(grep -v "^#" panel-locks.txt | cut -d"|" -f3); do test -f opponents/$j || { echo "missing jar $j"; exit 1; }; done && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out work/pc-livematch-rel-live --label pc-locks-livematch --shuffle-jobs && python3 tools/live_match.py work/pc-livematch-rel-live/arms.tsv --out ${OUT}/pc-locks16-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock | ./bench-top20.sh ${C} ${P} --set panel-locks.txt --seeds 12 --seed-base 85200 --arms ${W}-prep/lock.arms --out ${W} --label pc-locks --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

gate | python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks16-lock.md && python3 tools/lock_prep.py --restrict ${W}/arms.tsv ${W}-prep ${W}/arms-picked.tsv && python3 ../data/tools/mode_table.py ${W}/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-locks16-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks16-lock-pick.md && python3 tools/per_robot.py ${W}/arms-picked.tsv --arms rbd rp vj --out ${OUT}/$(date +%Y-%m-%d)_pc-locks16-lock-per-robot.md --out-tsv ${OUT}/pc-locks16-lock-per-robot.tsv && python3 tools/per_robot.py ${W}/arms.tsv --arms bb --out ${OUT}/$(date +%Y-%m-%d)_pc-locks16-onmaster-per-robot.md --out-tsv ${OUT}/pc-locks16-onmaster-per-robot.tsv && head -1 ${W}/arms.tsv > ${OUT}/pc-locks16-onmaster-rows.tsv && grep -E "AutoBot|QuickHack|MakoHT|Caedo|FloodSonnet|SavantMicro" ${W}/arms.tsv >> ${OUT}/pc-locks16-onmaster-rows.tsv
  after: lock

pr | bash tools/open_results_pr.sh claude/pc-locks16-results "1v1 cloud locks, round 16 (6 rbd, 1 rp, 1 vj; MOVE-56 and SHIELD-33 confirm) on 12 fresh PC seeds" ${OUT}/pc-locks16-livematch.md ${OUT}/*_pc-locks16-*.md ${OUT}/pc-locks16-lock-per-robot.tsv ${OUT}/pc-locks16-onmaster-per-robot.tsv ${OUT}/pc-locks16-onmaster-rows.tsv $(find ${OUT} -maxdepth 1 -name 'pc-locks16-lock-pick.tsv' -size +0c)
  after: gate
