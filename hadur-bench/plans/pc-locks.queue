# 1v1, cloud locks to the PC (BENCH-253), round 11: per-robot lines that locked on the cloud (95% low end above 0, live
# turn time; coverage/shards/locks.tsv, coverage/shards/round11-draft.md) after round 10's card (PR #915):
#   rfn (RAM-17 ram-fan, PR #918): Lifestealer +1.6 (low +0.8, 36 seeds), nanoPri +2.4 (+1.1, 12 seeds; on top of its
#      shipped ram lines)
#   rp (race power), Robocode 1.12.0 only (each on broken-1.11.2.txt; live runs 1.12.0): KurtBot +2.6 (low +1.8, 24 seeds),
#      Garm +3.7 (+1.1, 24 seeds), Raven +4.9 (+1.8, 24 seeds), WhiteFang +3.6 (+1.6, 24 seeds)
#   Each cloud gain is the smaller of the reads against c and against an A/A twin.
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live
#   lock       the 1.11.2 robots (panel-locks.txt)  c / aa / rp / rfn, 12 fresh seeds from 47900, --cpu-constant live, in
#              work/pc-locks11 (earlier rounds' battles stay in work/pc-locks to -locks10)
#   gate       each robot judged on its own arm only (lock_prep.py --restrict); it keeps its line where the 95% low end
#              is above 0 (mode_table.py --margin 0)
#   lock112    the robots that load only on Robocode 1.12.0 (panel-locks-112.txt), same arms and seeds on --engine 1.12.0
#              --keep-broken, in work/pc-locks11-112. The 18 Nov engine check found no score or timing difference between
#              1.11.2 and 1.12.0, so the 1.11.2 livematch certifies the PC's timing for this step too
#   gate112    fails if any battle's engine.log names a host other than 1.12.0; then the same gate; then compiles back on 1.11.2
# Leigh starts it once the PC is free (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-locks --fresh        (or  ./queue.sh run pc-locks --fresh)
#   --fresh because round 10 left this plan's queue state marked complete; an interrupted round 11 resumes without it.
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. 288 lock battles (6 robots, 4 arms, 12 seeds), about
# 15 minutes with the live-match check.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: every line names one robot; every other robot, team and melee play bit for bit as master.
#   - Diagnosis first (truth logs against BeepBoop 2.0 and Saguaro 1.1.4; slow-hit rammer and newcomers lanes 18 Nov):
#     rfn: Lifestealer and nanoPri ram point blank with plain lagged linear aims; our escape's single-line model foresees about half
#     their real hits, a +-4 degree fan about three quarters (pb hit% 35 -> 30 and 40 -> 36 on the cloud).
#     rp: KurtBot, Garm, Raven and WhiteFang are learning-gun bots whose energy wars go to BeepBoop (KurtBot's gun hits us
#     12.9% vs BeepBoop 8.9%; we lose more low-energy wars); race power wins the energy race.
#   - Every robot passed the cloud lock bar on 12+ fresh seeds.
# Stop rules (docs/bench/watch.md): the watcher's A/A rule needs 10 robots read in both c and aa, which no step here
# reaches, so no aa stop rule is set; aa is read in the gates (multiarm.py prints aa against c). Each lock halts on 30 failed
# battles, an arm scoring nothing in 8 or no battle in 30 minutes; the 1.11.2 lock also on 60+ skipped turns a battle over
# the last 24. The live-match step stops the card if the PC no longer scores us and BeepBoop as live does
# (tools/live_match.py exit 3). ALERT opens an issue for Leigh on any stop.
# Bank: the owning cloud thread adds the gates' lines on this card's results PR. Nothing is released by the card.
set V = 3.23
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-locks11
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && python3 tools/lock_prep.py plans/locks-pick.tsv panel-locks.txt plans/pc-locks.arms ${W}-prep && bash ${W}-prep/build.sh && for a in rp rfn; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; done && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-locks.txt && ./fetch-opponents.sh --set panel-locks-112.txt && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out work/pc-livematch-rel-live --label pc-locks-livematch --shuffle-jobs && python3 tools/live_match.py work/pc-livematch-rel-live/arms.tsv --out ${OUT}/pc-locks11-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock | ./bench-top20.sh ${C} ${P} --set panel-locks.txt --seeds 12 --seed-base 47900 --arms ${W}-prep/lock.arms --out ${W} --label pc-locks --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

gate | python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks11-lock.md && python3 tools/lock_prep.py --restrict ${W}/arms.tsv ${W}-prep ${W}/arms-picked.tsv && python3 ../data/tools/mode_table.py ${W}/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-locks11-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks11-lock-pick.md && python3 tools/per_robot.py ${W}/arms-picked.tsv --arms rp rfn --out ${OUT}/$(date +%Y-%m-%d)_pc-locks11-lock-per-robot.md --out-tsv ${OUT}/pc-locks11-lock-per-robot.tsv
  after: lock

lock112 | ./bench-top20.sh ${C} ${P} --engine 1.12.0 --keep-broken --set panel-locks-112.txt --seeds 12 --seed-base 47900 --arms ${W}-prep/lock.arms --out ${W}-112 --label pc-locks-112 --shuffle-jobs
  after: gate
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

gate112 | grep -h "robocode.host/" ${W}-112/battles/*/engine.log | grep -v "robocode.host/1.12.0" | (! grep -q .) && python3 ../data/tools/multiarm.py ${W}-112/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks11-112-lock.md && python3 tools/lock_prep.py --restrict ${W}-112/arms.tsv ${W}-prep ${W}-112/arms-picked.tsv && python3 ../data/tools/mode_table.py ${W}-112/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-locks11-112-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks11-112-lock-pick.md && python3 tools/per_robot.py ${W}-112/arms-picked.tsv --arms rp rfn --out ${OUT}/$(date +%Y-%m-%d)_pc-locks11-112-lock-per-robot.md --out-tsv ${OUT}/pc-locks11-112-lock-per-robot.tsv && mvn -q compile
  after: lock112

pr | bash tools/open_results_pr.sh claude/pc-locks11-results "1v1 cloud locks, round 11 (6 robots, 4 on Robocode 1.12.0) locked on 12 fresh PC seeds" ${OUT}/pc-locks11-livematch.md ${OUT}/*_pc-locks11-*.md ${OUT}/pc-locks11-lock-per-robot.tsv ${OUT}/pc-locks11-112-lock-per-robot.tsv $(find ${OUT} -maxdepth 1 -name 'pc-locks11-*lock-pick.tsv' -size +0c)
  after: gate112
