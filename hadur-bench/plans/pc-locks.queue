# 1v1, cloud locks to the PC (BENCH-253), round 23. Round 22 ran as PR #1007 (Cephalosporin qw +0.48, did not clear 0, not shipped).
# Round 23 carries the RAM-20 learned shot model (ram-learn lines) on 25 robots; all are read in every arm, so no A/A pad.
# Cloud read (Robocode 1.12.0, live turn time; c is master before RAM-20, aa its A/A copy), per robot vs c / vs aa (seeds):
#      Dreadnaught +2.8+-2.2 / +3.4+-1.0 (12); NanoDeath +2.3+-1.4 / +2.6+-1.2 (12); Bicephal +3.0+-1.4 / +2.4+-1.7 (12)
#      FollowFire +3.0+-2.4 / +2.8+-2.6 (12); MaxRisk +1.8+-1.2 / +5.9+-3.5 (12); Impact +1.4+-0.8 / +1.3+-1.1 (24)
#      Machete +1.8+-1.1 / +1.3+-0.9 (24); Lifestealer +3.3+-0.5 / +3.1+-0.7 (18); SledgeHammer +4.0+-1.6 / +3.7+-1.5 (18)
#      Galaxy03 +3.6+-1.0 / +3.2+-1.2 (18); SuperRamFire +3.3+-1.3 / +3.0+-1.2 (18); Bruce +2.7+-0.9 / +2.9+-1.2 (18)
#      xbots +2.6+-1.0 / +3.5+-1.1 (18); nanoPri +2.8+-0.8 / +2.5+-1.0 (18); DOSexe +3.1+-1.1 / +2.2+-1.0 (18)
#      RammingC +2.2+-1.1 / +2.1+-1.3 (18); Prototype +1.4+-0.9 / +2.1+-1.2 (18); TopGun +1.5+-0.5 / +1.2+-0.7 (18)
#      Squaraus +0.9+-0.4 / +1.2+-0.3 (18); Caligula +2.2+-1.8 / +1.7+-1.3 (18); Trinity +0.8+-0.5 / +0.8+-0.4 (12)
#      KnackOnOne +0.7+-0.6 / +0.7+-0.4 (12); BelajarBot +0.2+-0.2 / +0.2+-0.1 (12); Bender +0.4+-0.2 / +0.3+-0.2 (12)
#      Roskilde +0.5+-0.4 / +0.3+-0.2 (12)
#   Class reads with the model on for every rammer: 16 close-range robots, 12 seeds 62601, +1.21 +- 0.43 / +1.40 +- 0.52;
#      54 more robots with rammer lines, 12 seeds 62701-12 on two boxes, +0.77 +- 0.15 / +0.80 +- 0.16 (A/A level on both).
#      The list jar on the first five, 12 seeds 62951: +3.10 +- 0.90 / +2.56 +- 0.85. Kuramatron read wholly below 0 and has no line.
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live
#   lock       panel-locks.txt  c / aa / rln, 12 fresh seeds from 86500, --cpu-constant live, in work/pc-locks23
#              (earlier rounds' battles stay in work/pc-locks to -locks22)
#   gate       each robot judged on its own lever arm only (lock_prep.py --restrict); it keeps its line where the 95%
#              low end is above 0 (mode_table.py --margin 0).
# Leigh starts it once the PC is free (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-locks --fresh        (or  ./queue.sh run pc-locks --fresh)
#   --fresh because round 22 left this plan's queue state marked complete; the new work directory and seeds mean no
#   battle is read back from an earlier round (and BENCH-272 refights any whose jar changed).
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. 900 lock battles (25 robots, 3 arms, 12 seeds),
# about 30 minutes with the live-match check. The prep step stops if any panel robot's jar is missing.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: each line names one robot; every other robot, team and melee play bit for bit as master
#     (ramLearns() is empty on master, the replay fixtures are unchanged, and only the duel strand's pin moved).
#   - Diagnosis: against close-range robots with simple guns, 85% of the damage we take beyond a reference surfer's comes
#     from shots a dodge existed for, and distance is not the cause. RAM-5 predicts each bullet with two fixed aims at one
#     tick; these guns fire about six aim variants over three ticks of lag. Replayed offline the fixed pair reproduces our
#     real hit rates (45/20/17% at 60-100/100-150/150-250 px); aims learned from the bullets that hit us give 24/10/7%.
#   - Mechanism measured in battle: with the model on, the hit rate fell in every band (49 to 41%, 26 to 16%, 17 to 9%)
#     and damage taken fell 13%. The model checks itself (leading aim score 2 and 0.2 of bullets read), so it is silent
#     against guns that are not simple.
#   - Cost: about 2 more skipped turns a battle on the cloud (5.8 against 3.7); the lock's skip rule guards it on the PC.
# Stop rules (docs/bench/watch.md): the watcher's A/A rule needs 10 robots read in both c and aa; this lock reads 25, but
# the gate reads aa (multiarm.py prints aa against c), so no aa stop rule is set. The lock halts on 30 failed battles, an
# arm scoring nothing in 8, 60+ skipped turns a battle over the last 24 or no battle in 30 minutes. The live-match step
# stops the card if the PC no longer scores us and BeepBoop as live does (tools/live_match.py exit 3).
# ALERT opens an issue for Leigh on any stop.
# Bank: the owning cloud thread adds the gate's lines in a PR after this card's results PR. Nothing is released by the card.
set V = 3.24
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-locks23
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && python3 tools/lock_prep.py plans/locks-pick.tsv panel-locks.txt plans/pc-locks.arms ${W}-prep && bash ${W}-prep/build.sh && for a in rln; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; done && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-locks.txt && for j in $(grep -v "^#" panel-locks.txt | cut -d"|" -f3); do test -f opponents/$j || { echo "missing jar $j"; exit 1; }; done && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out work/pc-livematch-rel-live --label pc-locks-livematch --shuffle-jobs && python3 tools/live_match.py work/pc-livematch-rel-live/arms.tsv --out ${OUT}/pc-locks23-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock | ./bench-top20.sh ${C} ${P} --set panel-locks.txt --seeds 12 --seed-base 86500 --arms ${W}-prep/lock.arms --out ${W} --label pc-locks --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

gate | python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks23-lock.md && python3 tools/lock_prep.py --restrict ${W}/arms.tsv ${W}-prep ${W}/arms-picked.tsv && python3 ../data/tools/mode_table.py ${W}/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-locks23-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks23-lock-pick.md && python3 tools/per_robot.py ${W}/arms-picked.tsv --arms rln --out ${OUT}/$(date +%Y-%m-%d)_pc-locks23-lock-per-robot.md --out-tsv ${OUT}/pc-locks23-lock-per-robot.tsv
  after: lock

pr | bash tools/open_results_pr.sh claude/pc-locks23-results "1v1 cloud locks, round 23 (RAM-20 ram-learn, 25 robots) on 12 fresh PC seeds" ${OUT}/pc-locks23-livematch.md ${OUT}/*_pc-locks23-*.md ${OUT}/pc-locks23-lock-per-robot.tsv $(find ${OUT} -maxdepth 1 -name 'pc-locks23-lock-pick.tsv' -size +0c)
  after: gate
