# 1v1, cloud locks to the PC (BENCH-253), round 32. Round 31 ran as PR #1076 (A/A -0.49 +- 0.58 on 12 robots): gl
# (gun stack) on YersiniaPestis +5.5, Ascendant +5.2 and Wavelet +4.4, x0 (exit off) on LightningStorm +2.6, rlnrkn on
# Sanguijuela +2.5, and rwl (ram wait) on NanoR2 +1.6, Buba +1.1, Gron +1.1, RandomLinear +0.7 and Dharok +0.6 held
# and were banked (plans/locks31-shipped.txt); QuantumChromodynamics rwl (+0.2) and Blade ky (+0.8) did not clear 0.
# Round 32 carries 9 per-robot lines on existing table switches, each read on 12 to 84 fresh cloud seeds (one to seven
# independent 12-seed blocks on separate boxes; every single-block line clears 0 by 0.3 points or more) against both c
# (master) and aa (its A/A twin) at Robocode 1.12.0 and the live turn time (coverage/shards/locks.tsv):
#   gl (GUN-11 gun stack)              Neuromancer +2.4 vs c / +3.0 vs aa (48 seeds), PulsarMax +3.9 / +3.6 (84 seeds)
#   rwl (MOVE-46 ram wait)             One +1.1 / +0.8, Hotspur +0.9 / +0.8, Dzhigit +1.3 / +1.2, Phoenix +1.4 / +1.7
#   rlnrkn (RAM-20 + RAM-21)           Colossus2 +3.1 / +3.2, Alpha +2.6 / +2.6 (two boxes each)
#   rln (RAM-20 alone)                 BagPuss +1.1 / +1.4
# and four robots whose round 31 line is on master (Gron, Buba, LightningStorm, Sanguijuela) read only in c and aa, so
# the A/A check reads 13 robots. The PC reads 24 fresh seeds from 112000 and a line ships only on the PC's own read;
# every robot is judged on its own.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: each line names one robot; every other robot, team and melee play bit for bit as master.
#   - Diagnosis: Neuromancer and PulsarMax are strong learning movers our main gun hits below its field rate; the gun
#     stack adds the second gun's view on them alone (on Neuromancer it deals about 13% more damage). One, Hotspur,
#     Dzhigit and Phoenix land 20% or more of their hits on us after our endgame ram on their disabled robot starts
#     (ram-wait census of live ranks 800-1000); the ram wait lets those waves pass first. Colossus2 (88% of its hits in rammer
#     rounds), Alpha and BagPuss are rammers; the learned and known rammer models cut damage taken from about 200 to
#     45-95 a battle on the first two. On BagPuss the known-rammer model alone was harmful, so it takes RAM-20 only.
#   - Every line read positive against both controls on fresh cloud seeds; 24 PC seeds settle each one.
# Stop rules (docs/bench/watch.md): no aa stop rule (aa is read in the gate). The lock halts on 30 failed battles, an arm
# scoring nothing in 8, 60+ skipped turns a battle over the last 24 or no battle in 30 minutes. The live-match step stops
# the card if the PC no longer scores us and BeepBoop as live does (tools/live_match.py exit 3).
# ALERT opens an issue for Leigh on any stop.
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live, in its
#              own folder (work/pc-locks32-livematch), so no earlier round's battle is read back
#   lock       panel-locks.txt  c / aa, 24 fresh seeds from 112000, --cpu-constant live, in work/pc-locks32-ctl
#   stage      writes each lever's two-arm file (c and the lever) and copies in, times kept, the c battles of that lever's
#              own robots, so the bench reads them back (BENCH-95) and the watcher counts them as resumed
#   lock-X     each lever arm (gl, rwl, rlnrkn, rln) on its own picked robots only, same seeds, in work/pc-locks32-X; the
#              gate takes c and aa from -ctl and only the lever rows from each -X
#   gate       each robot judged on its own lever arm only (lock_prep.py --restrict); it keeps its line where the 95%
#              low end is above 0 (mode_table.py --margin 0).
# Leigh starts it once the PC is free (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-locks --fresh        (or  ./queue.sh run pc-locks --fresh)
#   --fresh because round 31 left this plan's queue state marked complete; the new work directory and seeds mean no
#   battle is read back from an earlier round (and BENCH-272 refights any whose jar changed).
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. 840 lock battles (13 robots in c and aa, the nine
# lever robots again on their own arm, 24 seeds), about 45 minutes with the live-match check (round 31's 864 took 40).
# The prep step stops if any panel robot's jar is missing.
#
set V = 3.24
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-locks32
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && python3 tools/lock_prep.py plans/locks-pick.tsv panel-locks.txt plans/pc-locks.arms ${W}-prep && bash ${W}-prep/build.sh && for a in gl rwl rlnrkn rln; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; grep -F -f ${W}-prep/$a.list panel-locks.txt > ${W}-prep/$a.panel && grep "^$a |" ${W}-prep/lock.arms > ${W}-prep/$a.arms || exit 1; done && grep -E "^(c|aa) [|]" ${W}-prep/lock.arms > ${W}-prep/ctl.arms && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-locks.txt && for j in $(grep -v "^#" panel-locks.txt | cut -d"|" -f3); do test -f opponents/$j || { echo "missing jar $j"; exit 1; }; done && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out ${W}-livematch --label pc-locks-livematch --shuffle-jobs && python3 tools/live_match.py ${W}-livematch/arms.tsv --out ${OUT}/pc-locks32-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock | ./bench-top20.sh ${C} ${P} --set panel-locks.txt --seeds 24 --seed-base 112000 --arms ${W}-prep/ctl.arms --out ${W}-ctl --label pc-locks --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

stage | for a in gl rwl rlnrkn rln; do grep -E "^(c|$a) [|]" ${W}-prep/lock.arms > ${W}-prep/$a-c.arms && mkdir -p ${W}-$a/battles || exit 1; for s in $(grep -v "^#" ${W}-prep/$a.panel | cut -d"|" -f1 | sed -E "s/^ +| +$//g; s/[^A-Za-z0-9.]+/_/g"); do cp -rp ${W}-ctl/battles/$s-*-c ${W}-$a/battles/ || exit 1; done; done
  after: lock

lock-gl | ./bench-top20.sh ${C} ${P} --set ${W}-prep/gl.panel --seeds 24 --seed-base 112000 --arms ${W}-prep/gl-c.arms --out ${W}-gl --label pc-locks-gl --shuffle-jobs
  after: stage
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-rwl | ./bench-top20.sh ${C} ${P} --set ${W}-prep/rwl.panel --seeds 24 --seed-base 112000 --arms ${W}-prep/rwl-c.arms --out ${W}-rwl --label pc-locks-rwl --shuffle-jobs
  after: lock-gl
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m



lock-rlnrkn | ./bench-top20.sh ${C} ${P} --set ${W}-prep/rlnrkn.panel --seeds 24 --seed-base 112000 --arms ${W}-prep/rlnrkn-c.arms --out ${W}-rlnrkn --label pc-locks-rlnrkn --shuffle-jobs
  after: lock-rwl
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-rln | ./bench-top20.sh ${C} ${P} --set ${W}-prep/rln.panel --seeds 24 --seed-base 112000 --arms ${W}-prep/rln-c.arms --out ${W}-rln --label pc-locks-rln --shuffle-jobs
  after: lock-rlnrkn
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

gate | mkdir -p ${W} && (cat ${W}-ctl/arms.tsv && for d in gl rwl rlnrkn rln; do awk -F"\t" -v a=$d 'NR > 1 && $1 == a' ${W}-$d/arms.tsv || exit 1; done) > ${W}/arms.tsv && python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks32-lock.md && python3 tools/lock_prep.py --restrict ${W}/arms.tsv ${W}-prep ${W}/arms-picked.tsv && python3 ../data/tools/mode_table.py ${W}/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-locks32-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks32-lock-pick.md && python3 tools/per_robot.py ${W}/arms-picked.tsv --arms gl rwl rlnrkn rln --out ${OUT}/$(date +%Y-%m-%d)_pc-locks32-lock-per-robot.md --out-tsv ${OUT}/pc-locks32-lock-per-robot.tsv
  after: lock-rln

pr | bash tools/open_results_pr.sh claude/pc-locks32-results "1v1 cloud locks, round 32 (2 gl, 4 rwl, 2 rlnrkn, BagPuss rln) on 24 fresh PC seeds" ${OUT}/pc-locks32-livematch.md ${OUT}/*_pc-locks32-*.md ${OUT}/pc-locks32-lock-per-robot.tsv $(find ${OUT} -maxdepth 1 -name 'pc-locks32-lock-pick.tsv' -size +0c)
  after: gate
