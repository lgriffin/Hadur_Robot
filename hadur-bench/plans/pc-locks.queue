# 1v1, cloud locks to the PC (BENCH-253), round 37.
# Round 36 ran as PR #1100 (A/A -0.08 +- 0.97): Che x0 +2.5 and Ogi cpl +4.3 held and were banked (#1101,
# plans/locks36-shipped.txt); the other seven lines did not clear 0.
# Round 37 carries 8 robots on existing table switches, each read on 12 or more fresh cloud seeds at 0.7x the live turn
# time against both c and aa, gain vs mean(c, aa) (coverage/shards/locks.tsv):
#   rp (POW-17 race power)        Wavelet +13.7 +- 3.8 (12; screen +12.1), Nene
#                                 +3.9 +- 1.7 (24), JKHydra +3.0 +- 1.0 (24; +1.8 +- 1.6 vs c),
#                                 Firestarter +2.7 +- 1.9 (24), PricklyPear +1.9 +- 1.4 (24): BB outlasts these in long energy races that we lose late
#   rppb (rp with POW-20 bands)   Knight +10.2 +- 3.1 (12; rp alone +5.9 and +4.5 on two more blocks); bands 0.77 0.73 0.41 0.12
#   zl (SHIELD-20 still plans)    Quest +3.1 +- 2.8 (24): BB stands still on all its shots, we on 72%
#   vj (velocity jitter)          Viper +2.4 +- 1.8 (12)
# BeepBoop, DrussGT, Saguaro and ScalarR pad the A/A check to 12 robots on arm aa. The PC
# reads 24 fresh seeds from 117000 and a line ships only on the PC's own read.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: each line names one robot; every other robot, team and melee play bit for bit as master.
#   - Diagnosis: on Wavelet, Knight, Nene, JKHydra and Firestarter we spend our energy early and lose the late race (we spend 43% of ticks
#     under 20 energy against Wavelet), and race power keeps energy for it; Quest fires while we move, where still
#     shot plans keep the shield on; Viper aims at our velocity stats.
#   - Every line read positive against both controls at PC-like turn time on fresh cloud seeds; 24 PC seeds settle it.
#
# Stop rules (docs/bench/watch.md): no aa stop rule (aa is read in the gate). Each bench step halts on 30 failed
# battles, an arm scoring nothing in 8, 60+ skipped turns a battle over the last 24 or no battle in 30 minutes. The
# live-match step stops the card if the PC no longer scores us and BeepBoop as live does (tools/live_match.py exit 3).
# ALERT opens an issue for Leigh on any stop.
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live, in its
#              own folder (work/pc-locks37-livematch), so no earlier round's battle is read back
#   lock       panel-locks.txt  c / aa, 24 fresh seeds from 117000, --cpu-constant live, in work/pc-locks37-ctl
#   stage      writes each lever's two-arm file (c and the lever) and copies in, times kept, the c battles of that lever's
#              own robots, so the bench reads them back (BENCH-95) and the watcher counts them as resumed
#   lock-X     each lever arm on its own picked robots only, same seeds, in work/pc-locks37-X; the gate takes c and aa
#              from -ctl and only the lever rows from each -X
#   gate       each robot judged on its own lever arm only (lock_prep.py --restrict); it keeps its line where the 95% low
#              end is above 0 (mode_table.py --margin 0)
# Leigh starts it once the PC is free (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-locks --fresh        (or  ./queue.sh run pc-locks --fresh)
#   --fresh because round 36 left this plan's queue state marked complete; the new work directory and seeds mean no
#   battle is read back from an earlier round (and BENCH-272 refights any whose jar changed).
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. 124 live-match battles and 768 lock battles (12
# robots in c and aa, each lever robot again on its own arm, 24 seeds): 892 in all, about 20 minutes.
# The prep step stops if any panel robot's jar is missing.
#
set V = 3.25
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-locks37
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && python3 tools/lock_prep.py plans/locks-pick.tsv panel-locks.txt plans/pc-locks.arms ${W}-prep && bash ${W}-prep/build.sh && for a in zl vj rp rppb; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; awk -F"\t" -v a=$a '$2 == a {print $1 " |"}' plans/locks-pick.tsv > ${W}-prep/$a.names && grep -F -f ${W}-prep/$a.names panel-locks.txt > ${W}-prep/$a.panel && grep "^$a |" ${W}-prep/lock.arms > ${W}-prep/$a.arms || exit 1; done && grep -E "^(c|aa) [|]" ${W}-prep/lock.arms > ${W}-prep/ctl.arms && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-locks.txt && for j in $(grep -hv "^#" panel-locks.txt | cut -d"|" -f3); do test -f opponents/$j || { echo "missing jar $j"; exit 1; }; done && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out ${W}-livematch --label pc-locks-livematch --shuffle-jobs && python3 tools/live_match.py ${W}-livematch/arms.tsv --out ${OUT}/pc-locks37-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock | ./bench-top20.sh ${C} ${P} --set panel-locks.txt --seeds 24 --seed-base 117000 --arms ${W}-prep/ctl.arms --out ${W}-ctl --label pc-locks --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

stage | for a in zl vj rp rppb; do grep -E "^(c|$a) [|]" ${W}-prep/lock.arms > ${W}-prep/$a-c.arms && mkdir -p ${W}-$a/battles || exit 1; for s in $(grep -v "^#" ${W}-prep/$a.panel | cut -d"|" -f1 | sed -E "s/^ +| +$//g; s/[^A-Za-z0-9.]+/_/g"); do cp -rp ${W}-ctl/battles/$s-*-c ${W}-$a/battles/ || exit 1; done; done
  after: lock

lock-zl | ./bench-top20.sh ${C} ${P} --set ${W}-prep/zl.panel --seeds 24 --seed-base 117000 --arms ${W}-prep/zl-c.arms --out ${W}-zl --label pc-locks-zl --shuffle-jobs
  after: stage
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-vj | ./bench-top20.sh ${C} ${P} --set ${W}-prep/vj.panel --seeds 24 --seed-base 117000 --arms ${W}-prep/vj-c.arms --out ${W}-vj --label pc-locks-vj --shuffle-jobs
  after: lock-zl
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-rp | ./bench-top20.sh ${C} ${P} --set ${W}-prep/rp.panel --seeds 24 --seed-base 117000 --arms ${W}-prep/rp-c.arms --out ${W}-rp --label pc-locks-rp --shuffle-jobs
  after: lock-vj
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-rppb | ./bench-top20.sh ${C} ${P} --set ${W}-prep/rppb.panel --seeds 24 --seed-base 117000 --arms ${W}-prep/rppb-c.arms --out ${W}-rppb --label pc-locks-rppb --shuffle-jobs
  after: lock-rp
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

gate | mkdir -p ${W} && (cat ${W}-ctl/arms.tsv && for d in zl vj rp rppb; do awk -F"\t" -v a=$d 'NR > 1 && $1 == a' ${W}-$d/arms.tsv || exit 1; done) > ${W}/arms.tsv && python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks37-lock.md && python3 tools/lock_prep.py --restrict ${W}/arms.tsv ${W}-prep ${W}/arms-picked.tsv && python3 ../data/tools/mode_table.py ${W}/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-locks37-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks37-lock-pick.md && python3 tools/per_robot.py ${W}/arms-picked.tsv --arms zl vj rp rppb --out ${OUT}/$(date +%Y-%m-%d)_pc-locks37-lock-per-robot.md --out-tsv ${OUT}/pc-locks37-lock-per-robot.tsv
  after: lock-rppb

pr | bash tools/open_results_pr.sh claude/pc-locks37-results "1v1 cloud locks, round 37 (8 lines on zl, vj, rp, rppb), 24 fresh PC seeds" ${OUT}/pc-locks37-livematch.md ${OUT}/*_pc-locks37-*.md ${OUT}/pc-locks37-lock-per-robot.tsv $(find ${OUT} -maxdepth 1 -name 'pc-locks37-lock-pick.tsv' -size +0c)
  after: gate
