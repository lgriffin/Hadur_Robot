# 1v1, cloud locks to the PC (BENCH-253), round 30. Round 29 ran as PR #1062 (A/A -0.21 +- 0.38 on 14 robots): rwl
# (ram wait) on X_FireFly, iRobot, Thinker, Jammy, Samspin, Gnome and Eater_of_Worlds_Mini (+0.6 to +1.2) and MagicD3 x0
# (+3.6) held and were banked (plans/locks29-shipped.txt); Blur, Rover, ROBv300, Ant, GhostShell and gpBot_0 rwl did not
# clear 0.
# Round 30 carries 9 per-robot lines on existing table switches, each read on 12+ fresh cloud seeds against both c
# (master) and aa (its A/A twin) at Robocode 1.12.0 and the live turn time (coverage/shards/locks.tsv):
#   ky (SHIELD-35 close-range yield)   GFMicro +7.3 vs c / +8.4 vs aa (12 seeds); PkAssassin +1.2 / +0.7 (12 seeds);
#        Fhqwhgads +3.1 / +6.2 (24 seeds)
#   rwl (MOVE-46 ram wait)             TheoryOfEverything +1.4 / +1.4 (12 fresh seeds), Fe4r +1.3 / +1.5 and LightningBug
#        +0.9 / +1.1 (24 fresh seeds)
#   ty (SHIELD-33 tiny-shot waves)     Sparrow +0.9 / +0.6 and Decepticon +0.7 / +0.4 (18 seeds)
#   x0 (SHIELD-19 exit off)            DarkHallow +1.3 / +2.3 (36 seeds; near, low end vs c just under 0)
# and four robots whose round 29 line is on master (Jammy, iRobot, Thinker, Samspin) read only in c and aa, so the A/A
# check reads 13 robots. The PC reads 24 fresh seeds from 109000 and a line ships only on the PC's own read; every
# robot is judged on its own.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: each line names one robot; every other robot, team and melee play bit for bit as master.
#   - Diagnosis: ky robots out-hit our shield inside 150 px, so the shield hands the drive to the surf until 250 px. The
#     rwl robots land 20% or more of their hits on us after our endgame ram on their disabled robot starts; the ram wait
#     lets those waves pass first. The ty robots sit under 0.2 energy firing sub-0.1 shots for 100+ ticks a round while
#     we shield, and each hit refunds them; ty gives those shots waves the shield can meet. DarkHallow hits us for 121
#     damage a battle after the shield leaves the battle on damage; x0 keeps the shield on.
#   - Every line read positive against both controls on the cloud; 24 PC seeds settle each one.
# Stop rules (docs/bench/watch.md): no aa stop rule (aa is read in the gate). The lock halts on 30 failed battles, an arm
# scoring nothing in 8, 60+ skipped turns a battle over the last 24 or no battle in 30 minutes. The live-match step stops
# the card if the PC no longer scores us and BeepBoop as live does (tools/live_match.py exit 3).
# ALERT opens an issue for Leigh on any stop.
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live, in its
#              own folder (work/pc-locks30-livematch), so no earlier round's battle is read back
#   lock       panel-locks.txt  c / aa, 24 fresh seeds from 109000, --cpu-constant live, in work/pc-locks30-ctl
#   stage      writes each lever's two-arm file (c and the lever) and copies in, times kept, the c battles of that lever's
#              own robots, so the bench reads them back (BENCH-95) and the watcher counts them as resumed
#   lock-X     each lever arm (ky, rwl, ty, x0) on its own picked robots only, same seeds, in work/pc-locks30-X; the gate
#              takes c and aa from -ctl and only the lever rows from each -X
#   gate       each robot judged on its own lever arm only (lock_prep.py --restrict); it keeps its line where the 95%
#              low end is above 0 (mode_table.py --margin 0).
# Leigh starts it once the PC is free (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-locks --fresh        (or  ./queue.sh run pc-locks --fresh)
#   --fresh because round 29 left this plan's queue state marked complete; the new work directory and seeds mean no
#   battle is read back from an earlier round (and BENCH-272 refights any whose jar changed).
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. 840 lock battles (13 robots in c and aa, the nine
# lever robots again on their own arm, 24 seeds), about 1.5 hours with the live-match check. The prep step stops if any
# panel robot's jar is missing.
#
set V = 3.24
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-locks30
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && python3 tools/lock_prep.py plans/locks-pick.tsv panel-locks.txt plans/pc-locks.arms ${W}-prep && bash ${W}-prep/build.sh && for a in ky rwl ty x0; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; grep -F -f ${W}-prep/$a.list panel-locks.txt > ${W}-prep/$a.panel && grep "^$a |" ${W}-prep/lock.arms > ${W}-prep/$a.arms || exit 1; done && grep -E "^(c|aa) [|]" ${W}-prep/lock.arms > ${W}-prep/ctl.arms && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-locks.txt && for j in $(grep -v "^#" panel-locks.txt | cut -d"|" -f3); do test -f opponents/$j || { echo "missing jar $j"; exit 1; }; done && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out ${W}-livematch --label pc-locks-livematch --shuffle-jobs && python3 tools/live_match.py ${W}-livematch/arms.tsv --out ${OUT}/pc-locks30-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock | ./bench-top20.sh ${C} ${P} --set panel-locks.txt --seeds 24 --seed-base 109000 --arms ${W}-prep/ctl.arms --out ${W}-ctl --label pc-locks --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

stage | for a in ky rwl ty x0; do grep -E "^(c|$a) [|]" ${W}-prep/lock.arms > ${W}-prep/$a-c.arms && mkdir -p ${W}-$a/battles || exit 1; for s in $(grep -v "^#" ${W}-prep/$a.panel | cut -d"|" -f1 | sed -E "s/^ +| +$//g; s/[^A-Za-z0-9.]+/_/g"); do cp -rp ${W}-ctl/battles/$s-*-c ${W}-$a/battles/ || exit 1; done; done
  after: lock

lock-ky | ./bench-top20.sh ${C} ${P} --set ${W}-prep/ky.panel --seeds 24 --seed-base 109000 --arms ${W}-prep/ky-c.arms --out ${W}-ky --label pc-locks-ky --shuffle-jobs
  after: stage
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-rwl | ./bench-top20.sh ${C} ${P} --set ${W}-prep/rwl.panel --seeds 24 --seed-base 109000 --arms ${W}-prep/rwl-c.arms --out ${W}-rwl --label pc-locks-rwl --shuffle-jobs
  after: lock-ky
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-ty | ./bench-top20.sh ${C} ${P} --set ${W}-prep/ty.panel --seeds 24 --seed-base 109000 --arms ${W}-prep/ty-c.arms --out ${W}-ty --label pc-locks-ty --shuffle-jobs
  after: lock-rwl
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-x0 | ./bench-top20.sh ${C} ${P} --set ${W}-prep/x0.panel --seeds 24 --seed-base 109000 --arms ${W}-prep/x0-c.arms --out ${W}-x0 --label pc-locks-x0 --shuffle-jobs
  after: lock-ty
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

gate | mkdir -p ${W} && (cat ${W}-ctl/arms.tsv && for d in ky rwl ty x0; do awk -F"\t" -v a=$d 'NR > 1 && $1 == a' ${W}-$d/arms.tsv; done) > ${W}/arms.tsv && python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks30-lock.md && python3 tools/lock_prep.py --restrict ${W}/arms.tsv ${W}-prep ${W}/arms-picked.tsv && python3 ../data/tools/mode_table.py ${W}/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-locks30-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks30-lock-pick.md && python3 tools/per_robot.py ${W}/arms-picked.tsv --arms ky rwl ty x0 --out ${OUT}/$(date +%Y-%m-%d)_pc-locks30-lock-per-robot.md --out-tsv ${OUT}/pc-locks30-lock-per-robot.tsv
  after: lock-x0

pr | bash tools/open_results_pr.sh claude/pc-locks30-results "1v1 cloud locks, round 30 (3 close-range yield ky, 3 ram-wait rwl, 2 tiny-shot ty, DarkHallow x0) on 24 fresh PC seeds" ${OUT}/pc-locks30-livematch.md ${OUT}/*_pc-locks30-*.md ${OUT}/pc-locks30-lock-per-robot.tsv $(find ${OUT} -maxdepth 1 -name 'pc-locks30-lock-pick.tsv' -size +0c)
  after: gate
