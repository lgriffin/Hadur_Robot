# 1v1, cloud locks to the PC (BENCH-253), round 9: per-robot lines that locked on the cloud (95% low end above 0, live
# turn time; coverage/shards/locks.tsv, coverage/shards/round9-draft.md) after round 8 (PR #905) ran:
#   rf (RAM-15 ram-flee): Prototype +3.2 (low +1.9), Zafaran +2.5 (+1.6), Bruce +2.2 (+1.2), Snezhok +2.0 (+1.0),
#      mahrram +1.6 (+0.6), David +1.1 (+0.7), Serenity +1.0 (+0.6, 36 seeds), ScalpBotC +0.8 (+0.4, 48 seeds); 24 seeds unless marked
#   sp2 (DODGE-6 shot-dodge planner): RobAtHome +2.2 (+1.1, 12 seeds), Gandhi +1.7 (+0.8, 12 seeds)
#   Each gain is the smaller of the reads against c and against an A/A twin. ScalpBotC only just clears 0; the PC decides it.
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live
#   lock       the 10 robots  c / aa / rf / sp2 (each lever arm built with only its own robots)   12 fresh seeds from 45900,
#              --cpu-constant live, in work/pc-locks9 (earlier rounds' battles stay in work/pc-locks to -locks8)
#   gate       each robot judged on its own arm only (lock_prep.py --restrict); it keeps its line where the 95% low end
#              is above 0 (mode_table.py --margin 0)
# Leigh starts it once the PC is free (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-locks --fresh        (or  ./queue.sh run pc-locks --fresh)
#   --fresh because round 8 left this plan's queue state marked complete; an interrupted round 9 resumes without it.
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. 480 lock battles (10 robots, 4 arms, 12 seeds), about 10 minutes
# with the live-match check.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: every line names one robot; every other robot, team and melee play bit for bit as master.
#   - Diagnosis first (truth logs against BeepBoop 2.0 and Saguaro 1.1.4, re-lever lane 17 Nov: relever-A, -C, -L, -M):
#     rf: these robots charge under RAM-1's 6 px a tick, so RAM-2 never confirms them and we stay in contact taking their
#     point-blank fire; BeepBoop backs away (ram damage on us above BeepBoop's in the traces; move/ramflee/README.md).
#     sp2: non-rammers fought beyond 300 px whose simple or partial aims hit us well above BeepBoop's rate; the planner
#     steps off the aimed line (relever-M/README.md).
#   - Every robot passed the cloud lock bar first; round 8 held 6 of 11 (#905, banked #906).
# Stop rules (docs/bench/watch.md): the watcher's A/A rule needs 10 robots read in both c and aa, which this 10-robot
# lock reaches only near its end (shuffled jobs), so no aa stop rule is set; aa is read in the gate (multiarm.py prints aa against c). The card halts on 30 failed
# battles, an arm scoring nothing in 8, 60+ skipped turns a battle over the last 24, or no battle in 30 minutes. The
# live-match step stops the card if the PC no longer scores us and BeepBoop as live does (tools/live_match.py exit 3).
# ALERT opens an issue for Leigh on any stop.
# Bank: the owning cloud thread adds the gate's lines on this card's results PR. Nothing is released by the card.
set V = 3.23
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-locks9
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && python3 tools/lock_prep.py plans/locks-pick.tsv panel-locks.txt plans/pc-locks.arms ${W}-prep && bash ${W}-prep/build.sh && for a in rf sp2; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; done && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-locks.txt && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out work/pc-livematch-rel-live --label pc-locks-livematch --shuffle-jobs && python3 tools/live_match.py work/pc-livematch-rel-live/arms.tsv --out ${OUT}/pc-locks9-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock | ./bench-top20.sh ${C} ${P} --set panel-locks.txt --seeds 12 --seed-base 45900 --arms ${W}-prep/lock.arms --out ${W} --label pc-locks --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

gate | python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks9-lock.md && python3 tools/lock_prep.py --restrict ${W}/arms.tsv ${W}-prep ${W}/arms-picked.tsv && python3 ../data/tools/mode_table.py ${W}/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-locks9-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks9-lock-pick.md && python3 tools/per_robot.py ${W}/arms-picked.tsv --arms rf sp2 --out ${OUT}/$(date +%Y-%m-%d)_pc-locks9-lock-per-robot.md --out-tsv ${OUT}/pc-locks9-lock-per-robot.tsv
  after: lock

pr | bash tools/open_results_pr.sh claude/pc-locks9-results "1v1 cloud locks, round 9 (10 robots from the re-lever lane) locked on 12 fresh PC seeds" ${OUT}/pc-locks9-livematch.md ${OUT}/*_pc-locks9-*.md ${OUT}/pc-locks9-lock-per-robot.tsv $(find ${OUT} -maxdepth 1 -name 'pc-locks9-lock-pick.tsv' -size +0c)
  after: gate
