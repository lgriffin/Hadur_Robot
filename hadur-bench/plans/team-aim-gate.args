# PC card pc-team-aim (BENCH-172): arm gate against aa. Template: aiprep writes work/team-aim-gate.args with @V@ = the robot.release in hadur-robot/pom.xml
--team
true
--seeds
16
--seed-base
8300
--rounds
10
--parallel
auto
--child-heap
2G
--cpu-constant
auto
--set
