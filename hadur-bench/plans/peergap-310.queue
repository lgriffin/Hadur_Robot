# Step 1 of the 3.11 attack (docs/bench/live-3.10.md, issue #151): measure 3.10 on the fixed bench
# (BENCH-83, confirmed by confirm-fix-310) against all 144 PEERGAP opponents, the bots where the
# peers ranked 8th to 11th outscore Hadur by 5+ live. 68 of them were never benched and 41 were
# benched only on the crippled harness, so this is the first trustworthy read of where 3.11's
# +0.75 APS of room lives. 4 seeds of 35 rounds, 3.10 alone. Close the RoboRumble client first.
# Run from hadur-bench:  .\queue.ps1 run peergap-310   (or ./queue.sh)
#
# Read it with: python3 ../data/tools/live_passes.py classify ... --bench '../data/bench/*peergap-310*_cold.tsv'
# (the command in docs/bench/live-3.10.md); a bot whose bench share sits 5+ under the peers'
# median joins the 3.11 gate list.

set COMMON = --skip-fetch --rounds 35 --cpu-constant 1488498 --child-heap 2G --engine 1.11.1
set C310 = --robot-jar ../hadur-robot/target/hadur2.Hadur_3.10.jar --robot "hadur2.Hadur 3.10"

prep | (cd .. && mvn -q -B package -DskipTests) && ./fetch-opponents.sh --set peergap-310.txt

peergap-310 | ./bench-top20.sh --skip-build ${COMMON} --set peergap-310.txt --seeds 4 ${C310} --label peergap-310
  after: prep
