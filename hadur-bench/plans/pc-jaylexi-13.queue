# JayLexi 1.3 confirm on the whole MiniRumble field (thread "Rebuild JayLexi movement to win MiniRumble"; BENCH-274).
# 1.3 is 1.2 with one fix (JAYLEXI-26): JayLexi drops an enemy wave about the tick its bullet reaches it, before
# onHitByBullet runs, so 1.2's surf stats learned from about 1 hit in 4. 1.3 keeps the wave it dropped last and logs the
# hit on it. 1,486 B.
#   ./queue.sh run pc-jaylexi-13        (or  .\queue.ps1 run pc-jaylexi-13)
# Run it from master with this card merged: git checkout master && git pull
# One bench queue, RoboRumble workers at 0. Nothing is uploaded or released. About 2 h 45 min to the end.
#
# Why it should win:
# - Diagnosed: FoilistMC's movement on JayLexi's gun beats 1.2 by +1.2 to +2.4, and twelve movement-mechanic prototypes
#   (rocking, speed, reversals, options, danger tweaks) moved nothing. Reading what the surf learns from found the cause:
#   on 6 robots an instrumented 1.2 matched only 93 of 376 hits on it to a wave (25%); the rest were never logged.
#   With the fix 730 of 746 match (98%).
# - Cloud, truth logs on the 24 robots where the hybrid gains most (3 seeds): enemy hit rate 7.16% -> 6.61%, lower in
#   every reversal class. Score, 145 MiniRumble robots x 3 fresh seeds (435 pairs an arm), A/A +0.05 +- 0.12:
#   the tight fix +1.10 +- 0.11 over 1.2 (+1.05 +- 0.22 over the A/A copy). Cloud gains have read about half size on
#   the PC, so about +0.5 is expected here.
# - c is 1.2's source read from master at 4cbd7b3d6 (checked by grep: per-robot power rows, no dropped-wave logging);
#   t is the shipped source (checked by grep for the dropped-wave logging); aa is c rebuilt. The replay tests show 1.3
#   plays the readable reference bit for bit and that the fix changes the orders.
# - Risk: the dropped-wave slot is cleared each round and null until its first drop, where the search stops; hits still
#   match within 100 px of a wave front, as before.
#
# Timing: --cpu-constant live (BENCH-245). The livematch step is Hadur's and BeepBoop's 1v1 check of the PC's turn time;
# MiniRumble runs on the same LiteRumble clients, so the same constant holds for it.
# Pilot: shuffled jobs, so the first 20% is a fair sample. A/A outside its band at 20% halts; t below -0.5 points at 20%
# finishes the run early (futility).
# Panel: kitlab/mini-pw-field.txt (668 MiniRumble robots). 4 arms x 668 x 6 fresh seeds from 63000 x 35 rounds =
# 16,032 battles.
# Gate: t (1.3) against c and aa pooled, mean over the 668 robots with its 95% low end above 0. r6 (the released 0.6)
# shows what 0.7 to 1.3 add over live. A pass is banked; release only on Leigh's word.
# Stop rules: fails 30, dead 8, skips 60 over 200, stall 30m (halt; every battle fought is kept and a rerun resumes),
# aa after 20% (halt), futility t below -0.5 after 20% (finish). ALERT opens an issue for Leigh on a stop.

set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 512M
set SRC = ../jaylexi/src/main/java/hadur117/mini/JayLexi.java
set W = work/jaylexi-13
set OUT = ../docs/bench/local
set ALERT = lgriffin
set REL = https://github.com/lgriffin/Hadur_Robot/releases/download

prep | git checkout -q master && rm -f ${OUT}/*_jaylexi-13*.md && mkdir -p ${W} kitlab/jars bisect work && (cd ../jaylexi && mvn -q verify) && grep -q "waves.add(0, gone)" ${SRC} && git show 4cbd7b3d6:jaylexi/src/main/java/hadur117/mini/JayLexi.java > ${W}/JayLexi.java && grep -q "POWER.charAt(row + band)" ${W}/JayLexi.java && ! grep -q "gone" ${W}/JayLexi.java && bash kitlab/build_arm_pg.sh ${W}/JayLexi.java hadur117.mini.JayLexi 1.2c && bash kitlab/build_arm_pg.sh ${W}/JayLexi.java hadur117.mini.JayLexi 1.2aa && bash kitlab/build_arm_pg.sh ${SRC} hadur117.mini.JayLexi 1.3t && curl -fsSL -o kitlab/jars/hadur117.mini.JayLexi_0.6.jar ${REL}/jaylexi-v0.6/hadur117.mini.JayLexi_0.6.jar && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set kitlab/mini-pw-field.txt && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out work/pc-livematch-rel-live --label pc-jaylexi-13-livematch --shuffle-jobs && python3 tools/live_match.py work/pc-livematch-rel-live/arms.tsv --out ${OUT}/pc-jaylexi-13-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

bench | ./bench-top20.sh ${C} ${P} --set kitlab/mini-pw-field.txt --seeds 6 --seed-base 63000 --arms plans/jaylexi-13.arms --out ${W}/run --label jaylexi-13 --shuffle-jobs
  after: livematch
  watch:
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m
  stop: aa after 20%
  stop: futility t below -0.5 after 20%

gate | python3 ../data/tools/multiarm.py ${W}/run/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_jaylexi-13.md && printf '\n## Gate\n\nt (1.3) ships when its mean against c and aa pooled over the 668 robots has its 95%% low end above 0. c is 1.2; r6 is the released 0.6.\n' >> ${OUT}/$(date +%Y-%m-%d)_jaylexi-13.md && python3 tools/arm_pair.py ${W}/run/arms.tsv --candidate t --baseline c --robots FoilistMC CunobelinDC "Foilist 1" Komarious WeeksOnEnd --out ${OUT}/$(date +%Y-%m-%d)_jaylexi-13.md && { [ ! -f ${W}/run/EARLY-STOP.md ] || cat ${W}/run/EARLY-STOP.md >> ${OUT}/$(date +%Y-%m-%d)_jaylexi-13.md; }
  after: bench

pr | bash tools/open_results_pr.sh claude/pc-jaylexi-13-results "JayLexi 1.3 on the whole MiniRumble field (pc-jaylexi-13)" ${OUT}/*_jaylexi-13.md ${OUT}/pc-jaylexi-13-livematch.md
  after: gate
