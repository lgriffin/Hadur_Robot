# Saor's plan for 1st in MicroMelee, stage 5b (docs/plan-saor-first.md 6h): a live-shaped confirm.
# pc-saor-s04 (PR #347) passed LA, Saor 0.2 learning a transition on every scan: +0.45 ± 0.29 over
# 0.2 on the MicroMelee census. This card seats Figment beside 0.2, LA and LAU (LA without the
# end-game cap, 25 bytes free) on the live-shaped census, and re-reads them on the MicroMelee census.
#   ./queue.sh run pc-saor-s05        (or  .\queue.ps1 run pc-saor-s05)
# Run it from master:
#   git checkout master && git pull
# One bench queue, RoboRumble workers at 0, unpinned, 12 workers. Every step resumes; no step needs
# a decision. Nothing here touches Hadur.
#
# Arms (saor-arms/arms.txt; bytes after ProGuard):
#   C      Saor 0.2, the control (748)
#   FIG    kc.micro.Figment 1.0 seated, live-shaped census only
#   LA     0.2 learning on every scan (737)
#   LAU    LA without the end-game power cap (723)
# The live-shaped census (SAOR-16) for C, FIG, LA, LAU (360 battles a seat, about 30-60 min each);
# the MicroMelee census for C, LA, LAU (216 battles, about 15 min an arm).
# Pass: the best of LA and LAU leads FIG by +0.5 or more on the live-shaped census, its low end
# above Figment's 69.37 live after the run's offset (C's read minus 68.08; the read applies it
# with --control-live 68.08).

set MVN = mvn -q -Drobocode.version=1.11.1 compile exec:java
set OUT = ../docs/bench/local
set ARMS = C,LA,LAU
set LIVE = C,FIG,LA,LAU

prep | (cd .. && mvn -q -DskipTests install -pl saor -am) && cp ../saor/target/hadur117.micro.Saor_0.2.jar opponents/ && ./fetch-opponents.sh --set micromelee-field.txt && for f in melee-census-317/f*.txt; do ./fetch-opponents.sh --set "$f" || exit 1; done && SAOR_RUN=s05 bash tools/saor_arms.sh census 12 2200 ${ARMS} && SAOR_RUN=s05 bash tools/saor_arms.sh live 8 2300 ${LIVE}

live-C | ${MVN} "-Dexec.args=@work/saor-s05/live-C.args"
  after: prep

live-FIG | ${MVN} "-Dexec.args=@work/saor-s05/live-FIG.args"
  after: live-C

live-LA | ${MVN} "-Dexec.args=@work/saor-s05/live-LA.args"
  after: live-FIG

live-LAU | ${MVN} "-Dexec.args=@work/saor-s05/live-LAU.args"
  after: live-LA

census-C | ${MVN} "-Dexec.args=@work/saor-s05/census-C.args"
  after: live-LAU

census-LA | ${MVN} "-Dexec.args=@work/saor-s05/census-LA.args"
  after: census-C

census-LAU | ${MVN} "-Dexec.args=@work/saor-s05/census-LAU.args"
  after: census-LA

read | python3 tools/saor_arms.py --work-root work/saor-s05 --field live --arms ${LIVE} --control C --only work/saor-s05/live/micro.txt --top5 69.37 --control-live 68.08 > ${OUT}/saor-s05-live.md && python3 tools/saor_arms.py --work-root work/saor-s05 --arms ${ARMS} --control C > ${OUT}/saor-s05-census.md
  after: census-LAU

pr | bash tools/open_results_pr.sh claude/pc-saor-s05-results "Saor stage 5b: LA live-shaped with Figment seated" ${OUT}/saor-s05-live.md ${OUT}/saor-s05-census.md ${OUT}/saor-s05-live-*.md ${OUT}/saor-s05-census-*.md
  after: read
