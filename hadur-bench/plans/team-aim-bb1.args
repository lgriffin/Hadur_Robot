# PC card pc-team-aim (BENCH-172): arm bb (pilot) against aa. Template: aiprep writes work/team-aim-bb1.args with @V@ = the robot.release in hadur-robot/pom.xml
--team
true
--seeds
3
--seed-base
8200
--rounds
10
--parallel
auto
--child-heap
2G
--cpu-constant
auto
--set
plans/team-aim-set.txt
--robot-jar
bisect/hadur117.HadurTeam_@V@bb.jar
--robot
hadur117.HadurTeam @V@bb
--member
hadur117.Hadur
--out
work/team-aim-@V@-bb
--report
../docs/bench/local/team-aim-bb-pilot.md
--baseline
bisect/hadur117.HadurTeam_@V@aa.jar
--baseline-robot
hadur117.HadurTeam @V@aa
