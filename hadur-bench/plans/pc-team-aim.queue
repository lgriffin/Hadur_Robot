# Per-team aim for the mid teams OgiTeam out-hits (TMODE-40 AIM, BENCH-172; team thread "Build per-team
# counters to close the team gap"). Team only: duel and melee fixtures replay bit for bit.
# Why it should win: pc-team-mirror (PR #569) has OgiTeam and HadurTeam on the same teams and seeds.
# Against the mid teams both win nearly every round and deal the same damage, but Ogi hits 3.7 points
# more often (TroodonPack 24.2% vs 17.7%, GrofGroup 22.2/18.0, TMNR 20.1/16.3, DemoniacNimrods 19.8/16.1),
# so its rounds end about 35% sooner and its members take less fire. These are nano and micro teams with
# simple movement, where a head-on, linear or circular aim can out-hit a learning gun. AIM scores those
# three aims on our own waves, per enemy class, and lets one take a class only once it beats the field
# gun's hit rate by 25%, so a team it cannot read keeps the field gun. Global switches stay off: only
# the teams the screen and a fresh-seed gate both pick get AIM in the table.
# Leigh's rule (2026-11-03): a pilot stage first. aipilot reads the first 3 of 12 seeds (25% of the
# screen) and stops the card if AIM's projected change is not above zero; the results PR opens either way.
#   aiprep   build aa, bb and am (tmaim: AIM on every team, to screen)
#   aibb1    bb vs aa, the 13 teams of plans/team-aim-set.txt x 3 seeds (base 8200), 10 rounds; aiam1 the same for am
#   aipilot  AIM's projected change over the pilot (gain less half of bb's, /46), every team needing its 3
#            paired seeds: under 0 opens the results PR and ends the card; a short pilot halts it (rerun)
#   aibb     bb vs aa, the same 13 teams to 12 seeds (resumes the pilot's 3); aiam the same for am
#   aiscr    the whole screen's read, every team needing its 12 paired seeds (a short screen halts: rerun)
#   aipick   per team, AIM's gain over both baselines, +3.0 points or more with the 95% low end above
#            zero; entries play MATEFIRE, HUNT, PATH, DODGE and CONCORD with AIM; a named team keeps its entry
#   aigate   the picked table (mk) vs aa on the picked teams, 16 fresh seeds (base 8300); aigbb its A/A
#   aisum    projected APS = sum of the picked teams' gains / 46 (gate +0.15, low end above zero); only on
#            PASS is the table written as the table to ship
#   aipr     results PR after the gate (aipilot opens it itself when it stops the card)
# Each seed is a pair (the arm and aa): pilot 2 x 13 x 3 x 2 = 156 battles (about 15 min at 12
# workers), screen to 624 (about 1 h), plus 64 a picked team for the gate. Every step resumes.
# Stop rules on every battle step (halt): 60 failed battles, no battle in 30 minutes, or 40+ skipped
# turns a battle over the last 100 (the experts' extra aims costing too much CPU).
# The team thread reads claude/pc-team-aim-results.
#   ./queue.sh run pc-team-aim        (or  .\queue.ps1 run pc-team-aim)
# Run it from master (one bench queue at a time):
#   git checkout master && git pull

set OUT = ../docs/bench/local
set T = python3 tools/team_modes.py

aiprep | git checkout -q master && V=$(sed -n 's:.*<robot.release>\(.*\)</robot.release>.*:\1:p' ../hadur-robot/pom.xml) && test -n "$V" && for j in aa bb am mk; do rm -f bisect/hadur117.HadurTeam_"$V"$j.jar; done && rm -f ${OUT}/team-aim-*.md ${OUT}/team-aim-pick.tsv ${OUT}/team-aim-locked.java.txt work/team-aim-picked.java work/team-aim-gate.txt && ./fetch-opponents.sh --set team-census46.txt && bash ./build-ablation.sh aa && bash ./build-ablation.sh bb && bash ./build-ablation.sh tmaim && mkdir -p work && for a in bb am gate gbb; do rm -rf work/team-aim-"$V"-$a; done && for a in bb1 am1 bb am gate gbb; do sed "s/@V@/$V/g" plans/team-aim-$a.args > work/team-aim-$a.args || exit 1; done && for j in aa bb am; do test -f bisect/hadur117.HadurTeam_"$V"$j.jar || exit 1; done && mvn -q compile
aibb1  | mvn -q exec:java "-Dexec.args=@work/team-aim-bb1.args" || test $? -eq 1
  after: aiprep
  watch: battles=78
  stop: fails 60
  stop: stall 30m
  stop: skips 40 over 100
aiam1  | mvn -q exec:java "-Dexec.args=@work/team-aim-am1.args" || test $? -eq 1
  after: aibb1
  watch: battles=78
  stop: fails 60
  stop: stall 30m
  stop: skips 40 over 100
aipilot | ${T} gate --report ${OUT}/team-aim-am-pilot.md --control ${OUT}/team-aim-bb-pilot.md --set plans/team-aim-set.txt --seeds 3 --teams 46 --min-aps 0.3 --stop-below 0.0 --out-md ${OUT}/team-aim-pilot.md; rc=$?; if [ $rc -eq 3 ]; then bash tools/open_results_pr.sh claude/pc-team-aim-results "Per-team aim (AIM) on the 13 mid teams: pilot, screen, pick and gate" $(ls ${OUT}/team-aim-*.md ${OUT}/team-aim-pick.tsv ${OUT}/team-aim-locked.java.txt 2>/dev/null); fi; exit $rc
  after: aiam1
aibb   | mvn -q exec:java "-Dexec.args=@work/team-aim-bb.args" || test $? -eq 1
  after: aipilot
  watch: battles=312
  stop: fails 60
  stop: stall 30m
  stop: skips 40 over 100
aiam   | mvn -q exec:java "-Dexec.args=@work/team-aim-am.args" || test $? -eq 1
  after: aibb
  watch: battles=312
  stop: fails 60
  stop: stall 30m
  stop: skips 40 over 100
aiscr  | ${T} gate --report ${OUT}/team-aim-am.md --control ${OUT}/team-aim-bb.md --set plans/team-aim-set.txt --seeds 12 --teams 46 --min-aps 0.3 --out-md ${OUT}/team-aim-screen.md
  after: aiam
aipick | ${T} pick --report AIM=${OUT}/team-aim-am.md --control AIM=${OUT}/team-aim-bb.md --min-mean 3.0 --low-end 0 --base MATEFIRE,HUNT,PATH,DODGE,CONCORD --shipped ../hadur-core/src/main/java/hadur117/core/melee/TeamModes.java --census team-census46.txt --opponents opponents --out-md ${OUT}/team-aim-pick.md --out-tsv ${OUT}/team-aim-pick.tsv --out-java work/team-aim-picked.java --out-set work/team-aim-gate.txt && if [ -s work/team-aim-picked.java ]; then TEAM_MODE_LOCKED="$(pwd)/work/team-aim-picked.java" bash ./build-ablation.sh tmlock; else echo "nothing picked: no gate"; fi
  after: aiscr
aigate | if [ -s work/team-aim-picked.java ]; then mvn -q exec:java "-Dexec.args=@work/team-aim-gate.args" || test $? -eq 1; else echo "nothing picked: no gate"; fi
  after: aipick
  watch:
  stop: fails 60
  stop: stall 30m
  stop: skips 40 over 100
aigbb  | if [ -s work/team-aim-picked.java ]; then mvn -q exec:java "-Dexec.args=@work/team-aim-gbb.args" || test $? -eq 1; else echo "nothing picked: no gate"; fi
  after: aigate
  watch:
  stop: fails 60
  stop: stall 30m
  stop: skips 40 over 100
aisum  | if [ -s work/team-aim-picked.java ]; then ${T} gate --report ${OUT}/team-aim-gate.md --control ${OUT}/team-aim-gbb.md --set work/team-aim-gate.txt --seeds 16 --teams 46 --min-aps 0.15 --out-md ${OUT}/team-aim-verdict.md && if grep -q '\*\*PASS\*\*' ${OUT}/team-aim-verdict.md; then cp work/team-aim-picked.java ${OUT}/team-aim-locked.java.txt; else echo "gate failed: no table to ship"; fi; else echo "AIM cleared the screen on no team: no gate, the table stays as shipped." > ${OUT}/team-aim-verdict.md; fi
  after: aigbb
aipr   | bash tools/open_results_pr.sh claude/pc-team-aim-results "Per-team aim (AIM) on the 13 mid teams: pilot, screen, pick and gate" $(ls ${OUT}/team-aim-*.md ${OUT}/team-aim-pick.tsv ${OUT}/team-aim-locked.java.txt 2>/dev/null)
  after: aisum
