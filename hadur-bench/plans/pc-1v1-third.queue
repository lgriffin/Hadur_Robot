# HELD (2026-10-26): do not run yet. The shot-dodge planner lost both cloud smokes (-0.34, -0.65 points a
# robot); this card goes live only once a planner v3 smoke shows gains worth its 3 PC hours.
# 1v1 plan to 3rd ("Hadur 1v1: plan to 3rd place"), lever L0 and L1: Saguaro's ShotDodger movement
# per opponent (DODGE-4 to DODGE-6, docs/requirements.md) and the Stage 2 factorial mined for
# per-opponent switch picks.
#   ./queue.sh run pc-1v1-third        (or  .\queue.ps1 run pc-1v1-third)
# Run it from master:
#   git checkout master && git pull
# One bench queue, RoboRumble workers at 0, unpinned, 12 workers, truth log off. Every step resumes;
# no step needs a decision. About 3 h.
#
# Why: Saguaro leads Hadur 3.17 by +0.57 APS on the 423 robots its table fights with ShotDodger,
# +0.45 of it on the 148 of panel-third-dodge.txt (Hadur under 95 live, or Saguaro more than 3
# points ahead). The planner is off by default; a field-wide switch lost in the cloud smokes on the
# simple guns Hadur already beats at 95+, so it goes per robot, like stop-and-go.
#
# mine (0 battles): tools/factor_picks.py over Stage 2's two halves (work/top5-s2-half1, -half2),
#   when they are on this machine: per factor, the robots whose effect is 5+ points and the gain
#   held out on the other half of the design. A report only; no build follows from it in this card.
# screen (about 2.2 h): 148 robots x c, aa, sp x 3 seeds = 1,332 battles.
# pick: mode_table.py locks sp at +5 points with the 95% interval above 0.
# experts: tools/third.py reads each picked robot's DP records (our own battles) for its expert.
# candidate: t4 = master + those shot-dodge2 lines (build-ablation.sh sdplanlist).
# verify (about 0.6 h): the picked robots x c, aa, t4 x 3 fresh seeds.
# gate: t4 minus pooled c and aa summed over the verify panel / 1,217 pairings: PASS at +0.15 APS
#   with the lower end above 0 and the A/A inside its band. The verdict goes in the results PR
#   either way. Leigh's release rule stands: no 1v1 release until the census projects the target.

set P = --parallel 12 --no-truth-log
set HEAP = --child-heap 2G
set E = --engine 1.11.1
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant 1488498 ${HEAP} ${E}
set T = python3 tools/third.py
set OUT = ../docs/bench/local

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur2.Hadur_3.18.1.jar bisect/ && bash ./build-ablation.sh aa && bash ./build-ablation.sh sdplan && ./fetch-opponents.sh --set panel-third-dodge.txt && mvn -q compile

mine | if [ -f work/top5-s2-half1/arms.tsv ]; then python3 tools/factor_picks.py work/top5-s2-half1/arms.tsv $(ls work/top5-s2-half2/arms.tsv 2>/dev/null) --design plans/top5-factorial.design --out ${OUT}/$(date +%Y-%m-%d)_third-factor-picks.md --out-tsv ${OUT}/third-factor-picks.tsv; else echo "Stage 2 runs not on this machine" > ${OUT}/$(date +%Y-%m-%d)_third-factor-picks.md; fi
  after: prep

screen | ./bench-top20.sh ${C} ${P} --set panel-third-dodge.txt --seeds 3 --seed-base 2900 --arms plans/third-dodge.arms --out work/third-dodge --label third-dodge
  after: mine

pick | python3 ../data/tools/multiarm.py work/third-dodge/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_third-dodge-screen.md && python3 ../data/tools/mode_table.py work/third-dodge/arms.tsv --margin 5 --out-tsv ${OUT}/third-dodge-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_third-dodge-pick.md && ${T} experts work/third-dodge --pick ${OUT}/third-dodge-pick.tsv --arm sp --out ${OUT}/third-dodge-plans.txt
  after: screen

candidate | ${T} candidate ${OUT}/third-dodge-plans.txt --base 3.18.1 --out work/third-verify.arms && ${T} panel panel-third-dodge.txt --plans ${OUT}/third-dodge-plans.txt --out work/third-panel.txt
  after: pick

verify | ./bench-top20.sh ${C} ${P} --set work/third-panel.txt --seeds 3 --seed-base 3000 --arms work/third-verify.arms --out work/third-verify --label third-verify
  after: candidate

gate | python3 ../data/tools/multiarm.py work/third-verify/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_third-verify.md && python3 tools/shield_s2.py gate work/third-verify/arms.tsv --arm t4 --panel work/third-panel.txt --out ${OUT}/$(date +%Y-%m-%d)_third-gate.md
  after: verify

pr | bash tools/open_results_pr.sh claude/pc-1v1-third-results "1v1 plan to 3rd: shot-dodge planner per opponent and factorial picks" ${OUT}/*_third-*.md $(find ${OUT} -maxdepth 1 -name 'third-*' -size +0c)
  after: gate
