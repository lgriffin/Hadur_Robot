# Deise's stage E3b (docs/deise.md section 8): crowd survival, fitted and stacked.
# E3a (pc-deise-e05, PR #424, seeds from 3500), each arm against D (Deise 0.3) by field: AIM2
# +0.42 ± 0.23 (passes), P2 +0.30 and W10 +0.14 (stack partners), R72 +0.04, W50 -0.54, REACH
# -0.70. AIM2 raised the rounds Deise reaches the last two from 65.4% to 69.5% (Mirage 75.8% in
# e04) and won those duels as often. This card benches the stacks as the classes they would ship,
# on fresh seeds (from 3600), so the winner is ready to be 0.4.
#   ./queue.sh run pc-deise-e06        (or  .\queue.ps1 run pc-deise-e06)
# Run it from master:
#   git checkout master && git pull
# One bench queue, RoboRumble workers at 0, unpinned, 12 workers. A rerun skips every seat that
# finished; a seat that was stopped part-way is fought again from its start (the melee path has no
# per-battle resume). No step needs a decision. Nothing here touches Hadur, Saor or the shipped
# Deise class.
#
# Arms (deise-arms/arms.txt; flat classes in deise-arms/e3/, each FIT3F, 0.3 without the field cap):
#   D      Deise 0.3 (DeiseLab), the reference      SAOR  Saor 0.2 seated, the control
#   FA     AIM2 fitted: each opponent keeps the aim weight of its last scan (1, or 0.25 when another
#          robot is nearer it), which weighs its waves and sets its push, 160,000 or 80,000 (1,499 B)
#   FAP    FA with every push doubled (P2), 1,499 B
#   FAW    FA with the stray weight 0.1 (W10), its push still half a shooter's, 1,499 B
#   FAPW   FA with P2 and W10, 1,499 B
#   PW     FIT3F with P2 and W10, no aim push, 1,480 B
#   MIR    kc.mini.Mirage 0.2 seated: the gap left
# Live-shaped census: 46 fields x 6 seeds a seat (276 battles, about 17 min on the PC), 8 seats,
# about 2.3 h.
# Reads: each arm against SAOR and against D, field by field. The best arm that reads +0.30 or more
# over D with the low end above 0 becomes 0.4: the core and DeiseLab are matched to it (DEISE-16),
# and it ships on Leigh's go. With none, AIM2's +0.42 was luck and E3 looks elsewhere.
# Stop rules on every census step (halt; finished seats are kept, the stopped seat reruns from its
# start): 20 failed battles (a broken jar), no battle in 30 minutes (a hung step), or 40+ skipped
# turns a battle over the last 100. A halt at worst leaves the rest of that seat and the seats
# after it unrun, at most 2,208 battles (about 2.3 h). There is no early finish on score: a census
# seat is one robot, so there is no arm to call futile mid-step.

set MVN = mvn -q -Drobocode.version=1.11.1 compile exec:java
set OUT = ../docs/bench/local
set ARMS = D,FA,FAP,FAW,FAPW,PW,MIR,SAOR

prep | (cd .. && mvn -q -DskipTests install -pl deise -am) && cp ../deise/target/hadur117.mini.Deise_0.3.jar opponents/ && curl -fsSLo opponents/hadur117.micro.Saor_0.2.jar https://github.com/lgriffin/Hadur_Robot/releases/download/saor-v0.2/hadur117.micro.Saor_0.2.jar && ./fetch-opponents.sh --set minimelee-field.txt && for f in melee-census-317/f*.txt; do ./fetch-opponents.sh --set "$f" || exit 1; done && DEISE_RUN=e06 bash tools/deise_arms.sh live 6 3600 ${ARMS}

live-D | ${MVN} "-Dexec.args=@work/deise-e06/live-D.args"
  after: prep
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-FA | ${MVN} "-Dexec.args=@work/deise-e06/live-FA.args"
  after: live-D
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-FAP | ${MVN} "-Dexec.args=@work/deise-e06/live-FAP.args"
  after: live-FA
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-FAW | ${MVN} "-Dexec.args=@work/deise-e06/live-FAW.args"
  after: live-FAP
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-FAPW | ${MVN} "-Dexec.args=@work/deise-e06/live-FAPW.args"
  after: live-FAW
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-PW | ${MVN} "-Dexec.args=@work/deise-e06/live-PW.args"
  after: live-FAPW
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-MIR | ${MVN} "-Dexec.args=@work/deise-e06/live-MIR.args"
  after: live-PW
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-SAOR | ${MVN} "-Dexec.args=@work/deise-e06/live-SAOR.args"
  after: live-MIR
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

read | python3 tools/saor_arms.py --work-root work/deise-e06 --field live --arms ${ARMS} --control SAOR --only work/deise-e06/live/micro.txt --top5 71.20 --control-live 68.79 --pairings 203 --robot-prefix hadur117.mini.Deise --arms-file deise-arms/arms.txt > ${OUT}/deise-e06-live.md && python3 tools/saor_arms.py --work-root work/deise-e06 --field live --arms ${ARMS} --control D --only work/deise-e06/live/micro.txt --pairings 203 --robot-prefix hadur117.mini.Deise --arms-file deise-arms/arms.txt > ${OUT}/deise-e06-vs-d.md
  after: live-SAOR

pr | bash tools/open_results_pr.sh claude/pc-deise-e06-results "Deise stage E3b: crowd survival, fitted" ${OUT}/deise-e06-live.md ${OUT}/deise-e06-vs-d.md ${OUT}/deise-e06-live-*.md
  after: read
