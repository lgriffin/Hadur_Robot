# 1v1, learning-gun mimics per opponent on the next 36 learners (BENCH-179, MOVE-34). Leigh starts it once the PC is
# free (not beside another card: two cards on one checkout collide):
#   git checkout master && git pull
#   .\queue.ps1 run pc-mimic-wide        (or  ./queue.sh run pc-mimic-wide)
# One bench queue, RoboRumble workers at 0, unpinned, 12 workers, truth log off. Every step resumes; no step needs a
# decision. About 65 minutes if it runs to the end (screen 36 x 8 seeds x 3 arms = 864 battles, then the picks x 12
# seeds x 3 arms on fresh seeds), about 10 minutes if the pilot stops it.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring only: mimics on against named robots, master everywhere else. It is the switch that just
#     passed: pc-mimic9 (PR #603) +0.03 +- 0.02 APS, 8 of 9 robots holding on fresh seeds (Gaff +12.5, Pris +8.2), now
#     in mimicOns() (PR #605).
#   - The robots: the 36 learners of panel-learners-flat.txt not yet tried one by one, that pc-mimic (PR #581, every
#     mimic on, 3 seeds) read at +1 point or more (mean +2.2). That read predicted pc-mimic-on's per-robot result with a
#     correlation of 0.48 over its 28 robots, so it ranks candidates, though it is noisy at 3 seeds.
#   - What it can win: if a quarter of the 36 hold at +4 points (the 9 picks' rate and size), about +0.03 APS.
#   - Risk: pc-mimic's +1 to +5 is mostly noise for most of these; expect most to read 0. The pilot catches that.
# Pilot: `futility mq below 0.01 after 20%` ends the screen (as done, so the pick, confirm and PR still run on what was
# fought) once mq's best case over the 36 is under +0.01 APS, about +0.35 points a robot. An A/A outside its band
# halts it (`aa after 20%`). 36 robots read clears the watcher's 10-robot minimum for both.
#
# screen:  c, aa and mq (mimics on against the 36) x 8 seeds from 8600; pick at a 3-point margin with the interval above 0.
# confirm: the same mq jar (mimics only act on listed robots, so it plays the picks exactly as a picks-only build
#          would, and a resumed screen never meets a different jar), c, aa x 12 fresh seeds from 8800; the gate (mq minus pooled c and aa over the
#          picks / 1,217 pairings at +0.02 APS, 95% low end above 0) and every pick's difference. Claude writes the
#          holders into mimicOns() from the results PR; nothing ships from the card itself.
# Stop rules (docs/bench/watch.md): halt on 30 failed battles, an arm scoring nothing in 8, 60+ skipped turns a battle
# over the last 200, or no battle in 30 minutes; every battle fought is kept and a rerun resumes. The confirm has 12 or
# fewer robots at most, so it carries the halt rules only. prep2 first clears any confirm reports an earlier
# run left, so with no picks confirm and gate pass straight through and the PR carries this run's screen only. ALERT opens an issue for Leigh on any stop.

set V = 3.22
set P = --parallel 12 --no-truth-log
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant 1488498 --child-heap 2G
set W = work/mimic-wide
set W2 = work/mimic-wide2
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && MIMIC_ON=plans/mimic-wide.list bash ./build-ablation.sh mmlist && test -f bisect/hadur117.Hadur_${V}mq.jar && ./fetch-opponents.sh --set panel-mimic-wide.txt && mvn -q compile

screen | ./bench-top20.sh ${C} ${P} --set panel-mimic-wide.txt --seeds 8 --seed-base 8600 --arms plans/mimic-wide.arms --out ${W} --label mimic-wide --shuffle-jobs
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m
  stop: aa after 20%
  stop: futility mq below 0.01 after 20%

pick | python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_mimic-wide-screen.md && python3 ../data/tools/mode_table.py ${W}/arms.tsv --margin 3 --out-tsv ${OUT}/mimic-wide-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_mimic-wide-pick.md && python3 tools/per_robot.py ${W}/arms.tsv --arms mq --out ${OUT}/$(date +%Y-%m-%d)_mimic-wide-per-robot.md --out-tsv ${OUT}/mimic-wide-per-robot.tsv
  after: screen

prep2 | rm -f ${OUT}/*_mimic-wide2*.md ${OUT}/mimic-wide2-per-robot.tsv work/panel-mimic-wide-picks.txt && if [ ! -s ${OUT}/mimic-wide-pick.tsv ]; then echo 'no picks: confirm and gate skip'; exit 0; fi && python3 tools/pick_panel.py ${OUT}/mimic-wide-pick.tsv panel-mimic-wide.txt work/panel-mimic-wide-picks.txt
  after: pick

confirm | if [ ! -s work/panel-mimic-wide-picks.txt ]; then echo 'no picks'; exit 0; fi && ./bench-top20.sh ${C} ${P} --set work/panel-mimic-wide-picks.txt --seeds 12 --seed-base 8800 --arms plans/mimic-wide.arms --out ${W2} --label mimic-wide2 --shuffle-jobs
  after: prep2
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m

gate | if [ ! -s work/panel-mimic-wide-picks.txt ]; then echo 'no picks'; exit 0; fi && python3 ../data/tools/multiarm.py ${W2}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_mimic-wide2.md && python3 tools/shield_s2.py gate ${W2}/arms.tsv --arm mq --panel work/panel-mimic-wide-picks.txt --bar 0.02 --out ${OUT}/$(date +%Y-%m-%d)_mimic-wide2-gate.md && python3 tools/per_robot.py ${W2}/arms.tsv --arms mq --out ${OUT}/$(date +%Y-%m-%d)_mimic-wide2-per-robot.md --out-tsv ${OUT}/mimic-wide2-per-robot.tsv
  after: confirm

pr | bash tools/open_results_pr.sh claude/pc-mimic-wide-results "1v1 learning-gun mimics per opponent: the next 36 learners, screen and confirm" ${OUT}/*_mimic-wide*.md $(find ${OUT} -maxdepth 1 -name 'mimic-wide*.tsv' -size +0c)
  after: gate
