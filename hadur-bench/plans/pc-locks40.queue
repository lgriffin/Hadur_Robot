# 1v1, cloud locks to the PC (BENCH-253), round 40: 48 fresh seeds at the live turn time.
# Round 40 carries 4 robots, each read on 12 or more fresh cloud seeds against both c and aa, gain vs mean(c, aa)
# (coverage/shards/locks.tsv):
#   fgp (POW-21 fire gap, #1119)  BeepBoop +12.2 +- 4.0 (12 at the live constant; vs c +12.6, vs aa +11.8; share 33 vs 21,
#                                 firsts 17.5 vs 2.0): after round 0 both sides fire ~0.11 power for 7,500-tick rounds and
#                                 both hit under 1/7, so each shot costs its shooter energy; BeepBoop never stops firing, so
#                                 holding 45 ticks between our real shots wins the energy race (gap in plans/fire-gap-lines.txt)
#   zl (SHIELD-20 still plans)    AlphaDragon +1.95 +- 0.28 (12) and +2.98 +- 0.76 on a second box (12)
#   gl (gun stack)                Gaff +2.96 +- 2.34 (24, two blocks) and +2.50 +- 2.10 on a second box (12)
#   pb (POW-20 bands, on rp)      Identity +2.10 +- 1.30 (36), BB-fitted bands 0.74 1.18 0.98 0.95 on top of its race power
# DrussGT, ScalarR, Saguaro, Wavelet, Knight, JKHydra, Shadow and Diamond pad the A/A check to 12 robots on arm aa. The PC
# reads 48 fresh seeds from 120000 and a line ships only on the PC's own read.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: each line names one robot; every other robot, team and melee play bit for bit as master.
#   - Diagnosis: BeepBoop wins a low-power energy race we lose by firing too often; AlphaDragon's gun punishes our movement
#     where still plans keep the shield on; Gaff's gun is beaten by the stacked gun; Identity out-lasts us in an energy race
#     that race power narrowed and the fitted bands close further.
#   - Every line read positive against both controls on fresh cloud seeds; BeepBoop's only at the live turn time (0.7x
#     hides it), which is what this card runs.
#
# Stop rules (docs/bench/watch.md): no aa stop rule (aa is read in the gate). Each bench step halts on 30 failed
# battles, an arm scoring nothing in 8, 60+ skipped turns a battle over the last 24 or no battle in 30 minutes. The
# live-match step stops the card if the PC no longer scores us and BeepBoop as live does (tools/live_match.py exit 3).
# ALERT opens an issue for Leigh on any stop.
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live, in its
#              own folder (work/pc-locks40-livematch)
#   lock       panel-locks40.txt  c / aa, 48 fresh seeds from 120000, --cpu-constant live, in work/pc-locks40-ctl
#   stage      writes each lever's two-arm file (c and the lever) and copies in, times kept, the c battles of that lever's
#              own robots, so the bench reads them back (BENCH-95)
#   lock-X     each lever arm on its own picked robots only, same seeds, in work/pc-locks40-X
#   gate       each robot judged on its own lever arm only (lock_prep.py --restrict); it keeps its line where the 95% low
#              end is above 0 (mode_table.py --margin 0)
# Leigh starts it once the PC is free:
#   git checkout master && git pull
#   .\queue.ps1 run pc-locks40
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. 124 live-match battles and 1344 lock battles (12
# robots in c and aa = 1152, each lever robot again on its own arm = 192, 48 seeds): 1468 in all. BeepBoop rounds run
# long (~7,500 ticks), so allow 3 to 4 hours.
# The prep step stops if any panel robot's jar is missing.
#
set V = 3.25.1
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-locks40
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && python3 tools/lock_prep.py plans/locks40-pick.tsv panel-locks40.txt plans/pc-locks40.arms ${W}-prep && bash ${W}-prep/build.sh && for a in fgp zl gl pb; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; awk -F"\t" -v a=$a '$2 == a {print $1 " |"}' plans/locks40-pick.tsv > ${W}-prep/$a.names && grep -F -f ${W}-prep/$a.names panel-locks40.txt > ${W}-prep/$a.panel && grep "^$a |" ${W}-prep/lock.arms > ${W}-prep/$a.arms || exit 1; done && grep -E "^(c|aa) [|]" ${W}-prep/lock.arms > ${W}-prep/ctl.arms && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-locks40.txt && for j in $(grep -hv "^#" panel-locks40.txt | cut -d"|" -f3); do test -f opponents/$j || { echo "missing jar $j"; exit 1; }; done && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out ${W}-livematch --label pc-locks40-livematch --shuffle-jobs && python3 tools/live_match.py ${W}-livematch/arms.tsv --out ${OUT}/pc-locks40-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock | ./bench-top20.sh ${C} ${P} --set panel-locks40.txt --seeds 48 --seed-base 120000 --arms ${W}-prep/ctl.arms --out ${W}-ctl --label pc-locks40 --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

stage | for a in fgp zl gl pb; do grep -E "^(c|$a) [|]" ${W}-prep/lock.arms > ${W}-prep/$a-c.arms && mkdir -p ${W}-$a/battles || exit 1; for s in $(grep -v "^#" ${W}-prep/$a.panel | cut -d"|" -f1 | sed -E "s/^ +| +$//g; s/[^A-Za-z0-9.]+/_/g"); do cp -rp ${W}-ctl/battles/$s-*-c ${W}-$a/battles/ || exit 1; done; done
  after: lock

lock-fgp | ./bench-top20.sh ${C} ${P} --set ${W}-prep/fgp.panel --seeds 48 --seed-base 120000 --arms ${W}-prep/fgp-c.arms --out ${W}-fgp --label pc-locks40-fgp --shuffle-jobs
  after: stage
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-zl | ./bench-top20.sh ${C} ${P} --set ${W}-prep/zl.panel --seeds 48 --seed-base 120000 --arms ${W}-prep/zl-c.arms --out ${W}-zl --label pc-locks40-zl --shuffle-jobs
  after: lock-fgp
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-gl | ./bench-top20.sh ${C} ${P} --set ${W}-prep/gl.panel --seeds 48 --seed-base 120000 --arms ${W}-prep/gl-c.arms --out ${W}-gl --label pc-locks40-gl --shuffle-jobs
  after: lock-zl
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-pb | ./bench-top20.sh ${C} ${P} --set ${W}-prep/pb.panel --seeds 48 --seed-base 120000 --arms ${W}-prep/pb-c.arms --out ${W}-pb --label pc-locks40-pb --shuffle-jobs
  after: lock-gl
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

gate | mkdir -p ${W} && (cat ${W}-ctl/arms.tsv && for d in fgp zl gl pb; do awk -F"\t" -v a=$d 'NR > 1 && $1 == a' ${W}-$d/arms.tsv || exit 1; done) > ${W}/arms.tsv && python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks40-lock.md && python3 tools/lock_prep.py --restrict ${W}/arms.tsv ${W}-prep ${W}/arms-picked.tsv && python3 ../data/tools/mode_table.py ${W}/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-locks40-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks40-lock-pick.md && python3 tools/per_robot.py ${W}/arms-picked.tsv --arms fgp zl gl pb --out ${OUT}/$(date +%Y-%m-%d)_pc-locks40-lock-per-robot.md --out-tsv ${OUT}/pc-locks40-lock-per-robot.tsv
  after: lock-pb

pr | bash tools/open_results_pr.sh claude/pc-locks40-results "1v1 cloud locks, round 40 (4 lines on fgp, zl, gl, pb; BeepBoop fire gap), 48 fresh PC seeds" ${OUT}/pc-locks40-livematch.md ${OUT}/*_pc-locks40-*.md ${OUT}/pc-locks40-lock-per-robot.tsv $(find ${OUT} -maxdepth 1 -name 'pc-locks40-lock-pick.tsv' -size +0c)
  after: gate
