# What Firestarter (2nd) and Combat (3rd) do differently against the 14 mid teams that cost us 2.1 APS
# (docs/plan-team-top5.md section 10). Each is benched as the subject team against team-mid14.txt on
# the seeds pc-team-lane used (base 4100), 6 seeds, no baseline: 2 x 84 battles, about 15 min at 12
# workers. tools/team_losses.py then reads them beside HadurTeam's pc-team-lane A/A logs and writes
# docs/bench/local/team-compare.md. The team thread reads claude/pc-team-compare-results.
#   ./queue.sh run pc-team-compare        (or  .\queue.ps1 run pc-team-compare)
# Run it from master (one bench queue at a time).

set OUT = ../docs/bench/local

tcprep  | git checkout -q master && rm -f ../docs/bench/local/team-compare*.md && ./fetch-opponents.sh --set team-mid14.txt && ./fetch-opponents.sh --set team-census46.txt && mvn -q compile
tcfire  | mvn -q exec:java "-Dexec.args=@plans/team-compare-fire.args"
  after: tcprep
tccomb  | mvn -q exec:java "-Dexec.args=@plans/team-compare-combat.args"
  after: tcfire
tcread  | V=$(sed -n 's:.*<robot.release>\(.*\)</robot.release>.*:\1:p' ../hadur-robot/pom.xml) && test -d work/team-lane-"$V"-bb/battles && { python3 tools/team_losses.py --title "HadurTeam (pc-team-lane A/A)" work/team-lane-"$V"-bb && python3 tools/team_losses.py --ours "cb.fire.Firestarter " --title "FirestarterTeam against the mid 14" work/team-compare-fire && python3 tools/team_losses.py --ours "mn.Combat " --title "CombatTeam against the mid 14" work/team-compare-combat; } > ../docs/bench/local/team-compare.md
  after: tccomb
tcpr    | bash tools/open_results_pr.sh claude/pc-team-compare-results "Firestarter and Combat against the mid 14 (team-compare)" ${OUT}/team-compare*.md
  after: tcread
