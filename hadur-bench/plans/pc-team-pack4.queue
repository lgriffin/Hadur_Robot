# battle: team
# Team: four per-team table lines from the 2026-11-24 mode matrix (TMODE-60, TMODE-45, BENCH-279).
# Team thread: team-only, duel and melee untouched (table lines only, no new code).
#   aa      the baseline (master); bb its A/A copy
#   p4      tmtab with plans/team-pack4-table.java: NEAR (hunt place 150 px, not 250) added to both NightmareTeam
#           member classes, and QUARTERS added against Polylunar (five member classes on the default modes),
#           TeamDeathTeam (default modes) and ImpactTeam (its shipped entry)
# Every other pairing plays the same code as aa, so the card fights only the four teams (plans/team-pack4-set.txt)
# and spreads their gain over the 47 TeamRumble pairings.
# Pilot: p4 on the four teams, 8 fresh seeds from 45000, 12 rounds, paired with aa. A projected team APS change
#   under -0.15 stops the card there (team_modes.py gate --stop-below), and the PR carries the pilot. The bar is
#   below zero because an 8-seed pilot's interval is about +-0.2: it stops clear harm, not noise.
# Screen: bb and p4 against aa on the four teams, 24 fresh seeds from 45100, 12 rounds; p4 is gated at +0.10 APS with
#   the 95% low end above zero over 47 pairings, scored against both baselines.
# Why it should win: the matrix screened every single-mode toggle the table offers on the 22 lowest-share teams
#   (186 cells, 6 fresh cloud seeds each beside a master baseline on the same seeds) and re-ran every lean on fresh
#   seeds; these four are the cells that kept a 95% low end above zero, score share points, 10 rounds.
#   NightmareTeam with NEAR +3.3 +- 1.7 on 48 seeds (the last 24 alone +3.3 +- 2.4): its members close on us anyway,
#   and from the nearer place our guns gain more than theirs. Polylunar with QUARTERS +3.3 +- 1.8 on 48 seeds (the
#   last 24 alone +2.7 +- 2.5): the member a chaser drives at keeps the far rings to flee to; stacking OWN or
#   dropping PATH on top added nothing. TeamDeathTeam with QUARTERS +1.4 +- 1.2 on 24 seeds and ImpactTeam with
#   QUARTERS +1.4 +- 1.4 on 24 seeds are marginal, and this card is their extra seeds. About +0.20 APS over 47
#   pairings. Left out as not held on fresh seeds: QUARTERS against HOFSwarm, PhoenixTeam and OmegaSquad, NEAR
#   against OgiTeam, AlephTeam and Mamba, OWN against OgiTeam.
# Size: pilot 64 battles, screen 2 x 192: about 450 battles, about 25 minutes at the team rate. Every step resumes
#   where it stopped.
# Stop rules on every battle step (halt; every battle fought is kept and a rerun resumes): 10 failed battles, no
# battle in 30 minutes, or 60+ skipped turns a battle over the last 200.
# The team thread reads claude/pc-team-pack4-results.
#   ./queue.sh run pc-team-pack4        (or  .\queue.ps1 run pc-team-pack4)
# Run it from master (one bench queue at a time, RoboRumble workers at 0):
#   git checkout master && git pull

set OUT = ../docs/bench/local
set ALERT = lgriffin
set T = python3 tools/team_modes.py

tkprep | git checkout -q master && V=$(sed -n 's:.*<robot.release>\(.*\)</robot.release>.*:\1:p' ../hadur-robot/pom.xml) && test -n "$V" && for a in aa bb p4; do rm -f bisect/hadur117.HadurTeam_"$V"$a.jar; done && rm -f ${OUT}/team-pack4-p*.md ${OUT}/team-pack4-bb.md ${OUT}/team-pack4-p4.md ${OUT}/team-pack4-verdict.md && mkdir -p work && rm -rf work/team-pack4-"$V"-* && rm -f work/team-pack4-*.args work/team-pack4-go && ./fetch-opponents.sh --set plans/team-pack4-set.txt && bash ./build-ablation.sh aa && bash ./build-ablation.sh bb && TEAM_MODE_TABLE="$(pwd)/plans/team-pack4-table.java" TEAM_MODE_SUFFIX=p4 bash ./build-ablation.sh tmtab && sed -e "s/@V@/$V/g" plans/team-pack4-pilot.args > work/team-pack4-pep.args && for a in bb p4; do sed -e "s/@V@/$V/g" -e "s/@A@/$a/g" plans/team-pack4-screen.args > work/team-pack4-$a.args || exit 1; done && for a in aa bb p4; do test -f bisect/hadur117.HadurTeam_"$V"$a.jar || exit 1; done && mvn -q compile
tkpp4 | mvn -q exec:java "-Dexec.args=@work/team-pack4-pep.args"
  after: tkprep
  watch: battles=64
  stop: fails 10
  stop: stall 30m
  stop: skips 60 over 200
tkpilot | ${T} gate --report ${OUT}/team-pack4-pep.md --set plans/team-pack4-set.txt --seeds 8 --teams 47 --min-aps 0 --stop-below=-0.15 --out-md ${OUT}/team-pack4-pilot.md && touch work/team-pack4-go || test $? -eq 3 || exit 1
  after: tkpp4
tkbb | if [ -f work/team-pack4-go ]; then mvn -q exec:java "-Dexec.args=@work/team-pack4-bb.args"; else echo "p4 under -0.15 on the pilot: no screen"; fi
  after: tkpilot
  watch: battles=192
  stop: fails 10
  stop: stall 30m
  stop: skips 60 over 200
tkp4 | if [ -f work/team-pack4-go ]; then mvn -q exec:java "-Dexec.args=@work/team-pack4-p4.args"; else echo "p4 under -0.15 on the pilot: no screen"; fi
  after: tkbb
  watch: battles=192
  stop: fails 10
  stop: stall 30m
  stop: skips 60 over 200
tkgate | if [ -f work/team-pack4-go ]; then ${T} gate --report ${OUT}/team-pack4-p4.md --control ${OUT}/team-pack4-bb.md --set plans/team-pack4-set.txt --seeds 24 --teams 47 --min-aps 0.10 --out-md ${OUT}/team-pack4-verdict.md || exit 1; else echo "no screen"; fi
  after: tkp4
tkpr | bash tools/open_results_pr.sh claude/pc-team-pack4-results "Team: NEAR against NightmareTeam, QUARTERS against three teams (TMODE-60, TMODE-45)" $(ls ${OUT}/team-pack4-*.md 2>/dev/null | grep -v smoke)
  after: tkgate
