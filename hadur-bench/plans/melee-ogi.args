3196
--rounds
35
--parallel
@C@
--child-heap
2G
--cpu-constant
auto
--robot-jar
bisect/hadur117.Hadur_@V@@A@.jar
--robot
hadur117.Hadur @V@@A@
--out
work/melee-ogi-@V@-@A@
