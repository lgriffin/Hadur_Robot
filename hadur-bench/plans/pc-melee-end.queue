# The endgame duel in melee (docs/bench/melee-top3.md, HAND-4, HAND-5, BENCH-171).
# Leigh 2026-11-02 14:44 chose "Melee gun data in the endgame". Live 3.21 is 7th in melee (69.47),
# 1.98 APS behind 3rd; survival is 18-20 points lower than Firestarter's in every band. The 1.11.2
# cloud census of 3.21 found 21% of rounds lost in the endgame duel, fought at a median 694 px with a
# 14% hit rate (40% in the crowd), and only 43% won against top-10 survivors even when ahead on energy.
# Two switches, each read only after a melee hand-off (charter MELEE, no team link, one enemy left),
# so the 1v1 and the team never see them:
#   aa      the baseline (master)
#   bb      its A/A copy
#   eg      emgun, HAND-5: in the endgame duel the melee field gun (the kNN that watched the
#           survivor all battle) aims and fires whenever it has learned the survivor; the duel
#           keeps its movement, and its own gun aims while the field gun has not learned.
#           Cloud smoke (56 paired battles, seeds 4300-01): duel wins 69.0 -> 71.7%, vs top-10
#           survivors 21.3 -> 26.0%, APS -0.13 +- 0.50. Too noisy to call, hence the card.
#   ek      eclose, HAND-4: the endgame duel opens at 400 px instead of the 650 stranger ceiling.
#           Cloud smoke (58 paired battles, seeds 4200-01): distance 690 -> 575 px, hit rates
#           unchanged, APS +0.12 +- 0.51. Read here for the record at six seeds, beside eg.
# Each build fights the 46 census fields x 6 fresh seeds alone (3265-3270, after pc-melee-hand's
# 3259-3264; 276 battles, 1,104 in all, about 1.8 h at ~620 battles/h) at the machine's melee width
# and CPU constant. The read pairs bb with aa (A/A, within +-0.25) and each arm with the mean of aa
# and bb (--base2), battle for battle; the arm reports' "Rounds that ended as a duel" tables say
# where an arm's endgame wins moved.
# Verdict: an arm passes with its 95% low end above 0 (--gain 0, the melee gate since 2026-10-31),
# Hadur's share of others outlived no more than 1 point lower and the 1-30 endgame wins no more than
# 3 points lower; if its skipped turns a battle rise more than 20% over aa's it fails whatever its
# APS (read from the arm reports). The card ends in a results PR on claude/pc-melee-end-results
# whatever the verdict; the melee thread reads it.
#   ./queue.sh run pc-melee-end        (or  .\queue.ps1 run pc-melee-end)
# Run it from master, one bench queue at a time:
#   git checkout master && git pull
# haprep reads the version from hadur-robot/pom.xml, so a bump cannot point the card at stale
# jars, and fixes the width and version in work/, so a resumed card never mixes host profiles or
# reads another version's battles. Prep clears the arms' battle folders, since it rebuilds their jars.
# Stop rules (docs/bench/watch.md), halts only, each keeping every battle fought: fails 20 and
# stall 30m on each arm (each arm is its own single-arm step, so `dead` cannot be read). A halt
# leaves that arm's remaining battles (up to 276) and every later arm unrun (up to 828 if aa
# halts); the cause is fixed and the card resumed, and the halted arm refights all its 276
# battles (a single-arm run does not read back a stopped run's; up to ~27 min). No futility or
# skips rule: the paired read needs the baselines whole, and melee skips are read from the arm
# reports against aa's.

set OUT = ../docs/bench/local

meprep | git checkout -q master && V=$(sed -n 's:.*<robot.release>\(.*\)</robot.release>.*:\1:p' ../hadur-robot/pom.xml) && test -n "$V" && C=${MELEE_WORKERS} && for a in aa bb eg ek; do rm -f bisect/hadur117.Hadur_"$V"$a.jar; done && bash ./build-ablation.sh aa && bash ./build-ablation.sh bb && bash ./build-ablation.sh emgun && bash ./build-ablation.sh eclose && mkdir -p work && rm -rf work/melee-end-"$V"-aa work/melee-end-"$V"-bb work/melee-end-"$V"-eg work/melee-end-"$V"-ek && echo "$V" > work/melee-end.version && for a in aa bb eg ek; do test -f bisect/hadur117.Hadur_"$V"$a.jar && sed -e "s/@V@/$V/g" -e "s/@A@/$a/g" -e "s/@C@/$C/g" plans/melee-end.args > work/melee-end-$a.args || exit 1; done && rm -f ${OUT}/melee-end-*.md && for f in melee-census-317/f*.txt; do ./fetch-opponents.sh --set "$f" || exit 1; done && mvn -q compile
meaa   | mvn -q exec:java "-Dexec.args=@work/melee-end-aa.args"
  after: meprep
  watch: battles=276
  stop: fails 20
  stop: stall 30m
mebb   | mvn -q exec:java "-Dexec.args=@work/melee-end-bb.args"
  after: meaa
  watch: battles=276
  stop: fails 20
  stop: stall 30m
meeg   | mvn -q exec:java "-Dexec.args=@work/melee-end-eg.args"
  after: mebb
  watch: battles=276
  stop: fails 20
  stop: stall 30m
meek   | mvn -q exec:java "-Dexec.args=@work/melee-end-ek.args"
  after: meeg
  watch: battles=276
  stop: fails 20
  stop: stall 30m
meread | V=$(cat work/melee-end.version) && test -n "$V" && W=work/melee-end-"$V" && { python3 tools/melee_s0.py screen "$W"-aa --base2 "$W"-bb --arm bb="$W"-bb --arm eg="$W"-eg --arm ek="$W"-ek --census melee-census-317.txt --seeds 6 --gain 0 --survival-slack 1 --out ${OUT}/melee-end-read.md --title "The endgame duel switches on $V" || true; } && test -s ${OUT}/melee-end-read.md
  after: meek
mepr   | bash tools/open_results_pr.sh claude/pc-melee-end-results "The endgame duel switches (HAND-4, HAND-5)" ${OUT}/melee-end-read.md $(ls ${OUT}/melee-end-aa.md ${OUT}/melee-end-bb.md ${OUT}/melee-end-eg.md ${OUT}/melee-end-ek.md 2>/dev/null)
  after: meread
