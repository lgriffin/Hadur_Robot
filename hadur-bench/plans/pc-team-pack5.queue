# battle: team
# Team: one per-team table line from the 2026-11-26 cloud lock (TMODE-59, BENCH-296).
# Team thread: team-only, duel and melee untouched (a table line only, no new code).
#   aa      the baseline (master); bb its A/A copy
#   p5      tmtab with plans/team-pack5-table.java: TIGHT (the tight pack, hunt pull 1.0) added to FirestarterTeam's
#           shipped entry; nothing else in the entry changes
# Every other pairing plays the same code as aa, so the card fights only FirestarterTeam (plans/team-pack5-set.txt)
# and spreads its gain over the 47 TeamRumble pairings.
# Pilot: p5 on FirestarterTeam, 12 fresh seeds from 45200, 12 rounds, paired with aa. A projected team APS change
#   under -0.10 stops the card there (team_modes.py gate --stop-below), and the PR carries the pilot. The bar is
#   below zero because a 12-seed pilot's interval on one team is about +-0.1 APS: it stops clear harm, not noise.
# Screen: bb and p5 against aa on FirestarterTeam, 48 fresh seeds from 45300, 12 rounds; p5 is gated at +0.05 APS
#   with the 95% low end above zero over 47 pairings, scored against both baselines.
# Why it should win: FirestarterTeam is third in TeamRumble and one of our lowest shares. Its members spread wide
#   and each of ours that hunts alone meets two or three of their guns; packed tight, ours arrive together and the
#   first target falls sooner, which is how the tight pack already pays against five other teams. On the cloud,
#   paired with master on the same seeds, 10 rounds, score share points: a 12-seed screen +4.0 +- 4.6 (rounds
#   won in 12 of 12 battles against 10 of 12), then a lock on 12 fresh seeds +5.1 +- 4.6 (11 of 12 against 10 of
#   12). About +0.10 APS over 47 pairings. The same screen closed LAST off (-3.0 +- 5.5) and CLOSE off
#   (-4.5 +- 5.5) for this team, and TIGHT against CombatTeam did not hold over 24 fresh seeds (+1.3 +- 2.7), so
#   it is left out.
# Size: pilot 24 battles, screen 2 x 96: about 220 battles, about 15 minutes at the team rate. Every step resumes
#   where it stopped.
# Stop rules on every battle step (halt; every battle fought is kept and a rerun resumes): 10 failed battles, no
# battle in 30 minutes, or 60+ skipped turns a battle over the last 200.
# The team thread reads claude/pc-team-pack5-results.
#   ./queue.sh run pc-team-pack5        (or  .\queue.ps1 run pc-team-pack5)
# Run it from master (one bench queue at a time, RoboRumble workers at 0):
#   git checkout master && git pull

set OUT = ../docs/bench/local
set ALERT = lgriffin
set T = python3 tools/team_modes.py

tkprep | git checkout -q master && V=$(sed -n 's:.*<robot.release>\(.*\)</robot.release>.*:\1:p' ../hadur-robot/pom.xml) && test -n "$V" && for a in aa bb p5; do rm -f bisect/hadur117.HadurTeam_"$V"$a.jar; done && rm -f ${OUT}/team-pack5-p*.md ${OUT}/team-pack5-bb.md ${OUT}/team-pack5-p5.md ${OUT}/team-pack5-verdict.md && mkdir -p work && rm -rf work/team-pack5-"$V"-* && rm -f work/team-pack5-*.args work/team-pack5-go && ./fetch-opponents.sh --set plans/team-pack5-set.txt && bash ./build-ablation.sh aa && bash ./build-ablation.sh bb && TEAM_MODE_TABLE="$(pwd)/plans/team-pack5-table.java" TEAM_MODE_SUFFIX=p5 bash ./build-ablation.sh tmtab && sed -e "s/@V@/$V/g" plans/team-pack5-pilot.args > work/team-pack5-pep.args && for a in bb p5; do sed -e "s/@V@/$V/g" -e "s/@A@/$a/g" plans/team-pack5-screen.args > work/team-pack5-$a.args || exit 1; done && for a in aa bb p5; do test -f bisect/hadur117.HadurTeam_"$V"$a.jar || exit 1; done && mvn -q compile
tkpp5 | mvn -q exec:java "-Dexec.args=@work/team-pack5-pep.args"
  after: tkprep
  watch: battles=24
  stop: fails 10
  stop: stall 30m
  stop: skips 60 over 200
tkpilot | ${T} gate --report ${OUT}/team-pack5-pep.md --set plans/team-pack5-set.txt --seeds 12 --teams 47 --min-aps 0 --stop-below=-0.10 --out-md ${OUT}/team-pack5-pilot.md && touch work/team-pack5-go || test $? -eq 3 || exit 1
  after: tkpp5
tkbb | if [ -f work/team-pack5-go ]; then mvn -q exec:java "-Dexec.args=@work/team-pack5-bb.args"; else echo "p5 under -0.10 on the pilot: no screen"; fi
  after: tkpilot
  watch: battles=96
  stop: fails 10
  stop: stall 30m
  stop: skips 60 over 200
tkp5 | if [ -f work/team-pack5-go ]; then mvn -q exec:java "-Dexec.args=@work/team-pack5-p5.args"; else echo "p5 under -0.10 on the pilot: no screen"; fi
  after: tkbb
  watch: battles=96
  stop: fails 10
  stop: stall 30m
  stop: skips 60 over 200
tkgate | if [ -f work/team-pack5-go ]; then ${T} gate --report ${OUT}/team-pack5-p5.md --control ${OUT}/team-pack5-bb.md --set plans/team-pack5-set.txt --seeds 48 --teams 47 --min-aps 0.05 --out-md ${OUT}/team-pack5-verdict.md || exit 1; else echo "no screen"; fi
  after: tkp5
tkpr | bash tools/open_results_pr.sh claude/pc-team-pack5-results "Team: TIGHT against FirestarterTeam (TMODE-59)" $(ls ${OUT}/team-pack5-*.md 2>/dev/null | grep -v smoke)
  after: tkgate
