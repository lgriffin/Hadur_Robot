melee-census-317.txt
--seeds
1
--seed-base
3330
--rounds
20
--parallel
@C@
--child-heap
2G
--cpu-constant
auto
--melee-trace
true
--robot-jar
bisect/hadur117.Hadur_@V@aa.jar
--robot
hadur117.Hadur @V@aa
--out
work/melee-states-@V@
