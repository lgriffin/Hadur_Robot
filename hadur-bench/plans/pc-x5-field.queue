# 1v1, per robot over the whole field: the gun hides its bullet speed from round-matching surfers (POW-16) and the
# rammer escape dodges harder (RAM-6), each screened on every robot of census-312.txt (BENCH-197; Leigh 2026-11-05:
# "both a movement and a gun approach", and a tailored setting for every robot, not a shortlist). Leigh starts it
# once the PC is free (not beside another card):
#   git checkout master && git pull
#   .\queue.ps1 run pc-x5-field        (or  ./queue.sh run pc-x5-field)
# One bench queue, RoboRumble workers at 0, unpinned, 12 workers, truth log off. Every step resumes; no step needs a
# decision. Size: screen 1,212 robots x 3 arms (c, x5, rd) x 2 seeds = 7,272 battles, ~11 h at the ~650 battles/h
# recent cards ran; its first 78 battles are the pilot (~7 min); confirm = the picks x 3 arms x 4 seeds, ~2-3 h.
#
# Why it should win (Leigh's card rule, 2026-11-03):
#   - Per-opponent tailoring on every robot, both halves: each robot is fought with the gun line (POW-16) and with the
#     movement line (RAM-6) and keeps the one its own battles pick, or neither. No shortlist decides who is tried.
#   - Gun, the mechanism is measured: BeepBoop and Saguaro hit GeneralPatton, Durandal, Sparse, Athena and Pantheist
#     with ~60% of their shots against Hadur's 6-18%, because those robots never change direction against them. An
#     instrumented GeneralPatton logs 0 of 78 BeepBoop hits (each bullet's speed, read from BeepBoop's energy drop,
#     rounds to another tenth than the bullet's own: Math.round(speed * 10) on an x.x5 power) and so never learns;
#     against 3.21 it logs 28 of 60 and surfs. POW-16 picks, shot by shot, the x.x5 power at or below the gun's whose
#     read-back speed rounds apart: GeneralPatton then logs 0 of 72 Hadur hits. Cloud smoke, 7 names x 3 seeds:
#     Durandal +16.6, Sparse +14.4, Athena +5.9, GeneralPatton +4.9, NewBGank +2.9, Pantheist -1.2, SMG -2.7.
#     A bytecode scan finds 46 robots with the rounding (panel-x5.txt), but robots that obfuscate or match waves
#     another way are only found by fighting them, so the whole field is screened.
#   - Movement: point-blank rammer shots hit Hadur 56% of the time and BeepBoop 22% (truth logs, 6 rammers); RAM-6's
#     400 px shot cost dodges where RAM-5 took the hit: cloud smoke on the 6 x 3 seeds +1.3 a name (RammingC +3.4,
#     Galaxy03 +4.0). It only acts near a rammer, so on the rest of the field it costs nothing and is not picked.
#   - Risk: the gun line costs up to 0.3 power a shot against a robot that does not round; the pick (5-point margin,
#     95% low end above 0) keeps only robots that gain, and the confirm re-measures them on fresh seeds with an A/A arm.
# Pilot (tools/x5_card.py pilot): the 13 smoke names (panel-x5-pilot.txt) at the screen's seeds; the screen runs when
#   x5 gains 2+ points over c on the 7 gun names OR rd gains 1+ on the 6 rammers; otherwise straight to the results PR.
# screen:  census-312.txt x c, x5, rd x 2 seeds from 9300; pick at a 5-point margin (mode_table, ref c).
# confirm: the picks x c, aa, xr (x5 on the x5 picks, rd on the rd picks) x 4 fresh seeds from 9400; gate +0.03 APS.
# Stop rules (docs/bench/watch.md): halt on 30 failed battles, an arm scoring nothing in 8, 60+ skipped turns a battle
# over the last 200, or no battle in 30 minutes; every battle fought is kept and a rerun resumes. ALERT opens an
# issue for Leigh on any stop. Nothing here ships: the confirmed names go into ShieldTableData.x5Powers() and
# ramDodges() by PR; the release rule stands.

set V = 3.21
set P = --parallel 12 --no-truth-log
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant 1488498 --child-heap 2G
set W = work/x5f
set W2 = work/x5f-2
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && rm -f work/x5.stop && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && grep -v '^#' census-312.txt | cut -d'|' -f1 | sed 's/ *$//' | grep . > work/field.list && bash ./build-ablation.sh aa && X5_POWER=work/field.list bash ./build-ablation.sh x5list && RAM_DODGE=work/field.list bash ./build-ablation.sh rdlist && test -f bisect/hadur117.Hadur_${V}x5.jar && test -f bisect/hadur117.Hadur_${V}rd.jar && ./fetch-opponents.sh --set census-312.txt && mvn -q compile

pilot | ./bench-top20.sh ${C} ${P} --set panel-x5-pilot.txt --seeds 2 --seed-base 9300 --arms plans/x5-field.arms --out ${W} --label x5f --shuffle-jobs && python3 tools/x5_card.py pilot ${W}/arms.tsv --names panel-x5-pilot.txt --check x5=panel-x5.txt@2 --check rd=panel-rammers.txt@1 --ref c --out ${OUT}/$(date +%Y-%m-%d)_x5f-pilot.md --stop-file work/x5.stop
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m

screen | if [ -f work/x5.stop ]; then echo 'pilot: no gain on the smoke names, screen skips'; exit 0; fi && ./bench-top20.sh ${C} ${P} --set census-312.txt --seeds 2 --seed-base 9300 --arms plans/x5-field.arms --out ${W} --label x5f --shuffle-jobs
  after: pilot
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m

pick | if [ -f work/x5.stop ]; then exit 0; fi && python3 ../data/tools/multiarm.py ${W}/arms.tsv --census census-312.txt --out ${OUT}/$(date +%Y-%m-%d)_x5f-screen.md && python3 ../data/tools/mode_table.py ${W}/arms.tsv --margin 5 --out-tsv ${OUT}/x5f-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_x5f-pick.md
  after: screen

prep2 | if [ -f work/x5.stop ]; then exit 0; fi && python3 tools/pick_panel.py ${OUT}/x5f-pick.tsv census-312.txt work/panel-x5f-picks.txt && python3 tools/x5_card.py lists ${OUT}/x5f-pick.tsv --x5-out work/x5f-picks.list --rd-out work/rdf-picks.list --abl-out work/x5f-abl.txt --arms-out work/x5f-2.arms --version ${V} && X5_POWER=work/x5f-picks.list RAM_DODGE=work/rdf-picks.list bash ./build-ablation.sh $(cat work/x5f-abl.txt)
  after: pick

confirm | if [ -f work/x5.stop ]; then exit 0; fi && ./bench-top20.sh ${C} ${P} --set work/panel-x5f-picks.txt --seeds 4 --seed-base 9400 --arms work/x5f-2.arms --out ${W2} --label x5f-2 --shuffle-jobs
  after: prep2
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m

gate | if [ -f work/x5.stop ]; then exit 0; fi && python3 ../data/tools/multiarm.py ${W2}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_x5f-2.md && python3 tools/shield_s2.py gate ${W2}/arms.tsv --arm xr --panel work/panel-x5f-picks.txt --bar 0.03 --out ${OUT}/$(date +%Y-%m-%d)_x5f-2-gate.md && python3 ../data/tools/mode_table.py ${W2}/arms.tsv --margin 3 --out-tsv ${OUT}/x5f-2-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_x5f-2-pick.md && python3 tools/per_robot.py ${W2}/arms.tsv --arms xr --out ${OUT}/$(date +%Y-%m-%d)_x5f-2-per-robot.md --out-tsv ${OUT}/x5f-2-per-robot.tsv
  after: confirm

pr | bash tools/open_results_pr.sh claude/pc-x5-field-results "1v1 per robot, whole field: hidden bullet speed (POW-16) and the heavier rammer dodge (RAM-6)" ${OUT}/*_x5f*.md $(find ${OUT} -maxdepth 1 -name 'x5f*.tsv' -size +0c)
  after: gate
