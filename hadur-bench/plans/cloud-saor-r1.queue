# Saor 0.4 rewrite, stage 1: our own movement under the parity gate (docs/plan-saor-first.md 8). Cloud card, 3 workers, no alerts, no PR step.
#   ./queue.sh run cloud-saor-r1
#
# Why: Saor's corner oscillation is Figment's (MeleeSeed's) line for line. MR and MP are Saor's own movement: when a
# leg ends, the least risky of eight candidate points, risk being every live robot's energy (+20) over its squared
# distance, with the point we stand on excluded so the robot keeps moving. MR's candidates are a ring 170 away; MP's
# are the four corners and four edge midpoints, 40 in. Both remember every scanned robot's last position and energy
# by name hash and forget it on its death. Whole-file arms (saor-arms/SaorMR.java, SaorMP.java), javac 1,015 / 969
# B: over the limit, the byte fit comes once a part passes.
# Parity gate: the arm's paired interval over C (0.3) includes 0 and its mean is above -0.25; an arm whose low end is
# above 0 is a gain. AA is the A/A control. MicroMelee census (18 fields of 9) x 6 seeds from 4100, 108 battles an
# arm, about 35 min each on the cloud box. Nothing is uploaded or released.

set MVN = mvn -q -Drobocode.version=1.11.1 compile exec:java
set OUT = ../docs/bench/local
set ARMS = C,AA,MR,MP

prep | (cd .. && mvn -q -DskipTests install -pl saor -am) && ./fetch-opponents.sh --set micromelee-field.txt && SAOR_RUN=r1 bash tools/saor_arms.sh census 6 4100 ${ARMS} && sed -i 's/^12$/3/; s/^2G$/512M/' work/saor-r1/census-*.args

census-C | ${MVN} "-Dexec.args=@work/saor-r1/census-C.args"
  after: prep

census-AA | ${MVN} "-Dexec.args=@work/saor-r1/census-AA.args"
  after: census-C

census-MR | ${MVN} "-Dexec.args=@work/saor-r1/census-MR.args"
  after: census-AA

census-MP | ${MVN} "-Dexec.args=@work/saor-r1/census-MP.args"
  after: census-MR

read | python3 tools/saor_arms.py --work-root work/saor-r1 --arms ${ARMS} --control C > ${OUT}/saor-r1-census.md
  after: census-MP
