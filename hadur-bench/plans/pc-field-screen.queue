# 1v1, field re-screen overnight (BENCH-251): the 93 gap robots of shard E of the 15 Nov field triage (live gap to
# BeepBoop over 1.5 points) where the cloud screened the existing per-robot levers on 3-4 seeds and no lead held its
# 12-seed lock. The PC re-screens them at scale with six levers on 6 seeds, then locks each robot's best lever on 12
# fresh seeds, in one card, to catch leads the short cloud screens missed. Shards A-D run on their own cloud boxes, and
# the shard E thread designs new line types for the same robots; this card covers what no cloud box is screening.
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live
#   screen     93 robots   c / aa / fq / x5 / hl / dg / gl / mq     6 seeds from 35000, --cpu-constant live
#   pick       each robot's best lever at a 3-point margin, 95% low end above 0 (mode_table.py)
#   lock       the picked robots   c / aa / the picked arms, each rebuilt with only its picks   12 fresh seeds from 35100
#   gate       a robot ships its line only where the lock's 95% low end is above 0 (mode_table.py --margin 0)
# Leigh starts it once the PC is free, overnight (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-field-screen        (or  ./queue.sh run pc-field-screen)
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. Every step resumes; no step needs a decision.
# About 4,500 screen battles plus a lock of up to ~1,500; 6 to 9 hours.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: every line names one robot; every other robot, team and melee play bit for bit as master.
#   - The robots carry ~810 live gap points (the most of any open group), and their cloud screens were short: 3-4 seeds
#     read a lever to about +-5 points, so a real 3-point lever can hide there. 6 seeds on the PC halve that noise.
#   - Each robot keeps a line only after 12 fresh seeds with the 95% low end above 0 at the live turn time, the bar
#     every 1v1 line has passed since 13 Nov. Robots that still show nothing are settled as needing a new line type.
# Pilot and stop rules (docs/bench/watch.md): the screen's aa arm halts the card after 20% if master and its copy
# disagree; halt on 30 failed battles, an arm scoring nothing in 8, 60+ skipped turns a battle over the last 200
# (the lock: the last 24, as its panel can be small), or no battle in 30 minutes. The live-match step stops the card
# if the PC no longer scores us and BeepBoop as live does (tools/live_match.py exit 3). ALERT opens an issue on any stop.
# Bank: the owning cloud thread adds the gate's lines on this card's results PR. Nothing is released by the card.
set V = 3.22
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-field-screen
set L = work/pc-field-screen-lock
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && FLAT_ON=plans/field-e-add.txt bash ./build-ablation.sh fllist && X5_POWER=plans/field-e-add.txt bash ./build-ablation.sh x5list && HEAT_JIT=plans/field-e-add.txt bash ./build-ablation.sh hjlist && SHOT_DODGE=plans/field-e-add.txt bash ./build-ablation.sh sdodgelist && GUN_STACK=plans/field-e-add.txt bash ./build-ablation.sh gslist && MIMIC_ON=plans/field-e-add.txt bash ./build-ablation.sh mmlist && for a in fq x5 hl dg gl mq; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; done && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-field-e.txt && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out work/pc-livematch-rel-live --label pc-field-screen-livematch --shuffle-jobs && python3 tools/live_match.py work/pc-livematch-rel-live/arms.tsv --out ${OUT}/pc-field-screen-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

screen | ./bench-top20.sh ${C} ${P} --set panel-field-e.txt --seeds 6 --seed-base 35000 --arms plans/pc-field-screen.arms --out ${W} --label pc-field-screen --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m
  stop: aa after 20%

pick | python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-field-screen-screen.md && python3 ../data/tools/mode_table.py ${W}/arms.tsv --margin 3 --out-tsv ${OUT}/pc-field-screen-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-field-screen-pick.md && python3 tools/per_robot.py ${W}/arms.tsv --arms fq x5 hl dg gl mq --out ${OUT}/$(date +%Y-%m-%d)_pc-field-screen-per-robot.md --out-tsv ${OUT}/pc-field-screen-per-robot.tsv && python3 tools/lock_prep.py ${OUT}/pc-field-screen-pick.tsv panel-field-e.txt plans/pc-field-screen.arms ${L}-prep && bash ${L}-prep/build.sh
  after: screen

lock | if [ -s ${L}-prep/picks-panel.txt ]; then ./bench-top20.sh ${C} ${P} --set ${L}-prep/picks-panel.txt --seeds 12 --seed-base 35100 --arms ${L}-prep/lock.arms --out ${L} --label pc-field-screen-lock --shuffle-jobs; fi
  after: pick
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

gate | if [ -s ${L}-prep/picks-panel.txt ]; then python3 ../data/tools/multiarm.py ${L}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-field-screen-lock.md && python3 tools/lock_prep.py --restrict ${L}/arms.tsv ${L}-prep ${L}/arms-picked.tsv && python3 ../data/tools/mode_table.py ${L}/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-field-screen-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-field-screen-lock-pick.md && python3 tools/per_robot.py ${L}/arms-picked.tsv --arms $(grep -v '^#' ${L}-prep/lock.arms | cut -d'|' -f1 | grep -v -w -e c -e aa | tr -d ' ' | tr '\n' ' ') --out ${OUT}/$(date +%Y-%m-%d)_pc-field-screen-lock-per-robot.md --out-tsv ${OUT}/pc-field-screen-lock-per-robot.tsv; fi
  after: lock

pr | bash tools/open_results_pr.sh claude/pc-field-screen-results "1v1 field re-screen: six levers on the 93 shard-E gap robots, the best per robot locked on 12 fresh seeds" ${OUT}/pc-field-screen-livematch.md ${OUT}/*_pc-field-screen-*.md ${OUT}/pc-field-screen-*-per-robot.tsv $(find ${OUT} -maxdepth 1 -name 'pc-field-screen-*pick.tsv' -size +0c)
  after: gate
