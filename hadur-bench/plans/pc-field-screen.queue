# 1v1, field screen round 2 (BENCH-251): the per-robot lever tuner. Round 1 (six levers on 93 robots, 15 Nov) used
# seeds 35000 and 35100. This round fights the six per-robot movement levers built or first banked since then, none of
# which has had a screen wider than a few dozen robots, on the 120 robots that hold the most score we do not yet take:
# those we score 70 to 90% against without a shield, by gap to BeepBoop in the field ledger (1,200 gap points, about
# one APS point of the field).
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live, in this
#              round's own folder
#   screen     120 robots   c / aa / hof / rwl / qw / sb / vj / or     6 seeds from 107000, --cpu-constant live
#   pick       each robot's best lever at a 3-point margin, 95% low end above 0 (mode_table.py)
#   lock       the picked robots   c / aa / the picked arms, each rebuilt with only its picks   12 fresh seeds from 107500
#   gate       a robot ships its line only where the lock's 95% low end is above 0 (mode_table.py --margin 0)
# Run it once the PC is free (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-field-screen --fresh        (or  ./queue.sh run pc-field-screen --fresh)
#   --fresh because round 1 left this plan's queue state marked complete; the new work folders and seeds mean no battle
#   is read back from round 1.
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. Every step resumes; no step needs a decision.
# 5,760 screen battles plus a lock of up to ~1,500; 7 to 9 hours.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: every line names one robot; every other robot, team and melee play bit for bit as master.
#   - Each lever answers a known way of losing to a mid-field gun, and each has held PC locks on the robots it was
#     aimed at: hof (MOVE-71, a danger floor on the head-on angle) for guns that fire straight at us; rwl (MOVE-46, ram a
#     disabled robot only after its last waves pass) where late hits come during our finishing ram; qw (MOVE-67, simple
#     aims at full weight) for linear and circular guns; sb (speed band) and vj (velocity jitter) for guns that match on
#     our speed; or (MOVE-47, steady orbit) where our own stops and reversals are what gets read.
#   - Those locks came from robots found by hand, a few at a time. Which of the other mid-field robots share a cause is
#     only found by fighting them: 6 seeds read a lever to about +-3.5 points a robot, and the lock re-tests every pick on
#     12 fresh seeds, so a lucky screen read does not ship.
#   - Each robot keeps a line only after 12 fresh seeds with the 95% low end above 0 at the live turn time, the bar
#     every 1v1 line has passed since 13 Nov. Robots that still show nothing are settled as needing a new line type.
# Pilot and stop rules (docs/bench/watch.md): the screen's aa arm halts the card after 20% if master and its copy
# disagree; halt on 30 failed battles, an arm scoring nothing in 8, 60+ skipped turns a battle over the last 200
# (the lock: the last 24, as its panel can be small), or no battle in 30 minutes. The live-match step stops the card
# if the PC no longer scores us and BeepBoop as live does (tools/live_match.py exit 3). ALERT opens an issue on any stop.
# Bank: the gate's lines are added on this card's results PR. Nothing is released by the card.
set V = 3.25
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-field-screen2
set L = work/pc-field-screen2-lock
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && HEAD_ON_FLOOR=plans/field-m-add.txt bash ./build-ablation.sh hoflist && RAM_WAIT=plans/field-m-add.txt bash ./build-ablation.sh rwlist && AIM_WEIGHT=plans/field-m-add.txt bash ./build-ablation.sh aimwlist && SPEED_BAND=plans/field-m-add.txt bash ./build-ablation.sh sblist && VEL_JITTER=plans/field-m-add.txt bash ./build-ablation.sh vjlist && STEADY_ORBIT=plans/field-m-add.txt bash ./build-ablation.sh orlist && for a in hof rwl qw sb vj or; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; done && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-field-m.txt && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21900 --arms plans/livematch.arms --out ${W}-livematch --label pc-field-screen2-livematch --shuffle-jobs && python3 tools/live_match.py ${W}-livematch/arms.tsv --out ${OUT}/pc-field-screen2-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

screen | ./bench-top20.sh ${C} ${P} --set panel-field-m.txt --seeds 6 --seed-base 107000 --arms plans/pc-field-screen.arms --out ${W} --label pc-field-screen --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m
  stop: aa after 20%

pick | python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-field-screen2-screen.md && python3 ../data/tools/mode_table.py ${W}/arms.tsv --margin 3 --out-tsv ${OUT}/pc-field-screen2-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-field-screen2-pick.md && python3 tools/per_robot.py ${W}/arms.tsv --arms hof rwl qw sb vj or --out ${OUT}/$(date +%Y-%m-%d)_pc-field-screen2-per-robot.md --out-tsv ${OUT}/pc-field-screen2-per-robot.tsv && python3 tools/lock_prep.py ${OUT}/pc-field-screen2-pick.tsv panel-field-m.txt plans/pc-field-screen.arms ${L}-prep && bash ${L}-prep/build.sh
  after: screen

lock | if [ -s ${L}-prep/picks-panel.txt ]; then ./bench-top20.sh ${C} ${P} --set ${L}-prep/picks-panel.txt --seeds 12 --seed-base 107500 --arms ${L}-prep/lock.arms --out ${L} --label pc-field-screen2-lock --shuffle-jobs; fi
  after: pick
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

gate | if [ -s ${L}-prep/picks-panel.txt ]; then python3 ../data/tools/multiarm.py ${L}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-field-screen2-lock.md && python3 tools/lock_prep.py --restrict ${L}/arms.tsv ${L}-prep ${L}/arms-picked.tsv && python3 ../data/tools/mode_table.py ${L}/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-field-screen2-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-field-screen2-lock-pick.md && python3 tools/per_robot.py ${L}/arms-picked.tsv --arms $(grep -v '^#' ${L}-prep/lock.arms | cut -d'|' -f1 | grep -v -w -e c -e aa | tr -d ' ' | tr '\n' ' ') --out ${OUT}/$(date +%Y-%m-%d)_pc-field-screen2-lock-per-robot.md --out-tsv ${OUT}/pc-field-screen2-lock-per-robot.tsv; fi
  after: lock

pr | bash tools/open_results_pr.sh claude/pc-field-screen2-results "1v1 field screen round 2: six movement levers on 120 mid-field robots, the best per robot locked on 12 fresh seeds" ${OUT}/pc-field-screen2-livematch.md ${OUT}/*_pc-field-screen2-*.md ${OUT}/pc-field-screen2-*-per-robot.tsv $(find ${OUT} -maxdepth 1 -name 'pc-field-screen2-*pick.tsv' -size +0c)
  after: gate
