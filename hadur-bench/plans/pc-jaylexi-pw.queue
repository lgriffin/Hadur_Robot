# JayLexi per-robot bullet power (thread "Take 1st with JayLexi and Sanaro"; BENCH-184): spend the
# spare bytes before release. The diet (#626) freed 24 B; this card spends 10 of them on a power row
# a robot, read through the aim prior's row index.
#   ./queue.sh run pc-jaylexi-pw        (or  .\queue.ps1 run pc-jaylexi-pw)
# Run it from master with this card merged: git checkout master && git pull
# One bench queue, RoboRumble workers at 0, unpinned. Nothing here touches the shipped JayLexi; nothing is uploaded or
# released. Run it after pc-eveimear-pw, not alongside it. About 2 h 30 min to the end, about 25 min if the pilot stops it.
#
# Why it should win (the PC card rule of 2026-11-03):
# - Per-opponent tailoring only: each arm changes the power rows (one a robot in NAMES, by name hash) and nothing else;
#   the candidate ships only the robots that pass on fresh seeds. Same pick-and-confirm shape as pc-eveimear-st2 (#622,
#   +0.08 APS).
# - JayLexi's waves already fly at the fired power's speed and its bins span asin(8 / speed), so a power change needs
#   no gun fix. In a cloud screen (2026-11-04, kitlab/mini-mid-field.txt: 80 robots of ranks 121-450, 1 seed, 10 rounds)
#   hi (3.0 everywhere) read -0.76 +- 1.50 overall and lo (1.5) -4.10 +- 2.15, but 17 robots read +3 points or more
#   for hi and 10 for lo, against 3 for the A/A null: per-robot picks have room. Big single reads: OcnirpPM +24.8,
#   AceSurf +11.8, ShiningBeetle +11.5 (hi); Eve +10.9, Aversari +10.2 (lo).
# - The base (c, 1,480 B) passes JayLexiReplayTest against the readable 0.4 ref, so c and aa are the shipped play.
# - Risk: the 1-seed reads are noisy. The pilot's null count catches that.
#
# Pilot: every 5th robot (134) first, 10 seeds. Then `pilotgate` counts the real picks (hi or lo beating c and aa
# pooled by 3 points, interval above 0) against the null picks (aa beating c by the same test). Fewer than 2 x null + 3
# real picks and the screen, the build and the confirm all skip, and the PR carries the pilot alone. An A/A outside its
# band halts the pilot (aa after 20%).
# Screen: the other 534 robots, same arms and seeds; the pick reads pilot and screen together.
# Confirm: the picked robots with a power row of their own x 12 fresh seeds from 37000, c, aa and pk; gate: pk minus c
# and aa pooled, summed over the picks / 669 pairings, bar +0.05 APS with the 95% low end above 0, and every pick's
# difference. A pass ships in JayLexi 0.5 on Leigh's word only (pk's POWER table, 1,480 B).
# Panels: kitlab/mini-pw-field.txt (the 668 robots of mini-all-field.txt not in broken-1.11.2.txt), split into
# kitlab/mini-pw-pilot.txt (134) and kitlab/mini-pw-rest.txt (534).
# Stop rules: fails 30, dead 8, skips 60 over 200, stall 30m (halt; every battle fought is kept and a rerun resumes),
# aa after 20% (halt). ALERT opens an issue for Leigh on a stop.

set C = --skip-build --skip-fetch --rounds 35 --parallel auto --child-heap 512M --no-truth-log
set SRC = ../jaylexi/src/main/java/hadur117/mini/JayLexi.java
set W = work/jaylexi-pw
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && rm -f ${W}/GO ${OUT}/*_jaylexi-pw*.md ${OUT}/jaylexi-pw* && mkdir -p ${W} kitlab/jars && ./fetch-opponents.sh --set kitlab/mini-pw-field.txt && mvn -q compile && python3 tools/jaylexi_power2.py ${SRC} ${W}/b.java && python3 tools/jaylexi_power2.py ${SRC} ${W}/hi.java --all 30 && python3 tools/jaylexi_power2.py ${SRC} ${W}/lo.java --all 15 && bash kitlab/build_arm.sh ${W}/b.java hadur117.mini.JayLexi 0.5b && bash kitlab/build_arm.sh ${W}/b.java hadur117.mini.JayLexi 0.5ba && bash kitlab/build_arm.sh ${W}/hi.java hadur117.mini.JayLexi 0.5hi && bash kitlab/build_arm.sh ${W}/lo.java hadur117.mini.JayLexi 0.5lo

pilot | sh ./bench-top20.sh ${C} --set kitlab/mini-pw-pilot.txt --seeds 10 --seed-base 36000 --arms plans/jaylexi-pw.arms --out ${W}/pilot --label jaylexi-pw-pilot --shuffle-jobs
  after: prep
  watch:
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m
  stop: aa after 20%

pilotgate | python3 tools/eveimear_modes.py pilot ${W}/pilot/arms.tsv --margin 3 --out ${OUT}/$(date +%Y-%m-%d)_jaylexi-pw-pilot.md; rc=$?; [ $rc = 0 ] && touch ${W}/GO; [ $rc = 0 ] || [ $rc = 3 ]
  after: pilot

screen | if [ ! -f ${W}/GO ]; then echo 'pilot: no gain over noise, screen skips'; exit 0; fi && sh ./bench-top20.sh ${C} --set kitlab/mini-pw-rest.txt --seeds 10 --seed-base 36000 --arms plans/jaylexi-pw.arms --out ${W}/screen --label jaylexi-pw-screen --shuffle-jobs
  after: pilotgate
  watch:
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m
  stop: aa after 20%

build | rm -f ${W}/pick.tsv ${W}/written.tsv ${W}/picks.txt kitlab/jars/hadur117.mini.JayLexi_0.5pk.jar && if [ ! -f ${W}/GO ]; then echo 'pilot stopped the card'; exit 0; fi && python3 ../data/tools/mode_table.py ${W}/pilot/arms.tsv ${W}/screen/arms.tsv --margin 3 --out-tsv ${W}/pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_jaylexi-pw-pick.md && if [ ! -s ${W}/pick.tsv ]; then echo 'no picks'; exit 0; fi && python3 tools/jaylexi_power2.py ${SRC} ${W}/pk.java --pick ${W}/pick.tsv --field kitlab/mini-all-field.txt --arm-power hi=30 --arm-power lo=15 --written ${W}/written.tsv && python3 tools/pick_panel.py ${W}/written.tsv kitlab/mini-pw-field.txt ${W}/picks.txt && bash kitlab/build_arm.sh ${W}/pk.java hadur117.mini.JayLexi 0.5pk && cp ${W}/pick.tsv ${OUT}/jaylexi-pw-pick.tsv
  after: screen

confirm | if [ ! -s ${W}/picks.txt ]; then echo 'no picks'; exit 0; fi && sh ./bench-top20.sh ${C} --set ${W}/picks.txt --seeds 12 --seed-base 37000 --arms plans/jaylexi-pw-confirm.arms --out ${W}/confirm --label jaylexi-pw-confirm --shuffle-jobs
  after: build
  watch:
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m

gate | if [ ! -s ${W}/picks.txt ]; then echo 'no picks'; exit 0; fi && python3 ../data/tools/multiarm.py ${W}/confirm/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_jaylexi-pw-confirm.md && python3 tools/shield_s2.py gate ${W}/confirm/arms.tsv --arm pk --panel ${W}/picks.txt --field 669 --bar 0.05 --out ${OUT}/$(date +%Y-%m-%d)_jaylexi-pw-gate.md && python3 tools/per_robot.py ${W}/confirm/arms.tsv --arms pk --out ${OUT}/$(date +%Y-%m-%d)_jaylexi-pw-per-robot.md --out-tsv ${OUT}/jaylexi-pw-per-robot.tsv && cp ${W}/pk.java ${OUT}/jaylexi-pw-pk.java.txt
  after: confirm

pr | bash tools/open_results_pr.sh claude/pc-jaylexi-pw-results "JayLexi per-robot power (pc-jaylexi-pw)" ${OUT}/*_jaylexi-pw*.md $(find ${OUT} -maxdepth 1 -name 'jaylexi-pw*' -size +0c)
  after: gate
