# Sanaro's stage N18 (docs/sanaro.md section 26): Quantum's own rules on Sanaro 0.4. Quantum 1.0.0 (66.44, 1st in
# NanoMelee) ships its source in its jar. Read on 2026-11-05, it is Sanaro's engine: the same 0.9 anti-gravity decay,
# 120 - |turn| drive, wall push, heat-locked radar and 18 / d fire gate. It differs in three things only: it holds the
# nearest robot by name until a nearer one shows or it dies, it fires a fixed 2.5 capped at energy / 7 with no table
# or band, and it leads by v / (10 + 1.008^d). These arms take the first two, and carry the endgame pair the 2026-11-04
# plan named (N16).
#   ./queue.sh run pc-sanaro-q        (or  .\queue.ps1 run pc-sanaro-q)
# Run it from master:
#   git checkout master && git pull
# One bench queue, RoboRumble workers at 0, unpinned, 12 workers. Every step resumes; no step needs
# a decision. Nothing here touches Hadur, Saor, TwinSaor, Deise, JayLexi or Eveimear. No teach run.
#
# Why it should win: the n-series rebuilt Quantum piece by piece (the gate +1.06, the lock, the anti-gravity) and every
# piece paid; the last three cards turned knobs Quantum does not have (bands, hold fire, a lower lock) and lost. The
# two pieces never tried are its targeting and its power. Sanaro's creeping threshold drifts off a target as the range
# grows 25 px a scan and swaps to whatever passes; Quantum stays on the nearest robot, so its gun's lead and gate
# work on one track. Sanaro fires a table times 480 / d, so 0.1-power shots past 480 px; Quantum fires 2.5 at every
# range it fires at, which is the 14% more bullet damage the census measured. Arms are over the 249-byte limit where
# they must be (QT 269 B, QTP 253 B): bytes are found only for a winner (Leigh, 2026-11-05). Melee cards may be
# field-wide (Leigh, 2026-11-03 22:18).
#
# Arms (sanaro-arms/arms.txt, on 0.4's source):
#   S4   Sanaro 0.4 as banked (control, 249 B)
#   QT   Quantum's target: nearest robot, held by name, reset when any robot dies
#   QP   Quantum's power: min(energy / 7, 2.5), no table, no band
#   QTP  both
#   EW   the wall push halved with one robot left
#   EB   BAND 960 with one robot left (twice the duel power)
# Live-shaped census: 43 fields x 20 fresh seeds (base 31000) = 860 battles an arm, about 45 min an arm. About 4.5 h
# in all, the pilot included.
# Pilot (Leigh's rule, 2026-11-03): the first 4 of the 20 seeds of every arm (172 battles an arm, 20% of the run,
# about 55 min). sanaro_read --stop-below 0 then stops the card and opens the results PR unless some arm reads at or
# above S4. The full steps resume the pilot's battles.
# Read against S4. An arm passes when the low end of its difference is above zero (SANARO-13); a passing arm is
# then fitted under 249 B. Nothing is released.
# Stop rules on every battle step (docs/bench/watch.md; halt, every battle fought is kept and a rerun
# resumes):
# - 20 failed battles (a broken jar).
# - No battle in 30 minutes (a hung step).
# - 40+ skipped turns a battle over the last 100 (the PR #331 build-up).
# - The pilot gate above (exit 3 ends the card with a results PR).
# ALERT opens an issue for Leigh on a stop.

set MVN = mvn -q -Drobocode.version=1.11.1 compile exec:java
set OUT = ../docs/bench/local
set ALERT = lgriffin
set ARMS = S4,QT,QP,QTP,EW,EB
set W = work/sanaro-q

prep | (cd .. && mvn -q -DskipTests install -pl sanaro -am) && mkdir -p ${W} && cp ../sanaro/target/hadur117.nano.Sanaro_0.4.jar opponents/ && ./fetch-opponents.sh --set nanomelee-field.txt && for f in melee-census-317/f*.txt; do ./fetch-opponents.sh --set "$f" || exit 1; done

arms | SANARO_RUN=q bash tools/sanaro_arms.sh live 20 31000 ${ARMS} && for a in S4 QT QP QTP EW EB; do sed '/^--seeds$/{n;s/.*/4/;}' ${W}/live-$a.args > ${W}/pilot-$a.args || exit 1; done
  after: prep

pilot-S4 | ${MVN} "-Dexec.args=@${W}/pilot-S4.args"
  after: arms
  watch: battles=172
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

pilot-QT | ${MVN} "-Dexec.args=@${W}/pilot-QT.args"
  after: pilot-S4
  watch: battles=172
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

pilot-QP | ${MVN} "-Dexec.args=@${W}/pilot-QP.args"
  after: pilot-QT
  watch: battles=172
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

pilot-QTP | ${MVN} "-Dexec.args=@${W}/pilot-QTP.args"
  after: pilot-QP
  watch: battles=172
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

pilot-EW | ${MVN} "-Dexec.args=@${W}/pilot-EW.args"
  after: pilot-QTP
  watch: battles=172
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

pilot-EB | ${MVN} "-Dexec.args=@${W}/pilot-EB.args"
  after: pilot-EW
  watch: battles=172
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

pilot | python3 tools/sanaro_read.py --work-root ${W} --field live --arms ${ARMS} --control S4 --only ${W}/live/micro.txt --live 66.44 --stop-below 0 > ${OUT}/sanaro-q-pilot.md; rc=$?; if [ $rc -eq 3 ]; then bash tools/open_results_pr.sh claude/pc-sanaro-q-results "Sanaro stage N18: Quantum's target and power (stopped at the pilot)" ${OUT}/sanaro-q-pilot.md; fi; exit $rc
  after: pilot-EB

live-S4 | ${MVN} "-Dexec.args=@${W}/live-S4.args"
  after: pilot
  watch: battles=860
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-QT | ${MVN} "-Dexec.args=@${W}/live-QT.args"
  after: live-S4
  watch: battles=860
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-QP | ${MVN} "-Dexec.args=@${W}/live-QP.args"
  after: live-QT
  watch: battles=860
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-QTP | ${MVN} "-Dexec.args=@${W}/live-QTP.args"
  after: live-QP
  watch: battles=860
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-EW | ${MVN} "-Dexec.args=@${W}/live-EW.args"
  after: live-QTP
  watch: battles=860
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-EB | ${MVN} "-Dexec.args=@${W}/live-EB.args"
  after: live-EW
  watch: battles=860
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

read-live | python3 tools/sanaro_read.py --work-root ${W} --field live --arms ${ARMS} --control S4 --only ${W}/live/micro.txt --live 66.44 > ${OUT}/sanaro-q-live.md
  after: live-EB

pr | bash tools/open_results_pr.sh claude/pc-sanaro-q-results "Sanaro stage N18: Quantum's target and power, against 0.4" ${OUT}/sanaro-q-pilot.md ${OUT}/sanaro-q-live.md ${OUT}/sanaro-q-live-*.md
  after: read-live
