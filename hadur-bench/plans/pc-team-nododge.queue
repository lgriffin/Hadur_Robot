# DODGE off against the three teams where it lost (TMODE-30, BENCH-144; docs/plan-team-top5.md
# section 17). Team thread: team-only, duel and melee fixtures bit for bit. pc-team-dodge2 (PR #450)
# put DODGE with own fire on every team at +0.85 ± 0.42 APS, but three teams read worse with it:
# ImpactTeam -4.2 ± 1.5, ImWithStupidTeam -2.5 ± 1.6 and NightmareTeam -3.5 ± 3.7 share points.
# Those were picked after the fact from 46 teams, so this card confirms them on fresh seeds before
# any table entry ships. Leigh 2026-10-30: "Yup do that."
#   ndprep  build aa, bb, and xd: tmtab with plans/team-nododge-table.java (the three teams' member
#           classes get MATEFIRE, HUNT and PATH: every shipped mode but DODGE)
#   ndbb    bb vs aa, the 3 teams x 24 fresh seeds (base 5900), 12 rounds as pc-team-dodge2; ndxd the same for xd
#   ndsum   projected team APS change = (sum of each team's xd gain less half its bb gain) / 46
#           (gate: +0.15 with the 95% low end above zero; the three dodge2 losses add up to +0.22).
#           The card changes nothing: on a PASS a PR adds the entries of the teams whose own gain
#           is above zero to TeamModes.TABLE.
# Each seed is a pair (the arm and aa): 2 x 3 x 24 x 2 = 288 battles, about 20 minutes at 12 workers
# (sizes itself to the host). Every step resumes where it stopped.
# Stop rules on both battle steps (halt; every battle fought is kept and a rerun resumes): 20 failed
# battles (a broken jar), no battle in 30 minutes (a hung step), or 40+ skipped turns a battle over the
# last 100 (the PR #331 build-up). A halt at the very start leaves the whole card unrun (288 battles);
# a halt in ndbb leaves the rest of ndbb plus all 144 of ndxd; in ndxd, the rest of ndxd. No early
# finish on score: the gate pools the three teams.
# The team thread reads claude/pc-team-nododge-results.
#   ./queue.sh run pc-team-nododge        (or  .\queue.ps1 run pc-team-nododge)
# Run it from master (one bench queue at a time):
#   git checkout master && git pull

set OUT = ../docs/bench/local
set T = python3 tools/team_modes.py

ndprep | git checkout -q master && V=$(sed -n 's:.*<robot.release>\(.*\)</robot.release>.*:\1:p' ../hadur-robot/pom.xml) && test -n "$V" && rm -f bisect/hadur117.HadurTeam_"$V"aa.jar bisect/hadur117.HadurTeam_"$V"bb.jar bisect/hadur117.HadurTeam_"$V"xd.jar && rm -f ${OUT}/team-nododge-*.md && ./fetch-opponents.sh --set plans/team-nododge-set.txt && bash ./build-ablation.sh aa && bash ./build-ablation.sh bb && TEAM_MODE_TABLE="$(pwd)/plans/team-nododge-table.java" TEAM_MODE_SUFFIX=xd bash ./build-ablation.sh tmtab && mkdir -p work && rm -rf work/team-nododge-"$V"-bb work/team-nododge-"$V"-xd && for a in bb xd; do sed "s/@V@/$V/g" plans/team-nododge-$a.args > work/team-nododge-$a.args || exit 1; done && for j in aa bb xd; do test -f bisect/hadur117.HadurTeam_"$V"$j.jar || exit 1; done && mvn -q compile
ndbb   | mvn -q exec:java "-Dexec.args=@work/team-nododge-bb.args"
  after: ndprep
  watch: battles=144
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100
ndxd   | mvn -q exec:java "-Dexec.args=@work/team-nododge-xd.args"
  after: ndbb
  watch: battles=144
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100
ndsum  | ${T} gate --report ${OUT}/team-nododge-xd.md --control ${OUT}/team-nododge-bb.md --set plans/team-nododge-set.txt --seeds 24 --teams 46 --min-aps 0.15 --out-md ${OUT}/team-nododge-verdict.md
  after: ndxd
ndpr   | bash tools/open_results_pr.sh claude/pc-team-nododge-results "DODGE off against the three teams it lost to: fresh-seed confirm" $(ls ${OUT}/team-nododge-*.md 2>/dev/null)
  after: ndsum
