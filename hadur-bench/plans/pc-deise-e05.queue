# Deise's stage E3a (docs/deise.md section 8): crowd survival.
# pc-deise-e04 (PR #411) held 0.3 (+1.33 over SAOR, bar +1.1) and put Mirage 1.46 ahead on the
# bench (live 1.38). Over its 46 fields, damage a round is level (D 143.5, Mirage 144.9), and so
# are the final duels (won 71.4% to 70.9%). The gap is reaching them: Deise is in the last two in
# 64.1% of rounds and Mirage in 75.8%; Deise dies in 54.4% of rounds to Mirage's 46.6%, and the
# per-field gap follows the survival gap (r = 0.96). This card screens one-change arms on what the
# crowd does to Deise, unfitted (DeiseLab over the core); a winner is fitted afterwards into the
# 14 bytes FIT3F frees plus 0.3's 5 spare.
#   ./queue.sh run pc-deise-e05        (or  .\queue.ps1 run pc-deise-e05)
# Run it from master:
#   git checkout master && git pull
# One bench queue, RoboRumble workers at 0, unpinned, 12 workers. A rerun skips every seat that
# finished; a seat that was stopped part-way is fought again from its start (the melee path has no
# per-battle resume, unlike multi-arm and team runs). No step needs a decision. Nothing here touches Hadur, Saor or the shipped Deise class.
#
# Arms (deise-arms/arms.txt):
#   D      Deise 0.3 (DeiseLab)                     SAOR   Saor 0.2 seated, the control
#   AIM2   the push from an opponent likely aiming at Deise counts double
#   P2     every opponent's push doubled, against the waves
#   W10    a wave from a robot unlikely to aim at Deise weighs 0.1, not 0.25
#   W50    the same wave weighs 0.5
#   REACH  the ring reaches 0.6 of the target's distance, up to 220 px (0.45 and 160 now)
#   R72    72 candidate headings, not 36
# Live-shaped census: 46 fields x 6 seeds a seat (276 battles, about 17 min on the PC), 8 seats,
# about 2.3 h.
# Reads: each arm against SAOR (as e04 read) and against D, field by field. An arm passes E3a at
# +0.40 or more over D with the low end above 0; it then goes to E3b (fresh seeds, the passing
# arms stacked, and the fitted byte cost). An arm from +0.20 to +0.40 rides to E3b only as a
# stack partner. R72 doubles the ring's work: its skipped turns are read beside its score.
# Stop rules on every census step (halt; finished seats are kept, the stopped seat reruns from its
# start): 20 failed battles (a broken jar), no battle in 30 minutes (a hung step), or 40+ skipped
# turns a battle over the last 100 (the PR #331 build-up; R72 is the arm most likely to trip it).
# Since this card, the watcher counts failed melee battles and Bench's melee line carries each
# battle's skipped turns, so `fails` and `skips` act on melee seats; before, they could not. A halt
# at worst leaves the rest of that seat and the seats after it unrun, at most 2,208 battles
# (about 2.3 h).
# There is no early finish on score: a census seat is one robot, so there is no arm to call futile
# mid-step.

set MVN = mvn -q -Drobocode.version=1.11.1 compile exec:java
set OUT = ../docs/bench/local
set ARMS = D,AIM2,P2,W10,W50,REACH,R72,SAOR

prep | (cd .. && mvn -q -DskipTests install -pl deise -am) && cp ../deise/target/hadur117.mini.Deise_0.3.jar opponents/ && curl -fsSLo opponents/hadur117.micro.Saor_0.2.jar https://github.com/lgriffin/Hadur_Robot/releases/download/saor-v0.2/hadur117.micro.Saor_0.2.jar && ./fetch-opponents.sh --set minimelee-field.txt && for f in melee-census-317/f*.txt; do ./fetch-opponents.sh --set "$f" || exit 1; done && DEISE_RUN=e05 bash tools/deise_arms.sh live 6 3500 ${ARMS}

live-D | ${MVN} "-Dexec.args=@work/deise-e05/live-D.args"
  after: prep
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-AIM2 | ${MVN} "-Dexec.args=@work/deise-e05/live-AIM2.args"
  after: live-D
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-P2 | ${MVN} "-Dexec.args=@work/deise-e05/live-P2.args"
  after: live-AIM2
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-W10 | ${MVN} "-Dexec.args=@work/deise-e05/live-W10.args"
  after: live-P2
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-W50 | ${MVN} "-Dexec.args=@work/deise-e05/live-W50.args"
  after: live-W10
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-REACH | ${MVN} "-Dexec.args=@work/deise-e05/live-REACH.args"
  after: live-W50
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-R72 | ${MVN} "-Dexec.args=@work/deise-e05/live-R72.args"
  after: live-REACH
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-SAOR | ${MVN} "-Dexec.args=@work/deise-e05/live-SAOR.args"
  after: live-R72
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

read | python3 tools/saor_arms.py --work-root work/deise-e05 --field live --arms ${ARMS} --control SAOR --only work/deise-e05/live/micro.txt --top5 71.20 --control-live 68.79 --pairings 203 --robot-prefix hadur117.mini.Deise --arms-file deise-arms/arms.txt > ${OUT}/deise-e05-live.md && python3 tools/saor_arms.py --work-root work/deise-e05 --field live --arms ${ARMS} --control D --only work/deise-e05/live/micro.txt --pairings 203 --robot-prefix hadur117.mini.Deise --arms-file deise-arms/arms.txt > ${OUT}/deise-e05-vs-d.md
  after: live-SAOR

pr | bash tools/open_results_pr.sh claude/pc-deise-e05-results "Deise stage E3a: crowd survival" ${OUT}/deise-e05-live.md ${OUT}/deise-e05-vs-d.md ${OUT}/deise-e05-live-*.md
  after: read
