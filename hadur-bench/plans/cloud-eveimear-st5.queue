# Eveimear: relearn each robot's mode on the 0.5 body (thread "Take 1st with JayLexi, Eveimear and Sanaro"; BENCH-202).
# Cloud card: run on the cloud box, 3 workers, no alerts, no PR step (the thread reads it and opens the PR).
#   ./queue.sh run cloud-eveimear-st5
#
# Why it should win: Eveimear 0.5 is 1st in MicroRumble (86.03, 2026-11-06 live pass, docs/bench/live-kitlab-0.5.md),
# +0.46 over Cotillion on the shared opponents, but its per-robot mode table was learned on the 0.2 body (pc-eveimear-st
# and st2), whose switch counted bonus energy against 40 + 23 a round. 0.5 counts Cotillion's units (5 / bullet speed
# against 2 + round) and reads the same chars as multipliers, so a char picked for the old switch now means another
# threshold. Every loss left to Cotillion and WaveShark is survival against rammers, mirrors and nanos (M1Abrams,
# NanoLauLectrik, Ant, Flex, White, Blur, MirrorNano, Sparky: 1 battle each live, so read as a group), which is the
# mode's job. This card asks 0.5 itself, as pc-eveimear-st did for 0.1: it fights the whole MicroRumble field in each
# mode, and per robot keeps the mode whose paired gain over Cotillion's own switch (1) clears one standard error.
# Same 749 B: only the table's chars change.
#
# Steps:
#   M1, M9, M0   0.5 with every cell 1 (Cotillion's switch), 9 (stop-and-go held) or 0 (random from the first hit),
#                on kitlab/micro-all-field.txt (515 robots, weight 1) x 2 seeds: 1,030 battles each.
#   build        tools/distill.py oracle picks a char per robot (default 1, z 1); distill.py hash packs them into a
#                copy of 0.5 at shift 18 (the cell 0.5 reads, name.hashCode() >>> 18); ST5 jar.
#   test         c (0.5 as released), aa (its A/A rebuild) and ST5 on kitlab/micro-wide2-field.txt (112 robots)
#                x 6 fresh seeds from 37000, shuffled jobs: 2,016 battles.
# Read: ST5 against c (0.5) and aa pooled (multiarm.py). The picks were made on other battles against the same robots, as a
# live table is. ST5 passes when its low end against c (0.5) is above 0; it then becomes a PC card under the card gate.
# Stop rules on every bench step: fails 30, dead 8, skips 60 over 200, stall 30m (halt; every battle fought is kept and
# a rerun resumes); aa after 20% on test (halt). Nothing is uploaded or released.

set MVN = mvn -q -Drobocode.version=1.11.1 compile exec:java
set C = --skip-build --skip-fetch --rounds 35 --parallel 3 --child-heap 512M --no-truth-log
set SRC = ../eveimear/src/main/java/hadur117/micro/Eveimear.java
set W = work/eveimear-st5
set OUT = ../docs/bench/local
set ALERT =
set PROGRESS_BRANCH = off

prep | rm -f ${OUT}/*_eveimear-st5*.md && mkdir -p ${W} kitlab/jars && ./fetch-opponents.sh --set kitlab/micro-all-field.txt && ./fetch-opponents.sh --set kitlab/micro-wide2-field.txt && mvn -q compile && for v in 1 9 0; do python3 tools/eveimear_fill.py ${SRC} $v ${W}/Eveimear-m$v.java && bash kitlab/build_arm_pg.sh ${W}/Eveimear-m$v.java hadur117.micro.Eveimear 0.5m$v && bash kitlab/args.sh micro-all kitlab/jars/hadur117.micro.Eveimear_0.5m$v.jar "hadur117.micro.Eveimear 0.5m$v" st5-M$v 2 3 || exit 1; done

M1 | ${MVN} "-Dexec.args=@work/kitlab-st5-M1.args"
  after: prep
  watch: battles=1030
  stop: fails 30
  stop: stall 30m
  stop: skips 60 over 200

M9 | ${MVN} "-Dexec.args=@work/kitlab-st5-M9.args"
  after: M1
  watch: battles=1030
  stop: fails 30
  stop: stall 30m
  stop: skips 60 over 200

M0 | ${MVN} "-Dexec.args=@work/kitlab-st5-M0.args"
  after: M9
  watch: battles=1030
  stop: fails 30
  stop: stall 30m
  stop: skips 60 over 200

build | python3 tools/distill.py oracle kitlab/micro-all-field.txt --arm 1=work/kitlab-st5-M1 --arm 9=work/kitlab-st5-M9 --arm 0=work/kitlab-st5-M0 --default 1 --z 1 --out ${W}/modes.tsv && cp ${SRC} ${W}/Eveimear.java && python3 tools/distill.py hash kitlab/micro-participants.txt --modes ${W}/modes.tsv --default 1 --raw --shift 18 --min-bits 14 --max-bits 14 --max-conflicts 4 --src ${W}/Eveimear.java && bash kitlab/build_arm_pg.sh ${W}/Eveimear.java hadur117.micro.Eveimear 0.5st5 && bash kitlab/build_arm_pg.sh ${SRC} hadur117.micro.Eveimear 0.5c && bash kitlab/build_arm_pg.sh ${SRC} hadur117.micro.Eveimear 0.5aa
  after: M0

test | sh ./bench-top20.sh ${C} --set kitlab/micro-wide2-field.txt --seeds 6 --seed-base 37000 --arms plans/eveimear-st5.arms --out ${W}/run --label eveimear-st5 --shuffle-jobs --failed-ok
  after: build
  watch:
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m
  stop: aa after 20%

gate | (python3 ../data/tools/multiarm.py ${W}/run/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_eveimear-st5.md && printf '\n## Picks\n\n' >> ${OUT}/$(date +%Y-%m-%d)_eveimear-st5.md && cut -f2 ${W}/modes.tsv | grep -v '^#' | sort | uniq -c | sed 's/^/    /' >> ${OUT}/$(date +%Y-%m-%d)_eveimear-st5.md && printf '\nST5 passes when its low end against c (0.5) is above 0. All builds 749 B.\n' >> ${OUT}/$(date +%Y-%m-%d)_eveimear-st5.md && { [ ! -f ${W}/run/EARLY-STOP.md ] || cat ${W}/run/EARLY-STOP.md >> ${OUT}/$(date +%Y-%m-%d)_eveimear-st5.md; })
  after: test
