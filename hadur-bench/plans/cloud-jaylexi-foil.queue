# JayLexi: what is FoilistMC's gun worth on JayLexi's body? (thread "Take 1st with JayLexi, Eveimear and Sanaro";
# BENCH-201). Cloud card: run on the cloud box, 3 workers, no alerts, no PR step (the thread reads it and opens the PR).
#   ./queue.sh run cloud-jaylexi-foil
#
# Why it should win: the 2026-11-06 live pass (docs/bench/live-kitlab-0.5.md) put JayLexi 0.6 4th, 88.40, 0.54 behind
# FoilistMC 1.0 on the opponents they share. Half of that (-0.23) is ranks 251 to 450, where JayLexi survives as often
# as FoilistMC (-0.15 points of survival) and still scores 0.77 less a robot: there the gap is how fast and how much we
# hit, which is the gun. FoilistMC's source ships in its jar (RWPCL): a multiple-choice pattern matcher over the
# enemy's lateral speed in thirds, replayed with lateral and advancing speed, matches weighted by recency x length,
# and a power table by distance and own energy. Eveimear closed its whole 2.2-point gap to Cotillion the same way
# (pc-eveimear-cot, PR #669: the leader's gun on our body). The other half of the gap is the top 30 (-0.22, survival
# -10.7 points: the learning guns hit our surfing); F against FG says how much of it is movement, for the next card.
# FG is JayLexi 0.6 with only the gun section replaced (kitlab/arms/JayLexi-FG.java); it drops the per-robot gun rows
# and catcher jitter with the old gun, and comes to 1,434 B with ProGuard, so a win needs no byte hunt.
#
# Panel: kitlab/mini-wide3-field.txt (112 robots: top 12 by name, 100 rank bands) x 4 fresh seeds from 36000 x 35
# rounds; 4 arms = 1,792 battles, shuffled jobs. Read: each arm against c (0.6) and aa pooled (multiarm.py). FG passes when
# its low end against c (0.6) is above 0 and it is within noise of F; it then becomes a PC card (12 seeds) under the card
# gate (+0.3 low end). Stop rules: fails 30, dead 8, skips 60 over 200, stall 30m (halt; every battle fought is kept
# and a rerun resumes), aa after 20% (halt). Nothing is uploaded or released.

set C = --skip-build --skip-fetch --rounds 35 --parallel 3 --child-heap 512M --no-truth-log
set SRC = ../jaylexi/src/main/java/hadur117/mini/JayLexi.java
set W = work/jaylexi-foil
set OUT = ../docs/bench/local
set ALERT =
set PROGRESS_BRANCH = off

prep | rm -f ${OUT}/*_jaylexi-foil*.md && mkdir -p ${W} kitlab/jars && ./fetch-opponents.sh --set kitlab/mini-wide3-field.txt && mvn -q compile && bash kitlab/build_arm_pg.sh ${SRC} hadur117.mini.JayLexi 0.6c && bash kitlab/build_arm_pg.sh ${SRC} hadur117.mini.JayLexi 0.6aa && bash kitlab/build_arm_pg.sh kitlab/arms/JayLexi-FG.java hadur117.mini.JayLexi 0.6FG

bench | sh ./bench-top20.sh ${C} --set kitlab/mini-wide3-field.txt --seeds 4 --seed-base 36000 --arms plans/jaylexi-foil.arms --out ${W}/run --label jaylexi-foil --shuffle-jobs --failed-ok
  after: prep
  watch:
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m
  stop: aa after 20%

gate | python3 ../data/tools/multiarm.py ${W}/run/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_jaylexi-foil.md && printf '\n## Sizes\n\nc (0.6) 1,494 B; FG 1,434; FoilistMC 1,499 (ProGuard builds, kitlab_codesize.py). FG passes when its low end against c (0.6) is above 0 and it is within noise of F.\n' >> ${OUT}/$(date +%Y-%m-%d)_jaylexi-foil.md && { [ ! -f ${W}/run/EARLY-STOP.md ] || cat ${W}/run/EARLY-STOP.md >> ${OUT}/$(date +%Y-%m-%d)_jaylexi-foil.md; }
  after: bench
