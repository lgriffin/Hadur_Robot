# Far power from less spare energy (docs/bench/melee-top3.md, MGUN-26, BENCH-190).
# Leigh 2026-11-04 21:03: "what's next?" after pc-melee-far passed (y5 +0.30 +- 0.17, PR #647):
# MGUN-25 now fires at least 2.5 beyond 300 px, but only from 60 energy.
# Why it should win: the same lever, one step wider. In the cloud 3.21 census another 9% of Hadur's
# crowd shots (not finishers, three or more left, beyond 300 px) leave with 40-60 energy at 1.94
# power, where the top bots still fire harder. pc-melee-far showed 2.5 at range pays (+0.30) and
# its energy floor kept the endgame (energy entering it -0.2). The risk: below 60 the reserve is
# thinner, so endgame energy and 1-30 endgame wins may drop; the gate's endgame bar catches it.
# One constant, read only in melee off a team with three or more opponents alive:
#   aa      the baseline (master, MGUN-25 on from 60 energy)
#   bb      its A/A copy
#   z4      mfloor40, MGUN-26: MGUN-25 from 40 energy
#   z5      mfloor50, MGUN-26: MGUN-25 from 50 energy
# Pilot (BENCH-191): mlpilot fights z4 against an aa baseline battle for battle on 46 fields x 2
# seeds (3310-3311; 184 battles, about 1 h), and mlcheck stops the card unless Hadur's score share
# is up (--share-only), on at least 95% of the 92 pairs with all 35 rounds each. On a stop the
# check opens the results PR with the pilot read and fails, so no arm after it runs.
# Each build fights the 46 census fields x 6 fresh seeds alone (3304-3309; 276 battles, 1,104 in
# all, about 3 h at the PC's ~370 battles/h). The read pairs bb with aa (A/A) and each arm with the
# mean of aa and bb (--base2), battle for battle.
# Verdict: an arm passes with its 95% low end above 0 (--gain 0), Hadur's share of others outlived
# no more than 1 point lower and the 1-30 endgame wins no more than 3 points lower; skipped turns
# more than 20% over aa's fail it. The card ends in a results PR on claude/pc-melee-floor-results.
#   git checkout master && git pull
#   ./queue.sh run pc-melee-floor        (or  .\queue.ps1 run pc-melee-floor)
# Stop rules (docs/bench/watch.md), halts only, each keeping every battle fought: fails 20 and
# stall 30m on the pilot and each arm.

set OUT = ../docs/bench/local

mlprep | git checkout -q master && V=$(sed -n 's:.*<robot.release>\(.*\)</robot.release>.*:\1:p' ../hadur-robot/pom.xml) && test -n "$V" && C=${MELEE_WORKERS} && for a in aa bb z4 z5; do rm -f bisect/hadur117.Hadur_"$V"$a.jar; done && bash ./build-ablation.sh aa && bash ./build-ablation.sh bb && bash ./build-ablation.sh mfloor40 && bash ./build-ablation.sh mfloor50 && mkdir -p work && rm -rf work/melee-floor-"$V"-pilot work/melee-floor-"$V"-aa work/melee-floor-"$V"-bb work/melee-floor-"$V"-z4 work/melee-floor-"$V"-z5 && echo "$V" > work/melee-floor.version && for a in aa bb z4 z5; do test -f bisect/hadur117.Hadur_"$V"$a.jar && sed -e "s/@V@/$V/g" -e "s/@A@/$a/g" -e "s/@C@/$C/g" plans/melee-floor.args > work/melee-floor-$a.args || exit 1; done && sed -e "s/@V@/$V/g" -e "s/@C@/$C/g" plans/melee-floor-pilot.args > work/melee-floor-pilot.args && rm -f ${OUT}/melee-floor-*.md && for f in melee-census-317/f*.txt; do ./fetch-opponents.sh --set "$f" || exit 1; done && mvn -q compile
mlpilot | mvn -q exec:java "-Dexec.args=@work/melee-floor-pilot.args" || echo "pilot: some battles failed; mlcheck reads what finished"
  after: mlprep
  watch: battles=184
  stop: fails 20
  stop: stall 30m
mlcheck | V=$(cat work/melee-floor.version) && test -n "$V" && { python3 tools/melee_pilot.py work/melee-floor-"$V"-pilot --expect 92 --rounds 35 --share-only --out ${OUT}/melee-floor-pilot.md --title "pc-melee-floor pilot: z4 against aa on $V" || { bash tools/open_results_pr.sh claude/pc-melee-floor-results "Far power from less spare energy (MGUN-26): pilot stopped the card" ${OUT}/melee-floor-pilot.md; exit 1; }; }
  after: mlpilot
mlaa   | mvn -q exec:java "-Dexec.args=@work/melee-floor-aa.args"
  after: mlcheck
  watch: battles=276
  stop: fails 20
  stop: stall 30m
mlbb   | mvn -q exec:java "-Dexec.args=@work/melee-floor-bb.args"
  after: mlaa
  watch: battles=276
  stop: fails 20
  stop: stall 30m
mlz4   | mvn -q exec:java "-Dexec.args=@work/melee-floor-z4.args"
  after: mlbb
  watch: battles=276
  stop: fails 20
  stop: stall 30m
mlz5   | mvn -q exec:java "-Dexec.args=@work/melee-floor-z5.args"
  after: mlz4
  watch: battles=276
  stop: fails 20
  stop: stall 30m
mlread | V=$(cat work/melee-floor.version) && test -n "$V" && W=work/melee-floor-"$V" && { python3 tools/melee_s0.py screen "$W"-aa --base2 "$W"-bb --arm bb="$W"-bb --arm z4="$W"-z4 --arm z5="$W"-z5 --census melee-census-317.txt --seeds 6 --gain 0 --survival-slack 1 --out ${OUT}/melee-floor-read.md --title "Far power from less spare energy on $V" || true; } && test -s ${OUT}/melee-floor-read.md
  after: mlz5
mlpr   | bash tools/open_results_pr.sh claude/pc-melee-floor-results "Far power from less spare energy (MGUN-26)" ${OUT}/melee-floor-read.md ${OUT}/melee-floor-pilot.md $(ls ${OUT}/melee-floor-aa.md ${OUT}/melee-floor-bb.md ${OUT}/melee-floor-z4.md ${OUT}/melee-floor-z5.md 2>/dev/null)
  after: mlread
