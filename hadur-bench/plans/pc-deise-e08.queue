# Deise's stage E5 (docs/deise.md section 8): harder power at range.
# pc-deise-e07 (PR #469, seeds from 3700) passed no arm: 0.4's push, wave and ring constants sit at
# an optimum, and CONS (lighter power at range, -0.37 ± 0.23) lost. ScalarR, 1st in melee, fires
# about 1300 / d at full energy (PR #459's decompile), about twice Deise's log10(energy) x 325 / d.
# E5 walks the coefficient up. Constants only, so a winner ships at no cost in bytes as 0.4.1;
# HS650 and SR add about 10 bytes (SCAL's cap) and would need a cut.
#   ./queue.sh run pc-deise-e08        (or  .\queue.ps1 run pc-deise-e08)
# Run it from master:
#   git checkout master && git pull
# One bench queue, RoboRumble workers at 0, unpinned, 12 workers. A rerun skips every seat that
# finished; a seat that was stopped part-way is fought again from its start (the melee path has no
# per-battle resume). No step needs a decision. Nothing here touches Hadur, Saor or the shipped
# Deise class.
#
# Arms (deise-arms/arms.txt, each one sed on DeiseLab over the core, 0.4):
#   D      Deise 0.4 (DeiseLab), the reference      SAOR  Saor 0.2 seated, the control
#   H500   range power log10(energy) x 500 / distance (1.5 times 0.4's)
#   H650   log10(energy) x 650 / distance (twice; 1300 / d at full energy, ScalarR's level)
#   H900   log10(energy) x 900 / distance (power 3 out to 600 px at full energy)
#   HS650  H650 under SCAL's energy cap: energy / 6, energy / 15 with the target beyond 325 px
#   SR     1300 / distance with no energy term, under the same cap; measured only, to learn
#          its worth (ScalarR's shape; Deise keeps its own unless a later stage says otherwise)
# Live-shaped census: 46 fields x 6 seeds a seat (276 battles, about 17 min on the PC), 7 seats,
# about 2 h, fresh seeds from 3800.
# Reads: each arm against SAOR and against D, field by field. An arm that reads +0.30 or more over
# D with the low end above 0 goes into the shipped class and the core, matched (DEISE-16), as 0.4.1
# on Leigh's go. If the curve rises through H900, a later card walks further, not a guess.
# Stop rules on every census step (halt; finished seats are kept, the stopped seat reruns from its
# start): 20 failed battles (a broken jar), no battle in 30 minutes (a hung step), or 40+ skipped
# turns a battle over the last 100. A halt at worst leaves the rest of that seat and the seats
# after it unrun, at most 1,932 battles (about 2 h). There is no early finish on score: a census
# seat is one robot, so there is no arm to call futile mid-step.

set MVN = mvn -q -Drobocode.version=1.11.1 compile exec:java
set OUT = ../docs/bench/local
set ARMS = D,H500,H650,H900,HS650,SR,SAOR

prep | (cd .. && mvn -q -DskipTests install -pl deise -am) && cp ../deise/target/hadur117.mini.Deise_0.4.jar opponents/ && curl -fsSLo opponents/hadur117.micro.Saor_0.2.jar https://github.com/lgriffin/Hadur_Robot/releases/download/saor-v0.2/hadur117.micro.Saor_0.2.jar && ./fetch-opponents.sh --set minimelee-field.txt && for f in melee-census-317/f*.txt; do ./fetch-opponents.sh --set "$f" || exit 1; done && DEISE_RUN=e08 bash tools/deise_arms.sh live 6 3800 ${ARMS}

live-D | ${MVN} "-Dexec.args=@work/deise-e08/live-D.args"
  after: prep
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-H500 | ${MVN} "-Dexec.args=@work/deise-e08/live-H500.args"
  after: live-D
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-H650 | ${MVN} "-Dexec.args=@work/deise-e08/live-H650.args"
  after: live-H500
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-H900 | ${MVN} "-Dexec.args=@work/deise-e08/live-H900.args"
  after: live-H650
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-HS650 | ${MVN} "-Dexec.args=@work/deise-e08/live-HS650.args"
  after: live-H900
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-SR | ${MVN} "-Dexec.args=@work/deise-e08/live-SR.args"
  after: live-HS650
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-SAOR | ${MVN} "-Dexec.args=@work/deise-e08/live-SAOR.args"
  after: live-SR
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

read | python3 tools/saor_arms.py --work-root work/deise-e08 --field live --arms ${ARMS} --control SAOR --only work/deise-e08/live/micro.txt --top5 71.15 --control-live 68.79 --pairings 203 --robot-prefix hadur117.mini.Deise --arms-file deise-arms/arms.txt > ${OUT}/deise-e08-live.md && python3 tools/saor_arms.py --work-root work/deise-e08 --field live --arms ${ARMS} --control D --only work/deise-e08/live/micro.txt --pairings 203 --robot-prefix hadur117.mini.Deise --arms-file deise-arms/arms.txt > ${OUT}/deise-e08-vs-d.md
  after: live-SAOR

pr | bash tools/open_results_pr.sh claude/pc-deise-e08-results "Deise stage E5: harder power at range" ${OUT}/deise-e08-live.md ${OUT}/deise-e08-vs-d.md ${OUT}/deise-e08-live-*.md
  after: read
