# battle: team
# Team: close-range dodge rerank, per the 2026-11-18 diagnosis of hits taken against the 16 gap teams (BENCH-257).
# Team thread: team-only, duel and melee untouched (TMODE-52 acts in the team dodge only; off in the shipped build).
#   aa      the baseline (master); bb its A/A copy
#   cr      TMODE-52 on (tmcloserr): while an enemy wave lands on the member within 35 ticks, the team dodge drives
#           its 40 lowest-risk candidates through the waves instead of 12
# Pilot: cr on all 46 teams, 3 fresh seeds from 26000, 12 rounds, paired with aa. A projected team APS change under
#   0 stops the card there (team_modes.py gate --stop-below 0), and the PR carries the pilot.
# Screen: bb and cr against aa on all 46 teams, 12 fresh seeds from 26100, 12 rounds; cr is gated at +0.15 APS with
#   the 95% low end above zero over 46 pairings, scored against both baselines.
# Why it should win: on the cloud mirror of 3.23 and OgiTeam against the 16 gap teams, the hit-rate gap (17.3% of
#   enemy shots hit our members, 13.3% OgiTeam's) sits in shots that land within 30 ticks: 0-20 ticks 34.7% vs 25.2%,
#   20-30 ticks 19.1% vs 13.0%, level from 50 ticks on, at the same lateral speed, range and net move. The dodge
#   reranks only the 12 candidates lowest in base risk, which against a close wave seldom hold the escape.
#   Cloud smoke (team-closerange/ on the project files; the 16 gap teams, 10 rounds, paired with aa): the 25-tick
#   version over 16 seeds read +0.7 share points, the 35-tick version (this card) +2.2, +0.3, +1.6, +0.8, +0.9 on
#   five 4-seed blocks (about +1.2 +- 0.7, every block positive), and short-flight hits fell (0-20 ticks 34.3% -> 31.0%, 20-30
#   18.4% -> 16.8%). Skipped turns rise by about 1-7 a battle.
# Size: pilot 138 battles, screen 2 x 552: about 1,250 battles, about 1 h at the team rate pc-team-fitted ran at.
#   Every step resumes where it stopped.
# Stop rules on every battle step (halt; every battle fought is kept and a rerun resumes): 60 failed battles, no
# battle in 30 minutes, or 60+ skipped turns a battle over the last 200.
# The team thread reads claude/pc-team-closerr-results.
#   ./queue.sh run pc-team-closerr        (or  .\queue.ps1 run pc-team-closerr)
# Run it from master (one bench queue at a time, RoboRumble workers at 0):
#   git checkout master && git pull

set OUT = ../docs/bench/local
set ALERT = lgriffin
set T = python3 tools/team_modes.py

tcprep | git checkout -q master && V=$(sed -n 's:.*<robot.release>\(.*\)</robot.release>.*:\1:p' ../hadur-robot/pom.xml) && test -n "$V" && for a in aa bb cr; do rm -f bisect/hadur117.HadurTeam_"$V"$a.jar; done && rm -f ${OUT}/team-closerr-p*.md ${OUT}/team-closerr-bb.md ${OUT}/team-closerr-cr.md ${OUT}/team-closerr-verdict.md && mkdir -p work && rm -rf work/team-closerr-"$V"-* && rm -f work/team-closerr-*.args work/team-closerr-go && ./fetch-opponents.sh --set team-census46.txt && bash ./build-ablation.sh aa && bash ./build-ablation.sh bb && bash ./build-ablation.sh tmcloserr && sed -e "s/@V@/$V/g" plans/team-closerr-pilot.args > work/team-closerr-pep.args && for a in bb cr; do sed -e "s/@V@/$V/g" -e "s/@A@/$a/g" plans/team-closerr-screen.args > work/team-closerr-$a.args || exit 1; done && for a in aa bb cr; do test -f bisect/hadur117.HadurTeam_"$V"$a.jar || exit 1; done && mvn -q compile
tcpcr | mvn -q exec:java "-Dexec.args=@work/team-closerr-pep.args"
  after: tcprep
  watch: battles=276
  stop: fails 60
  stop: stall 30m
  stop: skips 60 over 200
tcpilot | ${T} gate --report ${OUT}/team-closerr-pep.md --set team-census46.txt --seeds 3 --teams 46 --min-aps 0 --stop-below 0 --out-md ${OUT}/team-closerr-pilot.md && touch work/team-closerr-go || test $? -eq 3 || exit 1
  after: tcpcr
tcbb | if [ -f work/team-closerr-go ]; then mvn -q exec:java "-Dexec.args=@work/team-closerr-bb.args"; else echo "cr under 0 on the pilot: no screen"; fi
  after: tcpilot
  watch: battles=1104
  stop: fails 60
  stop: stall 30m
  stop: skips 60 over 200
tccr | if [ -f work/team-closerr-go ]; then mvn -q exec:java "-Dexec.args=@work/team-closerr-cr.args"; else echo "cr under 0 on the pilot: no screen"; fi
  after: tcbb
  watch: battles=1104
  stop: fails 60
  stop: stall 30m
  stop: skips 60 over 200
tcgate | if [ -f work/team-closerr-go ]; then ${T} gate --report ${OUT}/team-closerr-cr.md --control ${OUT}/team-closerr-bb.md --set team-census46.txt --seeds 12 --teams 46 --min-aps 0.15 --out-md ${OUT}/team-closerr-verdict.md || exit 1; else echo "no screen"; fi
  after: tccr
tcpr | bash tools/open_results_pr.sh claude/pc-team-closerr-results "Team: close-range dodge rerank (TMODE-52)" $(ls ${OUT}/team-closerr-*.md 2>/dev/null | grep -v smoke)
  after: tcgate
