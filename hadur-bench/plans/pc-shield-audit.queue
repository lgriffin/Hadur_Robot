# 1v1, two shield list adds from the shield audit on fresh PC seeds (BENCH-209, docs/bench/shield-recent.md).
# Leigh starts it once the PC is free (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-shield-audit        (or  ./queue.sh run pc-shield-audit)
# One bench queue, RoboRumble workers at 0, unpinned, 12 workers, truth log off. Every step resumes; no step needs a
# decision. About 10 minutes of battles (2 robots x 3 arms x 12 seeds = 72).
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: each line names one robot; every other robot, team and melee play bit for bit as master.
#   - Measured: the shield audit of 2026-11-07 found 58 robots BeepBoop 2.0 shields and we do not. In the cloud the
#     still shield (list add + shield-still) beat master on Musashi by +20 on 6 seeds (every seed, 90-99 against
#     70-81) and on Princess by +11 on 2 seeds, +2 on 4 more with the damage exit off; it lost on the other five of
#     the seven read (GlowBlow, BlackSwans, CigaretBH, MatchupMicro, CassiusClay), which stay off.
#   - Mechanism: Musashi fires power 3 head-on from range; our shield intercepts 99.8% (4 hits in 35 rounds) and the
#     damage race is one-sided. Princess's learned aim moves after three exact rounds; SHIELD-11's 150-damage exit
#     ended the mode before it re-learnt, so Princess carries exit off (as Smoke, Cyprus, Avipes, GlowBlowAPM do).
#   - Risk: pc-shield-still (PR #510, 2026-10-31) fought both with the still shield on and did not pick them at its
#     5-point margin; cloud and PC have disagreed on shield robots before. This card re-measures on 12 fresh seeds
#     against master and its A/A copy; a robot ships only at a 3-point margin with its 95% low end above 0.
# gate: sa at +0.01 APS over the 2 / 1,217 pairings with the 95% low end above 0, A/A inside its band; a 3-point
# per-robot pick names the lines to ship. No pilot or futility rule: two robots are too few for an interim read
# (as pc-rival-confirm).
# Stop rules (docs/bench/watch.md): halt on 30 failed battles, an arm scoring nothing in 8, 60+ skipped turns a battle
# over the last 200, or no battle in 30 minutes; every battle fought is kept and a rerun resumes. ALERT opens an
# issue for Leigh on any stop. Nothing here ships: on a pass a PR adds the held lines to ShieldListData and
# ShieldTableData for the next release.

set V = 3.21
set P = --parallel 12 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant 1488498 --child-heap 2G
set W = work/shield-audit
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && SHIELD_ADD=plans/shield-audit-add.txt SHIELD_STILL=plans/shield-audit-still.txt SHIELD_EXIT0=plans/shield-audit-exit0.txt bash ./build-ablation.sh slistadd,szlist,sx0list && test -f bisect/hadur117.Hadur_${V}mtzlx0.jar && ./fetch-opponents.sh --set panel-shield-audit.txt && mvn -q compile

confirm | ./bench-top20.sh ${C} ${P} --set panel-shield-audit.txt --seeds 12 --seed-base 9950 --arms plans/shield-audit.arms --out ${W} --label shield-audit --shuffle-jobs
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m

gate | python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_shield-audit.md && python3 tools/shield_s2.py gate ${W}/arms.tsv --arm sa --panel panel-shield-audit.txt --bar 0.01 --out ${OUT}/$(date +%Y-%m-%d)_shield-audit-gate.md && python3 ../data/tools/mode_table.py ${W}/arms.tsv --margin 3 --out-tsv ${OUT}/shield-audit-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_shield-audit-pick.md && python3 tools/per_robot.py ${W}/arms.tsv --arms sa --out ${OUT}/$(date +%Y-%m-%d)_shield-audit-per-robot.md --out-tsv ${OUT}/shield-audit-per-robot.tsv
  after: confirm

pr | bash tools/open_results_pr.sh claude/pc-shield-audit-results "1v1 two shield list adds from the shield audit on fresh seeds" ${OUT}/*_shield-audit*.md ${OUT}/shield-audit-per-robot.tsv $(find ${OUT} -maxdepth 1 -name shield-audit-pick.tsv -size +0c)
  after: gate
