# battle: team
# Team: one per-team table line for the one team that beats us in TeamRumble (TMODE-64, BENCH-297).
# Team thread: team-only, duel and melee untouched (SWARM is read only with a living teammate, and only for a
# team whose table entry carries it; no shipped entry does).
#   aa      the baseline (master); bb its A/A copy
#   p6      tmtab with plans/team-pack6-table.java: SWARM added to OgiTeam's shipped entry; nothing else in the
#           entry changes
# Every other pairing plays the same code as aa, so the card fights only OgiTeam (plans/team-pack6-set.txt)
# and spreads its gain over the 47 TeamRumble pairings.
# Pilot: p6 on OgiTeam, 12 fresh seeds from 45400, 12 rounds, paired with aa. A projected team APS change
#   under -0.10 stops the card there (team_modes.py gate --stop-below), and the PR carries the pilot. The bar is
#   below zero because a 12-seed pilot's interval on one team is about +-0.1 APS: it stops clear harm, not noise.
# Screen: bb and p6 against aa on OgiTeam, 48 fresh seeds from 45500, 12 rounds; p6 is gated at +0.03 APS
#   (about 1.4 score share points on the one team) with the 95% low end above zero over 47 pairings, scored
#   against both baselines. The pairing itself is won at a share above 50; the report's share column says how far
#   p6 is from that.
# Why it should win: OgiTeam is the one pairing we lose. On master we take the first kill in three rounds of four
#   and still lose most rounds, because their leader starts on 200 energy, outlasts its four members, and is the
#   last of them standing in nine endgames of ten. By then our members are drained: one under 30 energy is not
#   pulled to the last enemy at all and keeps a low profile across the field, so two thirds of our endgame shots
#   leave from beyond 750 px at power 0.2, while the leader fires 1.45 back. SWARM pulls every member to 150 px
#   of the last enemy whatever its energy and drops the posture. On the cloud, paired with master on the same
#   seeds, 10 rounds: 12 seeds +1.2 +- 3.5 score share points, then 12 fresh seeds +5.5 +- 4.6; rounds won 52
#   of 240 against 30 of 240; in the endgames with one of theirs left against two or more of ours, 23 of 38 won
#   against 13 of 44, our shots from a median 380 px instead of 956 at power 1.45 instead of 0.49, hitting 18.7%
#   instead of 11.9%. About +0.07 APS over 47 pairings. Closed on the same team: their leader as first target
#   (four strengths and timings, all level or worse on share), the swarm from 350 px (-4.1 +- 5.1) and the swarm
#   with two of theirs left (-3.4 +- 6.2).
# Size: pilot 24 battles, screen 2 x 96: about 220 battles, about 15 minutes at the team rate. Every step resumes
#   where it stopped.
# Stop rules on every battle step (halt; every battle fought is kept and a rerun resumes): 10 failed battles, no
# battle in 30 minutes, or 60+ skipped turns a battle over the last 200.
# The team thread reads claude/pc-team-pack6-results.
#   ./queue.sh run pc-team-pack6        (or  .\queue.ps1 run pc-team-pack6)
# Run it from master (one bench queue at a time, RoboRumble workers at 0):
#   git checkout master && git pull

set OUT = ../docs/bench/local
set ALERT = lgriffin
set T = python3 tools/team_modes.py

tkprep | git checkout -q master && V=$(sed -n 's:.*<robot.release>\(.*\)</robot.release>.*:\1:p' ../hadur-robot/pom.xml) && test -n "$V" && for a in aa bb p6; do rm -f bisect/hadur117.HadurTeam_"$V"$a.jar; done && rm -f ${OUT}/team-pack6-p*.md ${OUT}/team-pack6-bb.md ${OUT}/team-pack6-p6.md ${OUT}/team-pack6-verdict.md && mkdir -p work && rm -rf work/team-pack6-"$V"-* && rm -f work/team-pack6-*.args work/team-pack6-go && ./fetch-opponents.sh --set plans/team-pack6-set.txt && bash ./build-ablation.sh aa && bash ./build-ablation.sh bb && TEAM_MODE_TABLE="$(pwd)/plans/team-pack6-table.java" TEAM_MODE_SUFFIX=p6 bash ./build-ablation.sh tmtab && sed -e "s/@V@/$V/g" plans/team-pack6-pilot.args > work/team-pack6-pep.args && for a in bb p6; do sed -e "s/@V@/$V/g" -e "s/@A@/$a/g" plans/team-pack6-screen.args > work/team-pack6-$a.args || exit 1; done && for a in aa bb p6; do test -f bisect/hadur117.HadurTeam_"$V"$a.jar || exit 1; done && mvn -q compile
tkpp6 | mvn -q exec:java "-Dexec.args=@work/team-pack6-pep.args"
  after: tkprep
  watch: battles=24
  stop: fails 10
  stop: stall 30m
  stop: skips 60 over 200
tkpilot | ${T} gate --report ${OUT}/team-pack6-pep.md --set plans/team-pack6-set.txt --seeds 12 --teams 47 --min-aps 0 --stop-below=-0.10 --out-md ${OUT}/team-pack6-pilot.md && touch work/team-pack6-go || test $? -eq 3 || exit 1
  after: tkpp6
tkbb | if [ -f work/team-pack6-go ]; then mvn -q exec:java "-Dexec.args=@work/team-pack6-bb.args"; else echo "p6 under -0.10 on the pilot: no screen"; fi
  after: tkpilot
  watch: battles=96
  stop: fails 10
  stop: stall 30m
  stop: skips 60 over 200
tkp6 | if [ -f work/team-pack6-go ]; then mvn -q exec:java "-Dexec.args=@work/team-pack6-p6.args"; else echo "p6 under -0.10 on the pilot: no screen"; fi
  after: tkbb
  watch: battles=96
  stop: fails 10
  stop: stall 30m
  stop: skips 60 over 200
tkgate | if [ -f work/team-pack6-go ]; then ${T} gate --report ${OUT}/team-pack6-p6.md --control ${OUT}/team-pack6-bb.md --set plans/team-pack6-set.txt --seeds 48 --teams 47 --min-aps 0.03 --out-md ${OUT}/team-pack6-verdict.md || exit 1; else echo "no screen"; fi
  after: tkp6
tkpr | bash tools/open_results_pr.sh claude/pc-team-pack6-results "Team: SWARM against OgiTeam (TMODE-64)" $(ls ${OUT}/team-pack6-*.md 2>/dev/null | grep -v smoke)
  after: tkgate
