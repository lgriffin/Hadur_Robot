# arms come from tools/jaylexi_rows_off.py --skip in the prep step.
c | hadur117.mini.JayLexi 0.4 | kitlab/jars/hadur117.mini.JayLexi_0.4.jar
aa | hadur117.mini.JayLexi 0.4aa | kitlab/jars/hadur117.mini.JayLexi_0.4aa.jar
p1 | hadur117.mini.JayLexi 0.4p1000 | kitlab/jars/hadur117.mini.JayLexi_0.4p1000.jar
p4 | hadur117.mini.JayLexi 0.4p4000 | kitlab/jars/hadur117.mini.JayLexi_0.4p4000.jar
