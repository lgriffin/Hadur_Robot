# 1v1, per robot, the next lever (BENCH-214): two screens are already on the PC and each still holds unspent
# evidence. pc-tailor-field (work/x5f) fought every robot on eight levers but kept ONE lever a robot, so a robot whose
# second-best lever also beat master there has never had that lever tried on top of the one it now carries.
# pc-race-power (work/rpf) fought every robot on race power at 2 seeds and kept the 5-point winners; the robots where
# rp led by 1-5 points were never fought again, as pc-tailor-near did for the other levers (28 of its picks held).
# This card gives both a fair second look in one build: every robot the table already tailors is fought with its best
# OTHER lever on top (a different family: one bullet-power rule, one stop-and-go variant; gs and fl never on a
# shield-mode robot), and every robot that leaned to race power is fought on it; each keeps its lever only where the
# new battles alone say it wins.
# Leigh starts it once the PC is free (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-tailor-stack        (or  ./queue.sh run pc-tailor-stack)
# It needs both earlier screens' battles, work/x5f/arms.tsv and work/rpf/arms.tsv (prep stops with a message when
# either is missing). One bench queue, RoboRumble workers at 0, unpinned, 12 workers, truth log off. Every step
# resumes; no step needs a decision. Size: about 100-150 stacking robots plus 300-500 race-power leaners x 2 arms
# (c, ln) x 4 seeds = ~3,500-5,000 battles, ~6-8 h at ~650 battles/h; the first fifth of each set is the pilot
# (~1.5 h); confirm = the picks x c, aa, xr x 4 fresh seeds, ~1-2 h.
#
# The arms: c is master (every banked pick in); ln is ONE build in which each robot is on its new lever only
# (tools/x5_card.py carried, lean --carry, then lists --arm ln), so the run costs 2 arms. The carried levers come from
# ShieldTableData itself at prep (x5, gs, fp, sg, sw, hj, fl, mm, rp), so nothing here goes stale when a pick lands.
# The stack set: robots in the table, best other-family lever +1 point or more over c on work/x5f. The race set: robots
# not in the stack set, not on a bullet-power lever and not among pc-race-power's 19 picks (the 11 that failed its
# confirm had their look), rp +1 point or more over c on work/rpf.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring with no new mechanism: every lever here ships and has held its own confirm; the question
#     is only which robots get a second one. The levers work different parts (power, gun aims, stop-and-go, heat
#     timing, flattener, mimic aims), so a second lever's gain has no reason to cancel the first's; whether it adds is
#     exactly what the card measures, against c carrying the first lever.
#   - Race power's screen reads like heat-jit's did: +0.14 +- 0.16 APS over the whole field at 2 seeds, a mass of
#     small gains the 5-point margin could not keep. pc-tailor-near turned the same shape of evidence into 28 holding
#     picks (+0.03 APS). Here rp's leaners get the same 4 new seeds and the same 2-point pick.
#   - No winner's curse: the lean is chosen on the old seeds, the pick is made on 4 new ones (from 10400) only, and
#     the confirm re-measures the picks on 4 more fresh seeds (from 10500) against c and aa before anything ships.
#   - Risk: a robot keeps its new lever only at a 2-point margin with its 95% low end above 0 on the new seeds; every
#     other robot stays as master plays it. Each set has its own pilot bar, so a dead set costs a fifth of its battles.
# Pilot (stop rule): every fifth robot of each set x c, ln x 4 seeds from 10400. A set whose mean ln gain over c there
#   is under 0.3 points is dropped (work/tms-stack.stop or work/tms-rp.stop); when both drop, work/tms.stop is written,
#   every later step skips and the results PR carries the pilots alone. The screen resumes the pilot's battles.
#   A screen that picks no robot writes work/tms.stop at prep2. Either set may be empty (lean exits 1, its files are
#   not written): prep goes on with the other and stops only when both are empty.
# screen:  the sets left x c, ln x 4 seeds from 10400; pick at a 2-point margin (mode_table, ref c).
# confirm: the picks x c, aa, xr (each picked robot on its new lever) x 4 fresh seeds from 10500; gate +0.03 APS.
# Note: when the picks keep every lever ln had, xr's jar has ln's name and replaces it at prep2; the screen is over by then.
# Stop rules (docs/bench/watch.md): halt on 30 failed battles, an arm scoring nothing in 8, 90+ skipped turns a battle
# over the last 200, or no battle in 30 minutes; every battle fought is kept and a rerun resumes. Nothing here ships:
# the confirmed lines go into ShieldTableData by PR; the release rule stands.

set V = 3.21
set P = --parallel 12 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant 1488498 --child-heap 2G
set W = work/tms
set W2 = work/tms-2
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && rm -f work/tms.stop work/tms-stack.stop work/tms-rp.stop work/tms-stack.tsv work/tms-rp.tsv work/panel-tms-stack.txt work/panel-tms-stack-pilot.txt work/panel-tms-rp.txt work/panel-tms-rp-pilot.txt && if [ ! -f work/x5f/arms.tsv ] || [ ! -f work/rpf/arms.tsv ]; then echo 'needs work/x5f/arms.tsv (pc-tailor-field) and work/rpf/arms.tsv (pc-race-power), the earlier screens'; exit 1; fi && python3 tools/x5_card.py carried ../hadur-robot/src/main/java/hadur117/ShieldTableData.java --out work/tms-carried.tsv && { python3 tools/x5_card.py lean work/x5f/arms.tsv --census census-312.txt --carry work/tms-carried.tsv --only-carried --shielded panel-shield-listed-321.txt --levers x5,gs,fp,sg,sw,hj,fl,mm --min 1 --req BENCH-214 --pick-out work/tms-stack.tsv --set-out work/panel-tms-stack.txt --pilot-out work/panel-tms-stack-pilot.txt || [ $? -eq 1 ]; } && { python3 tools/x5_card.py lean work/rpf/arms.tsv --census census-312.txt --carry work/tms-carried.tsv --exclude ${OUT}/rpf-pick.tsv $( [ -f work/tms-stack.tsv ] && echo --exclude work/tms-stack.tsv ) --levers rp --min 1 --req BENCH-214 --pick-out work/tms-rp.tsv --set-out work/panel-tms-rp.txt --pilot-out work/panel-tms-rp-pilot.txt || [ $? -eq 1 ]; } && { cat work/tms-stack.tsv work/tms-rp.tsv 2>/dev/null; :; } > work/tms-lean.tsv && if [ ! -s work/tms-lean.tsv ]; then echo 'no robot leans to a second lever or to race power: nothing to fight'; exit 1; fi && { cat work/panel-tms-stack-pilot.txt work/panel-tms-rp-pilot.txt 2>/dev/null; :; } > work/panel-tms-pilot.txt && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && python3 tools/x5_card.py lists work/tms-lean.tsv --list-prefix work/tsl --env-out work/tsl-env.sh --abl-out work/tsl-abl.txt --arms-out work/tms.arms --version ${V} --arm ln --no-aa && (. ./work/tsl-env.sh && bash ./build-ablation.sh $(cat work/tsl-abl.txt)) && test -f bisect/hadur117.Hadur_${V}aa.jar && test -f "$(awk -F'|' '/^ln /{gsub(/ /, "", $3); print $3}' work/tms.arms)" && ./fetch-opponents.sh --set census-312.txt && mvn -q compile

pilot | ./bench-top20.sh ${C} ${P} --set work/panel-tms-pilot.txt --seeds 4 --seed-base 10400 --arms work/tms.arms --out ${W} --label tms --shuffle-jobs && { [ ! -s work/panel-tms-stack.txt ] || python3 tools/x5_card.py pilot ${W}/arms.tsv --names work/panel-tms-stack-pilot.txt --check ln=work/panel-tms-stack.txt@0.3 --ref c --out ${OUT}/$(date +%Y-%m-%d)_tms-pilot-stack.md --stop-file work/tms-stack.stop; } && { [ ! -s work/panel-tms-rp.txt ] || python3 tools/x5_card.py pilot ${W}/arms.tsv --names work/panel-tms-rp-pilot.txt --check ln=work/panel-tms-rp.txt@0.3 --ref c --out ${OUT}/$(date +%Y-%m-%d)_tms-pilot-rp.md --stop-file work/tms-rp.stop; } && : > work/panel-tms.txt && { [ ! -s work/panel-tms-stack.txt ] || [ -f work/tms-stack.stop ] || cat work/panel-tms-stack.txt >> work/panel-tms.txt; } && { [ ! -s work/panel-tms-rp.txt ] || [ -f work/tms-rp.stop ] || cat work/panel-tms-rp.txt >> work/panel-tms.txt; } && { grep -q '|' work/panel-tms.txt || echo 'both pilots below the bar' > work/tms.stop; }
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 90 over 200
  stop: stall 30m

screen | if [ -f work/tms.stop ]; then echo 'pilot: ln under 0.3 points over c on both sets, no screen'; exit 0; fi && ./bench-top20.sh ${C} ${P} --set work/panel-tms.txt --seeds 4 --seed-base 10400 --arms work/tms.arms --out ${W} --label tms --shuffle-jobs
  after: pilot
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 90 over 200
  stop: stall 30m

pick | if [ -f work/tms.stop ]; then echo 'stopped (see work/tms.stop): skipped'; exit 0; fi && cp work/tms-lean.tsv ${OUT}/tms-lean.tsv && cp work/tms-carried.tsv ${OUT}/tms-carried.tsv && python3 ../data/tools/multiarm.py ${W}/arms.tsv --census census-312.txt --out ${OUT}/$(date +%Y-%m-%d)_tms-screen.md && python3 ../data/tools/mode_table.py ${W}/arms.tsv --margin 2 --out-tsv ${OUT}/tms-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_tms-pick.md && python3 tools/per_robot.py ${W}/arms.tsv --arms ln --out ${OUT}/$(date +%Y-%m-%d)_tms-per-robot.md --out-tsv ${OUT}/tms-per-robot.tsv
  after: screen

prep2 | if [ -f work/tms.stop ]; then echo 'stopped (see work/tms.stop): skipped'; exit 0; fi && awk -F'\t' 'BEGIN{OFS="\t"} NR==FNR{l[$1]=$2; next} ($1 in l){$2=l[$1]; print}' work/tms-lean.tsv ${OUT}/tms-pick.tsv > work/tms-pick-levers.tsv && if ! python3 tools/pick_panel.py work/tms-pick-levers.tsv census-312.txt work/panel-tms-picks.txt; then echo 'no robot picked: confirm and gate skip, the PR carries the screen'; echo 'screen picked no robot' > work/tms.stop; exit 0; fi && python3 tools/x5_card.py lists work/tms-pick-levers.tsv --list-prefix work/tsx --env-out work/tsx-env.sh --abl-out work/tsx-abl.txt --arms-out work/tms-2.arms --version ${V} && (. ./work/tsx-env.sh && bash ./build-ablation.sh $(cat work/tsx-abl.txt)) && test -f "$(awk -F'|' '/^xr /{gsub(/ /, "", $3); print $3}' work/tms-2.arms)"
  after: pick

confirm | if [ -f work/tms.stop ]; then echo 'stopped (see work/tms.stop): skipped'; exit 0; fi && ./bench-top20.sh ${C} ${P} --set work/panel-tms-picks.txt --seeds 4 --seed-base 10500 --arms work/tms-2.arms --out ${W2} --label tms-2 --shuffle-jobs
  after: prep2
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 90 over 200
  stop: stall 30m

gate | if [ -f work/tms.stop ]; then echo 'stopped (see work/tms.stop): skipped'; exit 0; fi && python3 ../data/tools/multiarm.py ${W2}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_tms-2.md && python3 tools/shield_s2.py gate ${W2}/arms.tsv --arm xr --panel work/panel-tms-picks.txt --bar 0.03 --out ${OUT}/$(date +%Y-%m-%d)_tms-2-gate.md && cp work/tms-pick-levers.tsv ${OUT}/tms-pick-levers.tsv && python3 tools/per_robot.py ${W2}/arms.tsv --arms xr --out ${OUT}/$(date +%Y-%m-%d)_tms-2-per-robot.md --out-tsv ${OUT}/tms-2-per-robot.tsv
  after: confirm

pr | bash tools/open_results_pr.sh claude/pc-tailor-stack-results "1v1 per robot: a second lever on the tailored robots, race power on the robots that leaned to it" ${OUT}/*_tms*.md $(find ${OUT} -maxdepth 1 -name 'tms*.tsv' -size +0c)
  after: gate
