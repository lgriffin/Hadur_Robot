diff --git a/hadur-core/src/main/java/hadur2/core/move/RegimeClock.java b/hadur-core/src/main/java/hadur2/core/move/RegimeClock.java
new file mode 100644
index 00000000..1fce12e7
--- /dev/null
+++ b/hadur-core/src/main/java/hadur2/core/move/RegimeClock.java
@@ -0,0 +1,66 @@
+package hadur2.core.move;
+
+/**
+ * MOVE-17: the regime switch, from the style lab (docs/bench/style-lab.md). The surf has two
+ * temperaments: free, where it reverses whenever reversing is the least danger (as without the
+ * switch), and steady, where it keeps its way round unless reversing is clearly safer, which
+ * lengthens the runs between reversals. On each new enemy shot the clock flips from one to the
+ * other with probability {@link #FLIP}, drawn from a replaying die ({@link ProteanPick}), so a
+ * gun that has learned how long we keep going one way is right less often.
+ *
+ * <p>Pure: no engine types, no clock. The surf tells it of each new real shot and asks whether
+ * a reversal should be held.</p>
+ */
+public final class RegimeClock {
+
+    /** The chance a new enemy shot flips the regime; the lab's best style flipped on 38%. */
+    static final double FLIP = 0.4;
+    /** In the steady regime, a reversal is taken only when it is this share safer than keeping on. */
+    static final double MARGIN = 0.3;
+
+    private final ProteanPick die = new ProteanPick();
+    private boolean steady;
+    private long lastShot = Long.MIN_VALUE;
+
+    /**
+     * Seeds the die from the enemy's name and the round, so the regimes replay, and starts the
+     * round free.
+     *
+     * @param enemyName the opponent's name
+     * @param round the round number
+     */
+    public void seed(String enemyName, int round) {
+        die.seed(enemyName, round);
+        steady = false;
+        lastShot = Long.MIN_VALUE;
+    }
+
+    /**
+     * Tells the clock of the real enemy shot being surfed. A shot newer than the last one seen
+     * draws once from the die; an older or the same one draws nothing.
+     *
+     * @param fireTime the tick the shot was fired
+     */
+    public void shot(long fireTime) {
+        if (fireTime <= lastShot) return;
+        lastShot = fireTime;
+        if (die.next() < FLIP) steady = !steady;
+    }
+
+    /** Whether the surf is in the steady regime. */
+    public boolean steady() {
+        return steady;
+    }
+
+    /**
+     * Whether a reversal should be held: in the steady regime, when reversing is not at least
+     * {@link #MARGIN} safer than keeping on; never in the free regime.
+     *
+     * @param keepDanger the danger of keeping on the way round we are going
+     * @param reverseDanger the danger of reversing
+     * @return true to keep on instead of reversing
+     */
+    public boolean holdReversal(double keepDanger, double reverseDanger) {
+        return steady && reverseDanger > keepDanger * (1 - MARGIN);
+    }
+}
