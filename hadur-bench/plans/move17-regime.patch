diff --git a/hadur-core/src/test/java/hadur2/core/move/RegimeClockTest.java b/hadur-core/src/test/java/hadur2/core/move/RegimeClockTest.java
new file mode 100644
index 00000000..b6a940d5
--- /dev/null
+++ b/hadur-core/src/test/java/hadur2/core/move/RegimeClockTest.java
@@ -0,0 +1,74 @@
+package hadur2.core.move;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+
+/** MOVE-17: the regime clock. */
+class RegimeClockTest {
+
+    static RegimeClock seeded() {
+        RegimeClock c = new RegimeClock();
+        c.seed("sample.Enemy 1.0", 3);
+        return c;
+    }
+
+    @Test
+    @Tag("MOVE-17")
+    @DisplayName("a round starts free, and the free regime never holds a reversal")
+    void startsFree() {
+        RegimeClock c = seeded();
+        assertFalse(c.steady());
+        assertFalse(c.holdReversal(1.0, 0.99));
+        assertFalse(c.holdReversal(0.1, 5.0));
+    }
+
+    @Test
+    @Tag("MOVE-17")
+    @DisplayName("each new shot flips the regime about 40% of the time; a shot seen again draws nothing")
+    void flipsOnNewShots() {
+        RegimeClock c = seeded();
+        int flips = 0;
+        boolean last = c.steady();
+        for (long t = 1; t <= 5000; t++) {
+            c.shot(t * 14);
+            c.shot(t * 14);
+            c.shot(t * 14 - 3);
+            if (c.steady() != last) flips++;
+            last = c.steady();
+        }
+        assertEquals(0.4, flips / 5000.0, 0.03);
+    }
+
+    @Test
+    @Tag("MOVE-17")
+    @DisplayName("the steady regime keeps on unless reversing is at least 30% safer")
+    void steadyHoldsUnlessClearlySafer() {
+        RegimeClock c = seeded();
+        long t = 0;
+        while (!c.steady()) c.shot(++t);
+        assertTrue(c.holdReversal(1.0, 0.8));
+        assertTrue(c.holdReversal(1.0, 0.71));
+        assertFalse(c.holdReversal(1.0, 0.69));
+        assertFalse(c.holdReversal(0.0, 0.0));
+    }
+
+    @Test
+    @Tag("MOVE-17")
+    @DisplayName("the regimes replay from the same seed, and a new seed starts the round free")
+    void replays() {
+        RegimeClock a = seeded();
+        RegimeClock b = seeded();
+        for (long t = 1; t <= 500; t++) {
+            a.shot(t);
+            b.shot(t);
+            assertEquals(a.steady(), b.steady(), "shot " + t);
+        }
+        a.seed("sample.Enemy 1.0", 4);
+        assertFalse(a.steady());
+    }
+}
