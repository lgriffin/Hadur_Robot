# Lean on the enemy leader, per team (TMODE-31 LEAD, BENCH-145; docs/plan-team-top5.md section 18).
# Team thread: team-only, duel and melee fixtures bit for bit. Leigh 2026-10-30: "our scores can come
# against mid and lower teams. Teams that play a leader control wise. Where killing it effectively
# ends the game." Nine teams in the field run on a leader's orders (Nightmare, Enjambre, BuggerHive,
# Slippery) or on droids fed by scanners (TroodonPack, Slartibartfass, Bakery, FourProphets,
# ImWithDroid). LEAD makes the gun lean 4x on the robot that started above 150 energy (the leader,
# 200), and with droids about (120) 2.5x on the robots that still see: when they fall the droids go blind.
#   lgprep  build aa, bb and ld (tmlead: LEAD forced on; the named teams play it on top of their entry)
#   lgbb    bb vs aa, the 9 teams x 16 seeds (base 6100), 10 rounds; lgld the same for ld
#   lgpick  per team, LEAD when its gain over both baselines is +3.0 points or more with the 95% low
#           end above zero (the counters rule); a team the table already names keeps its entry's modes
#   lggate  the picked table (mk) vs aa on the picked teams, 16 fresh seeds (base 6200); lggbb A/A
#   lgsum   projected team APS change = sum of the picked teams' gains / 46 (gate: +0.15 with the low
#           end above zero); only on PASS is the gated table written as the table to ship
# Each seed is a pair (the arm and aa): screens 2 x 9 x 16 x 2 = 576 battles, plus 64 per picked team
# for the gate, about 45 minutes to 1 h 15 at 12 workers (sizes itself to the host). Every step
# resumes where it stopped. Run it after pc-team-nododge (both name NightmareTeam; this one reads
# the table master ships).
# Stop rules on every battle step (halt; every battle fought is kept and a rerun resumes): 20 failed
# battles (a broken jar), no battle in 30 minutes (a hung step), or 40+ skipped turns a battle over the
# last 100 (the PR #331 build-up). A halt at the very start leaves the whole card unrun (576 screen
# battles plus 64 a picked team); a halt in lgbb leaves the rest of lgbb and all 288 of lgld; in lgld,
# the rest of lgld; in the gate steps, the rest of that step and lggbb. No early finish on score: the
# pick is per team.
# The team thread reads claude/pc-team-lead-results.
#   ./queue.sh run pc-team-lead        (or  .\queue.ps1 run pc-team-lead)
# Run it from master (one bench queue at a time):
#   git checkout master && git pull

set OUT = ../docs/bench/local
set T = python3 tools/team_modes.py

lgprep | git checkout -q master && V=$(sed -n 's:.*<robot.release>\(.*\)</robot.release>.*:\1:p' ../hadur-robot/pom.xml) && test -n "$V" && rm -f bisect/hadur117.HadurTeam_"$V"aa.jar bisect/hadur117.HadurTeam_"$V"bb.jar bisect/hadur117.HadurTeam_"$V"ld.jar bisect/hadur117.HadurTeam_"$V"mk.jar && rm -f ${OUT}/team-lead-*.md ${OUT}/team-lead-pick.tsv ${OUT}/team-lead-locked.java.txt work/team-lead-picked.java work/team-lead-gate.txt && ./fetch-opponents.sh --set plans/team-lead-set.txt && bash ./build-ablation.sh aa && bash ./build-ablation.sh bb && bash ./build-ablation.sh tmlead && mkdir -p work && rm -rf work/team-lead-"$V"-bb work/team-lead-"$V"-ld work/team-lead-"$V"-gate work/team-lead-"$V"-gbb && for a in bb ld gate gbb; do sed "s/@V@/$V/g" plans/team-lead-$a.args > work/team-lead-$a.args || exit 1; done && for j in aa bb ld; do test -f bisect/hadur117.HadurTeam_"$V"$j.jar || exit 1; done && mvn -q compile
lgbb   | mvn -q exec:java "-Dexec.args=@work/team-lead-bb.args"
  after: lgprep
  watch: battles=288
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100
lgld   | mvn -q exec:java "-Dexec.args=@work/team-lead-ld.args"
  after: lgbb
  watch: battles=288
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100
lgpick | ${T} pick --report LEAD=${OUT}/team-lead-ld.md --control LEAD=${OUT}/team-lead-bb.md --min-mean 3.0 --low-end 0 --base MATEFIRE,HUNT,PATH,DODGE --shipped ../hadur-core/src/main/java/hadur117/core/melee/TeamModes.java --census team-census46.txt --opponents opponents --out-md ${OUT}/team-lead-pick.md --out-tsv ${OUT}/team-lead-pick.tsv --out-java work/team-lead-picked.java --out-set work/team-lead-gate.txt && if [ -s work/team-lead-picked.java ]; then TEAM_MODE_LOCKED="$(pwd)/work/team-lead-picked.java" bash ./build-ablation.sh tmlock; else echo "nothing picked: no gate"; fi
  after: lgld
lggate | if [ -s work/team-lead-picked.java ]; then mvn -q exec:java "-Dexec.args=@work/team-lead-gate.args"; else echo "nothing picked: no gate"; fi
  after: lgpick
  watch:
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100
lggbb  | if [ -s work/team-lead-picked.java ]; then mvn -q exec:java "-Dexec.args=@work/team-lead-gbb.args"; else echo "nothing picked: no gate"; fi
  after: lggate
  watch:
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100
lgsum  | if [ -s work/team-lead-picked.java ]; then ${T} gate --report ${OUT}/team-lead-gate.md --control ${OUT}/team-lead-gbb.md --set work/team-lead-gate.txt --seeds 16 --teams 46 --min-aps 0.15 --out-md ${OUT}/team-lead-verdict.md && if grep -q '\*\*PASS\*\*' ${OUT}/team-lead-verdict.md; then cp work/team-lead-picked.java ${OUT}/team-lead-locked.java.txt; else echo "gate failed: no table to ship"; fi; else echo "LEAD cleared the screen on no team: no gate, the table stays as shipped." > ${OUT}/team-lead-verdict.md; fi
  after: lggbb
lgpr   | bash tools/open_results_pr.sh claude/pc-team-lead-results "Lean on the enemy leader: per-team screen, pick and gate" $(ls ${OUT}/team-lead-*.md ${OUT}/team-lead-pick.tsv ${OUT}/team-lead-locked.java.txt 2>/dev/null)
  after: lgsum
