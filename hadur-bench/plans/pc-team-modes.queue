# Team mode table (T7, docs/bench/team-top-decompile.md section 5, requirements T7 notes): one
# screen per team mode against all 46 TeamRumble teams, pick each team's mode, confirm the picks on
# fresh seeds, then census the confirmed table.
#   ./queue.sh run pc-team-modes        (or  .\queue.ps1 run pc-team-modes)
# Run from master with RoboRumble workers at 0, after pc-table-v1 is done. Team-only: every jar
# here plays as master off a team.
#
#   baseline  aa: master rebuilt (3.15 + T6/T7 code, every switch and mode off).
#   bb     A/A: master again under another name. Prices the run's noise.
#   ms     TMODE-2 SOFT forced on against every team.
#   mg     TMODE-3 GANG forced on against every team.
#   mf     TMODE-4 FINISH forced on against every team.
#   LEARN  is read from team-s2's dl report (MMOVE-10 forced on, seeds 2500), not run again.
# Screens: 46 teams x 6 seeds x 2 = 552 battles a step (about 30-35 min at --parallel 12).
# pick:    for each team, the mode whose paired gain has its 95% low end above zero.
# confirm: the screen's table (mt) on the picked teams only, 12 fresh seeds.
# lock:    keep a pick only where confirm gained at least +1.0 point.
# census:  the confirmed table (mk) against all 46 teams, 6 fresh seeds, paired with aa.
# Gate: census mean at least +3.0 points with the interval above +1.5 (bb inside +/- 1.0).
# About 2,800-3,100 battles, 3 h. Every bench step resumes where it stopped (BENCH-96).
# When done, the PC commits the reports to claude/pc-team-modes-results and opens a PR.

set OUT = ../docs/bench/local
set T = python3 tools/team_modes.py

prep | bash ./build-ablation.sh aa && bash ./build-ablation.sh bb && bash ./build-ablation.sh tmsoft && bash ./build-ablation.sh tmgang && bash ./build-ablation.sh tmfin && ./fetch-opponents.sh --set team-census46.txt && { test -f ${OUT}/2026-10-24_team-s2-dl.md || { git fetch -q origin claude/pc-team-s2-results && git show FETCH_HEAD:docs/bench/local/2026-10-24_team-s2-dl.md > ${OUT}/2026-10-24_team-s2-dl.md; }; } && (cd .. && mvn -q -DskipTests install -pl hadur-core -am) && mvn -q compile

bb    | mvn -q exec:java "-Dexec.args=@plans/team-modes-bb.args"
  after: prep
ms    | mvn -q exec:java "-Dexec.args=@plans/team-modes-ms.args"
  after: bb
mg    | mvn -q exec:java "-Dexec.args=@plans/team-modes-mg.args"
  after: ms
mf    | mvn -q exec:java "-Dexec.args=@plans/team-modes-mf.args"
  after: mg

pick | ${T} pick --report SOFT=${OUT}/team-modes-ms.md --report GANG=${OUT}/team-modes-mg.md --report FINISH=${OUT}/team-modes-mf.md --report LEARN=${OUT}/2026-10-24_team-s2-dl.md --aa ${OUT}/team-modes-bb.md --census team-census46.txt --opponents opponents --out-md ${OUT}/team-modes-pick.md --out-tsv ${OUT}/team-modes-pick.tsv --out-java work/team-modes-screen.java --out-set work/team-modes-confirm.txt && bash ./build-ablation.sh tmtab
  after: mf
confirm | if grep -qv '^#' work/team-modes-confirm.txt; then mvn -q exec:java "-Dexec.args=@plans/team-modes-confirm.args"; else echo "no team picked a mode: nothing to confirm"; fi
  after: pick
lock | if [ -f ${OUT}/team-modes-confirm.md ]; then ${T} lock --confirm ${OUT}/team-modes-confirm.md --pick-tsv ${OUT}/team-modes-pick.tsv --census team-census46.txt --opponents opponents --min-gain 1.0 --out-md ${OUT}/team-modes-lock.md --out-java work/team-modes-locked.java; else : > work/team-modes-locked.java; fi && bash ./build-ablation.sh tmlock
  after: confirm
census | if [ -s work/team-modes-locked.java ]; then mvn -q exec:java "-Dexec.args=@plans/team-modes-census.args"; else echo "no pick confirmed: no census"; fi
  after: lock

pr | bash tools/open_results_pr.sh claude/pc-team-modes-results "Team mode table: per-mode screens, confirm and census" $(ls ${OUT}/team-modes-*.md ${OUT}/team-modes-pick.tsv 2>/dev/null)
  after: census
