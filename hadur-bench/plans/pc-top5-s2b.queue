# Top-5 plan, Stage 2 half 2: the same factorial on the other half of the census (docs/plan-top5.md 7.2, 7.4).
# Half 1 (2026-10-22, docs/bench/local/2026-10-22_top5-s2-half1.md) left sw at +0.18 +/- 0.13 and F at
# +0.10 +/- 0.13, both in the 0.10-0.25 zone where 7.4 runs half 2. 12 workers unpinned (Stage 0).
#   ./queue.sh run pc-top5-s2b        (or  .\queue.ps1 run pc-top5-s2b)
# One bench queue, RoboRumble workers at 0. Resumable (a stop mid-half2 restarts half2).
#
# 17 arms, 1 seed, on top5-census-half2.txt (the other 606 bots): 10,302 battles, about 4.3 h at
# 12 workers (half 1's measured rate). prep rebuilds the same 16 jars (about 8 min).
#   Read: half 2 alone, then both halves pooled (1,212 bots, intervals about +/- 0.09). Keep rule
#   (7.4): a factor ships at >= +0.10 with its pooled interval above 0 and no segment below -0.05 APS.
# Reports: ../docs/bench/local/<date>_top5-s2-half2.md and <date>_top5-s2-pooled.md

set P = --parallel 12
set HEAP = --child-heap 2G
set E = --engine 1.11.1
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant 1488498 ${HEAP} ${E}
set READ = --census census-312.txt --segments plans/top5-segments.tsv --design plans/top5-factorial.design

prep | mkdir -p bisect && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur2.Hadur_3.14.jar bisect/ && bash ./build-ablation.sh aa && bash ./build-ablation.sh thgun,freegun,nodecay,ram2,flat,nolearn && bash ./build-ablation.sh hitclr,pkern,keep2,ram2,flat,fin && bash ./build-ablation.sh hitclr,pkern,keep2,thgun,freegun,nodecay,fin,nolearn && bash ./build-ablation.sh swall,flat,fin,nolearn && bash ./build-ablation.sh swall,thgun,freegun,nodecay,ram2,fin && bash ./build-ablation.sh swall,hitclr,pkern,keep2,ram2,nolearn && bash ./build-ablation.sh swall,hitclr,pkern,keep2,thgun,freegun,nodecay,flat && bash ./build-ablation.sh heatjit,ram2,fin,nolearn && bash ./build-ablation.sh heatjit,thgun,freegun,nodecay,flat,fin && bash ./build-ablation.sh heatjit,hitclr,pkern,keep2,flat,nolearn && bash ./build-ablation.sh heatjit,hitclr,pkern,keep2,thgun,freegun,nodecay,ram2 && bash ./build-ablation.sh heatjit,swall,ram2,flat && bash ./build-ablation.sh heatjit,swall,thgun,freegun,nodecay,nolearn && bash ./build-ablation.sh heatjit,swall,hitclr,pkern,keep2,fin && bash ./build-ablation.sh heatjit,swall,hitclr,pkern,keep2,thgun,freegun,nodecay,ram2,flat,fin,nolearn && ./fetch-opponents.sh --set top5-census-half2.txt && mvn -q compile

half2 | ./bench-top20.sh ${C} ${P} --set top5-census-half2.txt --seeds 1 --seed-base 1500 --arms plans/top5-factorial.arms --out work/top5-s2-half2 --label top5-s2-half2
  after: prep

half2-read | python3 tools/round0_skips.py work/top5-s2-half2 work/top5-s2-half2/round0.tsv && python3 ../data/tools/multiarm.py work/top5-s2-half2/arms.tsv ${READ} --out ../docs/bench/local/$(date +%Y-%m-%d)_top5-s2-half2.md
  after: half2

pooled-read | python3 ../data/tools/multiarm.py work/top5-s2-half1/arms.tsv work/top5-s2-half2/arms.tsv ${READ} --out ../docs/bench/local/$(date +%Y-%m-%d)_top5-s2-pooled.md
  after: half2-read
