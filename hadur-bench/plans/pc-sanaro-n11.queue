# Sanaro's stage N14 (docs/sanaro.md section 22): hold fire past a range. 0.4 (BAND 480, banked) never
# holds fire: past 480 px its power step is 0 and Robocode lifts setFire(0) to a 0.1 shot, which heats
# the gun for nothing. These arms fire nothing past 512, 480 or 400 px.
#   ./queue.sh run pc-sanaro-n11        (or  .\queue.ps1 run pc-sanaro-n11)
# Run it from master:
#   git checkout master && git pull
# One bench queue, RoboRumble workers at 0, unpinned, 12 workers. Every step resumes; no step needs
# a decision. Nothing here touches Hadur, Saor, TwinSaor, Deise, JayLexi or Eveimear. No teach run.
#
# Why it should win: a 0.1 shot past 480 px all but never hits in a ten-robot melee and costs 1.02
# gun heat. That is about 10 ticks in which a robot that closes to 200 px cannot be shot at full
# power. n09 and n10 found that weaker fire buys survival (23.8 to 28.2) at no APS cost, and B480
# passed twice (+0.10, +0.30). Holding fire is the end of that slope: no energy and no heat spent on
# far shots. H512's 5-byte form is if (((int) (aim * (range = d)) / GATE | d >> 9) == 0) (javac 249 ->
# 254 B; 250 B with the hand pass, so one byte short); the arm is built as && d < 512, the same play. H480 and H400 measure the slope. The arms are over the byte limit on
# purpose (Leigh 2026-11-05: measure the idea first, then find the bytes for a winner).
#
# Arms (sanaro-arms/arms.txt, on 0.4's source):
#   S4    Sanaro 0.4 as banked (control, 249 B)
#   H512  hold fire past 512 px
#   H480  hold fire past 480 px, where 0.4's step reaches 0
#   H400  hold fire past 400 px
# Live-shaped census: 43 fields x 20 fresh seeds (base 29000) = 860 battles an arm, about 50 min an
# arm at n10's rate. About 3 h 20 min in all, plus the pilot.
# Pilot (Leigh's rule, 2026-11-03): the first 4 of the 20 seeds of every arm (172 battles an arm,
# 20% of the run, about 40 min). sanaro_read --stop-below 0 then stops the card and opens the
# results PR unless some hold arm reads at or above S4. The full steps resume the pilot's battles.
# Read against S4. An arm passes when the low end of its difference is above zero (SANARO-13). A
# passing arm is 0.5 once its bytes are found, on Leigh's word.
# Stop rules on every battle step (docs/bench/watch.md; halt, every battle fought is kept and a
# rerun resumes):
# - 20 failed battles (a broken jar).
# - No battle in 30 minutes (a hung step).
# - 40+ skipped turns a battle over the last 100 (the PR #331 build-up).
# - The pilot gate above (exit 3 ends the card with a results PR).
# ALERT opens an issue for Leigh on a stop.

set MVN = mvn -q -Drobocode.version=1.11.1 compile exec:java
set OUT = ../docs/bench/local
set ALERT = lgriffin
set ARMS = S4,H512,H480,H400
set W = work/sanaro-n11

prep | (cd .. && mvn -q -DskipTests install -pl sanaro -am) && mkdir -p ${W} && cp ../sanaro/target/hadur117.nano.Sanaro_0.4.jar opponents/ && ./fetch-opponents.sh --set nanomelee-field.txt && for f in melee-census-317/f*.txt; do ./fetch-opponents.sh --set "$f" || exit 1; done

arms | SANARO_RUN=n11 bash tools/sanaro_arms.sh live 20 29000 ${ARMS} && for a in S4 H512 H480 H400; do sed '/^--seeds$/{n;s/.*/4/;}' ${W}/live-$a.args > ${W}/pilot-$a.args || exit 1; done
  after: prep

pilot-S4 | ${MVN} "-Dexec.args=@${W}/pilot-S4.args"
  after: arms
  watch: battles=172
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

pilot-H512 | ${MVN} "-Dexec.args=@${W}/pilot-H512.args"
  after: pilot-S4
  watch: battles=172
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

pilot-H480 | ${MVN} "-Dexec.args=@${W}/pilot-H480.args"
  after: pilot-H512
  watch: battles=172
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

pilot-H400 | ${MVN} "-Dexec.args=@${W}/pilot-H400.args"
  after: pilot-H480
  watch: battles=172
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

pilot | python3 tools/sanaro_read.py --work-root ${W} --field live --arms ${ARMS} --control S4 --only ${W}/live/micro.txt --live 66.44 --stop-below 0 > ${OUT}/sanaro-n11-pilot.md; rc=$?; if [ $rc -eq 3 ]; then bash tools/open_results_pr.sh claude/pc-sanaro-n11-results "Sanaro stage N14: hold fire past a range (stopped at the pilot)" ${OUT}/sanaro-n11-pilot.md; fi; exit $rc
  after: pilot-H400

live-S4 | ${MVN} "-Dexec.args=@${W}/live-S4.args"
  after: pilot
  watch: battles=860
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-H512 | ${MVN} "-Dexec.args=@${W}/live-H512.args"
  after: live-S4
  watch: battles=860
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-H480 | ${MVN} "-Dexec.args=@${W}/live-H480.args"
  after: live-H512
  watch: battles=860
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-H400 | ${MVN} "-Dexec.args=@${W}/live-H400.args"
  after: live-H480
  watch: battles=860
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

read-live | python3 tools/sanaro_read.py --work-root ${W} --field live --arms ${ARMS} --control S4 --only ${W}/live/micro.txt --live 66.44 > ${OUT}/sanaro-n11-live.md
  after: live-H400

pr | bash tools/open_results_pr.sh claude/pc-sanaro-n11-results "Sanaro stage N14: hold fire past a range against 0.4" ${OUT}/sanaro-n11-pilot.md ${OUT}/sanaro-n11-live.md ${OUT}/sanaro-n11-live-*.md
  after: read-live
