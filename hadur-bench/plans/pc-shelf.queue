# 1v1, K3 shelf: a per-robot menu of the duel's per-opponent switches on the 210 robots where BeepBoop or DrussGT
# out-score Hadur 3.21 by 6+ points live (BENCH-180). Leigh starts it once the PC is free (not beside another card):
#   git checkout master && git pull
#   .\queue.ps1 run pc-shelf        (or  ./queue.sh run pc-shelf)
# One bench queue, RoboRumble workers at 0, unpinned, 12 workers, truth log off. Every step resumes; no step needs a
# decision. About 3 hours if it runs to the end (screens 1,155 + 5,310 battles, then the picks x 3 arms x 12 fresh
# seeds); a panel whose pilot fails skips its screen (U's pilot stops it at about 25 minutes, S's at about 5).
#
# Why it should win (Leigh's card rule, 2026-11-03):
#   - Per-opponent tailoring only: every arm turns one switch on against named robots, and the confirm jar plays each
#     robot with the one switch its screen picked, master everywhere else. This is the K3 shelf as a table: the
#     per-robot configuration (shield or not, stop-and-go, stop-and-start, gun stack, still shots, exits, opening
#     drive) chosen by measurement, robot by robot.
#   - It is the method that has paid: mode table v1 (+49 shield lines, PR #244), shield part 2 (PR #256), the rival's
#     per-opponent picks (pc-rival-confirm +0.08 APS, PR #537), and the mimic picks (PR #603 +0.03, PR #615) are all
#     per-robot picks of a switch, confirmed on fresh seeds.
#   - The robots: the 210 with the most room, where the two robots above us score 6 to 60 points more live (Mjolnir,
#     Diamond, CassiusClay, Firestarter, Mirage, Neuromancer ...). Live per-pairing reads are noisy, so these rank
#     candidates; the screen decides. 177 are off the shield list (panel U), 33 on it (panel S).
#   - The switches have never been tried against most of these robots: of the 177, 74 had the shield tried and 36
#     stop-and-go (pc-rival-picks); stop-and-start and the gun stack were tried on 14 robots only (pc-1v1-factor), the
#     shield-execution switches on 50 shield robots.
#   - What it can win: the past menus locked about 1 robot in 8 at +5 points; 25 of 210 at +5 is +0.10 APS.
#   - Risk: each switch hurts most robots (that is why they ship off); the screen reads every arm on every robot, and
#     only a per-robot pick that holds on fresh seeds ships.
# Pilot (tools/shelf_pilot.py, the first of 5 seeds, 20% of each screen): for each switch arm, the robots it beats c on
# by 5+ points, against the A/A copy's count (pure noise). The screen runs only when some switch beats the A/A's count
# by 3+ robots; otherwise the panel skips its screen and confirm, and the PR says so. A panel-mean futility rule cannot
# judge a menu (a switch can lose on average and win big on a few robots), so the pilot reads robots, not the mean.
#
# screens: S 33 robots x c, aa, md, zl, x0, x4, mv; U 177 robots x c, aa, mt, wl, hl, gl; 5 seeds from 9300.
# pick:    mode_table.py, the best arm per robot at a 3-point margin with its interval above 0.
# confirm: one jar (sh, tools/shelf_build.py) with every pick's switch on for its own robot; c, aa, sh x 12 fresh seeds
#          from 9500 on the picked robots. Gate: sh minus pooled c and aa over the picks / 1,217 pairings, 95% low end
#          above 0; Claude ships the picks that hold (+1 point or more on the confirm) from the results PR. Nothing
#          ships from the card itself.
# Stop rules (docs/bench/watch.md): halt on 30 failed battles, an arm scoring nothing in 8, 60+ skipped turns a battle
# over the last 200, no battle in 30 minutes, or (screens) an A/A outside its band after 20%; every battle fought is
# kept and a rerun resumes. The pilot writes work/shelf-*.stop; build clears old confirm reports first, and with no
# pick the confirm and gate pass through and the PR carries the screens. ALERT opens an issue for Leigh on any stop.
# --failed-ok (BENCH-187): a robot that will not load on 1.11.2 leaves failed rows the readers skip, and the step
# still passes while under 1 battle in 20 fails (zen.Mirage and zen.Ronin did this, issue #630; now in broken-1.11.2.txt).

set V = 3.21
set P = --parallel 12 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant 1488498 --child-heap 2G
set W = work/shelf
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && rm -f work/shelf-s.stop work/shelf-u.stop && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && SHIELD_ADD=plans/shelf-u.list bash ./build-ablation.sh slistadd && STOP_GO=plans/shelf-u.list bash ./build-ablation.sh sgolist && HEAT_JIT=plans/shelf-u.list bash ./build-ablation.sh hjlist && GUN_STACK=plans/shelf-u.list bash ./build-ablation.sh gslist && SHIELD_DROP=plans/shelf-s.list bash ./build-ablation.sh slistdrop && SHIELD_STILL=plans/shelf-s.list bash ./build-ablation.sh szlist && SHIELD_EXIT0=plans/shelf-s.list bash ./build-ablation.sh sx0list && SHIELD_EXIT4=plans/shelf-s.list bash ./build-ablation.sh sx4list && SHIELD_MOVE=plans/shelf-s.list bash ./build-ablation.sh smovelist && for s in aa mt wl hl gl md zl x0 x4 mv; do test -f bisect/hadur117.Hadur_${V}$s.jar || exit 1; done && ./fetch-opponents.sh --set panel-shelf-s.txt && ./fetch-opponents.sh --set panel-shelf-u.txt && mvn -q compile

pilot-s | ./bench-top20.sh ${C} ${P} --set panel-shelf-s.txt --seeds 1 --seed-base 9300 --arms plans/shelf-s.arms --out ${W}/s --label shelf-s --shuffle-jobs && python3 tools/shelf_pilot.py ${W}/s/arms.tsv --arms md zl x0 x4 mv --out ${OUT}/$(date +%Y-%m-%d)_shelf-s-pilot.md --stop-file work/shelf-s.stop
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m

screen-s | if [ -f work/shelf-s.stop ]; then echo 'pilot S: no switch above chance, screen skips'; exit 0; fi && ./bench-top20.sh ${C} ${P} --set panel-shelf-s.txt --seeds 5 --seed-base 9300 --arms plans/shelf-s.arms --out ${W}/s --label shelf-s --shuffle-jobs
  after: pilot-s
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m
  stop: aa after 20%

pilot-u | ./bench-top20.sh ${C} ${P} --set panel-shelf-u.txt --seeds 1 --seed-base 9300 --arms plans/shelf-u.arms --out ${W}/u --label shelf-u --shuffle-jobs && python3 tools/shelf_pilot.py ${W}/u/arms.tsv --arms mt wl hl gl --out ${OUT}/$(date +%Y-%m-%d)_shelf-u-pilot.md --stop-file work/shelf-u.stop
  after: screen-s
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m

screen-u | if [ -f work/shelf-u.stop ]; then echo 'pilot U: no switch above chance, screen skips'; exit 0; fi && ./bench-top20.sh ${C} ${P} --set panel-shelf-u.txt --seeds 5 --seed-base 9300 --arms plans/shelf-u.arms --out ${W}/u --label shelf-u --shuffle-jobs
  after: pilot-u
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m
  stop: aa after 20%

pick | rm -f ${OUT}/shelf-s-pick.tsv ${OUT}/shelf-u-pick.tsv && if [ ! -f work/shelf-s.stop ]; then python3 ../data/tools/multiarm.py ${W}/s/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_shelf-s-screen.md && python3 ../data/tools/mode_table.py ${W}/s/arms.tsv --margin 3 --out-tsv ${OUT}/shelf-s-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_shelf-s-pick.md && python3 tools/per_robot.py ${W}/s/arms.tsv --arms md zl x0 x4 mv --out ${OUT}/$(date +%Y-%m-%d)_shelf-s-per-robot.md --out-tsv ${OUT}/shelf-s-per-robot.tsv || exit 1; fi && if [ ! -f work/shelf-u.stop ]; then python3 ../data/tools/multiarm.py ${W}/u/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_shelf-u-screen.md && python3 ../data/tools/mode_table.py ${W}/u/arms.tsv --margin 3 --out-tsv ${OUT}/shelf-u-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_shelf-u-pick.md && python3 tools/per_robot.py ${W}/u/arms.tsv --arms mt wl hl gl --out ${OUT}/$(date +%Y-%m-%d)_shelf-u-per-robot.md --out-tsv ${OUT}/shelf-u-per-robot.tsv || exit 1; fi
  after: screen-u

build | rm -f ${OUT}/*_shelf-confirm*.md ${OUT}/shelf-confirm-per-robot.tsv && python3 tools/shelf_build.py --version ${V} --work ${W}/jar --panel panel-shelf-s.txt panel-shelf-u.txt --panel-out work/panel-shelf-picks.txt ${OUT}/shelf-s-pick.tsv ${OUT}/shelf-u-pick.tsv
  after: pick

confirm | if [ ! -s work/panel-shelf-picks.txt ]; then echo 'no picks'; exit 0; fi && ./bench-top20.sh ${C} ${P} --set work/panel-shelf-picks.txt --seeds 12 --seed-base 9500 --arms ${W}/jar/shelf.arms --out ${W}/confirm --label shelf-confirm --shuffle-jobs
  after: build
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m

gate | if [ ! -s work/panel-shelf-picks.txt ]; then echo 'no picks'; exit 0; fi && python3 ../data/tools/multiarm.py ${W}/confirm/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_shelf-confirm.md && python3 tools/shield_s2.py gate ${W}/confirm/arms.tsv --arm sh --panel work/panel-shelf-picks.txt --bar 0 --out ${OUT}/$(date +%Y-%m-%d)_shelf-confirm-gate.md && python3 tools/per_robot.py ${W}/confirm/arms.tsv --arms sh --out ${OUT}/$(date +%Y-%m-%d)_shelf-confirm-per-robot.md --out-tsv ${OUT}/shelf-confirm-per-robot.tsv
  after: confirm

pr | bash tools/open_results_pr.sh claude/pc-shelf-results "1v1 K3 shelf: per-robot switch menu on the 210 robots with the most room" ${OUT}/*_shelf-*.md $(find ${OUT} -maxdepth 1 -name 'shelf-*.tsv' -size +0c)
  after: gate
