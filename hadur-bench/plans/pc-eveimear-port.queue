# Eveimear: the Cotillion transplant fitted to 749 bytes (thread "Take 1st with JayLexi, Eveimear and Sanaro";
# BENCH-200). pc-eveimear-cot (PR #669) found the whole gap to Cotillion: XR, Eveimear 0.4's movement with Cotillion's
# gun, radar, power and reversal rule, read +1.90 +- 0.63 points a robot over 0.4 (Cotillion itself +1.78 +- 0.67,
# A/A -0.03), but at 823 B. P is the fitted build: Cotillion 0.8's own code plus Eveimear's per-robot mode table,
# 749 B with ProGuard (kitlab/arms/Eveimear-port.java).
#   ./queue.sh run pc-eveimear-port        (or  .\queue.ps1 run pc-eveimear-port)
# Run it from master with this card merged: git checkout master && git pull
# One bench queue, RoboRumble workers at 0, unpinned. Nothing here touches the shipped Eveimear; nothing is uploaded or
# released. About 30 minutes to the end.
#
# Why it should win: P keeps everything XR measured except three Cotillion-faithful details that the bytes forced:
# the switch to random mode counts hits in Cotillion's units (5 / bullet speed against 2 + round, times the robot's
# mode) instead of Eveimear's (bonus energy against 40 + 23 a round, times the mode); a hit of ours books 10 energy off
# the enemy (Cotillion's) instead of the exact damage; and the radar is reset every tick as Cotillion does. Cotillion
# itself, with all three, read within noise of XR. The card checks that P holds XR's level at 749 B.
#
# Pilot (the rule of 2026-11-03): shuffled jobs, so the first 20% are a fair sample. At 20% the futility rule finishes
# the run when P can no longer reach +0.3 points over c. The A/A rule halts it if aa leaves its band against c.
# Panel: kitlab/micro-wide2-field.txt (112 robots) x 12 fresh seeds from 35000 x 35 rounds; 5 arms = 6,720 battles.
# Read: each arm against c and aa pooled. P passes when its low end against c is above +0.3 and it is inside XR's
# interval; it is then Eveimear 0.5 on Leigh's word. Stop rules: fails 30, dead 8, skips 60 over 200, stall 30m
# (halt; every battle fought is kept and a rerun resumes), aa after 20% (halt), futility P below 0.3 after 20%
# (finish). ALERT opens an issue for Leigh on a stop.

set C = --skip-build --skip-fetch --rounds 35 --parallel auto --child-heap 512M --no-truth-log
set SRC = ../eveimear/src/main/java/hadur117/micro/Eveimear.java
set W = work/eveimear-port
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && rm -f ${OUT}/*_eveimear-port*.md && mkdir -p ${W} kitlab/jars && ./fetch-opponents.sh --set kitlab/micro-wide2-field.txt && mvn -q compile && bash kitlab/build_arm_pg.sh ${SRC} hadur117.micro.Eveimear 0.4c && bash kitlab/build_arm_pg.sh ${SRC} hadur117.micro.Eveimear 0.4aa && bash kitlab/build_arm_pg.sh kitlab/arms/Eveimear-port.java hadur117.micro.Eveimear 0.5P && bash kitlab/build_arm_pg.sh kitlab/arms/Eveimear-cotXR.java hadur117.micro.Eveimear 0.4XR

bench | sh ./bench-top20.sh ${C} --set kitlab/micro-wide2-field.txt --seeds 12 --seed-base 35000 --arms plans/eveimear-port.arms --out ${W}/run --label eveimear-port --shuffle-jobs --failed-ok
  after: prep
  watch:
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m
  stop: aa after 20%
  stop: futility P below 0.3 after 20%

gate | python3 ../data/tools/multiarm.py ${W}/run/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_eveimear-port.md && printf '\n## Sizes\n\nc 0.4 742 B; P 749; XR 823; Cotillion 729 (ProGuard builds, kitlab_codesize.py). P passes when its 95%% low end against c is above +0.3 points and it sits inside the XR interval.\n' >> ${OUT}/$(date +%Y-%m-%d)_eveimear-port.md && { [ ! -f ${W}/run/EARLY-STOP.md ] || cat ${W}/run/EARLY-STOP.md >> ${OUT}/$(date +%Y-%m-%d)_eveimear-port.md; }
  after: bench

pr | bash tools/open_results_pr.sh claude/pc-eveimear-port-results "Eveimear: the Cotillion transplant at 749 B (pc-eveimear-port)" ${OUT}/*_eveimear-port.md
  after: gate
