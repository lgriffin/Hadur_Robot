# 1v1, the full-power rules off per opponent against the mid-field learners (BENCH-173, POW-15). Leigh starts it once
# the PC is free (not beside another card: two cards on one checkout collide):
#   git checkout master && git pull
#   .\queue.ps1 run pc-full-off        (or  ./queue.sh run pc-full-off)
# One bench queue, RoboRumble workers at 0, unpinned, 12 workers, truth log off. Every step resumes; no step needs a
# decision. About 45 min of battles (screen 167 x 3 arms x 3 seeds = 1,503; confirm the picks x 3 arms x 4 seeds).
#
# Why: DrussGT leads us by +0.22 APS over these 167 (BeepBoop by +0.53), all from survival. Cloud read 2026-11-02, same
# 24 robots and seeds: DrussGT and 3.21 deal and take the same damage, but we spend 10-15 more energy a round firing
# and survive 90% of rounds to its 96%; 15% of our shots are power 2.5-3 (POW-4 mostly) against its 2%. With the
# full-power rules off for those 24 (fp): survival 89.8% -> 92.6%, score +0.95 +- 0.70 points a robot (Neutrino +8.9,
# Morfeas +8.3, PinkerStinker +5.6; Rabbit -4.7, WaveRammer -3.1). Mixed, so per robot: screen, pick, confirm.
#
# screen:  the 167 (panel-midfield.txt) x c, aa, fp (all 167 named) x 3 fresh seeds from 8000.
# pick:    a per-robot pick at a 5-point margin (fp over pooled c and aa, low end above 0).
# confirm: the picks x c, aa, fp (picks only) x 4 fresh seeds from 8100; gate +0.03 APS, 95% low end above 0.
# Stop rules (docs/bench/watch.md): halt on 30 failed battles, an arm scoring nothing in 8, 60+ skipped turns a battle
# over the last 200, or no battle in 30 minutes; every battle fought is kept and a rerun resumes. A halt leaves the
# rest of the card unrun. ALERT opens an issue for Leigh on any stop. Nothing here ships: the confirmed robots go into
# ShieldTableData.fullOffs() by PR; the release rule stands.

set V = 3.21
set P = --parallel 12 --no-truth-log
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant 1488498 --child-heap 2G
set W = work/full-off
set W2 = work/full-off2
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && FULL_OFF=plans/full-off-all.list bash ./build-ablation.sh fplist && test -f bisect/hadur117.Hadur_${V}fp.jar && ./fetch-opponents.sh --set panel-midfield.txt && mvn -q compile

screen | ./bench-top20.sh ${C} ${P} --set panel-midfield.txt --seeds 3 --seed-base 8000 --arms plans/full-off.arms --out ${W} --label full-off --shuffle-jobs
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m

pick | python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_full-off-screen.md && python3 ../data/tools/mode_table.py ${W}/arms.tsv --margin 5 --out-tsv ${OUT}/full-off-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_full-off-pick.md
  after: screen

prep2 | python3 tools/pick_panel.py ${OUT}/full-off-pick.tsv panel-midfield.txt work/panel-full-off-picks.txt && FULL_OFF=${OUT}/full-off-pick.tsv bash ./build-ablation.sh fplist && test -f bisect/hadur117.Hadur_${V}fp.jar
  after: pick

confirm | ./bench-top20.sh ${C} ${P} --set work/panel-full-off-picks.txt --seeds 4 --seed-base 8100 --arms plans/full-off2.arms --out ${W2} --label full-off2 --shuffle-jobs
  after: prep2
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m

gate | python3 ../data/tools/multiarm.py ${W2}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_full-off2.md && python3 tools/shield_s2.py gate ${W2}/arms.tsv --arm fp --panel work/panel-full-off-picks.txt --bar 0.03 --out ${OUT}/$(date +%Y-%m-%d)_full-off2-gate.md && python3 ../data/tools/mode_table.py ${W2}/arms.tsv --margin 3 --out-tsv ${OUT}/full-off2-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_full-off2-pick.md && python3 tools/per_robot.py ${W2}/arms.tsv --arms fp --out ${OUT}/$(date +%Y-%m-%d)_full-off2-per-robot.md --out-tsv ${OUT}/full-off2-per-robot.tsv
  after: confirm

pr | bash tools/open_results_pr.sh claude/pc-full-off-results "1v1 full-power rules off per opponent: POW-15 screen and confirm on the mid-field learners" ${OUT}/*_full-off*.md ${OUT}/full-off-pick.tsv ${OUT}/full-off2-per-robot.tsv $(find ${OUT} -maxdepth 1 -name full-off2-pick.tsv -size +0c)
  after: gate
