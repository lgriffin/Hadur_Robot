# Saor 0.4 rewrite, stage 2: our own gun chain under the parity gate (docs/plan-saor-first.md 8). Cloud card, 3
# workers, no alerts, no PR step.
#   ./queue.sh run cloud-saor-r2
#
# Why: Saor's first-order Markov chain, row sampling and fixed +-4 bin vote are Figment's. G2 keys each row on the last
# two states ((state * 31 + previous) % 1151, 256 name hashes, same 75 MB), so a playout follows pairs of moves, with
# Saor's graded vote and learn-every-scan kept. GV spreads each playout's vote over 2 + ticks / 8 bins a side (at
# most 8): a long shot, whose prediction is looser, votes wider. G2V is both. Whole-file arms (saor-arms/SaorG2.java,
# SaorGV.java, SaorG2V.java), javac 777 / 754 / 793 B.
# Parity gate and panel as cloud-saor-r2: MicroMelee census x 6 seeds from 4200, 108 battles an arm, about 35 min
# each. The stage 1 winner is stacked with the stage 2 winner at the fit, stage 4. Nothing is uploaded or released.

set MVN = mvn -q -Drobocode.version=1.11.1 compile exec:java
set OUT = ../docs/bench/local
set ARMS = C,AA,G2,GV,G2V

prep | (cd .. && mvn -q -DskipTests install -pl saor -am) && ./fetch-opponents.sh --set micromelee-field.txt && SAOR_RUN=r1 bash tools/saor_arms.sh census 6 4200 ${ARMS} && sed -i 's/^12$/3/; s/^2G$/512M/' work/saor-r2/census-*.args

census-C | ${MVN} "-Dexec.args=@work/saor-r2/census-C.args"
  after: prep

census-AA | ${MVN} "-Dexec.args=@work/saor-r2/census-AA.args"
  after: census-C

census-G2 | ${MVN} "-Dexec.args=@work/saor-r2/census-G2.args"
  after: census-AA

census-GV | ${MVN} "-Dexec.args=@work/saor-r2/census-GV.args"
  after: census-G2

census-G2V | ${MVN} "-Dexec.args=@work/saor-r2/census-G2V.args"
  after: census-GV

read | python3 tools/saor_arms.py --work-root work/saor-r2 --arms ${ARMS} --control C > ${OUT}/saor-r2-census.md
  after: census-G2V
