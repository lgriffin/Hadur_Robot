# 1v1, cloud locks to the PC (BENCH-253), round 39: the overnight card, 48 fresh seeds.
# Round 38 (plans/pc-locks.queue, #1111) carries DumDum, Foilist, Neuromancer, Saguaro, Seraphim and Domogled; this card
# has its own plan, panel, picks and arms files so it can run straight after round 38 from the same checkout.
# Round 39 carries 7 robots on existing table switches, each read on 12 or more fresh cloud seeds at 0.7x the live turn
# time against both c and aa, gain vs mean(c, aa) (coverage/shards/locks.tsv):
#   zl (SHIELD-20 still plans)    Help +9.9 +- 5.8 (12; low ends +3.6 vs c, +3.5 vs aa): we stand still 83% of the time,
#                                 BB 96%, and Help hits us 2.2% against 0.7%
#   pb (POW-20 bands, on rp)      Diamond +2.8 +- 1.8 (12), bands 0.77 0.53 0.71 2.65 on top of its banked race power
#   rlnrkn (RAM-20 and RAM-21)    Sabreur +2.3 (24, two blocks): an unlined rammer, over half the fight inside 150 px
#   fgl (GUN-12, on rp)           JKHydra +2.9 +- 0.9 (23, two blocks) on top of its race power banked in round 37
#   mt (shield list)              NeophytePRAL +2.1 +- 1.7 (24; the two blocks disagree, the PC decides)
#   rf (RAM flee)                 NanoSatanMelee +2.65 (12; low end vs c at 0, the PC decides)
#   rp (POW-17 race power)        Shadow, a re-read: cloud +3.5 +- 3.0 (24) against round 37's PC -1.0 (24); judged pooled
#                                 with round 37's PC seeds
# BeepBoop, DrussGT, ScalarR, Saguaro, Wavelet and Knight pad the A/A check to 13 robots on arm aa. The PC reads 48
# fresh seeds from 119000 (twice the usual, for the borderline lines) and a line ships only on the PC's own read.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: each line names one robot; every other robot, team and melee play bit for bit as master.
#   - Diagnosis: Help's gun punishes our movement where still shot plans keep the shield on; Diamond and JKHydra out-last
#     us in energy races that race power already narrowed, and the bands and free gun add on top; Sabreur and
#     NanoSatanMelee ram, and the rammer escape's shot models and flee fit; NeophytePRAL hits us 5-11% where BB shields it.
#   - Every line read positive against both controls at PC-like turn time on fresh cloud seeds; 48 PC seeds settle it.
#
# Stop rules (docs/bench/watch.md): no aa stop rule (aa is read in the gate). Each bench step halts on 30 failed
# battles, an arm scoring nothing in 8, 60+ skipped turns a battle over the last 24 or no battle in 30 minutes. The
# live-match step stops the card if the PC no longer scores us and BeepBoop as live does (tools/live_match.py exit 3).
# ALERT opens an issue for Leigh on any stop.
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live, in its
#              own folder (work/pc-locks39-livematch)
#   lock       panel-locks39.txt  c / aa, 48 fresh seeds from 119000, --cpu-constant live, in work/pc-locks39-ctl
#   stage      writes each lever's two-arm file (c and the lever) and copies in, times kept, the c battles of that lever's
#              own robots, so the bench reads them back (BENCH-95)
#   lock-X     each lever arm on its own picked robots only, same seeds, in work/pc-locks39-X
#   gate       each robot judged on its own lever arm only (lock_prep.py --restrict); it keeps its line where the 95% low
#              end is above 0 (mode_table.py --margin 0)
# Leigh starts it once the PC is free (it can be chained after round 38 in one PowerShell line, see the PR):
#   git checkout master && git pull
#   .\queue.ps1 run pc-locks39
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. 124 live-match battles and 1584 lock battles (13
# robots in c and aa, each lever robot again on its own arm, 48 seeds): 1708 in all, about 3 to 4 hours.
# The prep step stops if any panel robot's jar is missing.
#
set V = 3.25.1
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-locks39
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && python3 tools/lock_prep.py plans/locks39-pick.tsv panel-locks39.txt plans/pc-locks39.arms ${W}-prep && bash ${W}-prep/build.sh && for a in zl pb rlnrkn fgl mt rf rp; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; awk -F"\t" -v a=$a '$2 == a {print $1 " |"}' plans/locks39-pick.tsv > ${W}-prep/$a.names && grep -F -f ${W}-prep/$a.names panel-locks39.txt > ${W}-prep/$a.panel && grep "^$a |" ${W}-prep/lock.arms > ${W}-prep/$a.arms || exit 1; done && grep -E "^(c|aa) [|]" ${W}-prep/lock.arms > ${W}-prep/ctl.arms && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-locks39.txt && for j in $(grep -hv "^#" panel-locks39.txt | cut -d"|" -f3); do test -f opponents/$j || { echo "missing jar $j"; exit 1; }; done && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out ${W}-livematch --label pc-locks39-livematch --shuffle-jobs && python3 tools/live_match.py ${W}-livematch/arms.tsv --out ${OUT}/pc-locks39-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock | ./bench-top20.sh ${C} ${P} --set panel-locks39.txt --seeds 48 --seed-base 119000 --arms ${W}-prep/ctl.arms --out ${W}-ctl --label pc-locks39 --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

stage | for a in zl pb rlnrkn fgl mt rf rp; do grep -E "^(c|$a) [|]" ${W}-prep/lock.arms > ${W}-prep/$a-c.arms && mkdir -p ${W}-$a/battles || exit 1; for s in $(grep -v "^#" ${W}-prep/$a.panel | cut -d"|" -f1 | sed -E "s/^ +| +$//g; s/[^A-Za-z0-9.]+/_/g"); do cp -rp ${W}-ctl/battles/$s-*-c ${W}-$a/battles/ || exit 1; done; done
  after: lock

lock-zl | ./bench-top20.sh ${C} ${P} --set ${W}-prep/zl.panel --seeds 48 --seed-base 119000 --arms ${W}-prep/zl-c.arms --out ${W}-zl --label pc-locks39-zl --shuffle-jobs
  after: stage
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-pb | ./bench-top20.sh ${C} ${P} --set ${W}-prep/pb.panel --seeds 48 --seed-base 119000 --arms ${W}-prep/pb-c.arms --out ${W}-pb --label pc-locks39-pb --shuffle-jobs
  after: lock-zl
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-rlnrkn | ./bench-top20.sh ${C} ${P} --set ${W}-prep/rlnrkn.panel --seeds 48 --seed-base 119000 --arms ${W}-prep/rlnrkn-c.arms --out ${W}-rlnrkn --label pc-locks39-rlnrkn --shuffle-jobs
  after: lock-pb
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-fgl | ./bench-top20.sh ${C} ${P} --set ${W}-prep/fgl.panel --seeds 48 --seed-base 119000 --arms ${W}-prep/fgl-c.arms --out ${W}-fgl --label pc-locks39-fgl --shuffle-jobs
  after: lock-rlnrkn
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-mt | ./bench-top20.sh ${C} ${P} --set ${W}-prep/mt.panel --seeds 48 --seed-base 119000 --arms ${W}-prep/mt-c.arms --out ${W}-mt --label pc-locks39-mt --shuffle-jobs
  after: lock-fgl
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-rf | ./bench-top20.sh ${C} ${P} --set ${W}-prep/rf.panel --seeds 48 --seed-base 119000 --arms ${W}-prep/rf-c.arms --out ${W}-rf --label pc-locks39-rf --shuffle-jobs
  after: lock-mt
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock-rp | ./bench-top20.sh ${C} ${P} --set ${W}-prep/rp.panel --seeds 48 --seed-base 119000 --arms ${W}-prep/rp-c.arms --out ${W}-rp --label pc-locks39-rp --shuffle-jobs
  after: lock-rf
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

gate | mkdir -p ${W} && (cat ${W}-ctl/arms.tsv && for d in zl pb rlnrkn fgl mt rf rp; do awk -F"\t" -v a=$d 'NR > 1 && $1 == a' ${W}-$d/arms.tsv || exit 1; done) > ${W}/arms.tsv && python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks39-lock.md && python3 tools/lock_prep.py --restrict ${W}/arms.tsv ${W}-prep ${W}/arms-picked.tsv && python3 ../data/tools/mode_table.py ${W}/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-locks39-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-locks39-lock-pick.md && python3 tools/per_robot.py ${W}/arms-picked.tsv --arms zl pb rlnrkn fgl mt rf rp --out ${OUT}/$(date +%Y-%m-%d)_pc-locks39-lock-per-robot.md --out-tsv ${OUT}/pc-locks39-lock-per-robot.tsv
  after: lock-rp

pr | bash tools/open_results_pr.sh claude/pc-locks39-results "1v1 cloud locks, round 39 overnight (7 lines on zl, pb, rlnrkn, fgl, mt, rf, rp), 48 fresh PC seeds" ${OUT}/pc-locks39-livematch.md ${OUT}/*_pc-locks39-*.md ${OUT}/pc-locks39-lock-per-robot.tsv $(find ${OUT} -maxdepth 1 -name 'pc-locks39-lock-pick.tsv' -size +0c)
  after: gate
