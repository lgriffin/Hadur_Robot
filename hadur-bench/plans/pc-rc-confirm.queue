# 1v1 release-candidate confirm (BENCH-264): master against the released 3.23 on the whole 1v1 field, overnight.
# Nothing ships from this card. It answers one question before the weekend release: does master beat live 3.23 on
# the full field at the live turn time, with no robot class falling behind? Leigh starts it on a free PC:
#   git checkout master && git pull
#   .\queue.ps1 run pc-rc-confirm --fresh        (or  ./queue.sh run pc-rc-confirm --fresh)
# Fetches tolerate a missing archive jar (Seraphim 2.4.0 and Nullstride 2.3.3 404 there); --failed-ok skips them.
# One bench queue, RoboRumble workers at 0, 12 workers, truth log off. About 7,500 battles; at the 624 an hour the
# census fought at 12 workers, run 2's ~7,100 unrun battles take about 11 hours:
#   livematch  the live-match check (BENCH-245) on the 31-robot panel, read against live
#   field      census-312.txt (the 1,212-robot 1v1 field; broken-1.11.2 robots skipped) x rel, c, aa x 2 fresh
#              seeds from 83000 (about 7,000 battles)
#   ret        panel-ret16.txt (the 16 returners, 15 of them 1.12.0-only) x rel, c, aa x 6 fresh seeds from 83100 on
#              --engine 1.12.0 --keep-broken (288 battles); gate112 checks every engine.log names robocode.host/1.12.0
#   gate       multiarm on both (A/A is aa - c; rel - c is the release minus master, so master's gain is its negative)
#              and the field read (shield_s2.py gate --arm rel over 1,217 pairings): PASS when rel minus pooled master
#              has its 95% high end below 0
# Stop rules (docs/bench/watch.md): 30 failed battles, an arm scoring nothing in 8, 60+ skipped turns a battle over
# the last 200, no battle in 30 minutes, aa after 20% outside its band; every battle fought is kept and a rerun resumes.
#
# Run 1 (issue #947, 20 Nov 00:27) halted on the skips rule at 16 workers: the field read 46.1 skipped turns a battle
# over its first 200 battles and 60.6 over the last 200, with rel skipping as badly as c and aa, so the host was
# loaded, not master. The whole field skips 31 to 40 a battle on a healthy PC at 12 workers (pc-census-320), so run 2
# uses 12. That census pinned another cpu constant and engine, so 12 is not proven for this card: run the short
# round 13 card (pc-locks, live constant, 16 workers) first as the health check. If it skips well above round 12's
# ~17 a battle, the PC is still loaded; fix that before this card, since fewer workers alone may not hold it under 60.
# A rerun WITHOUT --fresh resumes: prep and livematch are done, and the field keeps its 308 battles.
#
# Why it should win (the PC card rule of 2026-11-03): master carries MOVE-52 intercept views (PC #934 pass) and the
# round 3-12 per-opponent lines. The cloud release check on 19 Nov (coverage/shards/dzlane, 4-12 seeds a panel at the
# live turn time, master A/A pair against the released jar) read every panel up: danger44 +0.65 +- 0.32, field-e
# +0.57 +- 0.44, midfield +0.53 +- 0.28, returners +1.87 +- 1.76, r31 +1.15 +- 1.13 points a robot, and all 471 line
# robots +0.57 +- 0.19 (old lines level, the new r3-12 lines +2.46 +- 0.63); flag rechecks on 12 seeds left three
# small losses worth about 0.005 APS together. This card checks the same thing on the whole field at once.

set V = 3.23
set P = --parallel 12 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-rc-confirm
set OUT = ../docs/bench/local
set ALERT = lgriffin
set RELSHA = 4d9d10404fe8158efc9d57435d4d4c0a72000c966d1f420378b9ee360861aa94

prep | git checkout -q master && mkdir -p bisect/rel work && (cd .. && mvn -q -DskipTests package) && bash ./build-ablation.sh aa && bash ./build-ablation.sh bb && test -f bisect/hadur117.Hadur_${V}bb.jar && (test -f bisect/rel/hadur117.Hadur_${V}.jar || curl -fsSL -o bisect/rel/hadur117.Hadur_${V}.jar https://github.com/lgriffin/Hadur_Robot/releases/download/v${V}/hadur117.Hadur_${V}.jar) && python3 -c "import hashlib,sys; sys.exit(hashlib.sha256(open(sys.argv[1],'rb').read()).hexdigest()!=sys.argv[2])" bisect/rel/hadur117.Hadur_${V}.jar ${RELSHA} && bash tools/fetch_live_jar.sh && (./fetch-opponents.sh --set panel-r31.txt || true) && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && (./fetch-opponents.sh --set census-312.txt || true) && (./fetch-opponents.sh --set panel-ret16.txt || true) && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out work/pc-livematch-rel-live --label pc-rc-confirm-livematch --shuffle-jobs && python3 tools/live_match.py work/pc-livematch-rel-live/arms.tsv --out ${OUT}/pc-rc-confirm-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

field | ./bench-top20.sh ${C} ${P} --set census-312.txt --seeds 2 --seed-base 83000 --arms plans/pc-rc-confirm.arms --out ${W}-field --label pc-rc-confirm-field --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m
  stop: aa after 20%

ret | ./bench-top20.sh ${C} ${P} --engine 1.12.0 --keep-broken --set panel-ret16.txt --seeds 6 --seed-base 83100 --arms plans/pc-rc-confirm.arms --out ${W}-ret --label pc-rc-confirm-ret --shuffle-jobs
  after: field
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

gate112 | n=$(ls -d ${W}-ret/battles/*/ 2>/dev/null | wc -l); m=$(grep -l "robocode.host/1.12.0" ${W}-ret/battles/*/engine.log 2>/dev/null | wc -l); ( [ "$n" -gt 0 ] && [ "$m" -eq "$n" ] && ! grep -h "robocode.host/" ${W}-ret/battles/*/engine.log | grep -qv "robocode.host/1.12.0" && python3 ../data/tools/multiarm.py ${W}-ret/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-rc-confirm-ret.md ); rc=$?; mvn -q compile; exit $rc
  after: ret

gate | python3 ../data/tools/multiarm.py ${W}-field/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-rc-confirm-field.md && python3 tools/shield_s2.py gate ${W}-field/arms.tsv --arm rel --field 1217 --bar -99 --low -99 --out ${OUT}/$(date +%Y-%m-%d)_pc-rc-confirm-field-gate.md
  after: gate112

pr | bash tools/open_results_pr.sh claude/pc-rc-confirm-results "1v1 release-candidate confirm: master against the released 3.23 on the whole field" ${OUT}/pc-rc-confirm-livematch.md ${OUT}/*_pc-rc-confirm-*.md
  after: gate
