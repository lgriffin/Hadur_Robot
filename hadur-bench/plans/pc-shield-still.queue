# 1v1, shield step (BENCH-152, docs/bench/shield-step.md). Leigh starts it:
#   git checkout master && git pull
#   .\queue.ps1 run pc-shield-still        (or  ./queue.sh run pc-shield-still)
# One bench queue, RoboRumble workers at 0, unpinned, 12 workers, truth log off. Every step resumes;
# no step needs a decision. About 1.7 h of battles (2,214; pc-sg-wide ran 1,736 in about 1.4 h) and seconds
# of analysis.
#
# Why: BeepBoop leads us by +0.35 APS on the robots we both shield and +0.32 on the 64 it shields and we
# surf. A debug build traced our shield's leaks to its own 0.1 px step aside (SHIELD-5's wiggle): an enemy
# that aims a few ticks before it fires sees the step, and its bullet is head-on to where we stood mid-step,
# which no predictor holds (all 16 of Hydrogen's leaks, about half of Toa's). SHIELD-20 takes a plan from
# where we stand whenever one exists. Cloud reads (35 rounds, paired): with the shield forced on, the 9
# robots BeepBoop shields and we don't went 75.4 -> 83.9 (our surf 77.6, BeepBoop 92.9); on 36 listed robots
# x 2 seeds sz - master +2.56 +- 2.22 points a robot (20 biggest BeepBoop leads +3.66, 16 random +1.20).
#
# still:  the 273 shield-listed robots (panel-shield-listed-320.txt) x c, aa, sz x 2 fresh seeds from 5200 =
#         1,638 battles, 35 rounds.
# add:    the 64 robots on BeepBoop's shield list and not on ours (panel-beep-shield-only.txt) x c, aa, szmt
#         (SHIELD-20 with those 64 on the list) x 3 fresh seeds from 5300 = 576 battles.
# gate:   sz at +0.05 APS over the 273 / 1,217 pairings, 95% low end above 0, A/A inside its band; szmt the
#         same at +0.05 over the 64; a per-robot pick of the 64 at a 5-point margin (mode_table.py) for a
#         table line if szmt as a whole fails; per-robot differences with losses.
# Stop rules (docs/bench/watch.md): each step halts on 30 failed battles, an arm scoring nothing in 8,
# 40+ skipped turns a battle over the last 200, no battle in 30 minutes, or an A/A outside its z 3 band
# after 20%; every battle fought is kept and a rerun resumes. The still step also finishes early once sz
# cannot reach +0.05 APS at z 3 after 30% (492 of 1,638 battles): that leaves at most 1,146 battles (about
# 55 min) unrun, the add step still runs, the gate reads the rows so far and the results PR says it stopped
# early. ALERT opens an issue for Leigh on any stop.
# Nothing here ships: on a pass a PR turns SHIELD-20 on (and adds the 64 or the picked ones) for the next
# census; the release rule stands.

set V = 3.20
set P = --parallel 12 --no-truth-log
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant 1488498 --child-heap 2G --engine 1.11.1
set W = work/shield-still
set WA = work/shield-still-add
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && bash ./build-ablation.sh sstill && SHIELD_ADD=plans/beep-shield-add.txt bash ./build-ablation.sh sstill,slistadd && test -f bisect/hadur117.Hadur_${V}szmt.jar && ./fetch-opponents.sh --set panel-shield-listed-320.txt && ./fetch-opponents.sh --set panel-beep-shield-only.txt && mvn -q compile

still | ./bench-top20.sh ${C} ${P} --set panel-shield-listed-320.txt --seeds 2 --seed-base 5200 --arms plans/shield-still.arms --out ${W} --label shield-still --shuffle-jobs
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 40 over 200
  stop: stall 30m
  stop: aa after 20%
  stop: futility sz below 0.05 after 30%

add | ./bench-top20.sh ${C} ${P} --set panel-beep-shield-only.txt --seeds 3 --seed-base 5300 --arms plans/shield-still-add.arms --out ${WA} --label shield-still-add --shuffle-jobs
  after: still
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 40 over 200
  stop: stall 30m
  stop: aa after 20%

gate | python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_shield-still.md && python3 tools/shield_s2.py gate ${W}/arms.tsv --arm sz --panel panel-shield-listed-320.txt --bar 0.05 --out ${OUT}/$(date +%Y-%m-%d)_shield-still-gate-sz.md && python3 tools/per_robot.py ${W}/arms.tsv --arms sz --out ${OUT}/$(date +%Y-%m-%d)_shield-still-per-robot.md --out-tsv ${OUT}/shield-still-per-robot.tsv && python3 ../data/tools/multiarm.py ${WA}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_shield-still-add.md && python3 tools/shield_s2.py gate ${WA}/arms.tsv --arm szmt --panel panel-beep-shield-only.txt --bar 0.05 --out ${OUT}/$(date +%Y-%m-%d)_shield-still-add-gate-szmt.md && python3 ../data/tools/mode_table.py ${WA}/arms.tsv --margin 5 --out-tsv ${OUT}/shield-still-add-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_shield-still-add-pick.md && python3 tools/per_robot.py ${WA}/arms.tsv --arms szmt --out ${OUT}/$(date +%Y-%m-%d)_shield-still-add-per-robot.md --out-tsv ${OUT}/shield-still-add-per-robot.tsv
  after: add

pr | bash tools/open_results_pr.sh claude/pc-shield-still-results "1v1 shield step: shield plans from where we stand (SHIELD-20) on the 273 listed robots and BeepBoop's 64" ${OUT}/*_shield-still*.md ${OUT}/shield-still-per-robot.tsv ${OUT}/shield-still-add-per-robot.tsv $(find ${OUT} -maxdepth 1 -name shield-still-add-pick.tsv -size +0c) $(find ${W} ${WA} -maxdepth 1 -name EARLY-STOP.md)
  after: gate
