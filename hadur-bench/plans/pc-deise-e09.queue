# Deise's stage E6 (docs/deise.md section 8): aim.
# tools/melee_split.py on pc-deise-e06 (PR #490) put 0.4 level with Mirage on survival (died 47.8% of
# rounds to 47.4%) and behind on damage (134.3 to 145.5 a round). E5 (pc-deise-e08, PR #485) showed
# that harder power buys damage only by dying more. E6 changes where the shot goes, not how hard.
# PR #491 frees 47 bytes in the shipped class, so a winner can be fitted.
#   ./queue.sh run pc-deise-e09        (or  .\queue.ps1 run pc-deise-e09)
# Run it from master:
#   git checkout master && git pull
# One bench queue, RoboRumble workers at 0, unpinned, 12 workers. A rerun skips every seat that
# finished; a seat that was stopped part-way is fought again from its start (the melee path has no
# per-battle resume). No step needs a decision. Nothing here touches Hadur, Saor or the shipped
# Deise class.
#
# Arms (deise-arms/arms.txt, each one sed on DeiseLab over the core, 0.4):
#   D       Deise 0.4 (DeiseLab), the reference     SAOR  Saor 0.2 seated, the control
#   SAME    fire only at the robot the gun was last aimed at (after a switch of target, the first
#           shot used to go down the old target's line)
#   PL400   400 playouts an aim, not 200 (CPU: the skip rule watches it)
#   WARM4   a row votes in full from 4 samples, not 8
#   WARM16  a row votes in full from 16 samples, not 8
#   NARROW  a vote spreads over half the target's width (9 px, not 18)
#   WSTOP   a playout that reaches a wall stops there and votes in full, not 1
# Live-shaped census: 46 fields x 6 seeds a seat (276 battles, about 17 min on the PC), 8 seats,
# about 2.3 h, fresh seeds from 3900.
# Reads: each arm against SAOR and against D, field by field, and melee_split's damage and survival
# split of every seat against D (deise-e09-split.md): an aim arm should raise damage a round without
# costing survival. An arm that reads +0.30 or more over D with the low end above 0 is fitted into
# the shipped class (PR #491's 47 bytes) and the core, matched (DEISE-16), as 0.5 on Leigh's go.
# Stop rules on every census step (halt; finished seats are kept, the stopped seat reruns from its
# start): 20 failed battles (a broken jar), no battle in 30 minutes (a hung step), or 40+ skipped
# turns a battle over the last 100. A halt at worst leaves the rest of that seat and the seats
# after it unrun, at most 2,208 battles (about 2.3 h). There is no early finish on score: a census
# seat is one robot, so there is no arm to call futile mid-step.

set MVN = mvn -q -Drobocode.version=1.11.1 compile exec:java
set OUT = ../docs/bench/local
set ARMS = D,SAME,PL400,WARM4,WARM16,NARROW,WSTOP,SAOR

prep | (cd .. && mvn -q -DskipTests install -pl deise -am) && cp ../deise/target/hadur117.mini.Deise_0.4.jar opponents/ && curl -fsSLo opponents/hadur117.micro.Saor_0.2.jar https://github.com/lgriffin/Hadur_Robot/releases/download/saor-v0.2/hadur117.micro.Saor_0.2.jar && ./fetch-opponents.sh --set minimelee-field.txt && for f in melee-census-317/f*.txt; do ./fetch-opponents.sh --set "$f" || exit 1; done && DEISE_RUN=e09 bash tools/deise_arms.sh live 6 3900 ${ARMS}

live-D | ${MVN} "-Dexec.args=@work/deise-e09/live-D.args"
  after: prep
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-SAME | ${MVN} "-Dexec.args=@work/deise-e09/live-SAME.args"
  after: live-D
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-PL400 | ${MVN} "-Dexec.args=@work/deise-e09/live-PL400.args"
  after: live-SAME
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-WARM4 | ${MVN} "-Dexec.args=@work/deise-e09/live-WARM4.args"
  after: live-PL400
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-WARM16 | ${MVN} "-Dexec.args=@work/deise-e09/live-WARM16.args"
  after: live-WARM4
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-NARROW | ${MVN} "-Dexec.args=@work/deise-e09/live-NARROW.args"
  after: live-WARM16
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-WSTOP | ${MVN} "-Dexec.args=@work/deise-e09/live-WSTOP.args"
  after: live-NARROW
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

live-SAOR | ${MVN} "-Dexec.args=@work/deise-e09/live-SAOR.args"
  after: live-WSTOP
  watch: battles=276
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100

read | python3 tools/saor_arms.py --work-root work/deise-e09 --field live --arms ${ARMS} --control SAOR --only work/deise-e09/live/micro.txt --top5 71.15 --control-live 68.79 --pairings 203 --robot-prefix hadur117.mini.Deise --arms-file deise-arms/arms.txt > ${OUT}/deise-e09-live.md && python3 tools/saor_arms.py --work-root work/deise-e09 --field live --arms ${ARMS} --control D --only work/deise-e09/live/micro.txt --pairings 203 --robot-prefix hadur117.mini.Deise --arms-file deise-arms/arms.txt > ${OUT}/deise-e09-vs-d.md && python3 tools/melee_split.py --ref D ${OUT}/deise-e09-live-D.md ${OUT}/deise-e09-live-SAME.md ${OUT}/deise-e09-live-PL400.md ${OUT}/deise-e09-live-WARM4.md ${OUT}/deise-e09-live-WARM16.md ${OUT}/deise-e09-live-NARROW.md ${OUT}/deise-e09-live-WSTOP.md ${OUT}/deise-e09-live-SAOR.md > ${OUT}/deise-e09-split.md
  after: live-SAOR

pr | bash tools/open_results_pr.sh claude/pc-deise-e09-results "Deise stage E6: aim" ${OUT}/deise-e09-live.md ${OUT}/deise-e09-vs-d.md ${OUT}/deise-e09-split.md ${OUT}/deise-e09-live-*.md
  after: read
