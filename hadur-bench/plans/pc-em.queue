# 1v1, MOVE-65 on the PC (BENCH-271): DrussGT 3.1.20's danger-model change built as one coupled system, after the
# loose parts failed on pc-drussgt (#979: miss-scoring on our old weights, a gated flattener blend and DrussGT's danger
# shape, each alone, all level or worse). None is on master: the arms are built from experiment commit EMX on branch
# claude/project-thread-n97hk6, the switch off by default and duel only, so team and melee are untouched.
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live
#   screen     panel-midfield (167 mid-field learning guns, where DrussGT gained)   c / aa / em / em2
#              3 seeds from 85600, --cpu-constant live, in work/pc-em
#   confirm    panel-r31 (the 31 robots with the largest bench gap to BeepBoop)   same arms, 4 seeds from 85700
#   gate       multiarm.py on each panel (each arm against c and aa pooled)
#   pairs      arm_pair.py: each arm against c and against aa on its own, one file per panel; an arm passes where it beats both
#              c and aa with the 95% low end above 0 on the mid-field and is not below 0 on panel-r31; only a passing
#              arm goes to Leigh for master (new code needs Leigh's OK)
# Leigh starts it once the PC is free (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-em        (or  ./queue.sh run pc-em)
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. 2,004 screen battles and 496 confirm battles,
# about 1 hour.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - em / em2 replace our 2^(2 x score) hit-only member weights with one multiplicative mixture update after every
#     enemy wave (a hit by each member's share on our body, a passing wave by its share off it, inside the reachable
#     GF range; rate 1/n for 5 hits then 0.01; trust n/(n+20) from fixed priors), with the flatteners as members and no
#     hit-rate gate: DrussGT 3.1.20's whole change (+0.35 APS live, +0.34 on 725 learning-gun pairings).
#   - Offline on 64 c and 64 BeepBoop truth-log battles (rounds 3+), the share of enemy bullets whose true aim sits in
#     our top-fifth danger: c 44.9% -> em 48.6%, em2 48.4%. em's priors (views 0.5, 26 others 0.01) let the aims
#     drown the views against learning guns (Spike 55.1 -> 45.3); em2 uses DrussGT's prior split (views 1.0, all
#     others sharing 0.06) and learns a hit once per flight tick, which keeps the learning guns (Spike 54.7, MrFreeze
#     36.3 -> 38.7) and most of the simple-aimer gain (NanoBidu 45 -> 67).
# Pilot and stop rules (docs/bench/watch.md): the screen's aa arm halts the card after 20% if master and its copy
# disagree; halt on 30 failed battles, an arm scoring nothing in 8, 60+ skipped turns a battle over the last 200, or no
# battle in 30 minutes. The live-match step stops the card if the PC no longer scores us and BeepBoop as live does.
# ALERT opens an issue on any stop. Nothing is released or banked by the card.
set V = 3.25
set EMX = 962fac10649b40b506c276432d17cf4c1648d5f2
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-em
set M = work/pc-em-r31
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && git fetch -q origin claude/project-thread-n97hk6 && git cat-file -e ${EMX}^{commit} && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && git show ${EMX}:hadur-bench/build-ablation.sh > work/build-ablation-emx.sh && for a in em em2; do cp work/build-ablation-emx.sh ./build-ablation-emx.sh && bash ./build-ablation-emx.sh --ref ${EMX} $a || exit 1; done && rm -f ./build-ablation-emx.sh && for a in aa em em2; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; done && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-midfield.txt && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out work/pc-livematch-rel-live --label pc-em-livematch --shuffle-jobs && python3 tools/live_match.py work/pc-livematch-rel-live/arms.tsv --out ${OUT}/pc-em-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

screen | ./bench-top20.sh ${C} ${P} --set panel-midfield.txt --seeds 3 --seed-base 85600 --arms plans/pc-em.arms --out ${W} --label pc-em --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m
  stop: aa after 20%

confirm | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 4 --seed-base 85700 --arms plans/pc-em.arms --out ${M} --label pc-em-r31 --shuffle-jobs
  after: screen
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m

gate | python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-em-mid.md && python3 ../data/tools/multiarm.py ${M}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-em-r31.md && python3 tools/per_robot.py ${W}/arms.tsv --arms em em2 --out ${OUT}/$(date +%Y-%m-%d)_pc-em-mid-per-robot.md --out-tsv ${OUT}/pc-em-mid-per-robot.tsv && cp ${W}/arms.tsv ${OUT}/pc-em-mid-arms.tsv && cp ${M}/arms.tsv ${OUT}/pc-em-r31-arms.tsv
  after: confirm

pairs | for a in em em2; do for b in c aa; do python3 tools/arm_pair.py ${W}/arms.tsv --candidate $a --baseline $b --out ${OUT}/$(date +%Y-%m-%d)_pc-em-pairs-mid.md && python3 tools/arm_pair.py ${M}/arms.tsv --candidate $a --baseline $b --out ${OUT}/$(date +%Y-%m-%d)_pc-em-pairs-r31.md || exit 1; done; done
  after: gate

pr | bash tools/open_results_pr.sh claude/pc-em-results "1v1 MOVE-65 coupled danger mixture (em, em2) on the mid-field and panel-r31" ${OUT}/pc-em-livematch.md ${OUT}/*_pc-em-*.md ${OUT}/pc-em-mid-per-robot.tsv ${OUT}/pc-em-mid-arms.tsv ${OUT}/pc-em-r31-arms.tsv
  after: pairs
