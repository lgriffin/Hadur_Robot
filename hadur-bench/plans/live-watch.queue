# Release watch (Leigh, 2026-10-26: "build that into your PC card at release"): run on the PC right after
# every release, while the RoboRumble clients run the new version, so collapsed live battles are logged
# with their health records (skipped turns, faults, shield verdicts) instead of guessed at afterwards.
#   ./queue.sh run live-watch --fresh        (or  .\queue.ps1 run live-watch --fresh)
# --fresh at each new release or RUN: the queue keeps done steps under the plan's name, so without it a
# PC that ran an earlier watch skips this one. To resume an interrupted watch, run it without --fresh.
# BENCH-121: the card runs the six RoboRumble clients itself (four 1v1 in C:/RoboRumbleWorkers/rr01..rr04,
# melee and team in C:/robocode), so CLOSE ANY CLIENT WINDOWS STARTED BY HAND FIRST. Each client's console
# goes to consoles/<client>-<UTC>.log per start; Hadur's console lines (disabled for a stall, thread not
# stoppable, skipped turn) go to client-events.tsv; every RESTART minutes each client is restarted at its
# next battle end or upload (none cut), or WAIT minutes later if none ends (counted as cut). In 3.17 run 2
# (PR #331) clients left running climbed from 4 to 87 skipped turns a battle in 75 minutes. Four 1v1 clients, not
# six (Leigh, 2026-10-27): with six plus melee and team, 3.17 run 3 (PR #355) skipped 57 turns a battle from the
# first minute and live APS fell 89.93 -> 89.48 over 1,010 battles; six alone had started at 4. All six stop
# when the watch ends. It never runs a bench, so it is the one queue on the PC for its length. Edit V1 / VT below in the release PR: the versions the
# 1v1/melee and team participant lines name (they can differ, as 3.17 and 3.17.1 did).
#
# Why these stops: about 1 live 1v1 battle in 100 collapses (7 of 659 on 3.16), and ~10 collapses with
#   their health records are enough to find a cause, so the watch ends at COLLAPSES collapses (a 1v1 battle 15+ points under its pairing's
#   score on the live page; a flat 70% line flagged normal battles vs strong robots) or
#   DUELS 1v1 battles, whichever comes first, capped at HOURS. Right after a release (its first pass,
#   when most client battles include Hadur) that is a few hours; later it can take days. It logs the
#   1v1 battle rate hourly. To finish early, create a file named STOP in the watch folder (data/live/
#   release-<V1>-run<RUN>/STOP): the watch ends as if it had hit a count, and report and pr run. Ctrl-C instead
#   interrupts the step, so report and pr do not run; re-running the card resumes the watch.
# watch: data/tools/live_client.py watch over the six clients it runs, with the three live pages; it resumes across restarts
#   (BENCH-86), so re-running the step after a reboot keeps every battle already recorded.
# --new-only: only battles fought after the watch first started (started.txt); the first 3.17 run
#   took yesterday's battles still in the clients' results files.
# report: live_client.py report, joining each collapse to its health record; the consoles packed into
#   one consoles.tar.gz so the results PR takes one file, not one per restart.
# pr: the watch folder's TSVs, report and log as a results PR; Claude reads it for the live collapses
#   (the +0.1..+0.2 APS lever L5 of the 1v1 plan to 3rd).

set V1 = 3.18
# PKG: the release's package, hadur2 through 3.18 and hadur117 from 3.19 (NAME-1); set it with V1 / VT.
set PKG = hadur2
set VT = 3.18
set HOURS = 72
set COLLAPSES = 10
set DUELS = 1000
set CLIENTS = C:/RoboRumbleWorkers
set ONES = rr01 rr02 rr03 rr04
set MAIN = C:/robocode
set RESTART = 15
set WAIT = 10
# RUN: 1 for a release's first watch; raise it to watch the same release again in a fresh folder
# and results branch (the first 3.17 run, PR #318, is in release-3.17). 3.18 starts at 2: the PC's
# release-3.18-run1 holds the 2026-10-27 14:01 start that ran before 3.18 existed (PR #350).
set RUN = 2
set W = ../data/live/release-${V1}-run${RUN}

watch | mkdir -p ${W} && rm -f ${W}/STOP && $(command -v python3 || command -v python) ../data/tools/live_client.py watch --root ${CLIENTS} $(for d in ${ONES}; do printf -- '--launch %s:roborumble.bat ' "$d"; done) --launch ${MAIN}:meleerumble.bat --launch ${MAIN}:teamrumble.bat --restart-minutes ${RESTART} --wait-minutes ${WAIT} --out ${W} --page "roborumble:${PKG}.Hadur ${V1}" --page "meleerumble:${PKG}.Hadur ${V1}" --page "teamrumble:${PKG}.HadurTeam ${VT}" --robot "${PKG}.Hadur ${V1}" --robot "${PKG}.HadurTeam ${VT}" --new-only --stop-collapses ${COLLAPSES} --stop-battles ${DUELS} --hours ${HOURS}

report | $(command -v python3 || command -v python) ../data/tools/live_client.py report ${W} --md ${W}/report.md && (cd ${W} && [ ! -d consoles ] || tar czf consoles.tar.gz consoles)
  after: watch

pr | bash tools/open_results_pr.sh claude/live-watch-${V1}-run${RUN}-results "Release watch: live battles and health records of ${V1} / team ${VT}" $(ls ${W}/*.tsv ${W}/report.md ${W}/watch.log 2>/dev/null) $(ls ${W}/consoles.tar.gz 2>/dev/null) $(find ${W}/profiles -name '*.tsv' -size +0c 2>/dev/null)
  after: report
