# Ogi's dodge as one piece (TMODE-27, BENCH-139; docs/plan-team-top5.md section 14), team thread:
# team-only, duel and melee fixtures bit for bit. Leigh 2026-10-29: OgiTeam leads by ~6.4 APS on
# survival; our ports of its parts one switch at a time read zero, so this is its dodge built whole:
#   DODGE (TMODE-27): every detected shot profiled once from aim experts (head-on, linear, circular,
#         averaged, half speed, the team's learned aims pooled by class) weighted by how well each
#         called the bullets that hit the team; the 12 safest candidates driven through the profiles
#         and the teammates' bullets; the base ranking counts no bullets.
#   tdprep  build aa, bb and dg (DODGE forced on; the named teams play it on top of their entry)
#   tdbb    bb vs aa, 46 teams x 12 seeds (base 5400); tddg the same for dg
#   tdglob  DODGE as every team's default: pooled gain of dg less half of bb over 46 teams, gate +0.30
#           APS with the 95% low end above zero (its own verdict file; nothing ships from the card)
#   tdpick  per team, DODGE where its gain over both baselines is +3.0 points or more with the 95% low
#           end above zero; a team the table already names keeps its entry's modes
#   tdgate  the picked table (mk) vs aa on the picked teams, 16 fresh seeds (base 5500); tdgbb A/A
#   tdsum   projected team APS change of the picked table = sum of the picked teams' gains / 46 (gate:
#           +0.30 with the low end above zero); only on PASS is the gated table written as the table to ship
# Each seed is a pair (the arm and aa): 2,208 screen battles plus 64 per picked team, about 2.6 h at 12
# workers (sizes itself to the host). Every step resumes where it stopped.
# Stop rules on every battle step (halt; every battle fought is kept and a rerun resumes): 20 failed
# battles (a broken jar), no battle in 30 minutes (a hung step), or 40+ skipped turns a battle over the
# last 100 (the PR #331 build-up; the dodge's CPU is what WAVES with learning lacked). A halt at the very
# start leaves the whole card unrun: 2,208 screen battles plus the gate's 64 a picked team (about 2.6 h);
# a halt in tdbb leaves the rest of it and all 1,104 of tddg; later, only the rest of that step and the
# steps after it. No early finish on score: the pick is per team.
# The team thread reads claude/pc-team-dodge-results.
#   ./queue.sh run pc-team-dodge        (or  .\queue.ps1 run pc-team-dodge)
# Run it from master (one bench queue at a time):
#   git checkout master && git pull

set OUT = ../docs/bench/local
set T = python3 tools/team_modes.py

tdprep | git checkout -q master && V=$(sed -n 's:.*<robot.release>\(.*\)</robot.release>.*:\1:p' ../hadur-robot/pom.xml) && test -n "$V" && rm -f bisect/hadur117.HadurTeam_"$V"aa.jar bisect/hadur117.HadurTeam_"$V"bb.jar bisect/hadur117.HadurTeam_"$V"dg.jar bisect/hadur117.HadurTeam_"$V"mk.jar && rm -f ${OUT}/team-dodge-*.md ${OUT}/team-dodge-pick.tsv ${OUT}/team-dodge-locked.java.txt work/team-dodge-picked.java work/team-dodge-gate.txt && rm -rf work/team-dodge-"$V"-bb work/team-dodge-"$V"-dg work/team-dodge-"$V"-gate work/team-dodge-"$V"-gbb && ./fetch-opponents.sh --set team-census46.txt && bash ./build-ablation.sh aa && bash ./build-ablation.sh bb && bash ./build-ablation.sh tmdodge && mkdir -p work && for a in bb dg gate gbb; do sed "s/@V@/$V/g" plans/team-dodge-$a.args > work/team-dodge-$a.args || exit 1; done && for j in aa bb dg; do test -f bisect/hadur117.HadurTeam_"$V"$j.jar || exit 1; done && mvn -q compile
tdbb   | mvn -q exec:java "-Dexec.args=@work/team-dodge-bb.args"
  after: tdprep
  watch: battles=1104
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100
tddg   | mvn -q exec:java "-Dexec.args=@work/team-dodge-dg.args"
  after: tdbb
  watch: battles=1104
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100
tdglob | ${T} gate --report ${OUT}/team-dodge-dg.md --control ${OUT}/team-dodge-bb.md --set team-census46.txt --seeds 12 --teams 46 --min-aps 0.3 --out-md ${OUT}/team-dodge-global.md
  after: tddg
tdpick | ${T} pick --report DODGE=${OUT}/team-dodge-dg.md --control DODGE=${OUT}/team-dodge-bb.md --min-mean 3.0 --low-end 0 --base MATEFIRE,HUNT --shipped ../hadur-core/src/main/java/hadur117/core/melee/TeamModes.java --census team-census46.txt --opponents opponents --out-md ${OUT}/team-dodge-pick.md --out-tsv ${OUT}/team-dodge-pick.tsv --out-java work/team-dodge-picked.java --out-set work/team-dodge-gate.txt && if [ -s work/team-dodge-picked.java ]; then TEAM_MODE_LOCKED="$(pwd)/work/team-dodge-picked.java" bash ./build-ablation.sh tmlock; else echo "nothing picked: no gate"; fi
  after: tdglob
tdgate | if [ -s work/team-dodge-picked.java ]; then mvn -q exec:java "-Dexec.args=@work/team-dodge-gate.args"; else echo "nothing picked: no gate"; fi
  after: tdpick
  watch:
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100
tdgbb  | if [ -s work/team-dodge-picked.java ]; then mvn -q exec:java "-Dexec.args=@work/team-dodge-gbb.args"; else echo "nothing picked: no gate"; fi
  after: tdgate
  watch:
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100
tdsum  | if [ -s work/team-dodge-picked.java ]; then ${T} gate --report ${OUT}/team-dodge-gate.md --control ${OUT}/team-dodge-gbb.md --set work/team-dodge-gate.txt --seeds 16 --teams 46 --min-aps 0.3 --out-md ${OUT}/team-dodge-verdict.md && if grep -q '\*\*PASS\*\*' ${OUT}/team-dodge-verdict.md; then cp work/team-dodge-picked.java ${OUT}/team-dodge-locked.java.txt; else echo "gate failed: no table to ship"; fi; else echo "DODGE cleared the screen on no team: no per-team gate, the table stays as shipped." > ${OUT}/team-dodge-verdict.md; fi
  after: tdgbb
tdpr   | bash tools/open_results_pr.sh claude/pc-team-dodge-results "Ogi's dodge whole: screen, global gate, per-team pick and gate" $(ls ${OUT}/team-dodge-*.md ${OUT}/team-dodge-pick.tsv ${OUT}/team-dodge-locked.java.txt 2>/dev/null)
  after: tdsum
