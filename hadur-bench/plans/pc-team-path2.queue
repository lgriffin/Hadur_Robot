# Confirm PATH as every team's default (TMODE-25, BENCH-135; docs/plan-team-top5.md section 13),
# team thread: team-only, duel and melee fixtures bit for bit. pc-team-path (PR #414) found no team
# where PATH paid +3.0 on its own, but pooled over the 46 it read +0.5 ± 0.5 share points over aa
# (bb -0.0 ± 0.5), with our bullets hitting our own members 15% less often. Leigh 2026-10-29: build the
# confirm. This card reruns that comparison on fresh seeds and gates it as one switch for every team.
#   tqprep  build aa, bb and mp (PATH forced on; the named teams play it on top of their entry)
#   tqbb    bb vs aa, 46 teams x 16 fresh seeds (base 5100); tqmp the same for mp
#   tqsum   projected team APS change = sum of each team's mp gain less half its bb gain / 46
#           (gate: +0.30 with the 95% low end above zero). On PASS the next step is a PR that sets
#           FORCE_PATH = true; the card itself changes nothing.
# 16 seeds, not 10: at 10 the pooled interval was ± 0.5, too wide to put a +0.5 gain's low end above zero.
# Each seed is a pair (the arm and aa): 2 x 46 x 16 x 2 = 2,944 battles, about 3.4 h at 12 workers
# (sizes itself to the host). Every step resumes where it stopped.
# Stop rules on both battle steps (halt; every battle fought is kept and a rerun resumes): 20 failed
# battles (a broken jar), no battle in 30 minutes (a hung step), or 40+ skipped turns a battle over the
# last 100 (the PR #331 build-up). A halt at the very start leaves the whole card unrun (2,944 battles,
# about 3.4 h); a halt in tqbb leaves the rest of tqbb plus all 1,472 of tqmp; in tqmp, the rest of
# tqmp. There is no early finish on score: the gate is pooled over all 46 teams.
# The team thread reads claude/pc-team-path2-results.
#   ./queue.sh run pc-team-path2        (or  .\queue.ps1 run pc-team-path2)
# Run it from master (one bench queue at a time):
#   git checkout master && git pull

set OUT = ../docs/bench/local
set T = python3 tools/team_modes.py

tqprep | git checkout -q master && V=$(sed -n 's:.*<robot.release>\(.*\)</robot.release>.*:\1:p' ../hadur-robot/pom.xml) && test -n "$V" && rm -f bisect/hadur117.HadurTeam_"$V"aa.jar bisect/hadur117.HadurTeam_"$V"bb.jar bisect/hadur117.HadurTeam_"$V"mp.jar && rm -f ${OUT}/team-path2-*.md && ./fetch-opponents.sh --set team-census46.txt && bash ./build-ablation.sh aa && bash ./build-ablation.sh bb && bash ./build-ablation.sh tmpath && mkdir -p work && for a in bb mp; do sed "s/@V@/$V/g" plans/team-path2-$a.args > work/team-path2-$a.args || exit 1; done && for j in aa bb mp; do test -f bisect/hadur117.HadurTeam_"$V"$j.jar || exit 1; done && mvn -q compile
tqbb   | mvn -q exec:java "-Dexec.args=@work/team-path2-bb.args"
  after: tqprep
  watch: battles=1472
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100
tqmp   | mvn -q exec:java "-Dexec.args=@work/team-path2-mp.args"
  after: tqbb
  watch: battles=1472
  stop: fails 20
  stop: stall 30m
  stop: skips 40 over 100
tqsum  | ${T} gate --report ${OUT}/team-path2-mp.md --control ${OUT}/team-path2-bb.md --set team-census46.txt --seeds 16 --teams 46 --min-aps 0.3 --out-md ${OUT}/team-path2-verdict.md
  after: tqmp
tqpr   | bash tools/open_results_pr.sh claude/pc-team-path2-results "Team path check on every team: fresh-seed confirm" $(ls ${OUT}/team-path2-*.md 2>/dev/null)
  after: tqsum
