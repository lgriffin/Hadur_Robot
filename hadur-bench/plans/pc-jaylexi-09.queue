# JayLexi 0.9 confirm on the whole MiniRumble field (thread "Take 1st with JayLexi, Eveimear and Sanaro"; BENCH-262).
# 0.9 counts the surf's danger prediction from tick 2 instead of 3 (JAYLEXI-22, 0 code bytes, 1,495 B). This card
# checks it on the PC over every MiniRumble robot before any release, and reads the whole unreleased stack (0.7 walls
# segment, 0.8 orbit lines, 0.9) against the live 0.6.
#   ./queue.sh run pc-jaylexi-09        (or  .\queue.ps1 run pc-jaylexi-09)
# Run it from master with this card merged: git checkout master && git pull
# One bench queue, RoboRumble workers at 0. Nothing is uploaded or released. About 1 h 20 min to the end.
#
# Why it should win:
# - Field-wide movement, one constant. The prediction walks our orbit a tick at a time until the wave reaches us and
#   scores that spot; the start tick sets how far the wave has already come. From 3 the scored spot is a tick short of
#   where we will be. That is our reading, not a timing trace: TI4 (a tick shorter still) lost -0.33.
# - Cloud, 112 MiniRumble robots (kitlab/mini-wide3-field.txt), against 0.8: screen +0.50 +- 0.44 (3 seeds 57000),
#   lock +0.32 +- 0.25 (6 seeds 58000) and +0.26 +- 0.36 (6 seeds 59000), 12 seeds +0.29 +- 0.23 (A/A -0.23 +- 0.18).
#   docs/bench/jaylexi-tailoring.md section 8.
# - n is the shipped source; c is the same source with tick 3 (0.8's play, checked by grep); aa is c rebuilt. The
#   replay test (JAYLEXI-22) shows the two play other orders and that the shipped build is the readable one.
# - Risk: the cloud field is 112 of 668 robots; the rest of the field could read flat. The whole-field read settles it.
#
# Timing: --cpu-constant live (BENCH-245). The livematch step is Hadur's and BeepBoop's 1v1 check of the PC's turn time;
# MiniRumble runs on the same LiteRumble clients, so the same constant holds for it.
# Pilot: shuffled jobs, so the first 20% is a fair sample. A/A outside its band at 20% halts; n below -0.5 points at 20%
# finishes the run early (futility).
# Panel: kitlab/mini-pw-field.txt (668 MiniRumble robots, none ours or in broken-1.11.2.txt). 4 arms x 668 x 6 fresh
# seeds from 60000 x 35 rounds = 16,032 battles.
# Gate: n against c and aa pooled, mean over the 668 robots with its 95% low end above 0. r6 (the released 0.6) shows what
# 0.7 to 0.9 add over live. A pass ships as 0.9 on Leigh's word only.
# Stop rules: fails 30, dead 8, skips 60 over 200, stall 30m (halt; every battle fought is kept and a rerun resumes),
# aa after 20% (halt), futility n below -0.5 after 20% (finish). ALERT opens an issue for Leigh on a stop.

set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 512M
set SRC = ../jaylexi/src/main/java/hadur117/mini/JayLexi.java
set W = work/jaylexi-09
set OUT = ../docs/bench/local
set ALERT = lgriffin
set REL = https://github.com/lgriffin/Hadur_Robot/releases/download

prep | git checkout -q master && rm -f ${OUT}/*_jaylexi-09*.md && mkdir -p ${W} kitlab/jars bisect work && (cd ../jaylexi && mvn -q verify) && grep -q "int tick = 2;" ${SRC} && sed 's/int tick = 2;/int tick = 3;/' ${SRC} > ${W}/JayLexi.java && grep -q "int tick = 3;" ${W}/JayLexi.java && bash kitlab/build_arm_pg.sh ${W}/JayLexi.java hadur117.mini.JayLexi 0.8c && bash kitlab/build_arm_pg.sh ${W}/JayLexi.java hadur117.mini.JayLexi 0.8aa && bash kitlab/build_arm_pg.sh ${SRC} hadur117.mini.JayLexi 0.9n && curl -fsSL -o kitlab/jars/hadur117.mini.JayLexi_0.6.jar ${REL}/jaylexi-v0.6/hadur117.mini.JayLexi_0.6.jar && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set kitlab/mini-pw-field.txt && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out work/pc-livematch-rel-live --label pc-jaylexi-09-livematch --shuffle-jobs && python3 tools/live_match.py work/pc-livematch-rel-live/arms.tsv --out ${OUT}/pc-jaylexi-09-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

bench | ./bench-top20.sh ${C} ${P} --set kitlab/mini-pw-field.txt --seeds 6 --seed-base 60000 --arms plans/jaylexi-09.arms --out ${W}/run --label jaylexi-09 --shuffle-jobs
  after: livematch
  watch:
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m
  stop: aa after 20%
  stop: futility n below -0.5 after 20%

gate | python3 ../data/tools/multiarm.py ${W}/run/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_jaylexi-09.md && printf '\n## Gate\n\nn (0.9) ships when its mean against c and aa pooled over the 668 robots has its 95%% low end above 0. r6 is the released 0.6.\n' >> ${OUT}/$(date +%Y-%m-%d)_jaylexi-09.md && { [ ! -f ${W}/run/EARLY-STOP.md ] || cat ${W}/run/EARLY-STOP.md >> ${OUT}/$(date +%Y-%m-%d)_jaylexi-09.md; }
  after: bench

pr | bash tools/open_results_pr.sh claude/pc-jaylexi-09-results "JayLexi 0.9 on the whole MiniRumble field (pc-jaylexi-09)" ${OUT}/*_jaylexi-09.md ${OUT}/pc-jaylexi-09-livematch.md
  after: gate
