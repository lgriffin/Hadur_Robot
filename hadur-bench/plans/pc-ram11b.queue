# 1v1, field rammers, follow-up (BENCH-249): lock RAM-11, the rammer escape's circular-aim dodge, per opponent on the PC
# for the rammers whose ram-circ line locked on the cloud after pc-ram11 (BENCH-248) was written. A screen of the line
# on the other 75 field rammers (3 seeds from 23100) averaged -0.2, so it stays per robot; its leads were locked on 12
# fresh seeds from 23200 at the live turn time: Fusion +3.9 (95% low end +2.6) locked; ArthurPanzergon (+2.0, low end
# -1.2) and RedBull did not.
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live
#   lock       the panel robots   c / aa / rcl   12 fresh seeds from 23600, --cpu-constant live
#   gate       a robot keeps its line only where the PC lock's 95% low end is above 0 (mode_table.py --margin 0)
# Leigh starts it once the PC is free, after pc-ram11 (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-ram11b        (or  ./queue.sh run pc-ram11b)
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. The live-match step resumes from
# work/pc-livematch-rel-live, so after pc-ram11 it costs nothing; the lock is 36 battles a robot, a few minutes.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: each line names one robot; every other robot, team and melee play bit for bit as master
#     (ram-circ lines are read only in a duel, and the rcl jar differs from master only in the listed names).
#   - Diagnosis first: like the pc-ram11 rammers, these aim circularly from our turn rate, and our rammer escape dodged
#     only head-on and linear aims while driving smooth arcs (the full diagnosis is in plans/pc-ram11.queue).
#   - Each robot passed the cloud lock bar (12 fresh seeds, 95% low end above 0, live turn time).
# Stop rules (docs/bench/watch.md): the panel is under 10 robots, so the watcher's A/A stop cannot read; aa is read in the
# gate (multiarm.py prints aa against c) and pooled with c as the control. The skips window is 24 battles, which the
# lock reaches. The card halts on 30 failed battles, an arm scoring nothing in 8, 60+ skipped turns a battle over the
# last 24, or no battle in 30 minutes.
# The live-match step stops the card if the PC no longer scores us and BeepBoop as live
# does (tools/live_match.py exit 3). ALERT opens an issue for Leigh on any stop.
# Bank: the owning cloud thread adds the gate's lines (ShieldTableData.ramCircs) on this card's results PR.
# Nothing is released by the card.
set V = 3.23
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-ram11b
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && RAM_CIRC=plans/ram11b-add.txt bash ./build-ablation.sh rclist && test -f bisect/hadur117.Hadur_${V}rcl.jar && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-ram11b.txt && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out work/pc-livematch-rel-live --label pc-ram11b-livematch --shuffle-jobs && python3 tools/live_match.py work/pc-livematch-rel-live/arms.tsv --out ${OUT}/pc-ram11b-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock | ./bench-top20.sh ${C} ${P} --set panel-ram11b.txt --seeds 12 --seed-base 23600 --arms plans/pc-ram11b.arms --out ${W} --label pc-ram11b --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

gate | python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-ram11b-lock.md && python3 ../data/tools/mode_table.py ${W}/arms.tsv --margin 0 --out-tsv ${OUT}/pc-ram11b-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-ram11b-lock-pick.md && python3 tools/per_robot.py ${W}/arms.tsv --arms rcl --out ${OUT}/$(date +%Y-%m-%d)_pc-ram11b-lock-per-robot.md --out-tsv ${OUT}/pc-ram11b-lock-per-robot.tsv
  after: lock

pr | bash tools/open_results_pr.sh claude/pc-ram11b-results "1v1 RAM-11 per-opponent lines on the follow-up cloud-locked field rammers, locked on 12 fresh PC seeds" ${OUT}/pc-ram11b-livematch.md ${OUT}/*_pc-ram11b-*.md ${OUT}/pc-ram11b-lock-per-robot.tsv $(find ${OUT} -maxdepth 1 -name 'pc-ram11b-lock-pick.tsv' -size +0c)
  after: gate
