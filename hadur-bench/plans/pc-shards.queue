# 1v1, field shards at PC scale (BENCH-252): the PC runs about 4,300 battles an hour, ten times a cloud box, so it takes
# the screens and locks of the 15 Nov field shards in one overnight card instead of one small card each. Panel: 471
# robots of shards A-D (untried gap robots, live gap to BeepBoop over 1.5), G (gap to the best rival), M and L (lined
# robots BeepBoop still beats by 3+, a second lever stacked on the line) and shard F's three cloud locks (mtzl).
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live
#   screen     471 robots   c / aa / fq / x5 / hl / dg / gl / mq / mtzl     6 seeds from 42000, --cpu-constant live
#   pick       each robot's best lever at a 3-point margin, 95% low end above 0 (mode_table.py)
#   lock       the picked robots   c / aa / the picked arms, each rebuilt with only its picks   12 fresh seeds from 42100
#   gate       a robot ships its line only where the lock's 95% low end is above 0 (mode_table.py --margin 0)
# Leigh starts it once the PC is free, overnight (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-shards        (or  ./queue.sh run pc-shards)
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. Every step resumes; no step needs a decision.
# About 25,400 screen battles (~6 h at pc-field-screen's 4,300 an hour) plus a lock of a few hundred to ~2,000.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: every line names one robot; every other robot, team and melee play bit for bit as master.
#   - Diagnosis first: each shard's cloud box diagnosed its robots from truth logs (coverage/shards/diag-X.md) and the
#     levers screened are the ones that have held per robot before (pc-r31, pc-class-1/2, pc-gl-lines, pc-field-screen).
#     The cloud screens read 3-4 seeds (about +-5 points a lever); 6 PC seeds halve that noise, and the screen covers
#     in one night what the cloud boxes need days for.
#   - Each robot keeps a line only after 12 fresh seeds with the 95% low end above 0 at the live turn time, the bar
#     every 1v1 line has passed since 13 Nov (pc-ram11, pc-ram11b, pc-gl-lines: 5 of 5 cloud locks held on the PC).
#     Shard F's three robots already passed that bar on the cloud.
# Pilot and stop rules (docs/bench/watch.md): the screen's aa arm halts the card after 20% if master and its copy
# disagree; halt on 30 failed battles, an arm scoring nothing in 8, 60+ skipped turns a battle over the last 200
# (the lock: the last 24, as its panel can be small), or no battle in 30 minutes. The live-match step stops the card
# if the PC no longer scores us and BeepBoop as live does (tools/live_match.py exit 3). ALERT opens an issue on any stop.
# Bank: the owning cloud thread adds the gate's lines on this card's results PR. Nothing is released by the card.
set V = 3.23
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-shards
set L = work/pc-shards-lock
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && FLAT_ON=plans/shards-add.txt bash ./build-ablation.sh fllist && X5_POWER=plans/shards-add.txt bash ./build-ablation.sh x5list && HEAT_JIT=plans/shards-add.txt bash ./build-ablation.sh hjlist && SHOT_DODGE=plans/shards-add.txt bash ./build-ablation.sh sdodgelist && GUN_STACK=plans/shards-add.txt bash ./build-ablation.sh gslist && MIMIC_ON=plans/shards-add.txt bash ./build-ablation.sh mmlist && SHIELD_ADD=plans/shards-add.txt SHIELD_STILL=plans/shards-add.txt bash ./build-ablation.sh slistadd,szlist && for a in fq x5 hl dg gl mq mtzl; do test -f bisect/hadur117.Hadur_${V}$a.jar || exit 1; done && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-shards.txt && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out work/pc-livematch-rel-live --label pc-shards-livematch --shuffle-jobs && python3 tools/live_match.py work/pc-livematch-rel-live/arms.tsv --out ${OUT}/pc-shards-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

screen | ./bench-top20.sh ${C} ${P} --set panel-shards.txt --seeds 6 --seed-base 42000 --arms plans/pc-shards.arms --out ${W} --label pc-shards --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m
  stop: aa after 20%

pick | python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-shards-screen.md && python3 ../data/tools/mode_table.py ${W}/arms.tsv --margin 3 --out-tsv ${OUT}/pc-shards-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-shards-pick.md && python3 tools/per_robot.py ${W}/arms.tsv --arms fq x5 hl dg gl mq mtzl --out ${OUT}/$(date +%Y-%m-%d)_pc-shards-per-robot.md --out-tsv ${OUT}/pc-shards-per-robot.tsv && python3 tools/lock_prep.py ${OUT}/pc-shards-pick.tsv panel-shards.txt plans/pc-shards.arms ${L}-prep && bash ${L}-prep/build.sh
  after: screen

lock | if [ -s ${L}-prep/picks-panel.txt ]; then ./bench-top20.sh ${C} ${P} --set ${L}-prep/picks-panel.txt --seeds 12 --seed-base 42100 --arms ${L}-prep/lock.arms --out ${L} --label pc-shards-lock --shuffle-jobs; fi
  after: pick
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

gate | if [ -s ${L}-prep/picks-panel.txt ]; then python3 ../data/tools/multiarm.py ${L}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-shards-lock.md && python3 tools/lock_prep.py --restrict ${L}/arms.tsv ${L}-prep ${L}/arms-picked.tsv && python3 ../data/tools/mode_table.py ${L}/arms-picked.tsv --margin 0 --out-tsv ${OUT}/pc-shards-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-shards-lock-pick.md && python3 tools/per_robot.py ${L}/arms-picked.tsv --arms $(grep -v '^#' ${L}-prep/lock.arms | cut -d'|' -f1 | grep -v -w -e c -e aa | tr -d ' ' | tr '\n' ' ') --out ${OUT}/$(date +%Y-%m-%d)_pc-shards-lock-per-robot.md --out-tsv ${OUT}/pc-shards-lock-per-robot.tsv; fi
  after: lock

pr | bash tools/open_results_pr.sh claude/pc-shards-results "1v1 field shards at PC scale: seven levers on 471 shard robots, the best per robot locked on 12 fresh seeds" ${OUT}/pc-shards-livematch.md ${OUT}/*_pc-shards-*.md ${OUT}/pc-shards-*-per-robot.tsv $(find ${OUT} -maxdepth 1 -name 'pc-shards-*pick.tsv' -size +0c)
  after: gate
