# 1v1, gun-stack lines (BENCH-250): lock the gun-stack line (gl, ShieldTableData.gunStacks) per opponent on the PC for
# the robots whose gl line locked on the cloud. The g3 batch (gap ranks 82-131, 21 learning robots, master against
# BeepBoop with truth logs) screened five levers on 3 seeds; each robot's best lead of 3+ points was locked on 12 fresh
# seeds from 23800 at the live turn time. Of 12 leads only BlackBox gl held: +5.7 (95% low end +2.6).
#   livematch  the released jar and BeepBoop 2.0 on the 31-robot panel at the live constant, read against live
#   lock       the panel robots   c / aa / gl   12 fresh seeds from 25500, --cpu-constant live
#   gate       a robot keeps its line only where the PC lock's 95% low end is above 0 (mode_table.py --margin 0)
# Leigh starts it once the PC is free, after pc-ram11b (one card at a time, from master):
#   git checkout master && git pull
#   .\queue.ps1 run pc-gl-lines        (or  ./queue.sh run pc-gl-lines)
# One bench queue, RoboRumble workers at 0, 16 workers, truth log off. The live-match step resumes from
# work/pc-livematch-rel-live, so after pc-ram11 it costs nothing; the lock is 36 battles a robot, a few minutes.
#
# Why it should win (the PC card rule of 2026-11-03):
#   - Per-opponent tailoring: each line names one robot; every other robot, team and melee play bit for bit as master
#     (gun-stack lines are read only in a duel, and the gl jar differs from master only in the listed names).
#   - Diagnosis first: BlackBox is a strong learning gun (live gap to BeepBoop 10+ points); BeepBoop out-hits it, and
#     the gun stack is the lever that lifts our hit rate against learners. BlackBox already carries a mimic-on line;
#     the gun stack adds to it.
#   - It passed the cloud lock bar (12 fresh seeds, 95% low end above 0, live turn time).
# Stop rules (docs/bench/watch.md): the panel is under 10 robots, so the watcher's A/A stop cannot read; aa is read in the
# gate (multiarm.py prints aa against c) and pooled with c as the control. The skips window is 24 battles, which the
# lock reaches. The card halts on 30 failed battles, an arm scoring nothing in 8, 60+ skipped turns a battle over the
# last 24, or no battle in 30 minutes. The live-match step stops the card if the PC no longer scores us and BeepBoop
# as live does (tools/live_match.py exit 3). ALERT opens an issue for Leigh on any stop.
# Bank: the owning cloud thread adds the gate's lines (ShieldTableData.gunStacks) on this card's results PR.
# Nothing is released by the card.
set V = 3.23
set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 2G
set W = work/pc-gl-lines
set OUT = ../docs/bench/local
set ALERT = lgriffin

prep | git checkout -q master && mkdir -p bisect work && (cd .. && mvn -q -DskipTests package) && cp ../hadur-robot/target/hadur117.Hadur_${V}.jar bisect/ && bash ./build-ablation.sh aa && GUN_STACK=plans/gl-lines-add.txt bash ./build-ablation.sh gslist && test -f bisect/hadur117.Hadur_${V}gl.jar && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set panel-gl-lines.txt && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out work/pc-livematch-rel-live --label pc-gl-lines-livematch --shuffle-jobs && python3 tools/live_match.py work/pc-livematch-rel-live/arms.tsv --out ${OUT}/pc-gl-lines-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

lock | ./bench-top20.sh ${C} ${P} --set panel-gl-lines.txt --seeds 12 --seed-base 25500 --arms plans/pc-gl-lines.arms --out ${W} --label pc-gl-lines --shuffle-jobs
  after: livematch
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 24
  stop: stall 30m

gate | python3 ../data/tools/multiarm.py ${W}/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-gl-lines-lock.md && python3 ../data/tools/mode_table.py ${W}/arms.tsv --margin 0 --out-tsv ${OUT}/pc-gl-lines-lock-pick.tsv --out ${OUT}/$(date +%Y-%m-%d)_pc-gl-lines-lock-pick.md && python3 tools/per_robot.py ${W}/arms.tsv --arms gl --out ${OUT}/$(date +%Y-%m-%d)_pc-gl-lines-lock-per-robot.md --out-tsv ${OUT}/pc-gl-lines-lock-per-robot.tsv
  after: lock

pr | bash tools/open_results_pr.sh claude/pc-gl-lines-results "1v1 gun-stack lines on the cloud-locked learners, locked on 12 fresh PC seeds" ${OUT}/pc-gl-lines-livematch.md ${OUT}/*_pc-gl-lines-*.md ${OUT}/pc-gl-lines-lock-per-robot.tsv $(find ${OUT} -maxdepth 1 -name 'pc-gl-lines-lock-pick.tsv' -size +0c)
  after: gate
