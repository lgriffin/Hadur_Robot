# Saor's plan for 1st in MicroMelee, stage 5a (docs/plan-saor-first.md 6f): a screen on 0.2.
# pc-saor-s03 (PR #329): S2 (Saor's graded vote, no ram leg, learning below 0.9 gun heat) read
# 69.83 on the live-shaped census against Figment's 69.79 in the same run, a tie. S2 shipped as
# Saor 0.2 (Leigh, 2026-10-27), 748 bytes. This card screens 0.2's free constants and its two
# byte savers on the MicroMelee census; the winners go to a live-shaped confirm card (stage 5b)
# with Figment seated.
#   ./queue.sh run pc-saor-s04        (or  .\queue.ps1 run pc-saor-s04)
# Run it from master:
#   git checkout master && git pull
# One bench queue, RoboRumble workers at 0, unpinned, 12 workers. Every step resumes; no step needs
# a decision. Nothing here touches Hadur.
#
# Arms (saor-arms/arms.txt; bytes after ProGuard):
#   C      Saor 0.2, the control (748)
#   LA     0.2 learning on every scan (737)
#   U2     0.2 without the end-game power cap (734)
#   V4     0.2 with full trust from 4 samples (747)
#   V16    0.2 with full trust from 16 samples (748)
#   B2, B6 0.2 spreading a playout's vote over 5 or 13 bins, not 9 (748, 749)
# MicroMelee census for every arm (216 battles, about 15 min an arm, about 2 h).
# Pass: +0.3 or more over C with the low end above 0, field by field.

set MVN = mvn -q -Drobocode.version=1.11.1 compile exec:java
set OUT = ../docs/bench/local
set ARMS = C,LA,U2,V4,V16,B2,B6

prep | (cd .. && mvn -q -DskipTests install -pl saor -am) && cp ../saor/target/hadur117.micro.Saor_0.2.jar opponents/ && ./fetch-opponents.sh --set micromelee-field.txt && SAOR_RUN=s04 bash tools/saor_arms.sh census 12 2100 ${ARMS}

census-C | ${MVN} "-Dexec.args=@work/saor-s04/census-C.args"
  after: prep

census-LA | ${MVN} "-Dexec.args=@work/saor-s04/census-LA.args"
  after: census-C

census-U2 | ${MVN} "-Dexec.args=@work/saor-s04/census-U2.args"
  after: census-LA

census-V4 | ${MVN} "-Dexec.args=@work/saor-s04/census-V4.args"
  after: census-U2

census-V16 | ${MVN} "-Dexec.args=@work/saor-s04/census-V16.args"
  after: census-V4

census-B2 | ${MVN} "-Dexec.args=@work/saor-s04/census-B2.args"
  after: census-V16

census-B6 | ${MVN} "-Dexec.args=@work/saor-s04/census-B6.args"
  after: census-B2

read | python3 tools/saor_arms.py --work-root work/saor-s04 --arms ${ARMS} --control C > ${OUT}/saor-s04-census.md
  after: census-B6

pr | bash tools/open_results_pr.sh claude/pc-saor-s04-results "Saor stage 5a: a screen on 0.2" ${OUT}/saor-s04-census.md ${OUT}/saor-s04-census-*.md
  after: read
