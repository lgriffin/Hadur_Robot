# JayLexi 1.2 and 1.1 confirm on the whole MiniRumble field (thread "Take 1st with JayLexi, Eveimear and Sanaro"; BENCH-269).
# Replaces pc-jaylexi-11 (BENCH-268, never run): one run reads 1.1 and 1.2 against 1.0 on the same battles.
# 1.1 is 1.0 byte-trimmed with identical play (43 B), firing within 1200 / distance degrees of its aim instead of a flat 3
# (JAYLEXI-24), with Leopard's orbit 0.4 rad closer inside 200 px and aim jitter against uCatcher. 1,447 B.
# 1.2 is 1.1 with five per-robot lines in the free strings: power 1 from 500 px at FoilistMC and CunobelinDC, the two
# robots above us in the MiniRumble (JAYLEXI-25), and orbit 1.35 rad at Mark8, CannonfodderMicro and Charo. 1,451 B.
#   ./queue.sh run pc-jaylexi-12        (or  .\queue.ps1 run pc-jaylexi-12)
# Run it from master with this card merged: git checkout master && git pull
# One bench queue, RoboRumble workers at 0. Nothing is uploaded or released. About 1 h 40 min to the end.
#
# Why it should win:
# - 1.1, diagnosed: the cloud gap runs against FoilistMC showed chargers hitting us close in, and the flat 3 degree gate
#   holding fire while a robot closes. Cloud, 112 MiniRumble robots (kitlab/mini-wide3-field.txt), against 1.0: three
#   fresh 12-seed locks read +0.36 +- 0.26, +0.31 +- 0.29 and +0.35 +- 0.26, all with low ends above 0; chargers +3 to +4
#   points each. No other gate beat it head to head (860/d, max(3, 1200/d), 10 degrees, steps under 200 and 300 px).
# - 1.2, per robot: a truth-log diagnosis against FoilistMC found the strong learners out-last us on energy at range
#   (we fire 1.47 past 500 px, FoilistMC 0.97). As a field rule power 1 loses (-0.5); as a line it holds on FoilistMC
#   (+6.62 +- 2.21, 24 fresh seeds) and CunobelinDC (+2.64 +- 2.02, 48 seeds). Orbit 1.35 closes the distance where
#   FoilistMC sits closer: Mark8 +1.41 +- 0.76, CannonfodderMicro +1.19 +- 0.47 (24 seeds each), Charo about +1.9
#   over 36. A whole-field cloud lock of 1.2 against 1.1 read the other 107 robots level with the A/A, as it should:
#   their tables are 1.1's. docs/bench/jaylexi-tailoring.md section 12.
# - c is 1.0's source read from master at 299c55f3c (checked by grep for its 3 degree gate); n is 1.1's read from master
#   at 65a273240 (checked by grep for its one power row); t is the shipped source (checked by grep for its power rows);
#   aa is c rebuilt. The replay tests show 1.2 plays the readable reference bit for bit and its power rows play.
# - Risk: the lines are worth about +0.07 APS on the field, under what 6 seeds can see; the field read is the check that
#   nothing else moved, and the five line robots are read on their own.
#
# Timing: --cpu-constant live (BENCH-245). The livematch step is Hadur's and BeepBoop's 1v1 check of the PC's turn time;
# MiniRumble runs on the same LiteRumble clients, so the same constant holds for it.
# Pilot: shuffled jobs, so the first 20% is a fair sample. A/A outside its band at 20% halts; n below -0.5 points at 20%
# finishes the run early (futility).
# Panel: kitlab/mini-pw-field.txt (668 MiniRumble robots, none ours or in broken-1.11.2.txt). 5 arms x 668 x 6 fresh
# seeds from 62000 x 35 rounds = 20,040 battles.
# Gate: t (1.2) against c and aa pooled, mean over the 668 robots with its 95% low end above 0. n shows what 1.1 adds and
# t against n what the lines add (tools/arm_pair.py: the field and each line robot on its own); r6 (the released 0.6) shows what 0.7 to 1.2 add over live. A pass is banked; release
# only on Leigh's word.
# Stop rules: fails 30, dead 8, skips 60 over 200, stall 30m (halt; every battle fought is kept and a rerun resumes),
# aa after 20% (halt), futility t below -0.5 after 20% (finish). ALERT opens an issue for Leigh on a stop.

set P = --parallel 16 --no-truth-log --failed-ok
set C = --skip-build --skip-fetch --rounds 35 --cpu-constant live --child-heap 512M
set SRC = ../jaylexi/src/main/java/hadur117/mini/JayLexi.java
set W = work/jaylexi-12
set OUT = ../docs/bench/local
set ALERT = lgriffin
set REL = https://github.com/lgriffin/Hadur_Robot/releases/download

prep | git checkout -q master && rm -f ${OUT}/*_jaylexi-12*.md && mkdir -p ${W} kitlab/jars bisect work && (cd ../jaylexi && mvn -q verify) && grep -q "POWER.charAt(row + band)" ${SRC} && git show 299c55f3c:jaylexi/src/main/java/hadur117/mini/JayLexi.java > ${W}/JayLexi.java && grep -q "getGunTurnRemaining()) < 3 &&" ${W}/JayLexi.java && mkdir -p ${W}/n && git show 65a273240:jaylexi/src/main/java/hadur117/mini/JayLexi.java > ${W}/n/JayLexi.java && grep -q "POWER.charAt(band)" ${W}/n/JayLexi.java && bash kitlab/build_arm_pg.sh ${W}/JayLexi.java hadur117.mini.JayLexi 1.0c && bash kitlab/build_arm_pg.sh ${W}/JayLexi.java hadur117.mini.JayLexi 1.0aa && bash kitlab/build_arm_pg.sh ${W}/n/JayLexi.java hadur117.mini.JayLexi 1.1n && bash kitlab/build_arm_pg.sh ${SRC} hadur117.mini.JayLexi 1.2t && curl -fsSL -o kitlab/jars/hadur117.mini.JayLexi_0.6.jar ${REL}/jaylexi-v0.6/hadur117.mini.JayLexi_0.6.jar && bash tools/fetch_live_jar.sh && ./fetch-opponents.sh --set panel-r31.txt && ./fetch-opponents.sh --set livematch-bb.txt && test -f opponents/kc.mega.BeepBoop_2.0.jar && ./fetch-opponents.sh --set kitlab/mini-pw-field.txt && mvn -q compile

livematch | ./bench-top20.sh ${C} ${P} --set panel-r31.txt --seeds 2 --seed-base 21700 --arms plans/livematch.arms --out work/pc-livematch-rel-live --label pc-jaylexi-12-livematch --shuffle-jobs && python3 tools/live_match.py work/pc-livematch-rel-live/arms.tsv --out ${OUT}/pc-jaylexi-12-livematch.md
  after: prep
  watch: field=1217
  stop: fails 30
  stop: dead 8
  stop: stall 30m

bench | ./bench-top20.sh ${C} ${P} --set kitlab/mini-pw-field.txt --seeds 6 --seed-base 62000 --arms plans/jaylexi-12.arms --out ${W}/run --label jaylexi-12 --shuffle-jobs
  after: livematch
  watch:
  stop: fails 30
  stop: dead 8
  stop: skips 60 over 200
  stop: stall 30m
  stop: aa after 20%
  stop: futility t below -0.5 after 20%

gate | python3 ../data/tools/multiarm.py ${W}/run/arms.tsv --out ${OUT}/$(date +%Y-%m-%d)_jaylexi-12.md && printf '\n## Gate\n\nt (1.2) ships when its mean against c and aa pooled over the 668 robots has its 95%% low end above 0. n is 1.1; r6 is the released 0.6.\n' >> ${OUT}/$(date +%Y-%m-%d)_jaylexi-12.md && python3 tools/arm_pair.py ${W}/run/arms.tsv --candidate t --baseline n --robots FoilistMC CunobelinDC Mark8 CannonfodderMicro Charo --out ${OUT}/$(date +%Y-%m-%d)_jaylexi-12.md && python3 tools/arm_pair.py ${W}/run/arms.tsv --candidate n --baseline c --out ${OUT}/$(date +%Y-%m-%d)_jaylexi-12.md && { [ ! -f ${W}/run/EARLY-STOP.md ] || cat ${W}/run/EARLY-STOP.md >> ${OUT}/$(date +%Y-%m-%d)_jaylexi-12.md; }
  after: bench

pr | bash tools/open_results_pr.sh claude/pc-jaylexi-12-results "JayLexi 1.2 and 1.1 on the whole MiniRumble field (pc-jaylexi-12)" ${OUT}/*_jaylexi-12.md ${OUT}/pc-jaylexi-12-livematch.md
  after: gate
