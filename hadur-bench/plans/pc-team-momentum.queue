# Dodge the enemies' bullets from how a member is really moving (TMODE-39 MOMENTUM, BENCH-171; team
# thread "Stop friendly fire to close the team gap"). Team only: duel and melee fixtures replay bit for bit.
# The Ogi mirror (PR #569) put +1.78 APS of the gap to Ogi on enemy bullets hitting us. The dodge
# (TMODE-27) scores each destination by driving 30 ticks through the enemies' waves, but that drive
# starts from a standstill already facing the spot. A member at 8 px a tick the other way brakes 2 a
# tick and turns at most 10 degrees a tick, so the spots it rates safe are often not reachable in
# time. MOMENTUM drives each spot from the member's real heading and velocity at the engine's turn
# rate, the same physics as CLEAR's (TMODE-38). Measured on its own, against aa (CLEAR off).
# TidalWave is left out (plans/team-angles-set.txt): it does not load on Robocode 1.11.2. Gains divide
# by 46 teams. A battle step's exit 1 (some battles failed) lets the card go on.
#   mtprep  build aa, bb and mo (tmmomentum: MOMENTUM on every team, the named ones included)
#   mtbb    bb vs aa, 45 teams x 12 seeds (base 7700), 10 rounds; mtmo the same for mo
#   mtff    own-fire read of both arms (tools/friendly_hits.py --candidate-only)
#   mtsum   projected team APS change for mo = sum of its per-team gain less half of bb's / 46
#           (gate: +0.30 with the 95% low end above zero). The card changes nothing: on a PASS a PR
#           turns FORCE_MOMENTUM on.
# Each seed is a pair (the arm and aa): 2 x 45 x 12 x 2 = 2,160 battles, about 2.2 h at 12 workers
# (sizes itself to the host). Every step resumes where it stopped. Run it after pc-team-clear.
# Stop rules on every battle step (halt; every battle fought is kept and a rerun resumes): 60 failed
# battles, no battle in 30 minutes (a hung step), or 40+ skipped turns a battle over the last 100.
# The team thread reads claude/pc-team-momentum-results.
#   ./queue.sh run pc-team-momentum        (or  .\queue.ps1 run pc-team-momentum)
# Run it from master (one bench queue at a time):
#   git checkout master && git pull

set OUT = ../docs/bench/local
set T = python3 tools/team_modes.py

mtprep | git checkout -q master && V=$(sed -n 's:.*<robot.release>\(.*\)</robot.release>.*:\1:p' ../hadur-robot/pom.xml) && test -n "$V" && for j in aa bb mo; do rm -f bisect/hadur117.HadurTeam_"$V"$j.jar; done && rm -f ${OUT}/team-momentum-*.md && ./fetch-opponents.sh --set team-census46.txt && bash ./build-ablation.sh aa && bash ./build-ablation.sh bb && bash ./build-ablation.sh tmmomentum && mkdir -p work && for a in bb mo; do rm -rf work/team-momentum-"$V"-$a && sed "s/@V@/$V/g" plans/team-momentum-$a.args > work/team-momentum-$a.args || exit 1; done && for j in aa bb mo; do test -f bisect/hadur117.HadurTeam_"$V"$j.jar || exit 1; done && mvn -q compile
mtbb   | mvn -q exec:java "-Dexec.args=@work/team-momentum-bb.args" || test $? -eq 1
  after: mtprep
  watch: battles=1080
  stop: fails 60
  stop: stall 30m
  stop: skips 40 over 100
mtmo   | mvn -q exec:java "-Dexec.args=@work/team-momentum-mo.args" || test $? -eq 1
  after: mtbb
  watch: battles=1080
  stop: fails 60
  stop: stall 30m
  stop: skips 40 over 100
mtff   | V=$(sed -n 's:.*<robot.release>\(.*\)</robot.release>.*:\1:p' ../hadur-robot/pom.xml) && python3 tools/friendly_hits.py --candidate-only work/team-momentum-"$V"-bb > ${OUT}/team-momentum-friendly-bb.md && python3 tools/friendly_hits.py --candidate-only work/team-momentum-"$V"-mo > ${OUT}/team-momentum-friendly-mo.md
  after: mtmo
mtsum  | ${T} gate --report ${OUT}/team-momentum-mo.md --control ${OUT}/team-momentum-bb.md --seeds 12 --teams 46 --min-aps 0.3 --out-md ${OUT}/team-momentum-verdict.md
  after: mtff
mtpr   | bash tools/open_results_pr.sh claude/pc-team-momentum-results "Dodge drives from heading and speed (MOMENTUM): every team, 12 seeds" $(ls ${OUT}/team-momentum-*.md 2>/dev/null)
  after: mtsum
