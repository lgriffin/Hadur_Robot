Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://rumble.robowiki.net/style.css

@charset "utf-8";

html { font-family: helvetica, arial, sans-serif; }

table, td, th { border: 1px solid rgb(211, 211, 211); border-collapse: collapse; padding: 2px 4px; margin-bottom: 1em; }

th > a, th > a:active, th > a:visited { color: rgb(0, 0, 0); text-decoration: none; }

th { text-align: left; padding-right: 1em; }

tr:nth-child(2n+1), tr.dim { background-color: rgb(244, 244, 244); }

table.rumble td:nth-child(3) { text-align: center; }

th.sortedby { font-style: italic; text-decoration: underline; }

h3 { font-weight: normal; }

form[action="BotCompare"] { margin: 0px; text-align: center; }

td.green { background-color: rgb(153, 204, 0); }

td.red { background-color: rgb(255, 102, 0); }

.header { position: absolute; }

#flag { width: 30px; height: 18px; }

#distribution { position: relative; height: 220px; width: auto; border: 1px solid black; }

#distribution2 { position: relative; height: 170px; width: auto; border: 1px solid black; }

body.dark { background-color: rgb(30, 30, 30); color: rgb(221, 221, 221); }

body.dark table, body.dark td, body.dark th { border-color: rgb(68, 68, 68); }

body.dark th > a, body.dark th > a:active, body.dark th > a:visited { color: rgb(221, 221, 221); }

body.dark a, body.dark a:visited { color: rgb(108, 182, 255); }

body.dark tr:nth-child(2n+1), body.dark tr.dim { background-color: rgb(42, 42, 42); }

body.dark td.green { background-color: rgb(76, 107, 0); }

body.dark td.red { background-color: rgb(163, 59, 0); }

body.dark #distribution, body.dark #distribution2 { border-color: rgb(221, 221, 221); }

#tip { background: rgb(255, 255, 238); border: 1px solid rgb(153, 153, 153); }

body.dark #tip { background: rgb(51, 51, 51); border-color: rgb(102, 102, 102); }
